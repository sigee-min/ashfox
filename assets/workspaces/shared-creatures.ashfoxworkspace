{"files":[{"path":"creatures/body.ashfox","source":"ashfox-model 1\nmodule body {\n  import \"./rig.ashfox\" as rig;\n  import \"./surface.ashfox\" as surface;\n  export component FoxBody {\n    requires rig skeleton: rig.CreatureRig;\n    requires surface skin: surface.Fur;\n    bind bone body to skeleton.body;\n    bind bone head to skeleton.head;\n    bind bone tail to skeleton.tail;\n    bind bone tail_tip to skeleton.tail_tip;\n    bind bone front_left to skeleton.front_left;\n    bind bone front_right to skeleton.front_right;\n    bind bone back_left to skeleton.back_left;\n    bind bone back_right to skeleton.back_right;\n    geometry {\n      bone body {\n        cube pelvis { origin = (-3u, 8u, 3.6u); size = (6u, 5u, 4u); pivot = (0u, 10.5u, 5.6u); rotation = (-4deg, 0deg, 0deg); surface = skin.pelvis; }\n        cube torso { origin = (-3.5u, 7.8u, -3u); size = (7u, 6u, 7u); surface = skin.torso; }\n        cube chest { origin = (-4u, 7.2u, -7.8u); size = (8u, 7u, 5u); pivot = (0u, 10.5u, -5.3u); rotation = (6deg, 0deg, 0deg); surface = skin.chest; }\n        cube ruff { origin = (-3.5u, 10.2u, -9.2u); size = (7u, 3u, 4u); pivot = (0u, 11.7u, -7.2u); rotation = (-10deg, 0deg, 0deg); surface = skin.ruff; }\n        bone head {\n          cube skull { origin = (-4u, 12.6u, -13u); size = (8u, 6u, 7u); pivot = (0u, 15.6u, -9.5u); rotation = (3deg, 0deg, 0deg); surface = skin.head; }\n          cube muzzle { origin = (-2u, 12.6u, -17u); size = (4u, 3u, 4u); surface = skin.muzzle; }\n          cube nose { origin = (-1u, 14.3u, -17.8u); size = (2u, 1u, 2u); surface = skin.nose; }\n          cube ear_base_l { origin = (-3.8u, 18.4u, -10u); size = (3u, 3u, 2u); pivot = (-2.3u, 18.4u, -9u); rotation = (-6deg, 0deg, -14deg); mirror-x = ear_base_r; surface = skin.ear_base; }\n          cube ear_tip_l { origin = (-3.3u, 21.3u, -9.8u); size = (2u, 2u, 1u); pivot = (-2.3u, 18.4u, -9u); rotation = (-6deg, 0deg, -14deg); mirror-x = ear_tip_r; surface = skin.ear_tip; }\n          cube ear_inner_l { origin = (-3.3u, 18.8u, -10.8u); size = (2u, 2u, 1u); pivot = (-2.3u, 18.4u, -9u); rotation = (-6deg, 0deg, -14deg); mirror-x = ear_inner_r; surface = skin.ear_inner; }\n          plane cheek_tuft_l { origin = (-4.05u, 12.4u, -12.4u); size = (3u, 3u); u-axis = (0u, 0u, 1u); v-axis = (0u, 1u, 0u); rotation = (0deg, -22deg, 0deg); mirror-x = cheek_tuft_r; surface = skin.cheek_tuft; }\n        }\n        bone tail {\n          cube tail_base { origin = (-1.5u, 9.6u, 7.6u); size = (3u, 3u, 6u); pivot = (0u, 11.1u, 7.6u); rotation = (-12deg, 0deg, 0deg); surface = skin.tail_base; }\n          bone tail_tip {\n            cube tail_mid { origin = (-2.5u, 9.4u, 12.6u); size = (5u, 5u, 7u); pivot = (0u, 11.9u, 13u); rotation = (12deg, 0deg, 0deg); surface = skin.tail_main; }\n            cube tail_end { origin = (-2u, 11.2u, 18.8u); size = (4u, 4u, 5u); pivot = (0u, 13.2u, 19u); rotation = (18deg, 0deg, 0deg); surface = skin.tail_tip; }\n            cube tail_end_tip { origin = (-1u, 13.4u, 22.8u); size = (2u, 2u, 3u); pivot = (0u, 14.4u, 23u); rotation = (22deg, 0deg, 0deg); surface = skin.tail_tip_fine; }\n            plane tail_plume_l { origin = (-2.55u, 10u, 13.5u); size = (4u, 3u); u-axis = (0u, 0u, 1u); v-axis = (0u, 1u, 0u); rotation = (0deg, -14deg, 0deg); mirror-x = tail_plume_r; surface = skin.tail_plume; }\n          }\n        }\n        bone front_left {\n          cube shoulder_fl { origin = (-4.4u, 5.5u, -6u); size = (3u, 4u, 3u); pivot = (-2.9u, 9.5u, -4.5u); rotation = (5deg, 0deg, 0deg); surface = skin.front_shoulder; }\n          cube forearm_fl { origin = (-3.6u, 2u, -5.5u); size = (2u, 4u, 2u); pivot = (-2.6u, 6u, -4.5u); rotation = (-3deg, 0deg, 0deg); surface = skin.front_leg; }\n          cube paw_fl { origin = (-3.6u, 0u, -6.5u); size = (2u, 2u, 3u); surface = skin.front_paw; }\n        }\n        bone front_right {\n          cube shoulder_fr { origin = (1.4u, 5.5u, -6u); size = (3u, 4u, 3u); pivot = (2.9u, 9.5u, -4.5u); rotation = (5deg, 0deg, 0deg); surface = skin.front_shoulder; }\n          cube forearm_fr { origin = (1.6u, 2u, -5.5u); size = (2u, 4u, 2u); pivot = (2.6u, 6u, -4.5u); rotation = (-3deg, 0deg, 0deg); surface = skin.front_leg; }\n          cube paw_fr { origin = (1.6u, 0u, -6.5u); size = (2u, 2u, 3u); surface = skin.front_paw; }\n        }\n        bone back_left {\n          cube thigh_bl { origin = (-4.6u, 6.2u, 3.8u); size = (4u, 4u, 4u); pivot = (-2.6u, 9.8u, 5.8u); rotation = (8deg, 0deg, 0deg); surface = skin.back_leg; }\n          cube shin_bl { origin = (-4u, 4u, 5.3u); size = (3u, 3u, 3u); pivot = (-2.5u, 5.5u, 6.8u); rotation = (-16deg, 0deg, 0deg); surface = skin.back_shin; }\n          cube hock_bl { origin = (-3.5u, 1.8u, 4.4u); size = (2u, 3u, 2u); pivot = (-2.5u, 2u, 5.4u); rotation = (18deg, 0deg, 0deg); surface = skin.back_hock; }\n          cube paw_bl { origin = (-3.5u, 0u, 3u); size = (2u, 2u, 3u); surface = skin.back_paw; }\n        }\n        bone back_right {\n          cube thigh_br { origin = (0.6u, 6.2u, 3.8u); size = (4u, 4u, 4u); pivot = (2.6u, 9.8u, 5.8u); rotation = (8deg, 0deg, 0deg); surface = skin.back_leg; }\n          cube shin_br { origin = (1u, 4u, 5.3u); size = (3u, 3u, 3u); pivot = (2.5u, 5.5u, 6.8u); rotation = (-16deg, 0deg, 0deg); surface = skin.back_shin; }\n          cube hock_br { origin = (1.5u, 1.8u, 4.4u); size = (2u, 3u, 2u); pivot = (2.5u, 2u, 5.4u); rotation = (18deg, 0deg, 0deg); surface = skin.back_hock; }\n          cube paw_br { origin = (1.5u, 0u, 3u); size = (2u, 2u, 3u); surface = skin.back_paw; }\n        }\n      }\n    }\n  }\n}\n"},{"path":"creatures/fox.ashfox","source":"ashfox-model 1\nasset fox {\n  import \"./rig.ashfox\" as rig;\n  import \"./surface.ashfox\" as surface;\n  import \"./body.ashfox\" as body;\n  export asset fox {\n    settings { density = 16; forward = north; profile = creature; }\n    skeleton = rig.CreatureSkeleton;\n    motion = rig.idle;\n    motion = rig.curious;\n    motion = rig.tail_wag;\n    use body.FoxBody as fox { bind skeleton = rig.CreatureRig; bind skin = surface.red_fox; };\n  }\n}\n"},{"path":"creatures/goblin-body.ashfox","source":"ashfox-model 1\nmodule goblin_body {\n  import \"./goblin-rig.ashfox\" as rig;\n  import \"./goblin-surface.ashfox\" as surface;\n  export component GoblinRaider {\n    requires rig skeleton: rig.GoblinRig;\n    requires surface skin: surface.RaiderSkin;\n    bind bone pelvis to skeleton.pelvis;\n    bind bone torso to skeleton.torso;\n    bind bone head to skeleton.head;\n    bind bone left_arm to skeleton.left_arm;\n    bind bone right_arm to skeleton.right_arm;\n    bind bone weapon to skeleton.weapon;\n    bind bone left_leg to skeleton.left_leg;\n    bind bone right_leg to skeleton.right_leg;\n    geometry {\n      bone pelvis {\n        cube hips { origin = (-4u, 9.5u, -2.5u); size = (8u, 3u, 5u); surface = skin.pelvis; }\n        cube belt { origin = (-4.5u, 12.5u, -3.2u); size = (9u, 2u, 6u); surface = skin.belt; }\n        cube buckle { origin = (-1.5u, 12.5u, -4.1u); size = (3u, 2u, 1u); surface = skin.buckle; }\n        plane loincloth_front { origin = (-3u, 7u, -3.4u); size = (6u, 5u); u-axis = (1u, 0u, 0u); v-axis = (0u, 1u, 0u); surface = skin.loincloth; }\n        plane loincloth_back { origin = (-3u, 7u, 3.1u); size = (6u, 5u); u-axis = (1u, 0u, 0u); v-axis = (0u, 1u, 0u); surface = skin.loincloth; }\n        bone torso {\n          cube chest { origin = (-5u, 14.5u, -3u); size = (10u, 8u, 6u); pivot = (0u, 18.5u, 0u); rotation = (4deg, 0deg, 0deg); surface = skin.torso; }\n          bone head {\n            cube skull { origin = (-4u, 22.5u, -5u); size = (8u, 7u, 8u); pivot = (0u, 25.5u, -1u); rotation = (4deg, 0deg, 0deg); surface = skin.head; }\n            cube snout { origin = (-2.5u, 22.2u, -7.9u); size = (5u, 2u, 3u); surface = skin.snout; }\n            cube tusk_l { origin = (-2.4u, 21.8u, -8.5u); size = (1u, 3u, 2u); pivot = (-1.9u, 22.5u, -7.5u); rotation = (-14deg, 0deg, -8deg); mirror-x = tusk_r; surface = skin.tusk; }\n            cube ear_l { origin = (-7.2u, 24.5u, -2u); size = (3u, 3u, 2u); pivot = (-4u, 26u, -1u); rotation = (0deg, 10deg, -18deg); mirror-x = ear_r; surface = skin.ear; }\n            cube ear_tip_l { origin = (-9.8u, 25.5u, -1.6u); size = (3u, 2u, 2u); pivot = (-4u, 26u, -1u); rotation = (0deg, 10deg, -22deg); mirror-x = ear_tip_r; surface = skin.ear_tip; }\n            cube mohawk_front { origin = (-1u, 29.4u, -4.5u); size = (2u, 3u, 4u); pivot = (0u, 29.4u, -2.5u); rotation = (-12deg, 0deg, 0deg); surface = skin.mohawk; }\n            cube mohawk_back { origin = (-1u, 29.4u, -0.4u); size = (2u, 3u, 4u); pivot = (0u, 29.4u, 1.5u); rotation = (16deg, 0deg, 0deg); surface = skin.mohawk; }\n          }\n          bone left_arm {\n            cube pauldron_l { origin = (-9.5u, 19.4u, -2.5u); size = (5u, 3u, 5u); pivot = (-5u, 20.4u, 0u); rotation = (0deg, 0deg, 16deg); surface = skin.pauldron; }\n            cube arm_l { origin = (-8.5u, 13.5u, -1.5u); size = (3u, 6u, 3u); surface = skin.arm; }\n            cube bracer_l { origin = (-9u, 10.5u, -2u); size = (4u, 3u, 4u); surface = skin.bracer; }\n            cube hand_l { origin = (-8.5u, 7.5u, -1.5u); size = (3u, 3u, 3u); surface = skin.hand; }\n            cube shield { origin = (-12.5u, 8u, -4.2u); size = (3u, 10u, 8u); pivot = (-10u, 13u, 0u); rotation = (0deg, -14deg, 0deg); surface = skin.shield; }\n            cube shield_boss { origin = (-13.4u, 11u, -2.2u); size = (1u, 4u, 4u); pivot = (-10u, 13u, 0u); rotation = (0deg, -14deg, 0deg); surface = skin.boss; }\n          }\n          bone right_arm {\n            cube pauldron_r { origin = (4.5u, 19.4u, -2.5u); size = (5u, 3u, 5u); pivot = (5u, 20.4u, 0u); rotation = (0deg, 0deg, -16deg); surface = skin.pauldron; }\n            cube arm_r { origin = (5.5u, 13.5u, -1.5u); size = (3u, 6u, 3u); surface = skin.arm; }\n            cube bracer_r { origin = (5u, 10.5u, -2u); size = (4u, 3u, 4u); surface = skin.bracer; }\n            cube hand_r { origin = (5.5u, 7.5u, -1.5u); size = (3u, 3u, 3u); surface = skin.hand; }\n            bone weapon {\n              cube grip { origin = (6u, 8u, -4.5u); size = (2u, 2u, 3u); surface = skin.grip; }\n              cube crossguard { origin = (4.5u, 8.5u, -5.6u); size = (5u, 1u, 1u); pivot = (7u, 9u, -5.1u); rotation = (0deg, 0deg, 22.5deg); surface = skin.crossguard; }\n              cube blade { origin = (6u, 8u, -19.2u); size = (2u, 2u, 13u); surface = skin.blade; }\n              cube blade_tip { origin = (6.5u, 8u, -22.2u); size = (1u, 2u, 3u); surface = skin.blade_tip; }\n              cube pommel { origin = (5.5u, 7.5u, 1.4u); size = (3u, 3u, 2u); surface = skin.pommel; }\n            }\n          }\n        }\n        bone left_leg {\n          cube leg_l { origin = (-4.2u, 5u, -2u); size = (4u, 5u, 4u); surface = skin.leg; }\n          cube boot_cuff_l { origin = (-4.6u, 3u, -2.5u); size = (5u, 2u, 5u); surface = skin.cuff; }\n          cube boot_l { origin = (-4.2u, 0u, -4u); size = (4u, 3u, 6u); surface = skin.boot; }\n        }\n        bone right_leg {\n          cube leg_r { origin = (0.2u, 5u, -2u); size = (4u, 5u, 4u); surface = skin.leg; }\n          cube boot_cuff_r { origin = (-0.4u, 3u, -2.5u); size = (5u, 2u, 5u); surface = skin.cuff; }\n          cube boot_r { origin = (0.2u, 0u, -4u); size = (4u, 3u, 6u); surface = skin.boot; }\n        }\n      }\n    }\n  }\n}\n"},{"path":"creatures/goblin-rig.ashfox","source":"ashfox-model 1\nmodule goblin_rig {\n  export rig contract GoblinRig {\n    handedness = right;\n    frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); }\n    joint root { parent = none; role = root; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = (rotation, scale); mirror = none; }\n    joint pelvis { parent = root; role = pelvis; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = rotation; mirror = none; }\n    joint torso { parent = pelvis; role = body; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = rotation; mirror = none; }\n    joint head { parent = torso; role = head; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = rotation; mirror = none; }\n    joint left_arm { parent = torso; role = arm; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = rotation; mirror = none; }\n    joint right_arm { parent = torso; role = arm; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = rotation; mirror = none; }\n    joint weapon { parent = right_arm; role = weapon; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = rotation; mirror = none; }\n    joint left_leg { parent = pelvis; role = leg; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = rotation; mirror = none; }\n    joint right_leg { parent = pelvis; role = leg; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = rotation; mirror = none; }\n  }\n\n  export skeleton RaiderSkeleton implements GoblinRig {\n    bind root { parent-origin = (0u, 0u, 0u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }\n    bind pelvis { parent-origin = (0u, 11u, 0u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }\n    bind torso { parent-origin = (0u, 2u, 0u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }\n    bind head { parent-origin = (0u, 10u, -1u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }\n    bind left_arm { parent-origin = (-6.5u, 6.5u, 0u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }\n    bind right_arm { parent-origin = (6.5u, 6.5u, 0u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }\n    bind weapon { parent-origin = (0u, -9.5u, -1u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }\n    bind left_leg { parent-origin = (-2u, -1u, 0u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }\n    bind right_leg { parent-origin = (2u, -1u, 0u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }\n  }\n\n  export motion idle for GoblinRig {\n    duration = 2s; fps = 20; loop = loop; rest-relative = true;\n    track pelvis.rotation {\n      key 0s = (0deg, 0deg, 0deg) catmullrom;\n      key 1s = (2deg, 0deg, 0deg) catmullrom;\n      key 2s = (0deg, 0deg, 0deg) catmullrom;\n    }\n    track torso.rotation {\n      key 0s = (0deg, 0deg, 0deg) catmullrom;\n      key 1s = (2deg, -3deg, 0deg) catmullrom;\n      key 2s = (0deg, 0deg, 0deg) catmullrom;\n    }\n    track head.rotation {\n      key 0s = (0deg, 0deg, 0deg) catmullrom;\n      key 1s = (-2deg, 5deg, 0deg) catmullrom;\n      key 2s = (0deg, 0deg, 0deg) catmullrom;\n    }\n    track right_arm.rotation {\n      key 0s = (0deg, 0deg, 0deg) catmullrom;\n      key 1s = (-4deg, 3deg, 3deg) catmullrom;\n      key 2s = (0deg, 0deg, 0deg) catmullrom;\n    }\n    track left_arm.rotation {\n      key 0s = (0deg, 0deg, 0deg) catmullrom;\n      key 1s = (4deg, -3deg, -3deg) catmullrom;\n      key 2s = (0deg, 0deg, 0deg) catmullrom;\n    }\n  }\n\n  export motion lookout for GoblinRig {\n    duration = 4s; fps = 24; loop = loop; rest-relative = true;\n    track head.rotation {\n      key 0s = (0deg, 0deg, 0deg) catmullrom;\n      key 1s = (0deg, -22deg, 2deg) catmullrom;\n      key 2s = (0deg, -22deg, 2deg) catmullrom;\n      key 3s = (-3deg, 20deg, -2deg) catmullrom;\n      key 4s = (0deg, 0deg, 0deg) catmullrom;\n    }\n    track left_arm.rotation {\n      key 0s = (0deg, 0deg, 0deg) catmullrom;\n      key 1s = (-8deg, 0deg, -8deg) catmullrom;\n      key 3s = (-8deg, 0deg, -8deg) catmullrom;\n      key 4s = (0deg, 0deg, 0deg) catmullrom;\n    }\n  }\n\n  export motion challenge for GoblinRig {\n    duration = 3s; fps = 24; loop = loop; rest-relative = true;\n    track right_arm.rotation {\n      key 0s = (0deg, 0deg, 0deg) catmullrom;\n      key 0.8s = (35deg, -8deg, 12deg) catmullrom;\n      key 1.5s = (35deg, -8deg, 12deg) catmullrom;\n      key 2.4s = (3deg, 0deg, 2deg) catmullrom;\n      key 3s = (0deg, 0deg, 0deg) catmullrom;\n 