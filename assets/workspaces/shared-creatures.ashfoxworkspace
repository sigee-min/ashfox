{"files":[{"path":"assets/models/goblin_raider.ashfox","source":"ashfox 1\nmodel goblin_raider {\n  import \"std/model/rig/biped\" as biped;\n  import \"std/model/motion/locomotion\" as loco;\n  import \"std/model/motion/combat\" as combat;\n  import \"std/core/hook/combat\" as combat_hook;\n  import \"std/core/hook/loot\" as loot_hook;\n  import \"shared_modules/goblin_kit\" as kit;\n  import \"shared_modules/goblin_skins\" as skins;\n\n  settings { density = 16; forward = north; profile = creature; }\n  skeleton = biped.BipedSkeleton;\n  motions = [kit.goblin_idle, loco.biped_walk, combat.slash, kit.goblin_challenge];\n\n  use kit.GoblinBody as body { skeleton = biped.BipedRig; skin = skins.raider_skin; }\n  use kit.RaiderGear as blade { skin = skins.raider_weapon; }\n  use kit.RaiderShield as shield { skin = skins.raider_shield; }\n  connect body.gear_hand -> blade.grip;\n  connect body.off_hand_mount -> shield.mount;\n\n  cue blade_arc : combat_hook.HitboxArc { clip = slash; at = 0.2s..0.45s; reach = 18u; damage = 16; damage_type = slash; }\n  anchor loot_drop : loot_hook.ItemDrop { bone = pelvis; item_id = \"ashfox:iron_sword\"; chance = 0.25; }\n  meta ai_profile : combat_hook.CombatStateMeta { aggro_range = 16.0; leash_range = 36.0; attack_cooldown = 1.4s; }\n}\n"},{"path":"assets/models/griffin_boss.ashfox","source":"ashfox 1\nmodel griffin_boss {\n  import \"std/model/rig/winged_quadruped\" as wq;\n  import \"std/core/hook/combat\" as combat_hook;\n  import \"std/core/hook/world\" as world_hook;\n  import \"griffin_plumage/plumage\" as plumage;\n\n  component GriffinBody {\n    requires rig skeleton: wq.WingedQuadrupedRig;\n    requires surface skin: plumage.GriffinPlumage;\n    bind bone root to skeleton.root;\n    bind bone torso to skeleton.torso;\n    bind bone neck to skeleton.neck;\n    bind bone head to skeleton.head;\n    bind bone wing_l to skeleton.wing_l;\n    bind bone wing_tip_l to skeleton.wing_tip_l;\n    bind bone wing_r to skeleton.wing_r;\n    bind bone wing_tip_r to skeleton.wing_tip_r;\n    bind bone foreleg_l to skeleton.foreleg_l;\n    bind bone foreleg_r to skeleton.foreleg_r;\n    bind bone hindleg_l to skeleton.hindleg_l;\n    bind bone hindleg_r to skeleton.hindleg_r;\n    bind bone tail to skeleton.tail;\n    bind bone tail_tip to skeleton.tail_tip;\n    geometry {\n      bone root {\n        bone torso {\n          cube haunch { origin = (-5u, 10u, 1u); size = (10u, 9u, 12u); surface = skin.haunch; }\n          cube chest { origin = (-6u, 10u, -8u); size = (12u, 11u, 9u); pivot = (0u, 16u, -3u); rotation = (4deg, 0deg, 0deg); surface = skin.chest; }\n          cube breast { origin = (-4u, 11u, -12u); size = (8u, 8u, 4u); pivot = (0u, 15u, -10u); rotation = (12deg, 0deg, 0deg); surface = skin.breast; }\n          cube mantle { origin = (-6u, 20.5u, -9.5u); size = (12u, 3u, 8u); pivot = (0u, 21.5u, -5.5u); rotation = (-12deg, 0deg, 0deg); surface = skin.mantle; }\n          bone neck {\n            cube neck_plume { origin = (-4.5u, 19u, -11u); size = (9u, 4u, 7u); pivot = (0u, 21u, -7.5u); rotation = (-8deg, 0deg, 0deg); surface = skin.neck_plume; }\n            bone head {\n              cube skull { origin = (-4u, 22u, -13u); size = (8u, 8u, 8u); pivot = (0u, 25u, -9u); rotation = (4deg, 0deg, 0deg); surface = skin.skull; }\n              expression_slot face {\n                origin = (-4u, 24u, -12u);\n                size = (5u, 4u);\n                u_axis = (0u, 0u, 1u);\n                v_axis = (0u, 1u, 0u);\n                placement = lateral_pair;\n                neutral = skin.face_neutral;\n                blink = skin.face_blink;\n                screech = skin.face_screech;\n              }\n              cube beak { origin = (-3u, 22.5u, -19u); size = (6u, 4u, 6u); surface = skin.beak; }\n              cube beak_tip { origin = (-2u, 21.5u, -21u); size = (4u, 3u, 2u); pivot = (0u, 23u, -19.5u); rotation = (16deg, 0deg, 0deg); surface = skin.beak_tip; }\n              cube crest_l { origin = (-4u, 29u, -9u); size = (2u, 3u, 4u); pivot = (-3u, 29u, -7u); rotation = (-16deg, 0deg, -14deg); mirror_x = crest_r; surface = skin.crest; }\n              plane crest_plume_l { origin = (-3.5u, 28u, -7u); size = (4u, 4u); u_axis = (0u, 0u, 1u); v_axis = (0u, 1u, 0u); rotation = (-12deg, 0deg, -14deg); mirror_x = crest_plume_r; surface = skin.crest_plume; }\n            }\n          }\n          bone wing_l {\n            cube shoulder_l { origin = (-13u, 19u, -5u); size = (7u, 5u, 7u); pivot = (-5u, 20u, -2u); rotation = (-20deg, 0deg, -30deg); surface = skin.shoulder; }\n            cube feather_l0 { origin = (-13u, 20u, 3u); size = (4u, 2u, 13u); pivot = (-5u, 20u, -2u); rotation = (-20deg, 0deg, -30deg); surface = skin.feather; }\n            cube tip_l0 { origin = (-13u, 20u, 16u); size = (4u, 2u, 4u); pivot = (-5u, 20u, -2u); rotation = (-20deg, 0deg, -30deg); surface = skin.feather_tip; }\n            bone wing_tip_l {\n              cube wing_arm_l { origin = (-23u, 19u, -3u); size = (10u, 4u, 6u); pivot = (-5u, 20u, -2u); rotation = (-20deg, 0deg, -30deg); surface = skin.wing_arm; }\n              cube feather_l1 { origin = (-17u, 20u, 3u); size = (4u, 2u, 13u); pivot = (-5u, 20u, -2u); rotation = (-20deg, 0deg, -30deg); surface = skin.feather; }\n              cube tip_l1 { origin = (-17u, 20u, 16u); size = (4u, 2u, 4u); pivot = (-5u, 20u, -2u); rotation = (-20deg, 0deg, -30deg); surface = skin.feather_tip; }\n              cube feather_l2 { origin = (-21u, 20u, 2u); size = (4u, 2u, 13u); pivot = (-5u, 20u, -2u); rotation = (-20deg, 0deg, -30deg); surface = skin.feather; }\n              cube tip_l2 { origin = (-21u, 20u, 15u); size = (4u, 2u, 4u); pivot = (-5u, 20u, -2u); rotation = (-20deg, 0deg, -30deg); surface = skin.feather_tip; }\n              cube feather_l3 { origin = (-25u, 20u, 1u); size = (4u, 2u, 13u); pivot = (-5u, 20u, -2u); rotation = (-20deg, 0deg, -30deg); surface = skin.feather; }\n              cube tip_l3 { origin = (-25u, 20u, 14u); size = (4u, 2u, 4u); pivot = (-5u, 20u, -2u); rotation = (-20deg, 0deg, -30deg); surface = skin.feather_tip; }\n            }\n          }\n          bone wing_r {\n            cube shoulder_r { origin = (6u, 19u, -5u); size = (7u, 5u, 7u); pivot = (5u, 20u, -2u); rotation = (-20deg, 0deg, 30deg); surface = skin.shoulder; }\n            cube feather_r0 { origin = (9u, 20u, 3u); size = (4u, 2u, 13u); pivot = (5u, 20u, -2u); rotation = (-20deg, 0deg, 30deg); surface = skin.feather; }\n            cube tip_r0 { origin = (9u, 20u, 16u); size = (4u, 2u, 4u); pivot = (5u, 20u, -2u); rotation = (-20deg, 0deg, 30deg); surface = skin.feather_tip; }\n            bone wing_tip_r {\n              cube wing_arm_r { origin = (13u, 19u, -3u); size = (10u, 4u, 6u); pivot = (5u, 20u, -2u); rotation = (-20deg, 0deg, 30deg); surface = skin.wing_arm; }\n              cube feather_r1 { origin = (13u, 20u, 3u); size = (4u, 2u, 13u); pivot = (5u, 20u, -2u); rotation = (-20deg, 0deg, 30deg); surface = skin.feather; }\n              cube tip_r1 { origin = (13u, 20u, 16u); size = (4u, 2u, 4u); pivot = (5u, 20u, -2u); rotation = (-20deg, 0deg, 30deg); surface = skin.feather_tip; }\n              cube feather_r2 { origin = (17u, 20u, 2u); size = (4u, 2u, 13u); pivot = (5u, 20u, -2u); rotation = (-20deg, 0deg, 30deg); surface = skin.feather; }\n              cube tip_r2 { origin = (17u, 20u, 15u); size = (4u, 2u, 4u); pivot = (5u, 20u, -2u); rotation = (-20deg, 0deg, 30deg); surface = skin.feather_tip; }\n              cube feather_r3 { origin = (21u, 20u, 1u); size = (4u, 2u, 13u); pivot = (5u, 20u, -2u); rotation = (-20deg, 0deg, 30deg); surface = skin.feather; }\n              cube tip_r3 { origin = (21u, 20u, 14u); size = (4u, 2u, 4u); pivot = (5u, 20u, -2u); rotation = (-20deg, 0deg, 30deg); surface = skin.feather_tip; }\n            }\n          }\n          bone foreleg_l {\n            cube foreleg_l { origin = (-5u, 3u, -9u); size = (3u, 8u, 3u); pivot = (-3.5u, 10u, -7.5u); rotation = (-5deg, 0deg, 0deg); surface = skin.foreleg; }\n            cube forefoot_l { origin = (-6u, 1u, -12u); size = (5u, 2u, 5u); surface = skin.forefoot; }\n            cube talon_l0 { origin = (-6u, 0u, -16u); size = (2u, 2u, 4u); surface = skin.talon; }\n            cube talon_l1 { origin = (-3u, 0u, -16u); size = (2u, 2u, 4u); surface = skin.talon; }\n          }\n          bone foreleg_r {\n            cube foreleg_r { origin = (2u, 3u, -9u); size = (3u, 8u, 3u); pivot = (3.5u, 10u, -7.5u); rotation = (-5deg, 0deg, 0deg); surface = skin.foreleg; }\n            cube forefoot_r { origin = (1u, 1u, -12u); size = (5u, 2u, 5u); surface = skin.forefoot; }\n            cube talon_r0 { origin = (1u, 0u, -16u); size = (2u, 2u, 4u); surface = skin.talon; }\n            cube talon_r1 { origin = (4u, 0u, -16u); size = (2u, 2u, 4u); surface = skin.talon; }\n          }\n          bone hindleg_l {\n            cube hind_thigh_l { origin = (-6.5u, 6u, 7u); size = (4u, 7u, 6u); pivot = (-4.5u, 12u, 10u); rotation = (-10deg, 0deg, 0deg); surface = skin.hind_thigh; }\n            cube hind_shin_l { origin = (-6.5u, 2u, 9u); size = (3u, 4u, 3u); surface = skin.hind_shin; }\n            cube hind_paw_l { origin = (-7u, 0u, 6u); size = (5u, 2u, 6u); surface = skin.hind_paw; }\n            cube hind_claw_l0 { origin = (-7u, 0u, 2u); size = (2u, 2u, 4u); surface = skin.talon; }\n            cube hind_claw_l1 { origin = (-4u, 0u, 2u); size = (2u, 2u, 4u); surface = skin.talon; }\n          }\n          bone hindleg_r {\n            cube hind_thigh_r { origin = (2.5u, 6u, 7u); size = (4u, 7u, 6u); pivot = (4.5u, 12u, 10u); rotation = (-10deg, 0deg, 0deg); surface = skin.hind_thigh; }\n            cube hind_shin_r { origin = (3.5u, 2u, 9u); size = (3u, 4u, 3u); surface = skin.hind_shin; }\n            cube hind_paw_r { origin = (2u, 0u, 6u); size = (5u, 2u, 6u); surface = skin.hind_paw; }\n            cube hind_claw_r0 { origin = (2u, 0u, 2u); size = (2u, 2u, 4u); surface = skin.talon; }\n            cube hind_claw_r1 { origin = (5u, 0u, 2u); size = (2u, 2u, 4u); surface = skin.talon; }\n          }\n          bone tail {\n            cube tail_base { origin = (-1.5u, 12u, 13u); size = (3u, 3u, 9u); pivot = (0u, 13.5u, 13u); rotation = (-10deg, 0deg, 0deg); surface = skin.tail_base; }\n            bone tail_tip {\n              cube tail_rise { origin = (-1u, 12u, 21u); size = (2u, 5u, 2u); pivot = (0u, 14u, 22u); rotation = (18deg, 0deg, 0deg); surface = skin.tail_rise; }\n              cube tail_tuft { origin = (-2u, 17u, 21u); size = (4u, 5u, 4u); surface = skin.tail_tuft; }\n            }\n          }\n        }\n      }\n    }\n  }\n\n  motion idle for wq.WingedQuadrupedRig {\n    duration = 3s; fps = 14; loop = loop; rest_relative = true;\n    track torso.position { key 0s = (0u, 0u, 0u) smooth; key 1.3s = (0u, -0.45u, 0u) ease_in_out; key 3s = (0u, 0u, 0u) ease_out; }\n    track torso.rotation { key 0s = (0deg, 0deg, 0deg) smooth; key 1.4s = (3deg, 0deg, 0deg) ease_in_out; key 3s = (0deg, 0deg, 0deg) ease_out; }\n    track head.rotation { key 0s = (0deg, 0deg, 0deg) smooth; key 1.4s = (-3deg, 7deg, 0deg) ease_in_out; key 3s = (0deg, 0deg, 0deg) ease_out; }\n    track wing_l.rotation { key 0s = (0deg, 0deg, 0deg) smooth; key 1.4s = (0deg, 0deg, -6deg) ease_in_out; key 3s = (0deg, 0deg, 0deg) ease_out; }\n    track wing_r.rotation { key 0s = (0deg, 0deg, 0deg) smooth; key 1.4s = (0deg, 0deg, 6deg) ease_in_out; key 3s = (0deg, 0deg, 0deg) ease_out; }\n    track tail.rotation { key 0s = (0deg, 0deg, 0deg) smooth; key 1.4s = (2deg, 9deg, 0deg) ease_in_out; key 3s = (0deg, 0deg, 0deg) ease_out; }\n    expression face { at 0s = neutral; at 1.9s..2.05s = blink; }\n    wave torso.rotation.x = breath(3s, inhale = 0.42) * 2.5deg;\n    secondary chain tail_chain { stiffness = 14; damping = 0.34; gravity = 0.25; }\n  }\n\n  motion wing_display for wq.WingedQuadrupedRig {\n    duration = 2.4s; fps = 14; loop = loop; rest_relative = true;\n    track torso.position { key 0s = (0u, 0u, 0u) smooth; key 0.8s = (0u, 0.8u, -0.4u) ease_out; key 1.6s = (0u, 0.8u, -0.4u) smooth; key 2.4s = (0u, 0u, 0u) ease_in_out; }\n    track wing_l.rotation { key 0s = (0deg, 0deg, 0deg) smooth; key 0.8s = (0deg, 0deg, -28deg) anticipate(0.2); key 1.6s = (0deg, 0deg, -28deg) smooth; key 2.4s = (0deg, 0deg, 0deg) ease_out; }\n    track wing_r.rotation { key 0s = (0deg, 0deg, 0deg) smooth; key 0.8s = (0deg, 0deg, 28deg) anticipate(0.2); key 1.6s = (0deg, 0deg, 28deg) smooth; key 2.4s = (0deg, 0deg, 0deg) ease_out; }\n    track head.rotation { key 0s = (0deg, 0deg, 0deg) smooth; key 0.8s = (-10deg, 0deg, 0deg) ease_out; key 1.6s = (-10deg, 0deg, 0deg) smooth; key 2.4s = (0deg, 0deg, 0deg) ease_out; }\n    expression face { at 0s = neutral; at 0.7s..1.7s = screech; }\n    secondary chain tail_chain { stiffness = 14; damping = 0.34; gravity = 0.2; }\n    cue 0.8s sound \"griffin_call\" at beak;\n  }\n\n  motion wing_flap for wq.WingedQuadrupedRig {\n    duration = 0.8s; fps = 15; loop = loop; rest_relative = true;\n    wave wing_l.rotation.z = flap(0.8s, down_ratio = 0.38, com_lift = 1.4u) * -24deg;\n    wave wing_r.rotation.z = flap(0.8s, down_ratio = 0.38) * 24deg;\n    wave head.rotation.x = breath(0.8s, inhale = 0.38) * -4deg;\n    secondary chain tail_chain { stiffness = 16; damping = 0.32; gravity = 0.22; }\n  }\n\n  settings { density = 16; forward = north; profile = creature; }\n  skeleton = wq.WingedQuadrupedSkeleton;\n  motions = [idle, wing_display, wing_flap];\n  use GriffinBody as griffin { skeleton = wq.WingedQuadrupedRig; skin = plumage.boss_plumage; }\n\n  anchor boss_spawn : world_hook.SpawnPoint { bone = root; kind = creature; radius = 6.0; tag = \"griffin_boss\"; }\n  cue wing_gust : combat_hook.HitboxArc { clip = wing_display; at = 0.8s..1.4s; arc_deg = 160deg; reach = 28u; damage = 28; damage_type = blunt; }\n  meta boss_ai : combat_hook.CombatStateMeta { aggro_range = 28.0; leash_range = 64.0; attack_cooldown = 2.0s; }\n}\n"},{"path":"assets/models/red_fox.ashfox","source":"ashfox 1\nmodel red_fox {\n  import \"std/model/rig/quadruped\" as quad;\n  import \"std/model/motion/idle\" as idle_kit;\n  import \"std/model/motion/locomotion\" as loco;\n  import \"std/core/hook/world\" as world_hook;\n  import \"fox_fur/fur\" as fur;\n\n  component FoxBody {\n    requires rig skeleton: quad.QuadrupedRig;\n    requires surface skin: fur.FoxFur;\n    bind bone root to skeleton.root;\n    bind bone body to skeleton.body;\n    bind bone neck to skeleton.neck;\n    bind bone head to skeleton.head;\n    bind bone tail to skeleton.tail;\n    bind bone tail_tip to skeleton.tail_tip;\n    bind bone front_left_leg to skeleton.front_left_leg;\n    bind bone front_right_leg to skeleton.front_right_leg;\n    bind bone back_left_leg to skeleton.back_left_leg;\n    bind bone back_right_leg to skeleton.back_right_leg;\n    geometry {\n      bone root {\n        bone body {\n          cube pelvis { origin = (-3u, 8u, 3.6u); size = (6u, 5u, 4u); pivot = (0u, 10.5u, 5.6u); rotation = (-4deg, 0deg, 0deg); surface = skin.pelvis; }\n          cube torso { origin = (-3.5u, 7.8u, -3u); size = (7u, 6u, 7u); surface = skin.torso; }\n          cube chest { origin = (-4u, 7.2u, -7.8u); size = (8u, 7u, 5u); pivot = (0u, 10.5u, -5.3u); rotation = (6deg, 0deg, 0deg); surface = skin.chest; }\n          bone neck {\n            cube ruff { origin = (-3.5u, 10.2u, -9.2u); size = (7u, 3u, 4u); pivot = (0u, 11.7u, -7.2u); rotation = (-10deg, 0deg, 0deg); surface = skin.ruff; }\n            bone head {\n              cube skull { origin = (-4u, 12.6u, -13u); size = (8u, 6u, 7u); pivot = (0u, 15.6u, -9.5u); rotation = (3deg, 0deg, 0deg); surface = skin.head; }\n              expression_slot face {\n                origin = (3.5u, 13.5u, -13.08u);\n                size = (7u, 4u);\n                u_axis = (-1u, 0u, 0u);\n                v_axis = (0u, 1u, 0u);\n                neutral = skin.face_neutral;\n                blink = skin.face_blink;\n                alert = skin.face_alert;\n              }\n              cube muzzle { origin = (-2u, 12.6u, -17u); size = (4u, 3u, 4u); surface = skin.muzzle; }\n              cube nose { origin = (-1u, 14.3u, -17.8u); size = (2u, 1u, 2u); surface = skin.nose; }\n              cube ear_base_l { origin = (-3.8u, 18.4u, -10u); size = (3u, 3u, 2u); pivot = (-2.3u, 18.4u, -9u); rotation = (-6deg, 0deg, -14deg); mirror_x = ear_base_r; surface = skin.ear_base; }\n              cube ear_tip_l { origin = (-3.3u, 21.3u, -9.8u); size = (2u, 2u, 1u); pivot = (-2.3u, 18.4u, -9u); rotation = (-6deg, 0deg, -14deg); mirror_x = ear_tip_r; surface = skin.ear_tip; }\n              cube ear_inner_l { origin = (-3.3u, 18.8u, -10.8u); size = (2u, 2u, 1u); pivot = (-2.3u, 18.4u, -9u); rotation = (-6deg, 0deg, -14deg); mirror_x = ear_inner_r; surface = skin.ear_inner; }\n              plane cheek_tuft_l { origin = (-4.05u, 12.4u, -12.4u); size = (3u, 3u); u_axis = (0u, 0u, 1u); v_axis = (0u, 1u, 0u); rotation = (0deg, -22deg, 0deg); mirror_x = cheek_tuft_r; surface = skin.cheek_tuft; }\n            }\n          }\n          bone tail {\n            cube tail_base { origin = (-1.5u, 9.6u, 7.6u); size = (3u, 3u, 6u); pivot = (0u, 11.1u, 7.6u); rotation = (-12deg, 0deg, 0deg); surface = skin.tail_base; }\n            bone tail_tip {\n              cube tail_mid { origin = (-2.5u, 9.4u, 12.6u); size = (5u, 5u, 7u); pivot = (0u, 11.9u, 13u); rotation = (12deg, 0deg, 0deg); surface = skin.tail_main; }\n              cube tail_end { origin = (-2u, 11.2u, 18.8u); size = (4u, 4u, 5u); pivot = (0u, 13.2u, 19u); rotation = (18deg, 0deg, 0deg); surface = skin.tail_tip; }\n              cube tail_end_tip { origin = (-1u, 13.4u, 22.8u); size = (2u, 2u, 3u); pivot = (0u, 14.4u, 23u); rotation = (22deg, 0deg, 0deg); surface = skin.tail_tip_fine; }\n              plane tail_plume_l { origin = (-2.55u, 10u, 13.5u); size = (4u, 3u); u_axis = (0u, 0u, 1u); v_axis = (0u, 1u, 0u); rotation = (0deg, -14deg, 0deg); mirror_x = tail_plume_r; surface = skin.tail_plume; }\n            }\n          }\n          bone front_left_leg {\n            cube shoulder_fl { origin = (-4.4u, 5.5u, -6u); size = (3u, 4u, 3u); pivot = (-2.9u, 9.5u, -4.5u); rotation = (5deg, 0deg, 0deg); surface = skin.front_shoulder; }\n            cube forearm_fl { origin = (-3.6u, 2u, -5.5u); size = (2u, 4u, 2u); pivot = (-2.6u, 6u, -4.5u); rotation = (-3deg, 0deg, 0deg); surface = skin.front_leg; }\n            cube paw_fl { origin = (-3.6u, 0u, -6.5u); size = (2u, 2u, 3u); surface = skin.front_paw; }\n          }\n          bone front_right_leg {\n            cube shoulder_fr { origin = (1.4u, 5.5u, -6u); size = (3u, 4u, 3u); pivot = (2.9u, 9.5u, -4.5u); rotation = (5deg, 0deg, 0deg); surface = skin.front_shoulder; }\n            cube forearm_fr { origin = (1.6u, 2u, -5.5u); size = (2u, 4u, 2u); pivot = (2.6u, 6u, -4.5u); rotation = (-3deg, 0deg, 0deg); surface = skin.front_leg; }\n            cube paw_fr { origin = (1.6u, 0u, -6.5u); size = (2u, 2u, 3u); surface = skin.front_paw; }\n          }\n          bone back_left_leg {\n            cube thigh_bl { origin = (-4.6u, 6.2u, 3.8u); size = (4u, 4u, 4u); pivot = (-2.6u, 9.8u, 5.8u); rotation = (8deg, 0deg, 0deg); surface = skin.back_leg; }\n            cube shin_bl { origin = (-4u, 4u, 5.3u); size = (3u, 3u, 3u); pivot = (-2.5u, 5.5u, 6.8u); rotation = (-16deg, 0deg, 0deg); surface = skin.back_shin; }\n            cube hock_bl { origin = (-3.5u, 1.8u, 4.4u); size = (2u, 3u, 2u); pivot = (-2.5u, 2u, 5.4u); rotation = (18deg, 0deg, 0deg); surface = skin.back_hock; }\n            cube paw_bl { origin = (-3.5u, 0u, 3u); size = (2u, 2u, 3u); surface = skin.back_paw; }\n          }\n          bone back_right_leg {\n            cube thigh_br { origin = (0.6u, 6.2u, 3.8u); size = (4u, 4u, 4u); pivot = (2.6u, 9.8u, 5.8u); rotation = (8deg, 0deg, 0deg); surface = skin.back_leg; }\n            cube shin_br { origin = (1u, 4u, 5.3u