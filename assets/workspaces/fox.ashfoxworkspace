{"files":[{"path":"assets/models/red_fox.ashfox","source":"ashfox 1\nmodel red_fox {\n  import \"std/model/rig/quadruped\" as quad;\n  import \"std/model/motion/idle\" as idle_kit;\n  import \"std/model/motion/locomotion\" as loco;\n  import \"std/core/hook/world\" as world_hook;\n  import \"fox_fur/fur\" as fur;\n\n  component FoxBody {\n    requires rig skeleton: quad.QuadrupedRig;\n    requires surface skin: fur.FoxFur;\n    bind bone root to skeleton.root;\n    bind bone body to skeleton.body;\n    bind bone neck to skeleton.neck;\n    bind bone head to skeleton.head;\n    bind bone tail to skeleton.tail;\n    bind bone front_left_leg to skeleton.front_left_leg;\n    bind bone front_right_leg to skeleton.front_right_leg;\n    bind bone back_left_leg to skeleton.back_left_leg;\n    bind bone back_right_leg to skeleton.back_right_leg;\n    geometry {\n      bone root {\n        bone body {\n          cube pelvis { origin = (-3u, 8u, 2.5u); size = (6u, 5u, 6u); surface = skin.pelvis; }\n          cube torso { origin = (-3.5u, 7.8u, -4u); size = (7u, 6u, 7u); surface = skin.body; }\n          cube chest { origin = (-4u, 7.2u, -7.5u); size = (8u, 7u, 4u); pivot = (0u, 10.5u, -5.5u); rotation = (5deg, 0deg, 0deg); surface = skin.chest; }\n          bone neck {\n            wedge ruff { origin = (-3.5u, 10.5u, -9.2u); size = (7u, 4u, 4u); slope = north; surface = skin.ruff; }\n            bone head {\n              cube skull { origin = (-4u, 12.6u, -13u); size = (8u, 6u, 7u); surface = skin.head; }\n              expression_slot face {\n                origin = (3.5u, 14.8u, -13.08u);\n                size = (7u, 4u);\n                u_axis = (-1u, 0u, 0u);\n                v_axis = (0u, 1u, 0u);\n                neutral = skin.face_neutral;\n                blink = skin.face_blink;\n                alert = skin.face_alert;\n              }\n              wedge muzzle { origin = (-2u, 12.6u, -16.8u); size = (4u, 3u, 4u); slope = north; surface = skin.muzzle; }\n              cube nose { origin = (-1u, 13.8u, -17.4u); size = (2u, 1u, 2u); surface = skin.nose; }\n              cube ear_base_l { origin = (-3.8u, 18.4u, -10u); size = (3u, 3u, 2u); pivot = (-2.3u, 18.4u, -9u); rotation = (-6deg, 0deg, -12deg); mirror_x = ear_base_r; surface = skin.ear_base; }\n              taper ear_tip_l { origin = (-3.3u, 20.9u, -9.8u); size = (2u, 2u, 2u); top_scale = (0.3, 0.4); axis = y; pivot = (-2.3u, 18.4u, -9u); rotation = (-6deg, 0deg, -12deg); mirror_x = ear_tip_r; surface = skin.ear_tip; }\n            }\n          }\n          bone tail {\n            cube tail_base { origin = (-1.5u, 9.6u, 7u); size = (3u, 3u, 6u); pivot = (0u, 11.1u, 7u); rotation = (-10deg, 0deg, 0deg); surface = skin.tail_base; }\n            cylinder tail_mid { origin = (0u, 11.5u, 12u); radius = 2.4u; radius_top = 2.2u; height = 6.5u; sides = 8; axis = z; surface = skin.tail_main; }\n            taper tail_end { origin = (-2u, 10u, 18.5u); size = (4u, 4u, 5u); top_scale = (0.28, 0.28); axis = z; surface = skin.tail_tip; }\n          }\n          bone front_left_leg {\n            cube shoulder_fl { origin = (-4.2u, 5u, -6.2u); size = (3u, 4u, 3u); surface = skin.shoulder; }\n            cube leg_fl { origin = (-3.8u, 2u, -5.8u); size = (2u, 4u, 2u); surface = skin.leg; }\n            cube paw_fl { origin = (-3.8u, 0u, -6.8u); size = (2u, 2u, 3u); surface = skin.paw; }\n          }\n          bone front_right_leg {\n            cube shoulder_fr { origin = (1.6u, 5u, -6.2u); size = (3u, 4u, 3u); surface = skin.shoulder; }\n            cube leg_fr { origin = (1.8u, 2u, -5.8u); size = (2u, 4u, 2u); surface = skin.leg; }\n            cube paw_fr { origin = (1.8u, 0u, -6.8u); size = (2u, 2u, 3u); surface = skin.paw; }\n          }\n          bone back_left_leg {\n            cube thigh_bl { origin = (-4.4u, 5u, 3.5u); size = (3u, 5u, 4u); surface = skin.thigh; }\n            cube leg_bl { origin = (-3.8u, 2u, 4.2u); size = (2u, 4u, 2u); surface = skin.leg; }\n            cube paw_bl { origin = (-3.8u, 0u, 3.2u); size = (2u, 2u, 3u); surface = skin.paw; }\n          }\n          bone back_right_leg {\n            cube thigh_br { origin = (1.2u, 5u, 3.5u); size = (3u, 5u, 4u); surface = skin.thigh; }\n            cube leg_br { origin = (1.8u, 2u, 4.2u); size = (2u, 4u, 2u); surface = skin.leg; }\n            cube paw_br { origin = (1.8u, 0u, 3.2u); size = (2u, 2u, 3u); surface = skin.paw; }\n          }\n        }\n      }\n    }\n  }\n\n  motion tail_wag for quad.QuadrupedRig {\n    duration = 2.4s; fps = 24; loop = loop; rest_relative = true;\n    track body.position { key 0s = (0u, 0u, 0u) smooth; key 0.6s = (0u, -0.4u, 0u) ease_in_out; key 1.2s = (0u, 0.2u, 0u) ease_out; key 1.8s = (0u, -0.4u, 0u) ease_in_out; key 2.4s = (0u, 0u, 0u) ease_out; }\n    track tail.rotation { key 0s = (0deg, 0deg, 0deg) smooth; key 0.4s = (3deg, 22deg, 0deg) ease_in_out; key 1.2s = (3deg, -22deg, 0deg) ease_in_out; key 2s = (3deg, 22deg, 0deg) ease_in_out; key 2.4s = (0deg, 0deg, 0deg) ease_out; }\n    expression face { at 0s = neutral; at 0.8s..1.4s = alert; at 1.9s..2.05s = blink; }\n  }\n\n  settings { density = 16; forward = north; profile = creature; }\n  skeleton = quad.QuadrupedSkeleton;\n  motions = [idle_kit.quad_idle, loco.quad_trot, tail_wag];\n  use FoxBody as fox { skeleton = quad.QuadrupedRig; skin = fur.fox_coat; }\n\n  anchor woodland_spawn : world_hook.SpawnPoint { bone = root; kind = creature; radius = 8.0; tag = \"red_fox\"; }\n}\n"},{"path":"assets/module/fox/fox_fur.ashfox","source":"ashfox 1\nmodule fox_fur {\n  import \"std/core/palette/nature\" as nat;\n\n  export surface contract FoxFur {\n    chart body box { coverage = opaque; }\n    chart pelvis box { coverage = opaque; }\n    chart chest box { coverage = opaque; }\n    chart ruff box { coverage = opaque; }\n    chart head box { coverage = opaque; }\n    chart muzzle box { coverage = opaque; }\n    chart nose box { coverage = opaque; }\n    chart ear_base box { coverage = opaque; }\n    chart ear_tip box { coverage = opaque; }\n    chart shoulder box { coverage = opaque; }\n    chart thigh box { coverage = opaque; }\n    chart leg box { coverage = opaque; }\n    chart paw box { coverage = opaque; }\n    chart tail_base box { coverage = opaque; }\n    chart tail_main box { coverage = opaque; }\n    chart tail_tip box { coverage = opaque; }\n    chart face_neutral flat { coverage = opaque; }\n    chart face_blink flat { coverage = opaque; }\n    chart face_alert flat { coverage = opaque; }\n    material = cutout;\n  }\n\n  export surface fox_coat: FoxFur {\n    material = cutout;\n    texture atlas {\n      density = 2;\n      background = void; background_alpha = 0;\n      palette {\n        void = #000000;\n        coat = (#9b3b1e, #d9642c, #f49b56);\n        coat_deep = (#6d2718, #a94322, #d46b37);\n        cream = (#b68d65, #e6c69c, #fff1d4);\n        sock = (nat.TerrainSoil.loam_shadow, nat.TerrainSoil.loam_base, nat.TerrainSoil.loam_light);\n        paw = (#2e1c1a, #492d28, #6b453e);\n        nose_tone = (#261918, #3d2725, #5e3e3a);\n        eye_dark = #211514;\n        eye_amber = #d47b2c;\n        eye_glint = #fff7e6;\n        brow_soft = #e8cfa6;\n      }\n      stamp chest_heart { pixels = \"..cccc../.cccccc./..cccc../...cc...\"; c = cream; }\n      stamp fox_eyes_n { pixels = \".bb......bb./.kw......wk./.ka......ak.\"; b = brow_soft; k = eye_dark; w = eye_glint; a = eye_amber; }\n      stamp fox_eyes_b { pixels = \"............/.bb......bb./.cc......cc.\"; b = brow_soft; c = coat_deep; }\n      stamp fox_eyes_a { pixels = \".bb......bb./.ww......ww./.aa......aa.\"; b = brow_soft; w = eye_glint; a = eye_amber; }\n\n      chart body box { fill = coat; roughness = 0.84; grain = soft; pattern gradient { to = coat_deep; axis = y; space = local; soft = 0.25; } pattern ao { strength = 0.45; radius = 0.9u; } }\n      chart pelvis box { fill = coat; roughness = 0.84; grain = soft; pattern gradient { to = coat_deep; axis = y; space = local; soft = 0.25; } }\n      chart chest box { fill = coat; roughness = 0.84; grain = soft; face north { stamp chest_heart { at = (4px, 4px); protect = true; } } }\n      chart ruff box { fill = cream; roughness = 0.86; grain = soft; }\n      chart head box { fill = coat; roughness = 0.82; grain = soft; pattern gradient { to = coat_deep; axis = y; space = local; soft = 0.2; } pattern ao { strength = 0.4; radius = 0.8u; } }\n      chart muzzle box { fill = cream; roughness = 0.84; grain = soft; }\n      chart nose box { fill = nose_tone; roughness = 0.22; metallic = 0.05; grain = none; }\n      chart ear_base box { fill = coat; roughness = 0.82; grain = soft; }\n      chart ear_tip box { fill = sock; roughness = 0.84; grain = none; }\n      chart shoulder box { fill = coat; roughness = 0.84; grain = soft; }\n      chart thigh box { fill = coat; roughness = 0.84; grain = soft; }\n      chart leg box { fill = sock; roughness = 0.84; grain = soft; pattern gradient { to = paw; axis = y; space = local; soft = 0.2; } }\n      chart paw box { fill = paw; roughness = 0.86; grain = none; pattern border { paint = sock; width = 1px; edges = top; } }\n      chart tail_base box { fill = coat; roughness = 0.84; grain = soft; }\n      chart tail_main box { fill = coat; roughness = 0.84; grain = soft; pattern gradient { to = cream; axis = z; space = local; soft = 0.2; } }\n      chart tail_tip box { fill = cream; roughness = 0.86; grain = soft; }\n      chart face_neutral flat { fill = coat; stamp fox_eyes_n { at = (1px, 2px); protect = true; } }\n      chart face_blink flat { fill = coat; stamp fox_eyes_b { at = (1px, 2px); protect = true; } }\n      chart face_alert flat { fill = coat; stamp fox_eyes_a { at = (1px, 2px); protect = true; } }\n      grain soft { seed = 2101; }\n      tone painterly;\n    }\n  }\n}\n"},{"path":"library/std/core/hook/combat.ashfox","source":"ashfox 1\nmodule combat {\n  export schema HitboxArc : cue {\n    field arc_deg : deg(10..360) = 110deg;\n    field reach : unit = 16u;\n    field damage : float(0..1000) = 12;\n    field knockback : float(0..10) = 0.45;\n    field damage_type : enum(slash, pierce, blunt, fire, shock, arcane) = slash;\n    field trigger_time : second = 0.15s;\n  }\n\n  export schema HurtboxZone : volume {\n    field armor_scale : float(0..5) = 1.0;\n    field weakpoint : bool = false;\n    field element_resist : enum(none, fire, frost, shock, arcane) = none;\n  }\n\n  export schema ProjectileMuzzle : anchor {\n    field projectile_id : string;\n    field speed : float(0..120) = 24.0;\n    field spread_deg : deg(0..45) = 2deg;\n    field gravity : float(0..30) = 9.8;\n    field sfx : string = \"\";\n  }\n\n  export schema CombatStateMeta : meta {\n    field aggro_range : float(1..128) = 18.0;\n    field leash_range : float(2..256) = 40.0;\n    field attack_cooldown : second = 1.2s;\n  }\n}\n"},{"path":"library/std/core/hook/loot.ashfox","source":"ashfox 1\nmodule loot {\n  export schema LootChest : anchor {\n    field table : string;\n    field tier : enum(common, uncommon, rare, epic, mythic) = common;\n    field min_rolls : int(1..16) = 1;\n    field max_rolls : int(1..32) = 3;\n    field facing : enum(north, south, east, west) = south;\n    field locked : bool = false;\n    mc_block = \"minecraft:chest[facing=${facing}]\";\n  }\n\n  export schema ItemDrop : anchor {\n    field item_id : string;\n    field chance : float(0..1) = 0.5;\n    field count : int(1..64) = 1;\n    field offset : vec3 = (0, 0.25, 0);\n  }\n\n  export schema HarvestingNode : anchor {\n    field resource : enum(ore, herb, timber, crystal, relic) = ore;\n    field tool_tier : int(0..5) = 1;\n    field respawn : second = 180s;\n    field prefab_id : string = \"\";\n  }\n\n  export schema DropTableMeta : meta {\n    field table_id : string;\n    field luck_bonus : float(0..5) = 0.2;\n    field unique_once : bool = false;\n  }\n}\n"},{"path":"library/std/core/hook/world.ashfox","source":"ashfox 1\nmodule world {\n  export schema SpawnPoint : anchor {\n    field kind : enum(player, npc, creature, patrol) = creature;\n    field radius : float(0..64) = 4.0;\n    field weight : float(0..100) = 1.0;\n    field respawn_delay : second = 60s;\n    field tag : string = \"\";\n  }\n\n  export schema PortalGate : anchor {\n    field target_world : string;\n    field destination : string;\n    field facing : enum(north, south, east, west) = north;\n    field locked : bool = false;\n    mc_block = \"minecraft:stone_brick_stairs[facing=${facing}]\";\n  }\n\n  export schema SafeZone : volume {\n    field pvp_disabled : bool = true;\n    field regen_rate : float(0..10) = 0.5;\n    field label : string = \"\";\n  }\n\n  export schema AmbientZone : volume {\n    field cue_id : string;\n    field reverb : enum(none, hall, cavern, outdoor) = outdoor;\n    field blend_radius : float(0..32) = 6.0;\n  }\n\n  export schema PatrolRoute : meta {\n    field route_id : string;\n    field speed : float(0..12) = 1.8;\n    field pause : second = 2s;\n    field loop : bool = true;\n  }\n}\n"},{"path":"library/std/core/material/metal.ashfox","source":"ashfox 1\nmodule metal {\n  export design MetalParams {\n    iron_shadow: color = #3b424a;\n    iron_base: color = #727e8a;\n    iron_light: color = #b0bcc7;\n    gold_shadow: color = #75531d;\n    gold_base: color = #bd8b34;\n    gold_light: color = #ebbf63;\n    copper_shadow: color = #693724;\n    copper_base: color = #b05c3d;\n    copper_light: color = #de8864;\n    metallic: ratio = 0.88;\n    roughness: ratio = 0.34;\n  }\n\n  export surface contract MetalSurface {\n    chart plate box { coverage = opaque; }\n    chart rivet box { coverage = opaque; }\n    material = double;\n  }\n\n  export surface forged_iron: MetalSurface {\n    material = double;\n    texture atlas {\n      density = 2;\n      background = void; background_alpha = 255;\n      palette {\n        void = #2a3038;\n        iron = (#3b424a, #727e8a, #b0bcc7);\n        rivet = (#4d555e, #8a95a1, #c7d1db);\n      }\n      chart plate box {\n        fill = iron;\n        grain = brushed;\n        pattern gradient { to = rivet; axis = y; space = local; soft = 0.2; }\n        pattern ao { strength = 0.45; radius = 0.8u; }\n      }\n      chart rivet box {\n        fill = rivet;\n        pattern border { paint = iron; width = 1px; }\n      }\n    }\n  }\n}\n"},{"path":"library/std/core/material/stone.ashfox","source":"ashfox 1\nmodule stone {\n  export design StoneParams {\n    cobble_shadow: color = #3d4047;\n    cobble_base: color = #686d78;\n    cobble_light: color = #989ea8;\n    basalt_shadow: color = #262930;\n    basalt_base: color = #414652;\n    basalt_light: color = #636978;\n    sandstone_shadow: color = #7d6847;\n    sandstone_base: color = #b59a6e;\n    sandstone_light: color = #dec699;\n    roughness: ratio = 0.82;\n    wear: ratio = 0.25;\n  }\n\n  export surface contract StoneSurface {\n    chart block box { coverage = opaque; }\n    chart trim box { coverage = opaque; }\n    material = opaque;\n  }\n\n  export surface dressed_stone: StoneSurface {\n    material = opaque;\n    texture atlas {\n      density = 2;\n      background = void; background_alpha = 255;\n      palette {\n        void = #282b30;\n        stone = (#3d4047, #686d78, #989ea8);\n        trim = (#4c5059, #7d838f, #adb3bf);\n      }\n      chart block box {\n        fill = stone;\n        grain = clustered;\n        pattern blotch { paint = trim; scale = (2px, 2px, 2px); density = 0.3; phase = 0; }\n        pattern ao { strength = 0.48; radius = 0.8u; }\n      }\n      chart trim box {\n        fill = trim;\n        pattern border { paint = stone; width = 1px; }\n      }\n    }\n  }\n}\n"},{"path":"library/std/core/material/wood.ashfox","source":"ashfox 1\nmodule wood {\n  export design WoodParams {\n    oak_shadow: color = #4a3121;\n    oak_base: color = #7d5538;\n    oak_light: color = #ad7c55;\n    spruce_shadow: color = #332219;\n    spruce_base: color = #593b2b;\n    spruce_light: color = #825a43;\n    birch_shadow: color = #8c7a5b;\n    birch_base: color = #bfaa82;\n    birch_light: color = #e3d2ae;\n    roughness: ratio = 0.68;\n    grain_depth: ratio = 0.32;\n  }\n\n  export surface contract WoodSurface {\n    chart plank box { coverage = opaque; }\n    chart bark box { coverage = opaque; }\n    material = opaque;\n  }\n\n  export surface oak_timber: WoodSurface {\n    material = opaque;\n    texture atlas {\n      density = 2;\n      background = void; background_alpha = 255;\n      palette {\n        void = #332219;\n        oak = (#4a3121, #7d5538, #ad7c55);\n        bark = (#2e2119, #4d382a, #70533f);\n      }\n      chart plank box {\n        fill = oak;\n        grain = wood;\n        pattern stripe { paint = bark; axis = x; period = 4px; width = 1px; }\n        pattern ao { strength = 0.4; radius = 0.7u; }\n      }\n      chart bark box {\n        fill = bark;\n        grain = wood;\n        pattern blotch { paint = oak; scale = (2px, 2px, 2px); density = 0.35; phase = 0; }\n      }\n    }\n  }\n}\n"},{"path":"library/std/core/palette/element.ashfox","source":"ashfox 1\nmodule element {\n  export design FlamePalette {\n    ember_core: color = #fff1b8;\n    flame_mid: color = #eb7a28;\n    flame_edge: color = #9e2d1b;\n    char_smoke: color = #3a2b29;\n  }\n\n  export design FrostPalette {\n    ice_core: color = #dcf7fc;\n    frost_mid: color = #6bc8e3;\n    glacier_edge: color = #3469a6;\n    mist_shadow: color = #273854;\n  }\n\n  export design StormPalette {\n    arc_core: color = #f2f8ff;\n    bolt_mid: color = #7eb5ff;\n    thunder_edge: color = #4155a8;\n    cloud_shadow: color = #2b2f45;\n  }\n\n  export design ArcanePalette {\n    glyph_core: color = #f7dcff;\n    ether_mid: color = #c068f0;\n    void_edge: color = #632ea1;\n    astral_shadow: color = #2d1f47;\n  }\n}\n"},{"path":"library/std/core/palette/medieval.ashfox","source":"ashfox 1\nmodule medieval {\n  export design CastleStone {\n    limestone_shadow: color = #484c54;\n    limestone_base: color = #7c828c;\n    limestone_light: color = #adb3bd;\n    slate_shadow: color = #2d323b;\n    slate_base: color = #4d5563;\n    slate_light: color = #757f91;\n    mortar_base: color = #9da097;\n    moss_accent: color = #4f7343;\n  }\n\n  export design GuildTimber {\n    oak_shadow: color = #4a3222;\n    oak_base: color = #7a5438;\n    oak_light: color = #a67853;\n    walnut_shadow: color = #33231c;\n    walnut_base: color = #573d31;\n    walnut_light: color = #7d5b49;\n    parchment_base: color = #d9c8a9;\n    wax_seal: color = #9e312b;\n  }\n\n  export design HeraldryBanner {\n    crimson_shadow: color = #5c1f24;\n    crimson_base: color = #99323a;\n    crimson_light: color = #cc525a;\n    cobalt_shadow: color = #213254;\n    cobalt_base: color = #36528a;\n    cobalt_light: color = #5778b8;\n    gold_trim: color = #cfa042;\n    ivory_crest: color = #e3dac8;\n  }\n}\n"},{"path":"library/std/core/palette/nature.ashfox","source":"ashfox 1\nmodule nature {\n  export design WoodlandFoliage {\n    canopy_shadow: color = #2b4d27;\n    canopy_base: color = #4b823c;\n    canopy_light: color = #76b359;\n    fern_shadow: color = #34542f;\n    fern_base: color = #5a8c4a;\n    fern_light: color = #87ba6e;\n    blossom_accent: color = #d97a96;\n    nectar_gold: color = #e3b84f;\n  }\n\n  export design TerrainSoil {\n    loam_shadow: color = #3b2b22;\n    loam_base: color = #614738;\n    loam_light: color = #876652;\n    sand_shadow: color = #8f7b58;\n    sand_base: color = #bfa77a;\n    sand_light: color = #dfd0a8;\n    bark_base: color = #523b2c;\n    clay_accent: color = #a65c42;\n  }\n\n  export design MeadowWater {\n    deep_shadow: color = #23475c;\n    stream_base: color = #3a758f;\n    ripple_light: color = #6cb0c7;\n    foam_crest: color = #d4eef5;\n    reed_green: color = #698548;\n  }\n}\n"},{"path":"library/std/model/motion/combat.ashfox","source":"ashfox 1\nmodule combat {\n  import \"std/model/rig/biped\" as biped;\n\n  export motion slash for biped.BipedRig {\n    duration = 0.7s; fps = 30; loop = once;\n    track torso.rotation {\n      key 0s = (0deg, 0deg, 0deg) catmullrom;\n      key 0.2s = (-6deg, -22deg, 0deg) catmullrom;\n      key 0.45s = (10deg, 28deg, 0deg) catmullrom;\n      key 0.7s = (0deg, 0deg, 0deg) catmullrom;\n    }\n    track right_arm.rotation {\n      key 0s = (0deg, 0deg, 0deg) catmullrom;\n      key 0.2s = (-85deg, -20deg, 25deg) catmullrom;\n      key 0.45s = (55deg, 28deg, -35deg) catmullrom;\n      key 0.7s = (0deg, 0deg, 0deg) catmullrom;\n    }\n    track weapon.rotation {\n      key 0s = (0deg, 0deg, 0deg) linear;\n      key 0.45s = (20deg, 0deg, 0deg) linear;\n      key 0.7s = (0deg, 0deg, 0deg) linear;\n    }\n  }\n\n  export motion thrust for biped.BipedRig {\n    duration = 0.6s; fps = 30; loop = once;\n    track torso.rotation {\n      key 0s = (0deg, 0deg, 0deg) catmullrom;\n      key 0.15s = (4deg, -18deg, 0deg) catmullrom;\n      key 0.35s = (8deg, 14deg, 0deg) catmullrom;\n      key 0.6s = (0deg, 0deg, 0deg) catmullrom;\n    }\n    track right_arm.rotation {\n      key 0s = (0deg, 0deg, 0deg) catmullrom;\n      key 0.15s = (28deg, 0deg, 0deg) catmullrom;\n      key 0.35s = (-82deg, 0deg, 0deg) catmullrom;\n      key 0.6s = (0deg, 0deg, 0deg) catmullrom;\n    }\n  }\n\n  export motion guard for biped.BipedRig {\n    duration = 1s; fps = 24; loop = loop;\n    track left_arm.rotation {\n      key 0s = (-48deg, 32deg, 0deg) linear;\n      key 0.5s = (-52deg, 34deg, 0deg) linear;\n      key 1s = (-48deg, 32deg, 0deg) linear;\n    }\n    track torso.rotation {\n      key 0s = (4deg, -16deg, 0deg) linear;\n      key 0.5s = (6deg, -16deg, 0deg) linear;\n      key 1s = (4deg, -16deg, 0deg) linear;\n    }\n  }\n}\n"},{"path":"library/std/model/motion/idle.ashfox","source":"ashfox 1\nmodule idle {\n  import \"std/model/rig/biped\" as biped;\n  import \"std/model/rig/quadruped\" as quad;\n\n  export motion biped_idle for biped.BipedRig {\n    duration = 2s; fps = 20; loop = loop;\n    track pelvis.rotation {\n      key 0s = (0deg, 0deg, 0deg) catmullrom;\n      key 1s = (1.5deg, 0deg, 0deg) catmullrom;\n      key 2s = (0deg, 0deg, 0deg) catmullrom;\n    }\n    track torso.rotation {\n      key 0s = (0deg, 0deg, 0deg) catmullrom;\n      key 1s = (2deg, -2deg, 0deg) catmullrom;\n      key 2s = (0deg, 0deg, 0deg) catmullrom;\n    }\n    track head.rotation {\n      key 0s = (0deg, 0deg, 0deg) catmullrom;\n      key 1s = (-2deg, 4deg, 0deg) catmullrom;\n      key 2s = (0deg, 0deg, 0deg) catmullrom;\n    }\n    track left_arm.rotation {\n      key 0s = (0deg, 0deg, 2deg) catmullrom;\n      key 1s = (3deg, 0deg, 4deg) catmullrom;\n      key 2s = (0deg, 0deg, 2deg) catmullrom;\n    }\n    track right_arm.rotation {\n      key 0s = (0deg, 0deg, -2deg) catmullrom;\n      key 1s = (-3deg, 0deg, -4deg) catmullrom;\n      key 2s = (0deg, 0deg, -2deg) catmullrom;\n    }\n  }\n\n  export motion quad_idle for quad.QuadrupedRig {\n    duration = 2.4s; fps = 20; loop = loop;\n    track body.rotation {\n      key 0s = (0deg, 0deg, 0deg) linear;\n      key 1.2s = (1.5deg, 0deg, 0deg) linear;\n      key 2.4s = (0deg, 0deg, 0deg) linear;\n    }\n    track head.rotation {\n      key 0s = (0deg, 0deg, 0deg) catmullrom;\n      key 1.2s = (-3deg, 6deg, 0deg) catmullrom;\n      key 2.4s = (0deg, 0deg, 0deg) catmullrom;\n    }\n    track tail.rotation {\n      key 0s = (0deg, -6deg, 0deg) catmullrom;\n      key 1.2s = (0deg, 6deg, 0deg) catmullrom;\n      key 2.4s = (0deg, -6deg, 0deg) catmullrom;\n    }\n  }\n}\n"},{"path":"library/std/model/motion/locomotion.ashfox","source":"ashfox 1\nmodule locomotion {\n  import \"std/model/rig/biped\" as biped;\n  import \"std/model/rig/quadruped\" as quad;\n  import \"std/model/rig/winged\" as winged;\n\n  export motion biped_walk for biped.BipedRig {\n    duration = 1.2s; fps = 24; loop = loop;\n    track pelvis.position {\n      key 0s = (0u, 0u, 0u) catmullrom;\n      key 0.3s = (0u, 0.8u, 0u) catmullrom;\n      key 0.6s = (0u, 0u, 0u) catmullrom;\n      key 0.9s = (0u, 0.8u, 0u) catmullrom;\n      key 1.2s = (0u, 0u, 0u) catmullrom;\n    }\n    track left_leg.rotation {\n      key 0s = (24deg, 0deg, 0deg) catmullrom;\n      key 0.6s = (-24deg, 0deg, 0deg) catmullrom;\n      key 1.2s = (24deg, 0deg, 0deg) catmullrom;\n    }\n    track right_leg.rotation {\n      key 0s = (-24deg, 0deg, 0deg) catmullrom;\n      key 0.6s = (24deg, 0deg, 0deg) catmullrom;\n      key 1.2s = (-24deg, 0deg, 0deg) catmullrom;\n    }\n    track left_arm.rotation {\n      key 0s = (-18deg, 0deg, 2deg) catmullrom;\n      key 0.6s = (18deg, 0deg, 2deg) catmullrom;\n      key 1.2s = (-18deg, 0deg, 2deg) catmullrom;\n    }\n    track right_arm.rotation {\n      key 0s = (18deg, 0deg, -2deg) catmullrom;\n      key 0.6s = (-18deg, 0deg, -2deg) catmullrom;\n      key 1.2s = (18deg, 0deg, -2deg) catmullrom;\n    }\n  }\n\n  export motion biped_run for biped.BipedRig {\n    duration = 0.8s; fps = 30; loop = loop;\n    track torso.rotation {\n      key 0s = (12deg, -4deg, 0deg) catmullrom;\n      key 0.4s = (12deg, 4deg, 0deg) catmullrom;\n      key 0.8s = (12deg, -4deg, 0deg) catmullrom;\n    }\n    track left_leg.rotation {\n      key 0s = (38deg, 0deg, 0deg) catmullrom;\n      key 0.4s = (-38deg, 0deg, 0deg) catmullrom;\n      key 0.8s = (38deg, 0deg, 0deg) catmullrom;\n    }\n    track right_leg.rotation {\n      key 0s = (-38deg, 0deg, 0deg) catmullrom;\n      key 0.4s = (38deg, 0deg, 0deg) catmullrom;\n      key 0.8s = (-38deg, 0deg, 0deg) catmullrom;\n    }\n  }\n\n  export motion quad_trot for quad.QuadrupedRig {\n    duration = 1s; fps = 24; loop = loop;\n    track front_left_leg.rotation {\n      key 0s = (22deg, 0deg, 0deg) catmullrom;\n      key 0.5s = (-22deg, 0deg, 0deg) catmullrom;\n      key 1s = (22deg, 0deg, 0deg) catmullrom;\n    }\n    track back_right_leg.rotation {\n      key 0s = (22deg, 0deg, 0deg) catmullrom;\n      key 0.5s = (-22deg, 0deg, 0deg) catmullrom;\n      key 1s = (22deg, 0deg, 0deg) catmullrom;\n    }\n    track front_right_leg.rotation {\n      key 0s = (-22deg, 0deg, 0deg) catmullrom;\n      key 0.5s = (22deg, 0deg, 0deg) catmullrom;\n      key 1s = (-22deg, 0deg, 0deg) catmullrom;\n    }\n    track back_left_leg.rotation {\n      key 0s = (-22deg, 0deg, 0deg) catmullrom;\n      key 0.5s = (22deg, 0deg, 0deg) catmullrom;\n      key 1s = (-22deg, 0deg, 0deg) catmullrom;\n    }\n  }\n\n  export motion wing_glide for winged.WingedRig {\n    duration = 2s; fps = 24; loop = loop;\n    track left_wing.rotation {\n      key 0s = (0deg, 0deg, -18deg) catmullrom;\n      key 1s = (0deg, 0deg, 24deg) catmullrom;\n      key 2s = (0deg, 0deg, -18deg) catmullrom;\n    }\n    track right_wing.rotation {\n      key 0s = (0deg, 0deg, 18deg) catmullrom;\n      key 1s = (0deg, 0deg, -24deg) catmullrom;\n      key 2s = (0deg, 0deg, 18deg) catmullrom;\n    }\n  }\n}\n"},{"path":"library/std/model/prop/container.ashfox","source":"ashfox 1\nmodule container {\n  export rig contract ChestRig {\n    joint root { parent = none; role = root; channels = rotation; }\n    joint lid { parent = root; role = prop; channels = rotation; }\n  }\n\n  export skeleton ChestSkeleton implements ChestRig {\n    bind root { parent_origin = (0u, 0u, 0u); }\n    bind lid { parent_origin = (0u, 7u, 4u); }\n  }\n\n  export surface contract ChestSurface {\n    chart base box { coverage = opaque; }\n    chart wall box { coverage = opaque; }\n    chart lid box { coverage = opaque; }\n    chart band box { coverage = opaque; }\n    chart latch box { coverage = opaque; }\n    material = opaque;\n  }\n\n  export motion lid_open for ChestRig {\n    duration = 1s; fps = 24; loop = once;\n    track lid.rotation {\n      key 0s = (0deg, 0deg, 0deg) catmullrom;\n      key 0.5s = (-72deg, 0deg, 0deg) catmullrom;\n      key 1s = (0deg, 0deg, 0deg) catmullrom;\n    }\n  }\n\n  export component StorageChest {\n    requires rig skeleton: ChestRig;\n    requires surface skin: ChestSurface;\n    bind bone root to skeleton.root;\n    bind bone lid to skeleton.lid;\n    geometry {\n      bone root {\n        cube plinth { origin = (-5u, 0u, -4u); size = (10u, 2u, 8u); surface = skin.base; }\n        cube hull { origin = (-4u, 2u, -3u); size = (8u, 5u, 6u); surface = skin.wall; }\n        cube band_l { origin = (-5u, 2u, -4u); size = (1u, 5u, 8u); mirror_x = band_r; surface = skin.band; }\n        bone lid {\n          cube lid_cap { origin = (-5u, 0u, -8u); size = (10u, 3u, 8u); surface = skin.lid; }\n          cube latch { origin = (-1u, -1u, -9u); size = (2u, 2u, 1u); surface = skin.latch; }\n        }\n      }\n    }\n  }\n}\n"},{"path":"library/std/model/prop/lighting.ashfox","source":"ashfox 1\nmodule lighting {\n  export rig contract LanternRig {\n    joint root { parent = none; role = root; channels = rotation; }\n    joint body { parent = root; role = prop; channels = rotation; }\n  }\n\n  export skeleton LanternSkeleton implements LanternRig {\n    bind root { parent_origin = (0u, 0u, 0u); }\n    bind body { parent_origin = (0u, 2u, 0u); }\n  }\n\n  export surface contract LanternSurface {\n    chart frame box { coverage = opaque; }\n    chart glass box { coverage = opaque; }\n    chart finial box { coverage = opaque; }\n    material = double;\n  }\n\n  export component IronLantern {\n    requires rig skeleton: LanternRig;\n    requires surface skin: LanternSurface;\n    bind bone root to skeleton.root;\n    bind bone body to skeleton.body;\n    geometry {\n      bone root {\n        cube base { origin = (-3u, 0u, -3u); size = (6u, 2u, 6u); surface = skin.frame; }\n        bone body {\n          cube core { origin = (-2u, 0u, -2u); size = (4u, 5u, 4u); surface = skin.glass; }\n          cube cap { origin = (-3u, 5u, -3u); size = (6u, 2u, 6u); surface = skin.frame; }\n          cube finial { origin = (-1u, 7u, -1u); size = (2u, 2u, 2u); surface = skin.finial; }\n        }\n      }\n    }\n  }\n}\n"},{"path":"library/std/model/rig/biped.ashfox","source":"ashfox 1\nmodule biped {\n  export socket contract HandGrip {\n  }\n\n  export rig contract BipedRig {\n    joint root { parent = none; role = root; channels = (rotation, scale); }\n    joint pelvis { parent = root; role = pelvis; channels = (position, rotation); }\n    joint torso { parent = pelvis; role = body; channels = rotation; }\n    joint head { parent = torso; role = head; channels = rotation; }\n    joint left_arm { parent = torso; role = arm; channels = rotation; }\n    joint right_arm { parent = torso; role = arm; channels = rotation; }\n    joint weapon { parent = right_arm; role = weapon; channels = rotation; }\n    joint left_leg { parent = pelvis; role = leg; channels = rotation; }\n    joint right_leg { parent = pelvis; role = leg; channels = rotation; }\n    socket main_hand: HandGrip { joint = right_arm; capacity = one; }\n    socket off_hand: HandGrip { joint = left_arm; capacity = one; }\n  }\n\n  export skeleton BipedSkeleton implements BipedRig {\n    bind root { parent_origin = (0u, 0u, 0u); }\n    bind pelvis { parent_origin = (0u, 12u, 0u); }\n    bind torso { parent_origin = (0u, 2u, 0u); }\n    bind head { parent_origin = (0u, 10u, 0u); }\n    bind left_arm { parent_origin = (-6u, 8u, 0u); }\n    bind right_arm { parent_origin = (6u, 8u, 0u); }\n    bind weapon { parent_origin = (0u, -9u, -1u); }\n    bind left_leg { parent_origin = (-2u, 0u, 0u); }\n    bind right_leg { parent_origin = (2u, 0u, 0u); }\n  }\n}\n"},{"path":"library/std/model/rig/quadruped.ashfox","source":"ashfox 1\nmodule quadruped {\n  export rig contract QuadrupedRig {\n    joint root { parent = none; role = root; channels = (rotation, scale); }\n    joint body { parent = root; role = body; channels = (position, rotation); }\n    joint neck { parent = body; role = neck; channels = rotation; }\n    joint head { parent = neck; role = head; channels = rotation; }\n    joint tail { parent = body; role = tail; channels = rotation; }\n    joint front_left_leg { parent = body; role = leg; channels = rotation; }\n    joint front_right_leg { parent = body; role = leg; channels = rotation; }\n    joint back_left_leg { parent = body; role = leg; channels = rotation; }\n    joint back_right_leg { parent = body; role = leg; channels = rotation; }\n  }\n\n  export skeleton QuadrupedSkeleton implements QuadrupedRig {\n    bind root { parent_origin = (0u, 0u, 0u); }\n    bind body { parent_origin = (0u, 10u, 0u); }\n    bind neck { parent_origin = (0u, 2u, -6u); }\n    bind head { parent_origin = (0u, 3u, -3u); }\n    bind tail { parent_origin = (0u, 1u, 7u); }\n    bind front_left_leg { parent_origin = (-3u, -2u, -5u); }\n    bind front_right_leg { parent_origin = (3u, -2u, -5u); }\n    bind back_left_leg { parent_origin = (-3u, -2u, 5u); }\n    bind back_right_leg { parent_origin = (3u, -2u, 5u); }\n  }\n}\n"},{"path":"library/std/model/rig/winged.ashfox","source":"ashfox 1\nmodule winged {\n  export rig contract WingedRig {\n    joint root { parent = none; role = root; channels = (rotation, scale); }\n    joint torso { parent = root; role = body; channels = (position, rotation); }\n    joint head { parent = torso; role = head; channels = rotation; }\n    joint left_wing { parent = torso; role = wing; channels = rotation; }\n    joint left_wing_tip { parent = left_wing; role = wing; channels = rotation; }\n    joint right_wing { parent = torso; role = wing; channels = rotation; }\n    joint right_wing_tip { parent = right_wing; role = wing; channels = rotation; }\n    joint tail { parent = torso; role = tail; channels = rotation; }\n    joint left_leg { parent = torso; role = leg; channels = rotation; }\n    joint right_leg { parent = torso; role = leg; channels = rotation; }\n  }\n\n  export skeleton WingedSkeleton implements WingedRig {\n    bind root { parent_origin = (0u, 0u, 0u); }\n    bind torso { parent_origin = (0u, 12u, 0u); }\n    bind head { parent_origin = (0u, 5u, -5u); }\n    bind left_wing { parent_origin = (-4u, 4u, -