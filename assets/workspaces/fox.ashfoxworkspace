{"files":[{"path":"creatures/body.ashfox","source":"ashfox-model 1\nmodule body {\n  import \"./rig.ashfox\" as rig;\n  import \"./surface.ashfox\" as surface;\n  export component FoxBody {\n    requires rig skeleton: rig.CreatureRig;\n    requires surface skin: surface.Fur;\n    bind bone body to skeleton.body;\n    bind bone head to skeleton.head;\n    bind bone tail to skeleton.tail;\n    bind bone tail_tip to skeleton.tail_tip;\n    bind bone front_left to skeleton.front_left;\n    bind bone front_right to skeleton.front_right;\n    bind bone back_left to skeleton.back_left;\n    bind bone back_right to skeleton.back_right;\n    geometry {\n      bone body {\n        cube torso { origin = (-4u, 7u, -3u); size = (8u, 6u, 11u); surface = skin.torso; }\n        cube chest { origin = (-3.5u, 6u, -7.5u); size = (7u, 7u, 5u); pivot = (0u, 9.5u, -5u); rotation = (10deg, 0deg, 0deg); surface = skin.chest; }\n        cube ruff { origin = (-4.5u, 10u, -6.5u); size = (9u, 4u, 4u); pivot = (0u, 12u, -4.5u); rotation = (-14deg, 0deg, 0deg); surface = skin.ruff; }\n        cube throat { origin = (-2u, 7u, -9.5u); size = (4u, 5u, 3u); surface = skin.throat; }\n        bone head {\n          cube skull { origin = (-4u, 11.5u, -12u); size = (8u, 7u, 7u); pivot = (0u, 15u, -8.5u); rotation = (4deg, 0deg, 0deg); surface = skin.head; }\n          cube muzzle { origin = (-2.5u, 11.5u, -16u); size = (5u, 3u, 5u); surface = skin.muzzle; }\n          cube nose { origin = (-1u, 13.5u, -16.8u); size = (2u, 1u, 1u); surface = skin.nose; }\n          cube brow_l { origin = (-3.5u, 16u, -12.6u); size = (2u, 1u, 1u); pivot = (-2.5u, 16.5u, -12u); rotation = (0deg, 0deg, -12deg); mirror-x = brow_r; surface = skin.brow; }\n          cube ear_base_l { origin = (-4u, 18u, -10u); size = (3u, 3u, 2u); pivot = (-2.5u, 18u, -9u); rotation = (-8deg, 0deg, -15deg); mirror-x = ear_base_r; surface = skin.ear_base; }\n          cube ear_tip_l { origin = (-3.5u, 20.5u, -9.5u); size = (2u, 2u, 2u); pivot = (-2.5u, 18u, -9u); rotation = (-8deg, 0deg, -15deg); mirror-x = ear_tip_r; surface = skin.ear_tip; }\n          cube ear_inner_l { origin = (-3.5u, 18.5u, -10.6u); size = (2u, 2u, 1u); pivot = (-2.5u, 18u, -9u); rotation = (-8deg, 0deg, -15deg); mirror-x = ear_inner_r; surface = skin.ear_inner; }\n          plane cheek_tuft_l { origin = (-4u, 11.5u, -11u); size = (3u, 3u); u-axis = (0u, 0u, 1u); v-axis = (0u, 1u, 0u); rotation = (0deg, -16deg, 0deg); mirror-x = cheek_tuft_r; surface = skin.cheek_tuft; }\n        }\n        bone tail {\n          cube tail_base { origin = (-2u, 8.5u, 7u); size = (4u, 4u, 7u); pivot = (0u, 10u, 7u); rotation = (-16deg, 0deg, 0deg); surface = skin.tail_base; }\n          bone tail_tip {\n            cube tail_mid { origin = (-2.5u, 10u, 12.5u); size = (5u, 5u, 7u); pivot = (0u, 12u, 13u); rotation = (14deg, 0deg, 0deg); surface = skin.tail_main; }\n            cube tail_end { origin = (-2u, 12u, 18.5u); size = (4u, 4u, 6u); pivot = (0u, 14u, 19u); rotation = (22deg, 0deg, 0deg); surface = skin.tail_tip; }\n            plane tail_plume_l { origin = (-2.5u, 10.5u, 14u); size = (4u, 3u); u-axis = (0u, 0u, 1u); v-axis = (0u, 1u, 0u); rotation = (0deg, -12deg, 0deg); mirror-x = tail_plume_r; surface = skin.tail_plume; }\n          }\n        }\n        bone front_left {\n          cube upper_fl { origin = (-3.5u, 2u, -6u); size = (3u, 6u, 3u); pivot = (-2u, 8u, -4.5u); rotation = (5deg, 0deg, 0deg); surface = skin.front_leg; }\n          cube paw_fl { origin = (-3.5u, 0u, -7u); size = (3u, 2u, 4u); surface = skin.front_paw; }\n        }\n        bone front_right {\n          cube upper_fr { origin = (0.5u, 2u, -6u); size = (3u, 6u, 3u); pivot = (2u, 8u, -4.5u); rotation = (5deg, 0deg, 0deg); surface = skin.front_leg; }\n          cube paw_fr { origin = (0.5u, 0u, -7u); size = (3u, 2u, 4u); surface = skin.front_paw; }\n        }\n        bone back_left {\n          cube thigh_bl { origin = (-4u, 3.5u, 4u); size = (4u, 5u, 4u); pivot = (-2u, 8u, 6u); rotation = (-10deg, 0deg, 0deg); surface = skin.back_leg; }\n          cube shin_bl { origin = (-3.5u, 2u, 5u); size = (3u, 3u, 3u); surface = skin.back_shin; }\n          cube paw_bl { origin = (-3.5u, 0u, 3.5u); size = (3u, 2u, 5u); surface = skin.back_paw; }\n        }\n        bone back_right {\n          cube thigh_br { origin = (0u, 3.5u, 4u); size = (4u, 5u, 4u); pivot = (2u, 8u, 6u); rotation = (-10deg, 0deg, 0deg); surface = skin.back_leg; }\n          cube shin_br { origin = (0.5u, 2u, 5u); size = (3u, 3u, 3u); surface = skin.back_shin; }\n          cube paw_br { origin = (0.5u, 0u, 3.5u); size = (3u, 2u, 5u); surface = skin.back_paw; }\n        }\n      }\n    }\n  }\n}\n"},{"path":"creatures/fox.ashfox","source":"ashfox-model 1\nasset fox {\n  import \"./rig.ashfox\" as rig;\n  import \"./surface.ashfox\" as surface;\n  import \"./body.ashfox\" as body;\n  export asset fox {\n    settings { density = 16; forward = north; profile = creature; }\n    skeleton = rig.CreatureSkeleton;\n    motion = rig.idle;\n    motion = rig.curious;\n    motion = rig.tail_wag;\n    use body.FoxBody as fox { bind skeleton = rig.CreatureRig; bind skin = surface.red_fox; };\n  }\n}\n"},{"path":"creatures/rig.ashfox","source":"ashfox-model 1\nmodule rig {\n  export rig contract CreatureRig {\n    handedness = right;\n    frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); }\n    joint root { parent = none; role = root; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = (rotation, scale); mirror = none; }\n    joint body { parent = root; role = body; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = rotation; mirror = none; }\n    joint head { parent = body; role = head; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = rotation; mirror = none; }\n    joint tail { parent = body; role = tail; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = rotation; mirror = none; }\n    joint tail_tip { parent = tail; role = tail; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = rotation; mirror = none; }\n    joint front_left { parent = body; role = leg; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = rotation; mirror = none; }\n    joint front_right { parent = body; role = leg; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = rotation; mirror = none; }\n    joint back_left { parent = body; role = leg; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = rotation; mirror = none; }\n    joint back_right { parent = body; role = leg; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = rotation; mirror = none; }\n  }\n\n  export skeleton CreatureSkeleton implements CreatureRig {\n    bind root { parent-origin = (0u, 0u, 0u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }\n    bind body { parent-origin = (0u, 10u, 0u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }\n    bind head { parent-origin = (0u, 3u, -6u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }\n    bind tail { parent-origin = (0u, 0u, 7u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }\n    bind tail_tip { parent-origin = (0u, 2u, 6u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }\n    bind front_left { parent-origin = (-2u, -2u, -4.5u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }\n    bind front_right { parent-origin = (2u, -2u, -4.5u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }\n    bind back_left { parent-origin = (-2u, -2u, 6u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }\n    bind back_right { parent-origin = (2u, -2u, 6u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }\n  }\n\n  export motion idle for CreatureRig {\n    duration = 2s; fps = 20; loop = loop; rest-relative = true;\n    track body.rotation {\n      key 0s = (0deg, 0deg, 0deg) catmullrom;\n      key 1s = (2deg, 0deg, 0deg) catmullrom;\n      key 2s = (0deg, 0deg, 0deg) catmullrom;\n    }\n    track head.rotation {\n      key 0s = (0deg, 0deg, 0deg) catmullrom;\n      key 1s = (-2deg, 5deg, 2deg) catmullrom;\n      key 2s = (0deg, 0deg, 0deg) catmullrom;\n    }\n    track tail.rotation {\n      key 0s = (0deg, 0deg, 0deg) catmullrom;\n      key 1s = (4deg, 8deg, 0deg) catmullrom;\n      key 2s = (0deg, 0deg, 0deg) catmullrom;\n    }\n    track tail_tip.rotation {\n      key 0s = (0deg, 0deg, 0deg) catmullrom;\n      key 1s = (6deg, 10deg, 0deg) catmullrom;\n      key 2s = (0deg, 0deg, 0deg) catmullrom;\n    }\n    track front_left.rotation {\n      key 0s = (0deg, 0deg, 0deg) catmullrom;\n      key 1s = (-3deg, 0deg, 0deg) catmullrom;\n      key 2s = (0deg, 0deg, 0deg) catmullrom;\n    }\n  }\n\n  export motion curious for CreatureRig {\n    duration = 4s; fps = 24; loop = loop; rest-relative = true;\n    track head.rotation {\n      key 0s = (0deg, 0deg, 0deg) catmullrom;\n      key 1s = (6deg, -18deg, -7deg) catmullrom;\n      key 2s = (6deg, -18deg, -7deg) catmullrom;\n      key 3s = (-3deg, 12deg, 5deg) catmullrom;\n      key 4s = (0deg, 0deg, 0deg) catmullrom;\n    }\n    track tail.rotation {\n      key 0s = (0deg, 0deg, 0deg) catmullrom;\n      key 1s = (3deg, 10deg, 0deg) catmullrom;\n      key 2s = (0deg, -8deg, 0deg) catmullrom;\n      key 3s = (3deg, 6deg, 0deg) catmullrom;\n      key 4s = (0deg, 0deg, 0deg) catmullrom;\n    }\n    track tail_tip.rotation {\n      key 0s = (0deg, 0deg, 0deg) catmullrom;\n      key 1.2s = (6deg, 14deg, 0deg) catmullrom;\n      key 2.2s = (2deg, -12deg, 0deg) catmullrom;\n      key 4s = (0deg, 0deg, 0deg) catmullrom;\n    }\n  }\n\n  export motion tail_wag for CreatureRig {\n    duration = 2.4s; fps = 24; loop = loop; rest-relative = true;\n    track tail.rotation {\n      key 0s = (0deg, 0deg, 0deg) catmullrom;\n      key 0.3s = (2deg, 18deg, 0deg) catmullrom;\n      key 0.9s = (2deg, -18deg, 0deg) catmullrom;\n      key 1.5s = (2deg, 18deg, 0deg) catmullrom;\n      key 2.1s = (2deg, -18deg, 0deg) catmullrom;\n      key 2.4s = (0deg, 0deg, 0deg) catmullrom;\n    }\n    track tail_tip.rotation {\n      key 0s = (0deg, 0deg, 0deg) catmullrom;\n      key 0.4s = (4deg, 22deg, 0deg) catmullrom;\n      key 1s = (4deg, -22deg, 0deg) catmullrom;\n      key 1.6s = (4deg, 22deg, 0deg) catmullrom;\n      key 2.2s = (4deg, -22deg, 0deg) catmullrom;\n      key 2.4s = (0deg, 0deg, 0deg) catmullrom;\n    }\n    track head.rotation {\n      key 0s = (0deg, 0deg, 0deg) catmullrom;\n      key 0.6s = (-4deg, 0deg, -3deg) catmullrom;\n      key 1.8s = (-4deg, 0deg, 3deg) catmullrom;\n      key 2.4s = (0deg, 0deg, 0deg) catmullrom;\n    }\n  }\n}\n"},{"path":"creatures/surface.ashfox","source":"ashfox-model 1\nmodule surface {\n  export surface contract Fur {\n    chart torso box { coverage = opaque; }\n    chart chest box { coverage = opaque; }\n    chart ruff box { coverage = opaque; }\n    chart throat box { coverage = opaque; }\n    chart head box { coverage = opaque; }\n    chart muzzle box { coverage = opaque; }\n    chart brow box { coverage = opaque; }\n    chart ear_base box { coverage = opaque; }\n    chart ear_tip box { coverage = opaque; }\n    chart ear_inner box { coverage = opaque; }\n    chart cheek_tuft flat { coverage = opaque; }\n    chart front_leg box { coverage = opaque; }\n    chart front_paw box { coverage = opaque; }\n    chart back_leg box { coverage = opaque; }\n    chart back_shin box { coverage = opaque; }\n    chart back_paw box { coverage = opaque; }\n    chart tail_base box { coverage = opaque; }\n    chart tail_main box { coverage = opaque; }\n    chart tail_tip box { coverage = opaque; }\n    chart tail_plume flat { coverage = opaque; }\n    chart nose box { coverage = opaque; }\n    material = opaque;\n  }\n\n  export surface red_fox: Fur {\n    material = opaque;\n    texture atlas {\n      background = deep; background-alpha = 255;\n      palette {\n        deep = #140b0a;\n        coat = (#612012, #c44c24, #f08946);\n        coat_dark = (#38130c, #742818, #af4827);\n        coat_warm = (#7d2d16, #db652c, #f8a45c);\n        cream = (#8a5b35, #d9a772, #ffe8bd);\n        leg = (#24110f, #4c251d, #804738);\n        paw = (#120908, #2b1713, #502f28);\n        inner = (#743032, #b85555, #e8897e);\n        eye_white = #fff4db;\n        eye_dark = (#090707, #171011, #302020);\n        nose = (#080606, #18100d, #362018);\n      }\n      stamp eye_pair {\n        pixels = \".wk..kw./.wk..kw.\";\n        w = eye_white;\n        k = eye_dark;\n      }\n      stamp face_mask {\n        pixels = \"......../cc....cc/ccc..ccc\";\n        c = cream;\n      }\n      stamp brow_tuft {\n        pixels = \".ll../..ll.\";\n        l = coat_warm;\n      }\n      stamp chest_blaze {\n        pixels = \"..cc../.cccc./cccccc/cccccc/.cccc./..cc..\";\n        c = cream;\n      }\n      stamp mouth_mark {\n        pixels = \".../.d.\";\n        d = eye_dark;\n      }\n\n      chart torso box {\n        fill = coat;\n        grain = clustered;\n        pattern gradient { from = coat_dark; to = coat_warm; axis = y; space = model; soft = 0.25ratio; }\n        pattern ao { strength = 0.85ratio; radius = 2u; }\n        pattern stripe { paint = coat_dark; axis = u; period = 5px; width = 1px; phase = 1; }\n      }\n      chart chest box {\n        fill = coat;\n        grain = clustered;\n        pattern gradient { from = cream; to = coat_warm; axis = y; space = model; soft = 0.2ratio; }\n        pattern ao { strength = 0.8ratio; radius = 2u; }\n        face north { stamp chest_blaze { at = (0px, 0px); protect = true; } }\n      }\n      chart ruff box {\n        fill = coat_warm;\n        grain = clustered;\n        pattern gradient { from = cream; to = coat; axis = y; space = local; soft = 0.2ratio; }\n        pattern border { paint = coat_dark; width = 1px; edges = bottom; }\n        pattern ao { strength = 0.75ratio; radius = 2u; }\n      }\n      chart throat box {\n        fill = cream;\n        grain = soft;\n        pattern gradient { from = coat_warm; to = cream; axis = y; space = local; soft = 0.25ratio; }\n        pattern ao { strength = 0.7ratio; radius = 2u; }\n      }\n      chart head box {\n        fill = coat;\n        grain = soft;\n        pattern gradient { from = coat_dark; to = coat_warm; axis = y; space = local; soft = 0.2ratio; }\n        pattern border { paint = coat_dark; width = 1px; edges = bottom; }\n        pattern ao { strength = 0.7ratio; radius = 2u; }\n        face north {\n          stamp eye_pair { at = (0px, 2px); protect = true; }\n          stamp face_mask { at = (0px, 4px); protect = true; }\n          stamp brow_tuft { at = (1px, 0px); }\n        }\n      }\n      chart muzzle box {\n        fill = cream;\n        grain = soft;\n        pattern gradient { from = cream; to = coat_warm; axis = y; space = local; soft = 0.3ratio; }\n        pattern ao { strength = 0.7ratio; radius = 2u; }\n        face north { stamp mouth_mark { at = (1px, 1px); protect = true; } }\n      }\n      chart brow box {\n        fill = coat_warm;\n        grain = soft;\n        pattern border { paint = cream; width = 1px; edges = bottom; }\n      }\n      chart ear_base box {\n        fill = coat;\n        grain = soft;\n        pattern gradient { from = coat_dark; to = coat_warm; axis = y; space = local; soft = 0.2ratio; }\n        pattern ao { strength = 0.75ratio; radius = 2u; }\n      }\n      chart ear_tip box {\n        fill = coat_dark;\n        grain = none;\n        pattern border { paint = paw; width = 1px; edges = top; }\n      }\n      chart ear_inner box {\n        fill = inner;\n        grain = soft;\n        pattern border { paint = cream; width = 1px; edges = bottom; }\n      }\n      chart cheek_tuft flat {\n        fill = cream;\n        grain = soft;\n        pattern gradient { from = coat; to = cream; axis = y; space = local; soft = 0.25ratio; }\n      }\n      chart back_leg box {\n        fill = coat;\n        grain = clustered;\n        pattern gradient { from = leg; to = coat; axis = y; space = model; soft = 0.25ratio; }\n        pattern ao { strength = 0.85ratio; radius = 2u; }\n      }\n      chart back_shin box {\n        fill = leg;\n        grain = clustered;\n        pattern gradient { from = paw; to = leg; axis = y; space = model; soft = 0.2ratio; }\n        pattern ao { strength = 0.8ratio; radius = 2u; }\n      }\n      chart front_leg box {\n        fill = leg;\n        grain = clustered;\n        pattern gradient { from = paw; to = coat; axis = y; space = model; soft = 0.25ratio; }\n        pattern ao { strength = 0.85ratio; radius = 2u; }\n      }\n      chart front_paw box {\n        fill = paw;\n        grain = none;\n        pattern border { paint = leg; width = 1px; edges = top; }\n        pattern ao { strength = 0.7ratio; radius = 2u; }\n      }\n      chart back_paw box {\n        fill = paw;\n        grain = none;\n        pattern border { paint = leg; width = 1px; edges = top; }\n        pattern ao { strength = 0.7ratio; radius = 2u; }\n      }\n      chart tail_base box {\n        fill = coat;\n        grain = clustered;\n        pattern gradient { from = coat_dark; to = coat_warm; axis = y; space = local; soft = 0.25ratio; }\n        pattern ao { strength = 0.85ratio; radius = 2u; }\n      }\n      chart tail_main box {\n        fill = coat_warm;\n        grain = clustered;\n        pattern gradient { from = coat_dark; to = coat_warm; axis = y; space = local; soft = 0.25ratio; }\n        pattern stripe { paint = coat; axis = v; period = 3px; width = 1px; phase = 0; }\n      }\n      chart tail_tip box {\n        fill = cream;\n        grain = soft;\n        pattern gradient { from = coat_warm; to = cream; axis = y; space = local; soft = 0.2ratio; }\n        pattern border { paint = coat_warm; width = 1px; edges = sides; }\n      }\n      chart tail_plume flat {\n        fill = cream;\n        grain = soft;\n        pattern gradient { from = coat; to = cream; axis = y; space = local; soft = 0.2ratio; }\n      }\n      chart nose box {\n        fill = nose;\n        grain = none;\n        pattern border { paint = leg; width = 1px; edges = top; }\n      }\n      grain clustered { seed = 8923; }\n      tone painterly;\n    }\n  }\n}\n"}],"lock":{"compilerFingerprint":"ashfox-asset-compiler:workspace+design+anchored-pixels+parent-space-rig+typed-hir+instantiation+canonical:v1","format":"ashfox-lock","packages":[{"contentHash":"sha256:858ab31c664593084e3904bd7912322b48ec0b1ff211f581581dd72a585b41d7","dependencies":[],"digest":null,"files":[{"contentHash":"sha256:012efc7936ed40e913cb17b24e129bfde85ec4c4b30b76f955248670e3b2cf7a","path":"creatures/body.ashfox"},{"contentHash":"sha256:f85b716316d0a91a499ce4ebeb5b8236fc370c2a5205d1e1aa817ea85df016c3","path":"creatures/fox.ashfox"},{"contentHash":"sha256:e7841c2a6dd5f401f0d76fb6514f4b772a21e1e740094e6cc27ca200f803ad3d","path":"creatures/rig.ashfox"},{"contentHash":"sha256:3f6448a4d6cdf5a6b8dff489bb4c9fa03f59f7fe18ba297d5b3b1b77cc3fff2d","path":"creatures/surface.ashfox"}],"interfaceHash":"sha256:52b4d6d4c96940844216e7e23e35d1f063a191ceb92c5c916b0e00e33f3840f2","manifest":{"dependencies":[],"entries":[{"name":"fox","path":"fox.ashfox"}],"format":"ashfox-package","modules":[{"path":"body.ashfox","subpath":"./body"},{"path":"rig.ashfox","subpath":"./rig"},{"path":"surface.ashfox","subpath":"./surface"}],"version":1},"manifestHash":"sha256:02dbb4ab381e619ee23a9099cb92cd4889d0ff637c5f7c32f630a9baed6333c2","name":"creatures","root":"creatures","source":"workspace"}],"version":1},"manifest":{"format":"ashfox-workspace","packages":[{"manifest":{"dependencies":[],"entries":[{"name":"fox","path":"fox.ashfox"}],"format":"ashfox-package","modules":[{"path":"body.ashfox","subpath":"./body"},{"path":"rig.ashfox","subpath":"./rig"},{"path":"surface.ashfox","subpath":"./surface"}],"version":1},"name":"creatures","root":"creatures"}],"version":1}}
