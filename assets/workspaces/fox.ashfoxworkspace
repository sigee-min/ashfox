{"files":[{"path":"creatures/body.ashfox","source":"ashfox 1\nmodule body {\n  import \"./rig.ashfox\" as rig;\n  import \"./surface.ashfox\" as surface;\n  export component FoxBody {\n    requires rig skeleton: rig.CreatureRig;\n    requires surface skin: surface.Fur;\n    bind bone body to skeleton.body;\n    bind bone head to skeleton.head;\n    bind bone tail to skeleton.tail;\n    bind bone tail_tip to skeleton.tail_tip;\n    bind bone front_left to skeleton.front_left;\n    bind bone front_right to skeleton.front_right;\n    bind bone back_left to skeleton.back_left;\n    bind bone back_right to skeleton.back_right;\n    geometry {\n      bone body {\n        cube pelvis { origin = (-3u, 8u, 3.6u); size = (6u, 5u, 4u); pivot = (0u, 10.5u, 5.6u); rotation = (-4deg, 0deg, 0deg); surface = skin.pelvis; }\n        cube torso { origin = (-3.5u, 7.8u, -3u); size = (7u, 6u, 7u); surface = skin.torso; }\n        cube chest { origin = (-4u, 7.2u, -7.8u); size = (8u, 7u, 5u); pivot = (0u, 10.5u, -5.3u); rotation = (6deg, 0deg, 0deg); surface = skin.chest; }\n        cube ruff { origin = (-3.5u, 10.2u, -9.2u); size = (7u, 3u, 4u); pivot = (0u, 11.7u, -7.2u); rotation = (-10deg, 0deg, 0deg); surface = skin.ruff; }\n        bone head {\n          cube skull { origin = (-4u, 12.6u, -13u); size = (8u, 6u, 7u); pivot = (0u, 15.6u, -9.5u); rotation = (3deg, 0deg, 0deg); surface = skin.head; }\n          cube muzzle { origin = (-2u, 12.6u, -17u); size = (4u, 3u, 4u); surface = skin.muzzle; }\n          cube nose { origin = (-1u, 14.3u, -17.8u); size = (2u, 1u, 2u); surface = skin.nose; }\n          cube ear_base_l { origin = (-3.8u, 18.4u, -10u); size = (3u, 3u, 2u); pivot = (-2.3u, 18.4u, -9u); rotation = (-6deg, 0deg, -14deg); mirror_x = ear_base_r; surface = skin.ear_base; }\n          cube ear_tip_l { origin = (-3.3u, 21.3u, -9.8u); size = (2u, 2u, 1u); pivot = (-2.3u, 18.4u, -9u); rotation = (-6deg, 0deg, -14deg); mirror_x = ear_tip_r; surface = skin.ear_tip; }\n          cube ear_inner_l { origin = (-3.3u, 18.8u, -10.8u); size = (2u, 2u, 1u); pivot = (-2.3u, 18.4u, -9u); rotation = (-6deg, 0deg, -14deg); mirror_x = ear_inner_r; surface = skin.ear_inner; }\n          plane cheek_tuft_l { origin = (-4.05u, 12.4u, -12.4u); size = (3u, 3u); u_axis = (0u, 0u, 1u); v_axis = (0u, 1u, 0u); rotation = (0deg, -22deg, 0deg); mirror_x = cheek_tuft_r; surface = skin.cheek_tuft; }\n        }\n        bone tail {\n          cube tail_base { origin = (-1.5u, 9.6u, 7.6u); size = (3u, 3u, 6u); pivot = (0u, 11.1u, 7.6u); rotation = (-12deg, 0deg, 0deg); surface = skin.tail_base; }\n          bone tail_tip {\n            cube tail_mid { origin = (-2.5u, 9.4u, 12.6u); size = (5u, 5u, 7u); pivot = (0u, 11.9u, 13u); rotation = (12deg, 0deg, 0deg); surface = skin.tail_main; }\n            cube tail_end { origin = (-2u, 11.2u, 18.8u); size = (4u, 4u, 5u); pivot = (0u, 13.2u, 19u); rotation = (18deg, 0deg, 0deg); surface = skin.tail_tip; }\n            cube tail_end_tip { origin = (-1u, 13.4u, 22.8u); size = (2u, 2u, 3u); pivot = (0u, 14.4u, 23u); rotation = (22deg, 0deg, 0deg); surface = skin.tail_tip_fine; }\n            plane tail_plume_l { origin = (-2.55u, 10u, 13.5u); size = (4u, 3u); u_axis = (0u, 0u, 1u); v_axis = (0u, 1u, 0u); rotation = (0deg, -14deg, 0deg); mirror_x = tail_plume_r; surface = skin.tail_plume; }\n          }\n        }\n        bone front_left {\n          cube shoulder_fl { origin = (-4.4u, 5.5u, -6u); size = (3u, 4u, 3u); pivot = (-2.9u, 9.5u, -4.5u); rotation = (5deg, 0deg, 0deg); surface = skin.front_shoulder; }\n          cube forearm_fl { origin = (-3.6u, 2u, -5.5u); size = (2u, 4u, 2u); pivot = (-2.6u, 6u, -4.5u); rotation = (-3deg, 0deg, 0deg); surface = skin.front_leg; }\n          cube paw_fl { origin = (-3.6u, 0u, -6.5u); size = (2u, 2u, 3u); surface = skin.front_paw; }\n        }\n        bone front_right {\n          cube shoulder_fr { origin = (1.4u, 5.5u, -6u); size = (3u, 4u, 3u); pivot = (2.9u, 9.5u, -4.5u); rotation = (5deg, 0deg, 0deg); surface = skin.front_shoulder; }\n          cube forearm_fr { origin = (1.6u, 2u, -5.5u); size = (2u, 4u, 2u); pivot = (2.6u, 6u, -4.5u); rotation = (-3deg, 0deg, 0deg); surface = skin.front_leg; }\n          cube paw_fr { origin = (1.6u, 0u, -6.5u); size = (2u, 2u, 3u); surface = skin.front_paw; }\n        }\n        bone back_left {\n          cube thigh_bl { origin = (-4.6u, 6.2u, 3.8u); size = (4u, 4u, 4u); pivot = (-2.6u, 9.8u, 5.8u); rotation = (8deg, 0deg, 0deg); surface = skin.back_leg; }\n          cube shin_bl { origin = (-4u, 4u, 5.3u); size = (3u, 3u, 3u); pivot = (-2.5u, 5.5u, 6.8u); rotation = (-16deg, 0deg, 0deg); surface = skin.back_shin; }\n          cube hock_bl { origin = (-3.5u, 1.8u, 4.4u); size = (2u, 3u, 2u); pivot = (-2.5u, 2u, 5.4u); rotation = (18deg, 0deg, 0deg); surface = skin.back_hock; }\n          cube paw_bl { origin = (-3.5u, 0u, 3u); size = (2u, 2u, 3u); surface = skin.back_paw; }\n        }\n        bone back_right {\n          cube thigh_br { origin = (0.6u, 6.2u, 3.8u); size = (4u, 4u, 4u); pivot = (2.6u, 9.8u, 5.8u); rotation = (8deg, 0deg, 0deg); surface = skin.back_leg; }\n          cube shin_br { origin = (1u, 4u, 5.3u); size = (3u, 3u, 3u); pivot = (2.5u, 5.5u, 6.8u); rotation = (-16deg, 0deg, 0deg); surface = skin.back_shin; }\n          cube hock_br { origin = (1.5u, 1.8u, 4.4u); size = (2u, 3u, 2u); pivot = (2.5u, 2u, 5.4u); rotation = (18deg, 0deg, 0deg); surface = skin.back_hock; }\n          cube paw_br { origin = (1.5u, 0u, 3u); size = (2u, 2u, 3u); surface = skin.back_paw; }\n        }\n      }\n    }\n  }\n}\n"},{"path":"creatures/fox.ashfox","source":"ashfox 1\nmodel fox {\n  import \"./rig.ashfox\" as rig;\n  import \"./surface.ashfox\" as surface;\n  import \"./body.ashfox\" as body;\n  settings { density = 16; forward = north; profile = creature; }\n  skeleton = rig.CreatureSkeleton;\n  motions = [rig.idle, rig.curious, rig.tail_wag];\n  use body.FoxBody as fox { skeleton = rig.CreatureRig; skin = surface.red_fox; }\n}\n"},{"path":"creatures/rig.ashfox","source":"ashfox 1\nmodule rig {\n  export rig contract CreatureRig {\n    handedness = right;\n    frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); }\n    joint root { parent = none; role = root; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = (rotation, scale); mirror = none; }\n    joint body { parent = root; role = body; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = rotation; mirror = none; }\n    joint head { parent = body; role = head; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = rotation; mirror = none; }\n    joint tail { parent = body; role = tail; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = rotation; mirror = none; }\n    joint tail_tip { parent = tail; role = tail; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = rotation; mirror = none; }\n    joint front_left { parent = body; role = leg; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = rotation; mirror = none; }\n    joint front_right { parent = body; role = leg; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = rotation; mirror = none; }\n    joint back_left { parent = body; role = leg; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = rotation; mirror = none; }\n    joint back_right { parent = body; role = leg; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = rotation; mirror = none; }\n  }\n\n  export skeleton CreatureSkeleton implements CreatureRig {\n    bind root { parent_origin = (0u, 0u, 0u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }\n    bind body { parent_origin = (0u, 10u, 0u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }\n    bind head { parent_origin = (0u, 3.5u, -7u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }\n    bind tail { parent_origin = (0u, 1u, 7.5u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }\n    bind tail_tip { parent_origin = (0u, 1u, 5.5u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }\n    bind front_left { parent_origin = (-2.2u, -1u, -4.5u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }\n    bind front_right { parent_origin = (2.2u, -1u, -4.5u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }\n    bind back_left { parent_origin = (-2.2u, -1u, 5.5u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }\n    bind back_right { parent_origin = (2.2u, -1u, 5.5u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }\n  }\n\n  export motion idle for CreatureRig {\n    duration = 2s; fps = 20; loop = loop; rest_relative = true;\n    track body.rotation {\n      key 0s = (0deg, 0deg, 0deg) catmullrom;\n      key 1s = (2deg, 0deg, 0deg) catmullrom;\n      key 2s = (0deg, 0deg, 0deg) catmullrom;\n    }\n    track head.rotation {\n      key 0s = (0deg, 0deg, 0deg) catmullrom;\n      key 1s = (-2deg, 5deg, 2deg) catmullrom;\n      key 2s = (0deg, 0deg, 0deg) catmullrom;\n    }\n    track tail.rotation {\n      key 0s = (0deg, 0deg, 0deg) catmullrom;\n      key 1s = (4deg, 8deg, 0deg) catmullrom;\n      key 2s = (0deg, 0deg, 0deg) catmullrom;\n    }\n    track tail_tip.rotation {\n      key 0s = (0deg, 0deg, 0deg) catmullrom;\n      key 1s = (6deg, 10deg, 0deg) catmullrom;\n      key 2s = (0deg, 0deg, 0deg) catmullrom;\n    }\n    track front_left.rotation {\n      key 0s = (0deg, 0deg, 0deg) catmullrom;\n      key 1s = (-3deg, 0deg, 0deg) catmullrom;\n      key 2s = (0deg, 0deg, 0deg) catmullrom;\n    }\n  }\n\n  export motion curious for CreatureRig {\n    duration = 4s; fps = 24; loop = loop; rest_relative = true;\n    track head.rotation {\n      key 0s = (0deg, 0deg, 0deg) catmullrom;\n      key 1s = (6deg, -18deg, -7deg) catmullrom;\n      key 2s = (6deg, -18deg, -7deg) catmullrom;\n      key 3s = (-3deg, 12deg, 5deg) catmullrom;\n      key 4s = (0deg, 0deg, 0deg) catmullrom;\n    }\n    track tail.rotation {\n      key 0s = (0deg, 0deg, 0deg) catmullrom;\n      key 1s = (3deg, 10deg, 0deg) catmullrom;\n      key 2s = (0deg, -8deg, 0deg) catmullrom;\n      key 3s = (3deg, 6deg, 0deg) catmullrom;\n      key 4s = (0deg, 0deg, 0deg) catmullrom;\n    }\n    track tail_tip.rotation {\n      key 0s = (0deg, 0deg, 0deg) catmullrom;\n      key 1.2s = (6deg, 14deg, 0deg) catmullrom;\n      key 2.2s = (2deg, -12deg, 0deg) catmullrom;\n      key 4s = (0deg, 0deg, 0deg) catmullrom;\n    }\n  }\n\n  export motion tail_wag for CreatureRig {\n    duration = 2.4s; fps = 24; loop = loop; rest_relative = true;\n    track tail.rotation {\n      key 0s = (0deg, 0deg, 0deg) catmullrom;\n      key 0.3s = (2deg, 18deg, 0deg) catmullrom;\n      key 0.9s = (2deg, -18deg, 0deg) catmullrom;\n      key 1.5s = (2deg, 18deg, 0deg) catmullrom;\n      key 2.1s = (2deg, -18deg, 0deg) catmullrom;\n      key 2.4s = (0deg, 0deg, 0deg) catmullrom;\n    }\n    track tail_tip.rotation {\n      key 0s = (0deg, 0deg, 0deg) catmullrom;\n      key 0.4s = (4deg, 22deg, 0deg) catmullrom;\n      key 1s = (4deg, -22deg, 0deg) catmullrom;\n      key 1.6s = (4deg, 22deg, 0deg) catmullrom;\n      key 2.2s = (4deg, -22deg, 0deg) catmullrom;\n      key 2.4s = (0deg, 0deg, 0deg) catmullrom;\n    }\n    track head.rotation {\n      key 0s = (0deg, 0deg, 0deg) catmullrom;\n      key 0.6s = (-4deg, 0deg, -3deg) catmullrom;\n      key 1.8s = (-4deg, 0deg, 3deg) catmullrom;\n      key 2.4s = (0deg, 0deg, 0deg) catmullrom;\n    }\n  }\n}\n"},{"path":"creatures/surface.ashfox","source":"ashfox 1\nmodule surface {\n  export surface contract Fur {\n    chart torso box { coverage = opaque; }\n    chart pelvis box { coverage = opaque; }\n    chart chest box { coverage = opaque; }\n    chart ruff box { coverage = opaque; }\n    chart head box { coverage = opaque; }\n    chart muzzle box { coverage = opaque; }\n    chart nose box { coverage = opaque; }\n    chart ear_base box { coverage = opaque; }\n    chart ear_tip box { coverage = opaque; }\n    chart ear_inner box { coverage = opaque; }\n    chart cheek_tuft flat { coverage = binary; }\n    chart front_shoulder box { coverage = opaque; }\n    chart front_leg box { coverage = opaque; }\n    chart front_paw box { coverage = opaque; }\n    chart back_leg box { coverage = opaque; }\n    chart back_shin box { coverage = opaque; }\n    chart back_hock box { coverage = opaque; }\n    chart back_paw box { coverage = opaque; }\n    chart tail_base box { coverage = opaque; }\n    chart tail_main box { coverage = opaque; }\n    chart tail_tip box { coverage = opaque; }\n    chart tail_tip_fine box { coverage = opaque; }\n    chart tail_plume flat { coverage = binary; }\n    material = double;\n  }\n\n  export surface red_fox: Fur {\n    material = double;\n    texture atlas {\n      density = 2;\n      background = bg; background_alpha = 255;\n      palette {\n        bg = #4d261a;\n        coat = (#9b3b1e, #d9642c, #f49b56);\n        coat_deep = (#6d2718, #a94322, #d46b37);\n        cream = (#b68d65, #e6c69c, #fff1d4);\n        sock = (#3d2420, #5c3831, #845549);\n        paw = (#2e1c1a, #492d28, #6b453e);\n        ear_pink = (#8c4842, #c9786e, #efb3a8);\n        nose_tone = (#261918, #3d2725, #5e3e3a);\n        eye_dark = #211514;\n        eye_amber = #d47b2c;\n        eye_glint = #fff7e6;\n        brow_soft = #e8cfa6;\n      }\n\n      stamp fox_eyes {\n        pixels = \"..bbb......bbb../..kwa......awk../..kka......akk../..kkk......kkk..\";\n        b = brow_soft;\n        k = eye_dark;\n        w = eye_glint;\n        a = eye_amber;\n      }\n      stamp cheek_blaze {\n        pixels = \"cc............cc/cccc........cccc/ccccc......ccccc/cccccc....cccccc\";\n        c = cream;\n      }\n      stamp muzzle_cleft {\n        pixels = \"......../...kk.../........\";\n        k = eye_dark;\n      }\n      stamp chest_heart {\n        pixels = \"....cccccccc..../..cccccccccccc../.cccccccccccccc./.cccccccccccccc./..cccccccccccc../...cccccccccc.../.....cccccc...../.......cc.......\";\n        c = cream;\n      }\n\n      chart torso box {\n        fill = coat;\n        grain = soft;\n        pattern gradient { to = coat_deep; axis = y; space = local; soft = 0.25; }\n        pattern ao { strength = 0.45; radius = 1u; }\n      }\n      chart pelvis box {\n        fill = coat;\n        grain = soft;\n        pattern gradient { to = coat_deep; axis = y; space = local; soft = 0.25; }\n        pattern ao { strength = 0.45; radius = 1u; }\n      }\n      chart chest box {\n        fill = coat;\n        grain = soft;\n        pattern ao { strength = 0.45; radius = 1u; }\n        face north { stamp chest_heart { at = (0px, 2px); protect = true; } }\n      }\n      chart ruff box {\n        fill = cream;\n        grain = soft;\n        pattern ao { strength = 0.4; radius = 1u; }\n      }\n      chart head box {\n        fill = coat;\n        grain = soft;\n        pattern gradient { to = coat_deep; axis = y; space = local; soft = 0.2; }\n        pattern ao { strength = 0.4; radius = 1u; }\n        face north {\n          stamp fox_eyes { at = (0px, 3px); protect = true; }\n          stamp cheek_blaze { at = (0px, 8px); protect = true; }\n        }\n      }\n      chart muzzle box {\n        fill = cream;\n        grain = soft;\n        pattern ao { strength = 0.4; radius = 1u; }\n        face north { stamp muzzle_cleft { at = (0px, 2px); protect = true; } }\n      }\n      chart nose box {\n        fill = nose_tone;\n        grain = none;\n      }\n      chart ear_base box {\n        fill = coat;\n        grain = soft;\n        pattern ao { strength = 0.45; radius = 1u; }\n      }\n      chart ear_tip box {\n        fill = sock;\n        grain = none;\n      }\n      chart ear_inner box {\n        fill = ear_pink;\n        grain = soft;\n        pattern ao { strength = 0.4; radius = 1u; }\n      }\n      chart cheek_tuft flat {\n        coverage = 111000111110111111111111011110001100;\n        fill = cream;\n        grain = soft;\n      }\n      chart front_shoulder box {\n        fill = coat;\n        grain = clustered;\n        pattern gradient { to = sock; axis = y; space = local; soft = 0.25; }\n        pattern ao { strength = 0.45; radius = 1u; }\n      }\n      chart front_leg box {\n        fill = sock;\n        grain = soft;\n        pattern gradient { to = paw; axis = y; space = local; soft = 0.2; }\n        pattern ao { strength = 0.4; radius = 1u; }\n      }\n      chart front_paw box {\n        fill = paw;\n        grain = none;\n        pattern border { paint = sock; width = 1px; edges = top; }\n      }\n      chart back_leg box {\n        fill = coat;\n        grain = clustered;\n        pattern gradient { to = coat_deep; axis = y; space = local; soft = 0.25; }\n        pattern ao { strength = 0.45; radius = 1u; }\n      }\n      chart back_shin box {\n        fill = coat_deep;\n        grain = soft;\n        pattern gradient { to = sock; axis = y; space = local; soft = 0.2; }\n        pattern ao { strength = 0.4; radius = 1u; }\n      }\n      chart back_hock box {\n        fill = sock;\n        grain = soft;\n      }\n      chart back_paw box {\n        fill = paw;\n        grain = none;\n        pattern border { paint = sock; width = 1px; edges = top; }\n      }\n      chart tail_base box {\n        fill = coat_deep;\n        grain = soft;\n        pattern ao { strength = 0.45; radius = 1u; }\n      }\n      chart tail_main box {\n        fill = coat;\n        grain = soft;\n        pattern gradient { to = coat_deep; axis = y; space = local; soft = 0.25; }\n        pattern ao { strength = 0.4; radius = 1u; }\n      }\n      chart tail_tip box {\n        fill = cream;\n        grain = soft;\n      }\n      chart tail_tip_fine box {\n        fill = cream;\n        grain = none;\n      }\n      chart tail_plume flat {\n        coverage = 111110001111110011111110111111110111111000111100;\n        fill = cream;\n        grain = soft;\n      }\n\n      grain soft { seed = 8923; }\n      