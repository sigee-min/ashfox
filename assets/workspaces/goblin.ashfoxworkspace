{"files":[{"path":"assets/models/goblin_raider.ashfox","source":"ashfox 1\nmodel goblin_raider {\n  import \"std/model/rig/biped\" as biped;\n  import \"std/model/motion/locomotion\" as loco;\n  import \"std/model/motion/combat\" as combat;\n  import \"std/core/hook/combat\" as combat_hook;\n  import \"std/core/hook/loot\" as loot_hook;\n  import \"shared_modules/goblin_kit\" as kit;\n  import \"shared_modules/goblin_skins\" as skins;\n\n  settings { density = 16; forward = north; profile = creature; }\n  skeleton = biped.BipedSkeleton;\n  motions = [kit.goblin_idle, loco.biped_walk, combat.slash, kit.goblin_challenge];\n\n  use kit.GoblinBody as body { skeleton = biped.BipedRig; skin = skins.raider_skin; }\n  use kit.RaiderGear as blade { skin = skins.raider_weapon; }\n  use kit.RaiderShield as shield { skin = skins.raider_shield; }\n  connect body.gear_hand -> blade.grip;\n  connect body.off_hand_mount -> shield.mount;\n\n  cue blade_arc : combat_hook.HitboxArc { clip = slash; at = 0.2s..0.45s; reach = 18u; damage = 16; damage_type = slash; }\n  anchor loot_drop : loot_hook.ItemDrop { bone = pelvis; item_id = \"ashfox:iron_sword\"; chance = 0.25; }\n  meta ai_profile : combat_hook.CombatStateMeta { aggro_range = 16.0; leash_range = 36.0; attack_cooldown = 1.4s; }\n}\n"},{"path":"assets/module/goblin/goblin_kit.ashfox","source":"ashfox 1\nmodule goblin_kit {\n  import \"std/model/rig/biped\" as biped;\n\n  export surface contract GoblinSkin {\n    chart torso box { coverage = opaque; }\n    chart pelvis box { coverage = opaque; }\n    chart head box { coverage = opaque; }\n    chart snout box { coverage = opaque; }\n    chart ear box { coverage = opaque; }\n    chart ear_tip box { coverage = opaque; }\n    chart tusk box { coverage = opaque; }\n    chart crest box { coverage = opaque; }\n    chart arm box { coverage = opaque; }\n    chart bracer box { coverage = opaque; }\n    chart hand box { coverage = opaque; }\n    chart leg box { coverage = opaque; }\n    chart cuff box { coverage = opaque; }\n    chart boot box { coverage = opaque; }\n    chart belt box { coverage = opaque; }\n    chart buckle box { coverage = opaque; }\n    chart loincloth flat { coverage = binary; }\n    chart pauldron box { coverage = opaque; }\n    chart face_neutral flat { coverage = opaque; }\n    chart face_blink flat { coverage = opaque; }\n    chart face_snarl flat { coverage = opaque; }\n    material = double;\n  }\n\n  export surface contract RaiderWeaponSkin {\n    chart pommel box { coverage = opaque; }\n    chart hilt box { coverage = opaque; }\n    chart guard box { coverage = opaque; }\n    chart blade box { coverage = opaque; }\n    chart blade_tip box { coverage = opaque; }\n    material = opaque;\n  }\n\n  export surface contract RaiderShieldSkin {\n    chart board box { coverage = opaque; }\n    chart boss box { coverage = opaque; }\n    material = opaque;\n  }\n\n  export surface contract PyroStaffSkin {\n    chart staff box { coverage = opaque; }\n    chart cage box { coverage = opaque; }\n    chart flame_crown box { coverage = opaque; }\n    material = opaque;\n  }\n\n  export component GoblinBody {\n    requires rig skeleton: biped.BipedRig;\n    requires surface skin: GoblinSkin;\n    provides socket gear_hand: biped.HandGrip capacity = one;\n    provides socket off_hand_mount: biped.HandGrip capacity = one;\n    bind bone root to skeleton.root;\n    bind bone pelvis to skeleton.pelvis;\n    bind bone torso to skeleton.torso;\n    bind bone head to skeleton.head;\n    bind bone left_arm to skeleton.left_arm;\n    bind bone right_arm to skeleton.right_arm;\n    bind bone weapon to skeleton.weapon;\n    bind bone left_leg to skeleton.left_leg;\n    bind bone right_leg to skeleton.right_leg;\n    bind socket gear_hand to bone weapon {\n      frame { origin = (0.5u, -2u, 1u); x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); }\n    }\n    bind socket off_hand_mount to bone left_arm {\n      frame { origin = (-2.5u, -8.5u, 0u); x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); }\n    }\n    geometry {\n      bone root {\n        bone pelvis {\n          cube hips { origin = (-4u, 10.5u, -2.5u); size = (8u, 3u, 5u); surface = skin.pelvis; }\n          cube belt { origin = (-4.5u, 12.5u, -3.2u); size = (9u, 2u, 6u); surface = skin.belt; }\n          cube buckle { origin = (-1.5u, 12.5u, -4.1u); size = (3u, 2u, 1u); surface = skin.buckle; }\n          plane loincloth_front { origin = (3u, 8u, -3.25u); size = (6u, 5u); u_axis = (-1u, 0u, 0u); v_axis = (0u, 1u, 0u); surface = skin.loincloth; }\n          plane loincloth_back { origin = (-3u, 8u, 3.15u); size = (6u, 5u); u_axis = (1u, 0u, 0u); v_axis = (0u, 1u, 0u); surface = skin.loincloth; }\n          bone torso {\n            cube chest { origin = (-5u, 14.5u, -3u); size = (10u, 9u, 6u); pivot = (0u, 19u, 0u); rotation = (4deg, 0deg, 0deg); surface = skin.torso; }\n            bone head {\n              cube skull { origin = (-4u, 23u, -4u); size = (8u, 7u, 8u); pivot = (0u, 26.5u, 0u); rotation = (4deg, 0deg, 0deg); surface = skin.head; }\n              expression_slot face {\n                origin = (3u, 24.8u, -4.08u);\n                size = (6u, 4u);\n                u_axis = (-1u, 0u, 0u);\n                v_axis = (0u, 1u, 0u);\n                neutral = skin.face_neutral;\n                blink = skin.face_blink;\n                snarl = skin.face_snarl;\n              }\n              cube snout { origin = (-2.5u, 22.8u, -6.9u); size = (5u, 2u, 3u); surface = skin.snout; }\n              cube tusk_l { origin = (-2.4u, 22.4u, -7.5u); size = (1u, 3u, 2u); pivot = (-1.9u, 23.1u, -6.5u); rotation = (-14deg, 0deg, -8deg); mirror_x = tusk_r; surface = skin.tusk; }\n              cube ear_l { origin = (-7.2u, 25u, -1u); size = (3u, 3u, 2u); pivot = (-4u, 26.5u, 0u); rotation = (0deg, 10deg, -18deg); mirror_x = ear_r; surface = skin.ear; }\n              cube ear_tip_l { origin = (-9.8u, 26u, -0.6u); size = (3u, 2u, 2u); pivot = (-4u, 26.5u, 0u); rotation = (0deg, 10deg, -22deg); mirror_x = ear_tip_r; surface = skin.ear_tip; }\n              cube mohawk_front { origin = (-1u, 29.9u, -3.5u); size = (2u, 3u, 4u); pivot = (0u, 29.9u, -1.5u); rotation = (-12deg, 0deg, 0deg); surface = skin.crest; }\n              cube mohawk_back { origin = (-1u, 29.9u, 0.6u); size = (2u, 3u, 4u); pivot = (0u, 29.9u, 2.5u); rotation = (16deg, 0deg, 0deg); surface = skin.crest; }\n            }\n            bone left_arm {\n              cube pauldron_l { origin = (-9.5u, 20.4u, -2.5u); size = (5u, 3u, 5u); pivot = (-5u, 21.4u, 0u); rotation = (0deg, 0deg, 16deg); surface = skin.pauldron; }\n              cube arm_l { origin = (-8.5u, 15u, -1.5u); size = (3u, 6u, 3u); surface = skin.arm; }\n              cube bracer_l { origin = (-9u, 12u, -2u); size = (4u, 3u, 4u); surface = skin.bracer; }\n              cube hand_l { origin = (-8.5u, 9.5u, -1.5u); size = (3u, 3u, 3u); surface = skin.hand; }\n            }\n            bone right_arm {\n              cube pauldron_r { origin = (4.5u, 20.4u, -2.5u); size = (5u, 3u, 5u); pivot = (5u, 21.4u, 0u); rotation = (0deg, 0deg, -16deg); surface = skin.pauldron; }\n              cube arm_r { origin = (5.5u, 15u, -1.5u); size = (3u, 6u, 3u); surface = skin.arm; }\n              cube bracer_r { origin = (5u, 12u, -2u); size = (4u, 3u, 4u); surface = skin.bracer; }\n              cube hand_r { origin = (5.5u, 9.5u, -1.5u); size = (3u, 3u, 3u); surface = skin.hand; }\n              bone weapon {}\n            }\n          }\n          bone left_leg {\n            cube leg_l { origin = (-4.2u, 5u, -2u); size = (4u, 6u, 4u); surface = skin.leg; }\n            cube cuff_l { origin = (-4.6u, 3u, -2.5u); size = (5u, 2u, 5u); surface = skin.cuff; }\n            cube boot_l { origin = (-4.2u, 0u, -4u); size = (4u, 3u, 6u); surface = skin.boot; }\n          }\n          bone right_leg {\n            cube leg_r { origin = (0.2u, 5u, -2u); size = (4u, 6u, 4u); surface = skin.leg; }\n            cube cuff_r { origin = (-0.4u, 3u, -2.5u); size = (5u, 2u, 5u); surface = skin.cuff; }\n            cube boot_r { origin = (0.2u, 0u, -4u); size = (4u, 3u, 6u); surface = skin.boot; }\n          }\n        }\n      }\n    }\n  }\n\n  export component RaiderGear {\n    requires socket grip: biped.HandGrip;\n    requires surface skin: RaiderWeaponSkin;\n    bind socket grip to bone root { frame { origin = (0u, 0u, 0u); x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }\n    geometry {\n      bone root {\n        cube pommel { origin = (-1.5u, -1.5u, 2.5u); size = (3u, 3u, 2u); surface = skin.pommel; }\n        cube hilt { origin = (-1u, -1u, -2.5u); size = (2u, 2u, 5u); surface = skin.hilt; }\n        cube guard { origin = (-2.5u, -0.5u, -3.5u); size = (5u, 1u, 1u); pivot = (0u, 0u, -3u); rotation = (0deg, 0deg, 22.5deg); surface = skin.guard; }\n        cube blade { origin = (-1u, -1u, -16.5u); size = (2u, 2u, 13u); surface = skin.blade; }\n        wedge blade_tip { origin = (-1u, -1u, -19.5u); size = (2u, 2u, 3u); slope = north; surface = skin.blade_tip; }\n      }\n    }\n  }\n\n  export component RaiderShield {\n    requires socket mount: biped.HandGrip;\n    requires surface skin: RaiderShieldSkin;\n    bind socket mount to bone root { frame { origin = (0u, 0u, 0u); x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }\n    geometry {\n      bone root {\n        cube board { origin = (-1.5u, -5u, -4u); size = (3u, 10u, 8u); pivot = (0u, 0u, 0u); rotation = (0deg, -14deg, 0deg); surface = skin.board; }\n        cylinder boss { origin = (-2.3u, 0u, 0u); radius = 1.1u; radius_top = 2.1u; height = 1.2u; sides = 8; axis = x; pivot = (0u, 0u, 0u); rotation = (0deg, -14deg, 0deg); surface = skin.boss; }\n      }\n    }\n  }\n\n  export component PyroGear {\n    requires socket grip: biped.HandGrip;\n    requires surface skin: PyroStaffSkin;\n    bind socket grip to bone root { frame { origin = (0u, 0u, 0u); x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }\n    geometry {\n      bone root {\n        cylinder staff { origin = (0.5u, -10u, -1u); radius = 0.9u; radius_top = 1.1u; height = 24u; sides = 8; axis = y; pivot = (0.5u, 0u, -1u); rotation = (-14deg, 0deg, 0deg); surface = skin.staff; }\n        cube cage { origin = (-1.5u, 13.5u, -3u); size = (4u, 4u, 4u); pivot = (0.5u, 0u, -1u); rotation = (-14deg, 0deg, 0deg); surface = skin.cage; }\n        taper flame_crown { origin = (-1u, 17.5u, -2.5u); size = (3u, 4u, 3u); top_scale = (0.2, 0.2); axis = y; pivot = (0.5u, 0u, -1u); rotation = (-14deg, 0deg, 0deg); surface = skin.flame_crown; }\n      }\n    }\n  }\n\n  export motion goblin_idle for biped.BipedRig {\n    duration = 2.4s; fps = 24; loop = loop; rest_relative = true;\n    track pelvis.position { key 0s = (0u, 0u, 0u) smooth; key 1.1s = (0u, -0.5u, 0.2u) ease_in_out; key 2.4s = (0u, 0u, 0u) ease_out; }\n    track torso.rotation { key 0s = (0deg, 0deg, 0deg) smooth; key 1.2s = (4deg, -5deg, 0deg) ease_in_out; key 2.4s = (0deg, 0deg, 0deg) ease_out; }\n    track head.rotation { key 0s = (0deg, 0deg, 0deg) smooth; key 1.2s = (-4deg, 8deg, 2deg) ease_in_out; key 2.4s = (0deg, 0deg, 0deg) ease_out; }\n    track right_arm.rotation { key 0s = (0deg, 0deg, 0deg) smooth; key 1.2s = (-8deg, 5deg, 4deg) ease_in_out; key 2.4s = (0deg, 0deg, 0deg) ease_out; }\n    track left_arm.rotation { key 0s = (0deg, 0deg, 0deg) smooth; key 1.2s = (6deg, -4deg, -4deg) ease_in_out; key 2.4s = (0deg, 0deg, 0deg) ease_out; }\n    expression face { at 0s = neutral; at 1.4s..1.55s = blink; }\n    wave torso.rotation.x = breath(2.4s, inhale = 0.42) * 3deg;\n    cue 0.5s sound \"goblin_grunt\" at head;\n  }\n\n  export motion goblin_challenge for biped.BipedRig {\n    duration = 2.0s; fps = 30; loop = once; rest_relative = true;\n    pose windup { torso.rotation = (-16deg, 22deg, 0deg); right_arm.rotation = (-64deg, -10deg, 20deg); left_arm.rotation = (16deg, 0deg, -12deg); head.rotation = (5deg, -18deg, 0deg); }\n    pose strike { torso.rotation = (20deg, -24deg, 0deg); right_arm.rotation = (44deg, 8deg, -12deg); left_arm.rotation = (-14deg, 0deg, -16deg); head.rotation = (-6deg, 16deg, 0deg); }\n    at 0s pose windup smooth;\n    at 0.55s pose windup anticipate(0.28);\n    at 1.0s pose strike snap;\n    at 1.6s pose windup ease_out;\n    at 2.0s pose windup smooth;\n    expression face { at 0s = neutral; at 0.55s..1.45s = snarl; }\n    smear weapon { at = 0.92s..1.04s; stretch = 1.35; axis = z; }\n    hitstop { at = 1.0s; hold = 0.04s; shake = 0.25u; }\n    cue 0.98s sound \"sword_slash\" at weapon;\n  }\n}\n"},{"path":"assets/module/goblin/goblin_skins.ashfox","source":"ashfox 1\nmodule goblin_skins {\n  import \"std/core/palette/medieval\" as med;\n  import \"std/core/palette/element\" as elem;\n  import \"std/core/material/metal\" as metal;\n  import \"std/core/material/wood\" as wood;\n  import \"./goblin_kit.ashfox\" as kit;\n\n  export surface raider_skin: kit.GoblinSkin {\n    material = double;\n    texture atlas {\n      density = 2;\n      atlas = (128px, 128px);\n      background = void; background_alpha = 0;\n      palette {\n        void = #000000;\n        skin = (#3c5c22, #6f9c3b, #a7cf5e);\n        skin_dark = (#2c441a, #50752b, #7ea644);\n        leather = (wood.WoodParams.oak_shadow, wood.WoodParams.oak_base, wood.WoodParams.oak_light);\n        leather_dark = (wood.WoodParams.spruce_shadow, wood.WoodParams.spruce_base, wood.WoodParams.spruce_light);\n        iron = (#6c7682, #a2aebc, #d8e2ec);\n        brass = (#8c6422, #d4a13f, #fad575);\n        cloth = (med.HeraldryBanner.crimson_shadow, med.HeraldryBanner.crimson_base, med.HeraldryBanner.crimson_light);\n        tooth = (#9c8b68, #d9c79b, #f0e4c8);\n        eye = #ffd94a;\n        glint = #fff9e6;\n        pupil = #211a14;\n        snarl_red = #d94646;\n      }\n      stamp face_neutral_s { pixels = \".ddd..ddd./kgyk..kygk/kkdk..kdkk\"; d = skin_dark; y = eye; g = glint; k = pupil; }\n      stamp face_blink_s { pixels = \"........../.ddd..ddd./kkkk..kkkk\"; d = skin_dark; k = pupil; }\n      stamp face_snarl_s { pixels = \".ddd..ddd./kyyk..kyyk/rrrr..rrrr\"; d = skin_dark; y = eye; k = pupil; r = snarl_red; }\n      stamp armor_strap { pixels = \"llbb..../..llll../....llbb/......ll\"; l = leather_dark; b = brass; }\n\n      chart torso box { fill = leather; roughness = 0.78; metallic = 0.05; grain = soft; pattern gradient { to = leather_dark; axis = y; space = local; soft = 0.2; } pattern ao { strength = 0.45; radius = 0.9u; } face north { stamp armor_strap { at = (1px, 2px); protect = true; } } }\n      chart pelvis box { fill = cloth; roughness = 0.88; grain = soft; pattern border { paint = leather_dark; width = 1px; edges = top; } }\n      chart head box { fill = skin; roughness = 0.76; grain = soft; pattern gradient { to = skin_dark; axis = y; space = local; soft = 0.2; } pattern ao { strength = 0.4; radius = 0.8u; } }\n      chart snout box { fill = skin; roughness = 0.76; grain = soft; pattern gradient { to = skin_dark; axis = z; space = local; soft = 0.2; } }\n      chart ear box { fill = skin; roughness = 0.78; grain = soft; pattern gradient { to = skin_dark; axis = y; space = local; soft = 0.25; } }\n      chart ear_tip box { fill = skin_dark; roughness = 0.78; grain = soft; pattern gradient { to = skin; axis = y; space = local; soft = 0.25; } }\n      chart tusk box { fill = tooth; roughness = 0.45; grain = none; pattern gradient { to = leather; axis = y; space = local; soft = 0.2; } }\n      chart crest box { fill = cloth; roughness = 0.85; grain = soft; pattern stripe { paint = brass; axis = z; period = 3px; width = 1px; } }\n      chart arm box { fill = skin; roughness = 0.76; grain = soft; pattern gradient { to = skin_dark; axis = y; space = local; soft = 0.2; } pattern ao { strength = 0.3; radius = 0.6u; } }\n      chart bracer box { fill = iron; roughness = 0.28; metallic = 0.88; roughness_variation = 0.08; grain = brushed; pattern border { paint = brass; width = 1px; edges = all; } }\n      chart hand box { fill = skin_dark; roughness = 0.78; grain = soft; pattern border { paint = skin; width = 1px; edges = top; } }\n      chart leg box { fill = cloth; roughness = 0.88; grain = soft; pattern gradient { to = leather_dark; axis = y; space = local; soft = 0.2; } pattern ao { strength = 0.35; radius = 0.7u; } }\n      chart cuff box { fill = leather; roughness = 0.80; grain = soft; pattern border { paint = brass; width = 1px; edges = top; } }\n      chart boot box { fill = leather_dark; roughness = 0.82; grain = clustered; pattern border { paint = leather; width = 1px; edges = top; } }\n      chart belt box { fill = leather_dark; roughness = 0.80; grain = clustered; pattern border { paint = iron; width = 1px; edges = bottom; } }\n      chart buckle box { fill = brass; roughness = 0.24; metallic = 0.90; roughness_variation = 0.06; grain = none; pattern border { paint = iron; width = 1px; edges = all; } }\n      chart loincloth flat { coverage = 111111111111111111111111111111111111111111111111111111111111111111111111011111111110011111111110001111111100001100110011; fill = cloth; roughness = 0.90; grain = soft; pattern border { paint = brass; width = 1px; edges = top; } }\n      chart pauldron box { fill = iron; roughness = 0.26; metallic = 0.88; roughness_variation = 0.08; grain = brushed; pattern border { paint = brass; width = 1px; edges = bottom; } }\n      chart face_neutral flat { fill = skin; stamp face_neutral_s { at = (1px, 2px); protect = true; } }\n      chart face_blink flat { fill = skin; stamp face_blink_s { at = (1px, 2px); protect = true; } }\n      chart face_snarl flat { fill = skin; stamp face_snarl_s { at = (1px, 2px); protect = true; } }\n      grain soft { seed = 4101; }\n      tone painterly;\n    }\n  }\n\n  export surface raider_weapon: kit.RaiderWeaponSkin {\n    material = opaque;\n    texture atlas {\n      density = 2;\n      atlas = (128px, 128px);\n      background = void; background_alpha = 255;\n      palette {\n        void = #1f1a18;\n        leather_dark = (wood.WoodParams.spruce_shadow, wood.WoodParams.spruce_base, wood.WoodParams.spruce_light);\n        steel = (#7b8694, #b0bcc9, #e1eaf2);\n        brass = (#8c6422, #d4a13f, #fad575);\n      }\n      chart pommel box { fill = brass; roughness = 0.24; metallic = 0.90; grain = none; pattern border { paint = steel; width = 1px; edges = all; } }\n      chart hilt box { fill = leather_dark; roughness = 0.75; grain = wood; pattern stripe { paint = brass; axis = z; period = 3px; width = 1px; } }\n      chart guard box { fill = brass; roughness = 0.24; metallic = 0.90; grain = none; pattern border { paint = steel; width = 1px; edges = all; } }\n      chart blade box { fill = steel; roughness = 0.22; metallic = 0.92; roughness_variation = 0.07; grain = brushed; pattern stripe { paint = brass; axis = z; period = 6px; width = 1px; } pattern ao { strength = 0.25; radius = 0.5u; } }\n      chart blade_tip box { fill = steel; roughness = 0.20; metallic = 0.94; grain = brushed; pattern gradient { to = brass; axis = z; space = local; soft = 0.25; } }\n      grain soft { seed = 4103; }\n      tone painterly;\n    }\n  }\n\n  export surface raider_shield: kit.RaiderShieldSkin {\n    material = opaque;\n    texture atlas {\n      density = 2;\n      atlas = (128px, 128px);\n      background = void; background_alpha = 255;\n      palette {\n        void = #261a12;\n        leather = (wood.WoodParams.oak_shadow, wood.WoodParams.oak_base, wood.WoodParams.oak_light);\n        steel = (#7b8694, #b0bcc9, #e1eaf2);\n        brass = (#8c6422, #d4a13f, #fad575);\n      }\n      chart board box { fill = leather; roughness = 0.78; grain = clustered; pattern border { paint = steel; width = 1px; edges = all; } pattern stripe { paint = brass; axis = y; period = 5px; width = 1px; } }\n      chart boss box { fill = brass; roughness = 0.24; metallic = 0.90; grain = none; pattern border { paint = steel; width = 1px; edges = all; } }\n      grain soft { seed = 4104; }\n      tone painterly;\n    }\n  }\n\n  export surface pyro_skin: kit.GoblinSkin {\n    material = double;\n    texture atlas {\n      density = 2;\n      atlas = (128px, 128px);\n      background = void; background_alpha = 0;\n      palette {\n        void = #000000;\n        skin = (#5c3224, #8f4e34, #c4764e);\n        skin_dark = (#422219, #6b3926, #965438);\n        robe = (elem.FlamePalette.flame_edge, elem.FlamePalette.flame_mid, elem.FlamePalette.ember_core);\n        char = (#261e20, #3d3034, #59464c);\n        bronze = (metal.MetalParams.copper_shadow, metal.MetalParams.copper_base, metal.MetalParams.copper_light);\n        gold = (#8c6422, #d4a13f, #fad575);\n        ember = (elem.FlamePalette.flame_mid, #ffbc4a, elem.FlamePalette.ember_core);\n        tooth = (#a69474, #ded0ad, #f0e6cc);\n        eye = #ff8c2e;\n        glint = #fff9e6;\n        pupil = #1f1210;\n        snarl_red = #ff4528;\n      }\n      stamp face_neutral_p { pixels = \".ddd..ddd./kgyk..kygk/kkdk..kdkk\"; d = skin_dark; y = eye; g = glint; k = pupil; }\n      stamp face_blink_p { pixels = \"........../.ddd..ddd./kkkk..kkkk\"; d = skin_dark; k = pupil; }\n      stamp face_snarl_p { pixels = \".ddd..ddd./kyyk..kyyk/rrrr..rrrr\"; d = skin_dark; y = eye; k = pupil; r = snarl_red; }\n      stamp rune_sash { pixels = \"rrgg..../..rrrr../....rrgg/......rr\"; r = robe; g = gold; }\n\n      chart torso box { fill = robe; roughness = 0.86; grain = cloth; pattern gradient { to = char; axis = y; space = local; soft = 0.25; } pattern ao { strength = 0.45; radius = 0.9u; } face north { stamp rune_sash { at = (1px, 2px); protect = true; } } }\n      chart pelvis box { fill = char; roughness = 0.88; grain = cloth; pattern border { paint = gold; width = 1px; edges = top; } }\n      chart head box { fill = skin; roughness = 0.74; grain = soft; pattern gradient { to = skin_dark; axis = y; space = local; soft = 0.2; } pattern ao { strength = 0.4; radius = 0.8u; } }\n      chart snout box { fill = skin; roughness = 0.74; 