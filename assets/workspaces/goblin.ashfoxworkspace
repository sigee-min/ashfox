= (3u, 3u, 2u); pivot = (-4u, 26u, -1u); rotation = (0deg, 10deg, -18deg); mirror-x = ear_r; surface = skin.ear; }\n            cube ear_tip_l { origin = (-9.8u, 25.5u, -1.6u); size = (3u, 2u, 2u); pivot = (-4u, 26u, -1u); rotation = (0deg, 10deg, -22deg); mirror-x = ear_tip_r; surface = skin.ear_tip; }\n            cube mohawk_front { origin = (-1u, 29.4u, -4.5u); size = (2u, 3u, 4u); pivot = (0u, 29.4u, -2.5u); rotation = (-12deg, 0deg, 0deg); surface = skin.mohawk; }\n            cube mohawk_back { origin = (-1u, 29.4u, -0.4u); size = (2u, 3u, 4u); pivot = (0u, 29.4u, 1.5u); rotation = (16deg, 0deg, 0deg); surface = skin.mohawk; }\n          }\n          bone left_arm {\n            cube pauldron_l { origin = (-9.5u, 19.4u, -2.5u); size = (5u, 3u, 5u); pivot = (-5u, 20.4u, 0u); rotation = (0deg, 0deg, 16deg); surface = skin.pauldron; }\n            cube arm_l { origin = (-8.5u, 13.5u, -1.5u); size = (3u, 6u, 3u); surface = skin.arm; }\n            cube bracer_l { origin = (-9u, 10.5u, -2u); size = (4u, 3u, 4u); surface = skin.bracer; }\n            cube hand_l { origin = (-8.5u, 7.5u, -1.5u); size = (3u, 3u, 3u); surface = skin.hand; }\n            cube shield { origin = (-12.5u, 8u, -4.2u); size = (3u, 10u, 8u); pivot = (-10u, 13u, 0u); rotation = (0deg, -14deg, 0deg); surface = skin.shield; }\n            cube shield_boss { origin = (-13.4u, 11u, -2.2u); size = (1u, 4u, 4u); pivot = (-10u, 13u, 0u); rotation = (0deg, -14deg, 0deg); surface = skin.boss; }\n          }\n          bone right_arm {\n            cube pauldron_r { origin = (4.5u, 19.4u, -2.5u); size = (5u, 3u, 5u); pivot = (5u, 20.4u, 0u); rotation = (0deg, 0deg, -16deg); surface = skin.pauldron; }\n            cube arm_r { origin = (5.5u, 13.5u, -1.5u); size = (3u, 6u, 3u); surface = skin.arm; }\n            cube bracer_r { origin = (5u, 10.5u, -2u); size = (4u, 3u, 4u); surface = skin.bracer; }\n            cube hand_r { origin = (5.5u, 7.5u, -1.5u); size = (3u, 3u, 3u); surface = skin.hand; }\n            bone weapon {\n              cube grip { origin = (6u, 8u, -4.5u); size = (2u, 2u, 3u); surface = skin.grip; }\n              cube crossguard { origin = (4.5u, 8.5u, -5.6u); size = (5u, 1u, 1u); pivot = (7u, 9u, -5.1u); rotation = (0deg, 0deg, 22.5deg); surface = skin.crossguard; }\n              cube blade { origin = (6u, 8u, -19.2u); size = (2u, 2u, 13u); surface = skin.blade; }\n              cube blade_tip { origin = (6.5u, 8u, -22.2u); size = (1u, 2u, 3u); surface = skin.blade_tip; }\n              cube pommel { origin = (5.5u, 7.5u, 1.4u); size = (3u, 3u, 2u); surface = skin.pommel; }\n            }\n          }\n        }\n        bone left_leg {\n          cube leg_l { origin = (-4.2u, 5u, -2u); size = (4u, 5u, 4u); surface = skin.leg; }\n          cube boot_cuff_l { origin = (-4.6u, 3u, -2.5u); size = (5u, 2u, 5u); surface = skin.cuff; }\n          cube boot_l { origin = (-4.2u, 0u, -4u); size = (4u, 3u, 6u); surface = skin.boot; }\n        }\n        bone right_leg {\n          cube leg_r { origin = (0.2u, 5u, -2u); size = (4u, 5u, 4u); surface = skin.leg; }\n          cube boot_cuff_r { origin = (-0.4u, 3u, -2.5u); size = (5u, 2u, 5u); surface = skin.cuff; }\n          cube boot_r { origin = (0.2u, 0u, -4u); size = (4u, 3u, 6u); surface = skin.boot; }\n        }\n      }\n    }\n  }\n}\n"},{"path":"creatures/goblin-rig.ashfox","source":"ashfox-model 1\nmodule goblin_rig {\n  export rig contract GoblinRig {\n    handedness = right;\n    frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); }\n    joint root { parent = none; role = root; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = (rotation, scale); mirror = none; }\n    joint pelvis { parent = root; role = pelvis; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = rotation; mirror = none; }\n    joint torso { parent = pelvis; role = body; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = rotation; mirror = none; }\n    joint head { parent = torso; role = head; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = rotation; mirror = none; }\n    joint left_arm { parent = torso; role = arm; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = rotation; mirror = none; }\n    joint right_arm { parent = torso; role = arm; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = rotation; mirror = none; }\n    joint weapon { parent = right_arm; role = weapon; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = rotation; mirror = none; }\n    joint left_leg { parent = pelvis; role = leg; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = rotation; mirror = none; }\n    joint right_leg { parent = pelvis; role = leg; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = rotation; mirror = none; }\n  }\n\n  export skeleton RaiderSkeleton implements GoblinRig {\n    bind root { parent-origin = (0u, 0u, 0u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }\n    bind pelvis { parent-origin = (0u, 11u, 0u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }\n    bind torso { parent-origin = (0u, 2u, 0u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }\n    bind head { parent-origin = (0u, 10u, -1u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }\n    bind left_arm { parent-origin = (-6.5u, 6.5u, 0u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }\n    bind right_arm { parent-origin = (6.5u, 6.5u, 0u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }\n    bind weapon { parent-origin = (0u, -9.5u, -1u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }\n    bind left_leg { parent-origin = (-2u, -1u, 0u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }\n    bind right_leg { parent-origin = (2u, -1u, 0u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }\n  }\n\n  export motion idle for GoblinRig {\n    duration = 2s; fps = 20; loop = loop; rest-relative = true;\n    track pelvis.rotation {\n      key 0s = (0deg, 0deg, 0deg) catmullrom;\n      key 1s = (2deg, 0deg, 0deg) catmullrom;\n      key 2s = (0deg, 0deg, 0deg) catmullrom;\n    }\n    track torso.rotation {\n      key 0s = (0deg, 0deg, 0deg) catmullrom;\n      key 1s = (2deg, -3deg, 0deg) catmullrom;\n      key 2s = (0deg, 0deg, 0deg) catmullrom;\n    }\n    track head.rotation {\n      key 0s = (0deg, 0deg, 0deg) catmullrom;\n      key 1s = (-2deg, 5deg, 0deg) catmullrom;\n      key 2s = (0deg, 0deg, 0deg) catmullrom;\n    }\n    track right_arm.rotation {\n      key 0s = (0deg, 0deg, 0deg) catmullrom;\n      key 1s = (-4deg, 3deg, 3deg) catmullrom;\n      key 2s = (0deg, 0deg, 0deg) catmullrom;\n    }\n    track left_arm.rotation {\n      key 0s = (0deg, 0deg, 0deg) catmullrom;\n      key 1s = (4deg, -3deg, -3deg) catmullrom;\n      key 2s = (0deg, 0deg, 0deg) catmullrom;\n    }\n  }\n\n  export motion lookout for GoblinRig {\n    duration = 4s; fps = 24; loop = loop; rest-relative = true;\n    track head.rotation {\n      key 0s = (0deg, 0deg, 0deg) catmullrom;\n      key 1s = (0deg, -22deg, 2deg) catmullrom;\n      key 2s = (0deg, -22deg, 2deg) catmullrom;\n      key 3s = (-3deg, 20deg, -2deg) catmullrom;\n      key 4s = (0deg, 0deg, 0deg) catmullrom;\n    }\n    track left_arm.rotation {\n      key 0s = (0deg, 0deg, 0deg) catmullrom;\n      key 1s = (-8deg, 0deg, -8deg) catmullrom;\n      key 3s = (-8deg, 0deg, -8deg) catmullrom;\n      key 4s = (0deg, 0deg, 0deg) catmullrom;\n    }\n  }\n\n  export motion challenge for GoblinRig {\n    duration = 3s; fps = 24; loop = loop; rest-relative = true;\n    track right_arm.rotation {\n      key 0s = (0deg, 0deg, 0deg) catmullrom;\n      key 0.8s = (35deg, -8deg, 12deg) catmullrom;\n      key 1.5s = (35deg, -8deg, 12deg) catmullrom;\n      key 2.4s = (3deg, 0deg, 2deg) catmullrom;\n      key 3s = (0deg, 0deg, 0deg) catmullrom;\n    }\n    track head.rotation {\n      key 0s = (0deg, 0deg, 0deg) catmullrom;\n      key 0.8s = (2deg, -8deg, -2deg) catmullrom;\n      key 1.5s = (2deg, -8deg, -2deg) catmullrom;\n      key 2.4s = (4deg, 0deg, 0deg) catmullrom;\n      key 3s = (0deg, 0deg, 0deg) catmullrom;\n    }\n    track left_arm.rotation {\n      key 0s = (0deg, 0deg, 0deg) catmullrom;\n      key 0.8s = (8deg, 0deg, -8deg) catmullrom;\n      key 1.5s = (8deg, 0deg, -8deg) catmullrom;\n      key 3s = (0deg, 0deg, 0deg) catmullrom;\n    }\n  }\n}\n"},{"path":"creatures/goblin-surface.ashfox","source":"ashfox-model 1\nmodule goblin_surface {\n  export surface contract RaiderSkin {\n    chart torso box { coverage = opaque; }\n    chart pelvis box { coverage = opaque; }\n    chart head box { coverage = opaque; }\n    chart snout box { coverage = opaque; }\n    chart ear box { coverage = opaque; }\n    chart ear_tip box { coverage = opaque; }\n    chart arm box { coverage = opaque; }\n    chart bracer box { coverage = opaque; }\n    chart hand box { coverage = opaque; }\n    chart leg box { coverage = opaque; }\n    chart cuff box { coverage = opaque; }\n    chart boot box { coverage = opaque; }\n    chart belt box { coverage = opaque; }\n    chart buckle box { coverage = opaque; }\n    chart loincloth flat { coverage = binary; }\n    chart pauldron box { coverage = opaque; }\n    chart blade box { coverage = opaque; }\n    chart blade_tip box { coverage = opaque; }\n    chart crossguard box { coverage = opaque; }\n    chart grip box { coverage = opaque; }\n    chart pommel box { coverage = opaque; }\n    chart shield box { coverage = opaque; }\n    chart boss box { coverage = opaque; }\n    chart tusk box { coverage = opaque; }\n    chart mohawk box { coverage = opaque; }\n    material = double;\n  }\n\n  export surface raider: RaiderSkin {\n    material = double;\n    texture atlas {\n      density = 2;\n      background = void; background-alpha = 255;\n      palette {\n        void = #2a3324;\n        skin = (#3c5c22, #6f9c3b, #a7cf5e);\n        skin_dark = (#2c441a, #50752b, #7ea644);\n        leather = (#4c2c1b, #7e4b2c, #b57644);\n        leather_dark = (#362017, #593525, #84533c);\n        iron = (#4e5861, #8b98a6, #cdd7e0);\n        iron_dark = (#343b42, #5c6670, #8a95a1);\n        cloth = (#521f24, #9c3842, #d9646b);\n        brass = (#7a551c, #c99232, #f5cb64);\n        eye = #ffd94a;\n        glint = #fff9e6;\n        pupil = #211a14;\n        tooth = (#9c8b68, #d9c79b, #f8edd4);\n      }\n      stamp goblin_face {\n        pixels = \"..dddd....dddd../...dddd..dddd.../..kgyk....kygk../..kkdk....kdkk../................/....dd....dd....\";\n        d = skin_dark;\n        y = eye;\n        g = glint;\n        k = pupil;\n      }\n      stamp armor_strap {\n        pixels = \"llbb................/..llll............../....llbb............/......llii........../........iidii......./..........iiiii...../............bbll..../..............llll../................bbll\";\n        l = leather_dark;\n        b = brass;\n        i = iron;\n        d = iron_dark;\n      }\n      stamp shield_crest {\n        pixels = \"..iiii../.i....i./i..bb..i/i.bbbb.i/i..bb..i/.i....i./..iiii..\";\n        i = iron;\n        b = brass;\n      }\n\n      chart torso box {\n        fill = leather;\n        grain = soft;\n        pattern gradient { to = leather_dark; axis = y; space = local; soft = 0.2ratio; }\n        pattern ao { strength = 0.45ratio; radius = 0.9u; }\n        face north { stamp armor_strap { at = (0px, 2px); protect = true; } }\n      }\n      chart head box {\n        fill = skin;\n        grain = soft;\n        pattern gradient { to = skin_dark; axis = y; space = local; soft = 0.2ratio; }\n        pattern ao { strength = 0.4ratio; radius = 0.9u; }\n        face north { stamp goblin_face { at = (0px, 3px); protect = true; } }\n      }\n      chart blade box {\n        fill = iron;\n        grain = none;\n      }\n      chart blade_tip box {\n        fill = iron;\n        grain = none;\n      }\n      chart shield box {\n        fill = leather_dark;\n        grain = clustered;\n        pattern border { paint = iron; width = 1px; edges = all; }\n        pattern ao { strength = 0.4ratio; radius = 0.9u; }\n        face west { stamp shield_crest { at = (4px, 6px); protect = true; } }\n      }\n      chart boss box {\n        fill = iron;\n        grain = none;\n        pattern border { paint = brass; width = 1px; edges = all; }\n      }\n      chart pelvis box {\n        fill = cloth;\n        grain = soft;\n      }\n      chart belt box {\n        fill = leather_dark;\n        grain = clustered;\n      }\n      chart buckle box {\n        fill = brass;\n        grain = none;\n      }\n      chart loincloth flat {\n        coverage = 111111111111111111111111111111111111111111111111111111111111111111111111011111111110011111111110001111111100001100110011;\n        fill = cloth;\n        grain = soft;\n        pattern border { paint = brass; width = 1px; edges = top; }\n      }\n      chart boot box {\n        fill = leather_dark;\n        grain = clustered;\n      }\n      chart cuff box {\n        fill = leather;\n        grain = soft;\n      }\n      chart leg box {\n        fill = cloth;\n        grain = soft;\n        pattern gradient { to = leather_dark; axis = y; space = local; soft = 0.2ratio; }\n      }\n      chart pauldron box {\n        fill = iron_dark;\n        grain = none;\n        pattern border { paint = brass; width = 1px; edges = bottom; }\n      }\n      chart bracer box {\n        fill = iron_dark;\n        grain = none;\n      }\n      chart snout box {\n        fill = skin;\n        grain = soft;\n      }\n      chart ear box {\n        fill = skin;\n        grain = soft;\n      }\n      chart ear_tip box {\n        fill = skin_dark;\n        grain = soft;\n      }\n      chart arm box {\n        fill = skin;\n        grain = soft;\n        pattern gradient { to = skin_dark; axis = y; space = local; soft = 0.2ratio; }\n      }\n      chart hand box {\n        fill = skin_dark;\n        grain = soft;\n      }\n      chart crossguard box {\n        fill = brass;\n        grain = none;\n      }\n      chart grip box {\n        fill = leather_dark;\n        grain = soft;\n      }\n      chart pommel box {\n        fill = iron_dark;\n        grain = none;\n      }\n      chart tusk box {\n        fill = tooth;\n        grain = none;\n      }\n      chart mohawk box {\n        fill = cloth;\n        grain = clustered;\n        pattern gradient { to = brass; axis = y; space = local; soft = 0.3ratio; }\n      }\n      grain soft { seed = 44021; }\n      tone painterly;\n    }\n  }\n}\n"},{"path":"creatures/goblin.ashfox","source":"ashfox-model 1\nasset goblin {\n  import \"./goblin-rig.ashfox\" as rig;\n  import \"./goblin-surface.ashfox\" as surface;\n  import \"./goblin-body.ashfox\" as body;\n  export asset goblin {\n    settings { density = 16; forward = north; profile = creature; }\n    skeleton = rig.RaiderSkeleton;\n    motion = rig.idle;\n    motion = rig.lookout;\n    motion = rig.challenge;\n    use body.GoblinRaider as goblin { bind skeleton = rig.GoblinRig; bind skin = surface.raider; };\n  }\n}\n"}],"lock":{"compilerFingerprint":"ashfox-asset-compiler:workspace+design+anchored-pixels+parent-space-rig+typed-hir+instantiation+canonical:v1","format":"ashfox-lock","packages":[{"contentHash":"sha256:5cc3f515cc4aa3595d5c2e7f9e01d09000077a736f7d8cb9f3e87bb81f94d4ca","dependencies":[],"digest":null,"files":[{"contentHash":"sha256:dfd062e5f22d9d04f12a319c896a1e5f71da08112eb9f0b92506282ec7c4ac15","path":"creatures/goblin-body.ashfox"},{"contentHash":"sha256:e4ddc2e88d59ed58da33202711b14bed4e9f414fe203f5a2e93fe0de72038d79","path":"creatures/goblin-rig.ashfox"},{"contentHash":"sha256:1ea525c9151ca791f0b108c885a969eb691afebd5c11b73c40cad30c8bd9f9e2","path":"creatures/goblin-surface.ashfox"},{"contentHash":"sha256:47e947e30582c9fffc6ce3fe88f6dd8d280115e52a448c20a5d1f180931bfb0c","path":"creatures/goblin.ashfox"}],"interfaceHash":"sha256:dc3afe6ee7cc7375758336a95ea485979cff1c88ba9