{"files":[{"path":"assets/models/griffin_boss.ashfox","source":"ashfox 1\nmodel griffin_boss {\n  import \"std/model/rig/winged_quadruped\" as wq;\n  import \"std/core/hook/combat\" as combat_hook;\n  import \"std/core/hook/world\" as world_hook;\n  import \"griffin_plumage/plumage\" as plumage;\n\n  component GriffinBody {\n    requires rig skeleton: wq.WingedQuadrupedRig;\n    requires surface skin: plumage.GriffinPlumage;\n    bind bone root to skeleton.root;\n    bind bone torso to skeleton.torso;\n    bind bone neck to skeleton.neck;\n    bind bone head to skeleton.head;\n    bind bone wing_l to skeleton.wing_l;\n    bind bone wing_tip_l to skeleton.wing_tip_l;\n    bind bone wing_r to skeleton.wing_r;\n    bind bone wing_tip_r to skeleton.wing_tip_r;\n    bind bone foreleg_l to skeleton.foreleg_l;\n    bind bone foreleg_r to skeleton.foreleg_r;\n    bind bone hindleg_l to skeleton.hindleg_l;\n    bind bone hindleg_r to skeleton.hindleg_r;\n    bind bone tail to skeleton.tail;\n    bind bone tail_tip to skeleton.tail_tip;\n    geometry {\n      bone root {\n        bone torso {\n          cube haunch { origin = (-5u, 10u, 1u); size = (10u, 9u, 12u); surface = skin.haunch; }\n          cube chest { origin = (-6u, 10u, -8u); size = (12u, 11u, 9u); pivot = (0u, 16u, -3u); rotation = (4deg, 0deg, 0deg); surface = skin.chest; }\n          cube breast { origin = (-4u, 11u, -12u); size = (8u, 8u, 4u); pivot = (0u, 15u, -10u); rotation = (12deg, 0deg, 0deg); surface = skin.breast; }\n          cube mantle { origin = (-6u, 20.5u, -9.5u); size = (12u, 3u, 8u); pivot = (0u, 21.5u, -5.5u); rotation = (-12deg, 0deg, 0deg); surface = skin.mantle; }\n          bone neck {\n            cube neck_plume { origin = (-4.5u, 19u, -11u); size = (9u, 4u, 7u); pivot = (0u, 21u, -7.5u); rotation = (-8deg, 0deg, 0deg); surface = skin.neck_plume; }\n            bone head {\n              cube skull { origin = (-4u, 22u, -13u); size = (8u, 8u, 8u); pivot = (0u, 25u, -9u); rotation = (4deg, 0deg, 0deg); surface = skin.skull; }\n              expression_slot face {\n                origin = (-4u, 24u, -12u);\n                size = (5u, 4u);\n                u_axis = (0u, 0u, 1u);\n                v_axis = (0u, 1u, 0u);\n                placement = lateral_pair;\n                neutral = skin.face_neutral;\n                blink = skin.face_blink;\n                screech = skin.face_screech;\n              }\n              cube beak { origin = (-3u, 22.5u, -19u); size = (6u, 4u, 6u); surface = skin.beak; }\n              cube beak_tip { origin = (-2u, 21.5u, -21u); size = (4u, 3u, 2u); pivot = (0u, 23u, -19.5u); rotation = (16deg, 0deg, 0deg); surface = skin.beak_tip; }\n              cube crest_l { origin = (-4u, 29u, -9u); size = (2u, 3u, 4u); pivot = (-3u, 29u, -7u); rotation = (-16deg, 0deg, -14deg); mirror_x = crest_r; surface = skin.crest; }\n              plane crest_plume_l { origin = (-3.5u, 28u, -7u); size = (4u, 4u); u_axis = (0u, 0u, 1u); v_axis = (0u, 1u, 0u); rotation = (-12deg, 0deg, -14deg); mirror_x = crest_plume_r; surface = skin.crest_plume; }\n            }\n          }\n          bone wing_l {\n            cube shoulder_l { origin = (-13u, 19u, -5u); size = (7u, 5u, 7u); pivot = (-5u, 20u, -2u); rotation = (-20deg, 0deg, -30deg); surface = skin.shoulder; }\n            cube feather_l0 { origin = (-13u, 20u, 3u); size = (4u, 2u, 13u); pivot = (-5u, 20u, -2u); rotation = (-20deg, 0deg, -30deg); surface = skin.feather; }\n            cube tip_l0 { origin = (-13u, 20u, 16u); size = (4u, 2u, 4u); pivot = (-5u, 20u, -2u); rotation = (-20deg, 0deg, -30deg); surface = skin.feather_tip; }\n            bone wing_tip_l {\n              cube wing_arm_l { origin = (-23u, 19u, -3u); size = (10u, 4u, 6u); pivot = (-5u, 20u, -2u); rotation = (-20deg, 0deg, -30deg); surface = skin.wing_arm; }\n              cube feather_l1 { origin = (-17u, 20u, 3u); size = (4u, 2u, 13u); pivot = (-5u, 20u, -2u); rotation = (-20deg, 0deg, -30deg); surface = skin.feather; }\n              cube tip_l1 { origin = (-17u, 20u, 16u); size = (4u, 2u, 4u); pivot = (-5u, 20u, -2u); rotation = (-20deg, 0deg, -30deg); surface = skin.feather_tip; }\n              cube feather_l2 { origin = (-21u, 20u, 2u); size = (4u, 2u, 13u); pivot = (-5u, 20u, -2u); rotation = (-20deg, 0deg, -30deg); surface = skin.feather; }\n              cube tip_l2 { origin = (-21u, 20u, 15u); size = (4u, 2u, 4u); pivot = (-5u, 20u, -2u); rotation = (-20deg, 0deg, -30deg); surface = skin.feather_tip; }\n              cube feather_l3 { origin = (-25u, 20u, 1u); size = (4u, 2u, 13u); pivot = (-5u, 20u, -2u); rotation = (-20deg, 0deg, -30deg); surface = skin.feather; }\n              cube tip_l3 { origin = (-25u, 20u, 14u); size = (4u, 2u, 4u); pivot = (-5u, 20u, -2u); rotation = (-20deg, 0deg, -30deg); surface = skin.feather_tip; }\n            }\n          }\n          bone wing_r {\n            cube shoulder_r { origin = (6u, 19u, -5u); size = (7u, 5u, 7u); pivot = (5u, 20u, -2u); rotation = (-20deg, 0deg, 30deg); surface = skin.shoulder; }\n            cube feather_r0 { origin = (9u, 20u, 3u); size = (4u, 2u, 13u); pivot = (5u, 20u, -2u); rotation = (-20deg, 0deg, 30deg); surface = skin.feather; }\n            cube tip_r0 { origin = (9u, 20u, 16u); size = (4u, 2u, 4u); pivot = (5u, 20u, -2u); rotation = (-20deg, 0deg, 30deg); surface = skin.feather_tip; }\n            bone wing_tip_r {\n              cube wing_arm_r { origin = (13u, 19u, -3u); size = (10u, 4u, 6u); pivot = (5u, 20u, -2u); rotation = (-20deg, 0deg, 30deg); surface = skin.wing_arm; }\n              cube feather_r1 { origin = (13u, 20u, 3u); size = (4u, 2u, 13u); pivot = (5u, 20u, -2u); rotation = (-20deg, 0deg, 30deg); surface = skin.feather; }\n              cube tip_r1 { origin = (13u, 20u, 16u); size = (4u, 2u, 4u); pivot = (5u, 20u, -2u); rotation = (-20deg, 0deg, 30deg); surface = skin.feather_tip; }\n              cube feather_r2 { origin = (17u, 20u, 2u); size = (4u, 2u, 13u); pivot = (5u, 20u, -2u); rotation = (-20deg, 0deg, 30deg); surface = skin.feather; }\n              cube tip_r2 { origin = (17u, 20u, 15u); size = (4u, 2u, 4u); pivot = (5u, 20u, -2u); rotation = (-20deg, 0deg, 30deg); surface = skin.feather_tip; }\n              cube feather_r3 { origin = (21u, 20u, 1u); size = (4u, 2u, 13u); pivot = (5u, 20u, -2u); rotation = (-20deg, 0deg, 30deg); surface = skin.feather; }\n              cube tip_r3 { origin = (21u, 20u, 14u); size = (4u, 2u, 4u); pivot = (5u, 20u, -2u); rotation = (-20deg, 0deg, 30deg); surface = skin.feather_tip; }\n            }\n          }\n          bone foreleg_l {\n            cube foreleg_l { origin = (-5u, 3u, -9u); size = (3u, 8u, 3u); pivot = (-3.5u, 10u, -7.5u); rotation = (-5deg, 0deg, 0deg); surface = skin.foreleg; }\n            cube forefoot_l { origin = (-6u, 1u, -12u); size = (5u, 2u, 5u); surface = skin.forefoot; }\n            cube talon_l0 { origin = (-6u, 0u, -16u); size = (2u, 2u, 4u); surface = skin.talon; }\n            cube talon_l1 { origin = (-3u, 0u, -16u); size = (2u, 2u, 4u); surface = skin.talon; }\n          }\n          bone foreleg_r {\n            cube foreleg_r { origin = (2u, 3u, -9u); size = (3u, 8u, 3u); pivot = (3.5u, 10u, -7.5u); rotation = (-5deg, 0deg, 0deg); surface = skin.foreleg; }\n            cube forefoot_r { origin = (1u, 1u, -12u); size = (5u, 2u, 5u); surface = skin.forefoot; }\n            cube talon_r0 { origin = (1u, 0u, -16u); size = (2u, 2u, 4u); surface = skin.talon; }\n            cube talon_r1 { origin = (4u, 0u, -16u); size = (2u, 2u, 4u); surface = skin.talon; }\n          }\n          bone hindleg_l {\n            cube hind_thigh_l { origin = (-6.5u, 6u, 7u); size = (4u, 7u, 6u); pivot = (-4.5u, 12u, 10u); rotation = (-10deg, 0deg, 0deg); surface = skin.hind_thigh; }\n            cube hind_shin_l { origin = (-6.5u, 2u, 9u); size = (3u, 4u, 3u); surface = skin.hind_shin; }\n            cube hind_paw_l { origin = (-7u, 0u, 6u); size = (5u, 2u, 6u); surface = skin.hind_paw; }\n            cube hind_claw_l0 { origin = (-7u, 0u, 2u); size = (2u, 2u, 4u); surface = skin.talon; }\n            cube hind_claw_l1 { origin = (-4u, 0u, 2u); size = (2u, 2u, 4u); surface = skin.talon; }\n          }\n          bone hindleg_r {\n            cube hind_thigh_r { origin = (2.5u, 6u, 7u); size = (4u, 7u, 6u); pivot = (4.5u, 12u, 10u); rotation = (-10deg, 0deg, 0deg); surface = skin.hind_thigh; }\n            cube hind_shin_r { origin = (3.5u, 2u, 9u); size = (3u, 4u, 3u); surface = skin.hind_shin; }\n            cube hind_paw_r { origin = (2u, 0u, 6u); size = (5u, 2u, 6u); surface = skin.hind_paw; }\n            cube hind_claw_r0 { origin = (2u, 0u, 2u); size = (2u, 2u, 4u); surface = skin.talon; }\n            cube hind_claw_r1 { origin = (5u, 0u, 2u); size = (2u, 2u, 4u); surface = skin.talon; }\n          }\n          bone tail {\n            cube tail_base { origin = (-1.5u, 12u, 13u); size = (3u, 3u, 9u); pivot = (0u, 13.5u, 13u); rotation = (-10deg, 0deg, 0deg); surface = skin.tail_base; }\n            bone tail_tip {\n              cube tail_rise { origin = (-1u, 12u, 21u); size = (2u, 5u, 2u); pivot = (0u, 14u, 22u); rotation = (18deg, 0deg, 0deg); surface = skin.tail_rise; }\n              cube tail_tuft { origin = (-2u, 17u, 21u); size = (4u, 5u, 4u); surface = skin.tail_tuft; }\n            }\n          }\n        }\n      }\n    }\n  }\n\n  motion idle for wq.WingedQuadrupedRig {\n    duration = 3s; fps = 14; loop = loop; rest_relative = true;\n    track torso.position { key 0s = (0u, 0u, 0u) smooth; key 1.3s = (0u, -0.45u, 0u) ease_in_out; key 3s = (0u, 0u, 0u) ease_out; }\n    track torso.rotation { key 0s = (0deg, 0deg, 0deg) smooth; key 1.4s = (3deg, 0deg, 0deg) ease_in_out; key 3s = (0deg, 0deg, 0deg) ease_out; }\n    track head.rotation { key 0s = (0deg, 0deg, 0deg) smooth; key 1.4s = (-3deg, 7deg, 0deg) ease_in_out; key 3s = (0deg, 0deg, 0deg) ease_out; }\n    track wing_l.rotation { key 0s = (0deg, 0deg, 0deg) smooth; key 1.4s = (0deg, 0deg, -6deg) ease_in_out; key 3s = (0deg, 0deg, 0deg) ease_out; }\n    track wing_r.rotation { key 0s = (0deg, 0deg, 0deg) smooth; key 1.4s = (0deg, 0deg, 6deg) ease_in_out; key 3s = (0deg, 0deg, 0deg) ease_out; }\n    track tail.rotation { key 0s = (0deg, 0deg, 0deg) smooth; key 1.4s = (2deg, 9deg, 0deg) ease_in_out; key 3s = (0deg, 0deg, 0deg) ease_out; }\n    expression face { at 0s = neutral; at 1.9s..2.05s = blink; }\n    wave torso.rotation.x = breath(3s, inhale = 0.42) * 2.5deg;\n    secondary chain tail_chain { stiffness = 14; damping = 0.34; gravity = 0.25; }\n  }\n\n  motion wing_display for wq.WingedQuadrupedRig {\n    duration = 2.4s; fps = 14; loop = loop; rest_relative = true;\n    track torso.position { key 0s = (0u, 0u, 0u) smooth; key 0.8s = (0u, 0.8u, -0.4u) ease_out; key 1.6s = (0u, 0.8u, -0.4u) smooth; key 2.4s = (0u, 0u, 0u) ease_in_out; }\n    track wing_l.rotation { key 0s = (0deg, 0deg, 0deg) smooth; key 0.8s = (0deg, 0deg, -28deg) anticipate(0.2); key 1.6s = (0deg, 0deg, -28deg) smooth; key 2.4s = (0deg, 0deg, 0deg) ease_out; }\n    track wing_r.rotation { key 0s = (0deg, 0deg, 0deg) smooth; key 0.8s = (0deg, 0deg, 28deg) anticipate(0.2); key 1.6s = (0deg, 0deg, 28deg) smooth; key 2.4s = (0deg, 0deg, 0deg) ease_out; }\n    track head.rotation { key 0s = (0deg, 0deg, 0deg) smooth; key 0.8s = (-10deg, 0deg, 0deg) ease_out; key 1.6s = (-10deg, 0deg, 0deg) smooth; key 2.4s = (0deg, 0deg, 0deg) ease_out; }\n    expression face { at 0s = neutral; at 0.7s..1.7s = screech; }\n    secondary chain tail_chain { stiffness = 14; damping = 0.34; gravity = 0.2; }\n    cue 0.8s sound \"griffin_call\" at beak;\n  }\n\n  motion wing_flap for wq.WingedQuadrupedRig {\n    duration = 0.8s; fps = 15; loop = loop; rest_relative = true;\n    wave wing_l.rotation.z = flap(0.8s, down_ratio = 0.38, com_lift = 1.4u) * -24deg;\n    wave wing_r.rotation.z = flap(0.8s, down_ratio = 0.38) * 24deg;\n    wave head.rotation.x = breath(0.8s, inhale = 0.38) * -4deg;\n    secondary chain tail_chain { stiffness = 16; damping = 0.32; gravity = 0.22; }\n  }\n\n  settings { density = 16; forward = north; profile = creature; }\n  skeleton = wq.WingedQuadrupedSkeleton;\n  motions = [idle, wing_display, wing_flap];\n  use GriffinBody as griffin { skeleton = wq.WingedQuadrupedRig; skin = plumage.boss_plumage; }\n\n  anchor boss_spawn : world_hook.SpawnPoint { bone = root; kind = creature; radius = 6.0; tag = \"griffin_boss\"; }\n  cue wing_gust : combat_hook.HitboxArc { clip = wing_display; at = 0.8s..1.4s; arc_deg = 160deg; reach = 28u; damage = 28; damage_type = blunt; }\n  meta boss_ai : combat_hook.CombatStateMeta { aggro_range = 28.0; leash_range = 64.0; attack_cooldown = 2.0s; }\n}\n"},{"path":"assets/module/griffin/griffin_plumage.ashfox","source":"ashfox 1\nmodule griffin_plumage {\n  export surface contract GriffinPlumage {\n    chart haunch box { coverage = opaque; }\n    chart chest box { coverage = opaque; }\n    chart breast box { coverage = opaque; }\n    chart mantle box { coverage = opaque; }\n    chart neck_plume box { coverage = opaque; }\n    chart skull box { coverage = opaque; }\n    chart beak box { coverage = opaque; }\n    chart beak_tip box { coverage = opaque; }\n    chart crest box { coverage = opaque; }\n    chart crest_plume flat { coverage = binary; }\n    chart foreleg box { coverage = opaque; }\n    chart forefoot box { coverage = opaque; }\n    chart talon box { coverage = opaque; }\n    chart hind_thigh box { coverage = opaque; }\n    chart hind_shin box { coverage = opaque; }\n    chart hind_paw box { coverage = opaque; }\n    chart shoulder box { coverage = opaque; }\n    chart wing_arm box { coverage = opaque; }\n    chart feather box { coverage = opaque; }\n    chart feather_tip box { coverage = opaque; }\n    chart tail_base box { coverage = opaque; }\n    chart tail_rise box { coverage = opaque; }\n    chart tail_tuft box { coverage = opaque; }\n    chart face_neutral flat { coverage = opaque; }\n    chart face_blink flat { coverage = opaque; }\n    chart face_screech flat { coverage = opaque; }\n    material = double;\n  }\n\n  export surface boss_plumage: GriffinPlumage {\n    material = double;\n    texture atlas {\n      density = 2;\n      background = void;\n      background_alpha = 0;\n      palette {\n        void = #000000;\n        gold = (#8a5b26, #c99142, #f0c475);\n        gold_deep = (#6e481e, #9c682d, #c99142);\n        ivory = (#969184, #cfc9b6, #eae3d2);\n        ivory_mid = (#747066, #a8a395, #d1cbb9);\n        beak = (#945c22, #e0a43a, #ffd66e);\n        feather = (#6d5e4e, #b8aa92, #e5dac3);\n        dark = (#323740, #4e5561, #7d8591);\n        steel_claw = (#6a7380, #9da8b8, #d2dce8);\n        eye = #223b40;\n        brow = #665848;\n        gleam = #58dec8;\n      }\n      stamp eye_neutral { pixels = \"bbbbbb/bbbbbb/eeeeee/eeggee\"; b = brow; e = eye; g = gleam; }\n      stamp eye_blink { pixels = \"....../bbbbbb/mmmmmm/......\"; b = brow; m = ivory_mid; }\n      stamp eye_screech { pixels = \"bbbbbb/.bbbb./gggggg/eeggee\"; b = brow; e = eye; g = gleam; }\n      stamp breast_crest { pixels = \"gggggg/.gggg./.mggm./..mm..\"; g = gold; m = ivory_mid; }\n\n      chart haunch box { fill = gold; roughness = 0.72; metallic = 0.12; grain = soft; pattern gradient { from = gold_deep; to = gold; axis = y; space = model; soft = 0.12; } pattern ao { strength = 0.35; radius = 0.7u; } }\n      chart chest box { fill = ivory; roughness = 0.78; grain = soft; pattern gradient { from = ivory_mid; to = ivory; axis = y; space = local; soft = 0.12; } pattern border { paint = ivory_mid; width = 1px; edges = bottom; } pattern ao { strength = 0.35; radius = 0.7u; } }\n      chart breast box { fill = ivory; roughness = 0.74; grain = soft; pattern ao { strength = 0.35; radius = 0.7u; } face north { stamp breast_crest { at = (5px, 5px); protect = true; } } }\n      chart mantle box { fill = ivory_mid; roughness = 0.78; grain = soft; pattern border { paint = gold; width = 1px; edges = bottom; } pattern ao { strength = 0.35; radius = 0.7u; } }\n      chart neck_plume box { fill = ivory; roughness = 0.78; grain = soft; pattern gradient { from = ivory_mid; to = ivory; axis = y; space = local; soft = 0.2; } pattern ao { strength = 0.35; radius = 0.7u; } }\n      chart skull box { fill = ivory; roughness = 0.76; grain = soft; pattern border { paint = feather; width = 1px; edges = bottom; } pattern ao { strength = 0.35; radius = 0.7u; } }\n      chart beak box { fill = beak; roughness = 0.30; metallic = 0.25; grain = none; pattern gradient { from = gold_deep; to = beak; axis = y; space = local; soft = 0.12; } pattern border { paint = gold_deep; width = 1px; edges = bottom; } }\n      chart beak_tip box { fill = beak; roughness = 0.26; metallic = 0.35; grain = none; pattern border { paint = dark; width = 1px; edges = bottom; } }\n      chart crest box { fill = ivory; roughness = 0.75; grain = soft; pattern gradient { to = feather; axis = y; space = local; soft = 0.25; } pattern border { paint = dark; width = 1px; edges = top; } }\n      chart crest_plume flat { fill = feather; coverage = 0000110000011110001111100111111111111110111111001111100011100000; roughness = 0.78; grain = soft; pattern gradient { to = ivory; axis = y; space = local; soft = 0.25; } }\n      chart foreleg box { fill = beak; roughness = 0.42; grain = none; pattern gradient { from = gold_deep; to = beak; axis = y; space = model; soft = 0.12; } pattern ao { strength = 0.45; radius = 1u; } }\n      chart forefoot box { fill = beak; roughness = 0.42; grain = none; pattern border { paint = gold_deep; width = 1px; edges = bottom; } pattern ao { strength = 0.45; radius = 1u; } }\n      chart talon box { fill = steel_claw; roughness = 0.26; metallic = 0.78; roughness_variation = 0.06; grain = brushed; pattern border { paint = dark; width = 1px; edges = top; } }\n      chart hind_thigh box { fill = gold; roughness = 0.72; grain = none; pattern gradient { from = gold_deep; to = gold; axis = y; space = model; soft = 0.12; } pattern ao { strength = 0.45; radius = 1u; } }\n      chart hind_shin box { fill = gold_deep; roughness = 0.74; grain = none; pattern gradient { from = gold_deep; to = gold; axis = y; space = model; soft = 0.12; } pattern ao { strength = 0.45; radius = 1u; } }\n      chart hind_paw box { fill = gold; roughness = 0.74; grain = none; pattern border { paint = gold_deep; width = 1px; edges = bottom; } pattern ao { strength = 0.45; radius = 1u; } }\n      chart shoulder box { fill = ivory; roughness = 0.76; grain = soft; pattern border { paint = gold; width = 1px; edges = bottom; } pattern ao { strength = 0.35; radius = 0.7u; } }\n      chart wing_arm box { fill = ivory_mid; roughness = 0.76; grain = none; pattern ao { strength = 0.35; radius = 0.7u; } }\n      chart feather box { fill = feather; roughness = 0.80; grain = soft; pattern border { paint = ivory_mid; width = 1px; edges = top; } pattern ao { strength = 0.35; radius = 0.7u; } }\n      chart feather_tip box { fill = dark; roughness = 0.68; grain = none; pattern gradient { to = steel_claw; axis = y; space = local; soft = 0.25; } pattern border { paint = feather; width = 1px; edges = top; } }\n      chart tail_base box { fill = gold; roughness = 0.72; grain = none; pattern gradient { from = gold_deep; to = gold; axis = y; space = local; soft = 0.12; } pattern ao { strength = 0.45; radius = 1u; } }\n      chart tail_rise box { fill = gold; roughness = 0.72; grain = none; pattern gradient { from = gold_deep; to = gold; axis = y; space = local; soft = 0.12; } }\n      chart tail_tuft box { fill = dark; roughness = 0.78; grain = soft; pattern gradient { to = feather; axis = y; space = local; soft = 0.25; } pattern border { paint = gold; width = 1px; edges = bottom; } }\n      chart face_neutral flat { fill = ivory; stamp eye_neutral { at = (2px, 2px); protect = true; } }\n      chart face_blink flat { fill = ivory; stamp eye_blink { at = (2px, 2px); protect = true; } }\n      chart face_screech flat { fill = ivory; stamp eye_screech { at = (2px, 2px); protect = true; } }\n\n      grain soft { seed = 7319; }\n      tone painterly;\n    }\n  }\n}\n"},{"path":"library/std/core/hook/combat.ashfox","source":"ashfox 1\nmodule combat {\n  export schema HitboxArc : cue {\n    field arc_deg : deg(10..360) = 110deg;\n    field reach : unit = 16u;\n    field damage : float(0..1000) = 12;\n    field knockback : float(0..10) = 0.45;\n    field damage_type : enum(slash, pierce, blunt, fire, shock, arcane) = slash;\n    field trigger_time : second = 0.15s;\n  }\n\n  export schema HurtboxZone : volume {\n    field armor_scale : float(0..5) = 1.0;\n    field weakpoint : bool = false;\n    field element_resist : enum(none, fire, frost, shock, arcane) = none;\n  }\n\n  export schema ProjectileMuzzle : anchor {\n    field projectile_id : string;\n    field speed : float(0..120) = 24.0;\n    field spread_deg : deg(0..45) = 2deg;\n    field gravity : float(0..30) = 9.8;\n    field sfx : string = \"\";\n  }\n\n  export schema CombatStateMeta : meta {\n    field aggro_range : float(1..128) = 18.0;\n    field leash_range : float(2..256) = 40.0;\n    field attack_cooldown : second = 1.2s;\n  }\n}\n"},{"path":"library/std/core/hook/loot.ashfox","source":"ashfox 1\nmodule loot {\n  export schema LootChest : anchor {\n    field table : string;\n    field tier : enum(common, uncommon, rare, epic, mythic) = common;\n    field min_rolls : int(1..16) = 1;\n    field max_rolls : int(1..32) = 3;\n    field facing : enum(north, south, east, west) = south;\n    field locked : bool = false;\n    mc_block = \"minecraft:chest[facing=${facing}]\";\n  }\n\n  export schema ItemDrop : anchor {\n    field item_id : string;\n    field chance : float(0..1) = 0.5;\n    field count : int(1..64) = 1;\n    field offset : vec3 = (0, 0.25, 0);\n  }\n\n  export schema HarvestingNode : anchor {\n    field resource : enum(ore, herb, timber, crystal, relic) = ore;\n    field tool_tier : int(0..5) = 1;\n    field respawn : second = 180s;\n    field prefab_id : string = \"\";\n  }\n\n  export schema DropTableMeta : meta {\n    field table_id : string;\n    field luck_bonus : float(0..5) = 0.2;\n    field unique_once : bool = false;\n  }\n}\n"},{"path":"library/std/core/hook/world.ashfox","source":"ashfox 1\nmodule world {\n  export schema SpawnPoint : anchor {\n    field kind : enum(player, npc, creature, patrol) = creature;\n    field radius : float(0..64) = 4.0;\n    field weight : float(0..100) = 1.0;\n    field respawn_delay : second = 60s;\n    field tag : string = \"\";\n  }\n\n  export schema PortalGate : anchor {\n    field target_world : string;\n    field destination : string;\n    field facing : enum(north, south, east, west) = north;\n    field locked : bool = false;\n    mc_block = \"minecraft:stone_brick_stairs[facing=${facing}]\";\n  }\n\n  export schema SafeZone : volume {\n    field pvp_disabled : bool = true;\n    field regen_rate : float(0..10) = 0.5;\n    field label : string = \"\";\n  }\n\n  export schema AmbientZone : volume {\n    field cue_id : string;\n    field reverb : enum(none, hall, cavern, outdoor) = outdoor;\n    field blend_radius : float(0..32) = 6.0;\n  }\n\n  export schema PatrolRoute : meta {\n    field route_id : string;\n    field speed : float(0..12) = 1.8;\n    field pause : second = 2s;\n    field loop : bool = true;\n  }\n}\n"},{"path":"library/std/core/material/metal.ashfox","source":"ashfox 1\nmodule metal {\n  export design MetalParams {\n    iron_shadow: color = #3b424a;\n    iron_base: color = #727e8a;\n    iron_light: color = #b0bcc7;\n    gold_shadow: color = #75531d;\n    gold_base: color = #bd8b34;\n    gold_light: color = #ebbf63;\n    copper_shadow: color = #693724;\n    copper_base: color = #b05c3d;\n    copper_light: color = #de8864;\n    metallic: ratio = 0.88;\n    roughness: ratio = 0.34;\n    normal_strength: ratio = 0.35;\n    edge_wear: ratio = 0.35;\n  }\n\n  export surface contract MetalSurface {\n    chart plate box { coverage = opaque; }\n    chart rivet box { coverage = opaque; }\n    material = double;\n  }\n\n  export surface forged_iron: MetalSurface {\n    material double {\n      roughness = 0.34;\n      metallic = 0.88;\n      roughness_variation = 0.10;\n      normal_strength = 0.35;\n      edge_wear = 0.35;\n    }\n    texture atlas {\n      density = 2;\n      background = void; background_alpha = 255;\n      palette {\n        void = #2a3038;\n        iron = (#3b424a, #727e8a, #b0bcc7);\n        rivet = (#4d555e, #8a95a1, #c7d1db);\n      }\n      chart plate box {\n        fill = iron;\n        grain = brushed;\n        pattern gradient { to = rivet; axis = y; space = local; soft = 0.2; }\n        pattern ao { strength = 0.45; radius = 0.8u; }\n      }\n      chart rivet box {\n        fill = rivet;\n        normal_strength = 0.45;\n        edge_wear = 0.40;\n        pattern border { paint = iron; width = 1px; }\n      }\n    }\n  }\n}\n"},{"path":"library/std/core/material/stone.ashfox","source":"ashfox 1\nmodule stone {\n  export design StoneParams {\n    cobble_shadow: color = #3d4047;\n    cobble_base: color = #686d78;\n    cobble_light: color = #989ea8;\n    basalt_shadow: color = #262930;\n    basalt_base: color = #414652;\n    basalt_light: color = #636978;\n    sandstone_shadow: color = #7d6847;\n    sandstone_base: color = #b59a6e;\n    sandstone_light: color = #dec699;\n    roughness: ratio = 0.82;\n    wear: ratio = 0.25;\n    normal_strength: ratio = 0.48;\n    edge_wear: ratio = 0.25;\n  }\n\n  export surface contract StoneSurface {\n    chart block box { coverage = opaque; }\n    chart trim box { coverage = opaque; }\n    material = opaque;\n  }\n\n  export surface dressed_stone: StoneSurface {\n    material opaque {\n      roughness = 0.82;\n      metallic = 0.0;\n      roughness_variation = 0.12;\n      normal_strength = 0.48;\n      edge_wear = 0.25;\n    }\n    texture atlas {\n      density = 2;\n      background = void; background_alpha = 255;\n      palette {\n        void = #282b30;\n        stone = (#3d4047, #686d78, #989ea8);\n        trim = (#4c5059, #7d838f, #adb3bf);\n      }\n      chart block box {\n        fill = stone;\n        grain = clustered;\n        pattern blotch { paint = trim; scale = (2px, 2px, 2px); density = 0.3; phase = 0; }\n        pattern ao { strength = 0.48; radius = 0.8u; }\n      }\n      chart trim box {\n        fill = trim;\n        pattern border { paint = stone; width = 1px; }\n      }\n    }\n  }\n}\n"},{"path":"library/std/core/material/wood.ashfox","source":"ashfox 1\nmodule wood {\n  export design WoodParams {\n    oak_shadow: color = #4a3121;\n    oak_base: color = #7d5538;\n    oak_light: color = #ad7c55;\n    spruce_shadow: color = #332219;\n    spruce_base: color = #593b2b;\n    spruce_light: color = #825a43;\n    birch_shadow: color = #8c7a5b;\n    birch_base: color = #bfaa82;\n    birch_light: color = #e3d2ae;\n    roughness: ratio = 0.68;\n    grain_depth: ratio = 0.32;\n    normal_strength: ratio = 0.36;\n    edge_wear: ratio = 0.15;\n  }\n\n  export surface contract WoodSurface {\n    chart plank box { coverage = opaque; }\n    chart bark box { coverage = opaque; }\n    material = opaque;\n  }\n\n  export surface oak_timber: WoodSurface {\n    material opaque {\n      roughness = 0.68;\n      metallic = 0.0;\n      roughness_variation = 0.10;\n      normal_strength = 0.36;\n      edge_wear = 0.15;\n    }\n    texture atlas {\n      density = 2;\n      background = void; background_alpha = 255;\n      palette {\n        void = #332219;\n        oak = (#4a3121, #7d5538, #ad7c55);\n        bark = (#2e2119, #4d382a, #70533f);\n      }\n      chart plank box {\n        fill = oak;\n        grain = wood;\n        pattern stripe { paint = bark; axis = x; period = 4px; width = 1px; }\n        pattern ao { strength = 0.4; radius = 0.7u; }\n      }\n      chart bark box {\n        fill = bark;\n        grain = wood;\n        pattern blotch { paint = oak; scale = (2px, 2px, 2px); density = 0.35; phase = 0; }\n      }\n    }\n  }\n}\n"},{"path":"library/std/core/palette/element.ashfox","source":"ashfox 1\nmodule element {\n  export design FlamePalette {\n    ember_core: color = #fff1b8;\n    flame_mid: color = #eb7a28;\n    flame_edge: color = #9e2d1b;\n    char_smoke: color = #3a2b29;\n  }\n\n  export design FrostPalette {\n    ice_core: color = #dcf7fc;\n    frost_mid: color = #6bc8e3;\n    glacier_edge: color = #3469a6;\n    mist_shadow: color = #273854;\n  }\n\n  export design StormPalette {\n    arc_core: color = #f2f8ff;\n    bolt_mid: color = #7eb5ff;\n    thunder_edge: color = #4155a8;\n    cloud_shadow: color = #2b2f45;\n  }\n\n  export design ArcanePalette {\n    glyph_core: color = #f7dcff;\n    ether_mid: color = #c068f0;\n    void_edge: color = #632ea1;\n    astral_shadow: color = #2d1f47;\n  }\n}\n"},{"path":"library/std/core/palette/medieval.ashfox","source":"ashfox 1\nmodule medieval {\n  export design CastleStone {\n    limestone_shadow: color = #484c54;\n    limestone_base: color = #7c828c;\n    limestone_light: color = #adb3bd;\n    slate_shadow: color = #2d323b;\n    slate_base: color = #4d5563;\n    slate_light: color = #757f91;\n    mortar_base: color = #9da097;\n    moss_accent: color = #4f7343;\n  }\n\n  export design GuildTimber {\n    oak_shadow: color = #4a3222;\n    oak_base: color = #7a5438;\n    oak_light: color = #a67853;\n    walnut_shadow: color = #33231c;\n    walnut_base: color = #573d31;\n    walnut_light: color = #7d5b49;\n    parchment_base: color = #d9c8a9;\n    wax_seal: color = #9e312b;\n  }\n\n  export design HeraldryBanner {\n    crimson_shadow: color = #5c1f24;\n    crimson_base: color = #99323a;\n    crimson_light: color = #cc525a;\n    cobalt_shadow: color = #213254;\n    cobalt_base: color = #36528a;\n    cobalt_light: color = #5778b8;\n    gold_trim: color = #cfa042;\n    ivory_crest: color = #e3dac8;\n  }\n}\n"},{"path":"library/std/model/motion/combat.ashfox","source":"ashfox 1\nmodule combat {\n  import \"std/model/rig/biped\" as biped;\n\n  export motion slash for biped.BipedRig {\n    duration = 0.7s; fps = 30; loop = once;\n    track torso.rotation {\n      key 0s = (0deg, 0deg, 0deg) catmullrom;\n      key 0.2s = (-6deg, -22deg, 0deg) catmullrom;\n      key 0.45s = (10deg, 28deg, 0deg) catmullrom;\n      key 0.7s = (0deg, 0deg, 0deg) catmullrom;\n    }\n    track right_arm.rotation {\n      key 0s = (0deg, 0deg, 0deg) catmullrom;\n      key 0.2s = (-85deg, -20deg, 25deg) catmullrom;\n      key 0.45s = (55deg, 28deg, -35deg) catmullrom;\n      key 0.7s = (0deg, 0deg, 0deg) catmullrom;\n    }\n    track weapon.rotation {\n      key 0s = (0deg, 0deg, 0deg) linear;\n      key 0.45s = (20deg, 0deg, 0deg) linear;\n      key 0.7s = (0deg, 0deg, 0deg) linear;\n    }\n  }\n\n  export motion thrust for biped.BipedRig {\n    duration = 0.6s; fps = 30; loop = once;\n    track torso.rotation {\n      key 0s = (0deg, 0deg, 0deg) catmullrom;\n      key 0.15s = (4deg, -18deg, 0deg) catmullrom;\n      key 0.35s = (8deg, 14deg, 0deg) catmullrom;\n      key 0.6s = (0deg, 0deg, 0deg) catmullrom;\n    }\n    track right_arm.rotation {\n      key 0s = (0deg, 0deg, 0deg) catmullrom;\n      key 0.15s = (28deg, 0deg, 0deg) catmullrom;\n      key 0.35s = (-82deg, 0deg, 0deg) catmullrom;\n      key 0.6s = (0deg, 0deg, 0deg) catmullrom;\n    }\n  }\n\n  export motion guard for biped.BipedRig {\n    duration = 1s; fps = 24; loop = loop;\n    track left_arm.rotation {\n      key 0s = (-48deg, 32deg, 0deg) linear;\n      key 0.5s = (-52deg, 34deg, 0deg) linear;\n      key 1s = (-48deg, 32deg, 0deg) linear;\n    }\n    track torso.rotation {\n      key 0s = (4deg, -16deg, 0deg) linear;\n      key 0.5s = (6deg, -16deg, 0deg) linear;\n      key 1s = (4deg, -16deg, 0deg) linear;\n    }\n  }\n}\n"},{"path":"library/std/model/motion/idle.ashfox","source":"ashfox 1\nmodule idle {\n  import \"std/model/rig/biped\" as biped;\n  import \"std/model/rig/quadruped\" as quad;\n\n  export motion biped_idle for biped.BipedRig {\n    duration = 2s; fps = 20; loop = loop;\n    track pelvis.rotation {\n      key 0s = (0deg, 0deg, 0deg) catmullrom;\n      key 1s = (1.5deg, 0deg, 0deg) catmullrom;\n      key 2s = (0deg, 0deg, 0deg) catmullrom;\n    }\n    track torso.rotation {\n      key 0s = (0deg, 0deg, 0deg) catmullrom;\n      key 1s = (2deg, -2deg, 0deg) catmullrom;\n      key 2s = (0deg, 0deg, 0deg) catmullrom;\n    }\n    track head.rotation {\n      key 0s = (0deg, 0deg, 0deg) catmullrom;\n      key 1s = (-2deg, 4deg, 0deg) catmullrom;\n      key 2s = (0deg, 0deg, 0deg) catmullrom;\n    }\n    track left_arm.rotation {\n      key 0s = (0deg, 0deg, 2deg) catmullrom;\n      key 1s = (3deg, 0deg, 4deg) catmullrom;\n      key 2s = (0deg, 0deg, 2deg) catmullrom;\n    }\n    track right_arm.rotation {\n      key 0s = (0deg, 0deg, -2deg) catmullrom;\n      key 1s = (-3deg, 0deg, -4deg) catmullrom;\n      key 2s = (0deg, 0deg, -2deg) catmullrom;\n    }\n  }\n\n  export motion quad_idle for quad.QuadrupedRig {\n    duration = 2.4s; fps = 20; loop = loop;\n    track body.rotation {\n      key 0s = (0deg, 0deg, 0deg) linear;\n      key 1.2s = (1.5deg, 0deg, 0deg) linear;\n      key 2.4s = (0deg, 0deg, 0deg) linear;\n    }\n    track head.rotation {\n      key 0s = (0deg, 0deg, 0deg) catmullrom;\n      key 1.2s = (-3deg, 6deg, 0deg) catmullrom;\n      key 2.4s = (0deg, 0deg, 0deg) catmullrom;\n    }\n    track tail.rotation {\n      key 0s = (0deg, -6deg, 0deg) catmullrom;\n      key 1.2s = (0deg, 6deg, 0deg) catmullrom;\n      key 2.4s = (0deg, -6deg, 0deg) catmullrom;\n    }\n  }\n}\n"},{"path":"library/std/model/motion/locomotion.ashfox","source":"ashfox 1\nmodule locomotion {\n  import \"std/model/rig/biped\" as biped;\n  import \"std/model/rig/quadruped\" as quad;\n  import \"std/model/rig/winged\" as winged;\n\n  export motion biped_walk for biped.BipedRig {\n    duration = 1.2s; fps = 24; loop = loop;\n    track pelvis.position {\n      key 0s = (0u, 0u, 0u) catmullrom;\n      key 0.3s = (0u, 0.8u, 0u) catmullrom;\n      key 0.6s = (0u, 0u, 0u) catmullrom;\n      key 0.9s = (0u, 0.8u, 0u) catmullrom;\n      key 1.2s = (0u, 0u, 0u) catmullrom;\n    }\n    track left_leg.rotation {\n      key 0s = (24deg, 0deg, 0deg) catmullrom;\n      key 0.6s = (-24deg, 0deg, 0deg) catmullrom;\n      key 1.2s = (24deg, 0deg, 0deg) catmullrom;\n    }\n    track right_leg.rotation {\n      key 0s = (-24deg, 0deg, 0deg) catmullrom;\n      key 0.6s = (24deg, 0deg, 0deg) catmullrom;\n      key 1.2s = (-24deg, 0deg, 0deg) catmullrom;\n    }\n    track left_arm.rotation {\n      key 0s = (-18deg, 0deg, 2deg) catmullrom;\n      key 0.6s = (18deg, 0deg, 2deg) catmullrom;\n      key 1.2s = (-18deg, 0deg, 2deg) catmullrom;\n    }\n    track right_arm.rotation {\n      key 0s = (18deg, 0deg, -2deg) catmullrom;\n      key 0.6s = (-18deg, 0deg, -2deg) catmullrom;\n      key 1.2s = (18deg, 0deg, -2deg) catmullrom;\n    }\n  }\n\n  export motion biped_run for biped.BipedRig {\n    duration = 0.8s; fps = 30; loop = loop;\n    track torso.rotation {\n      key 0s = (12deg, -4deg, 0deg) catmullrom;\n      key 0.4s = (12deg, 4deg, 0deg) catmullrom;\n      key 0.8s = (12deg, -4deg, 0deg) catmullrom;\n    }\n    track left_leg.rotation {\n      key 0s = (38deg, 0deg, 0deg) catmullrom;\n      key 0.4s = (-38deg, 0deg, 0deg) catmullrom;\n      key 0.8s = (38deg, 0deg, 0deg) catmullrom;\n    }\n    track right_leg.rotation {\n      key 0s = (-38deg, 0deg, 0deg) catmullrom;\n      key 0.4s = (38deg, 0deg, 0deg) catmullrom;\n      key 0.8s = (-38deg, 0deg, 0deg) catmullrom;\n    }\n  }\n\n  export motion quad_trot for quad.QuadrupedRig {\n    duration = 1s; fps = 24; loop = loop;\n    track front_left_leg.rotation {\n      key 0s = (22deg, 0deg, 0deg) catmullrom;\n      key 0.5s = (-22deg, 0deg, 0deg) catmullrom;\n      key 1s = (22deg, 0deg, 0deg) catmullrom;\n    }\n    track back_right_leg.rotation {\n      key 0s = (22deg, 0deg, 0deg) catmullrom;\n      key 0.5s = (-22deg, 0deg, 0deg) catmullrom;\n      key 1s = (22deg, 0deg, 0deg) catmullrom;\n    }\n    track front_right_leg.rotation {\n      key 0s = (-22deg, 0deg, 0deg) catmullrom;\n      key 0.5s = (22deg, 0deg, 0deg) catmullrom;\n      key 1s = (-22deg, 0deg, 0deg) catmullrom;\n    }\n    track back_left_leg.rotation {\n      key 0s = (-22deg, 0deg, 0deg) catmullrom;\n      key 0.5s = (22deg, 0deg, 0deg) catmullrom;\n      key 1s = (-22deg, 0deg, 0deg) catmullrom;\n    }\n  }\n\n  export motion wing_glide for winged.WingedRig {\n    duration = 2s; fps = 24; loop = loop;\n    track left_wing.rotation {\n      key 0s = (0deg, 0deg, -18deg) catmullrom;\n      key 1s = (0deg, 0deg, 24deg) catmullrom;\n      key 2s = (0deg, 0deg, -18deg) catmullrom;\n    }\n    track right_wing.rotation {\n      key 0s = (0deg, 0deg, 18deg) catmullrom;\n      key 1s = (0deg, 0deg, -24deg) catmullrom;\n      key 2s = (0deg, 0deg, 18deg) catmullrom;\n    }\n  }\n}\n"},{"path":"library/std/model/prop/container.ashfox","source":"ashfox 1\nmodule container {\n  export rig contract ChestRig {\n    joint root { parent = none; role = root; channels = rotation; }\n    joint lid { parent = root; role = prop; channels = rotation; }\n  }\n\n  export skeleton ChestSkeleton implements ChestRig {\n    bind root { parent_origin = (0u, 0u, 0u); }\n    bind lid { parent_origin = (0u, 7u, 4u); }\n  }\n\n  export surface contract ChestSurface {\n    chart base box { coverage = opaque; }\n    chart wall box { coverage = opaque; }\n    chart lid box { coverage = opaque; }\n    chart band box { coverage = opaque; }\n    chart latch box { coverage = opaque; }\n    material = opaque;\n  }\n\n  export motion lid_open for ChestRig {\n    duration = 1s; fps = 24; loop = once;\n    track lid.rotation {\n      key 0s = (0deg, 0deg, 0deg) catmullrom;\n      key 0.5s = (-72deg, 0deg, 0deg) catmullrom;\n      key 1s = (0deg, 0deg, 0deg) catmullrom;\n    }\n  }\n\n  export component StorageChest {\n    requires rig skeleton: ChestRig;\n    requires surface skin: ChestSurface;\n    bind bone root to skeleton.root;\n    bind bone lid to skeleton.lid;\n    geometry {\n      bone root {\n        cube plinth { origin = (-5u, 0u, -4u); size = (10u, 2u, 8u); surface = skin.base; }\n        cube hull { origin = (-4u, 2u, -3u); size = (8u, 5u, 6u); surface = skin.wall; }\n        cube band_l { origin = (-5u, 2u, -4u); size = (1u, 5u, 8u); mirror_x = band_r; surface = skin.band; }\n        bone lid {\n          cube lid_cap { origin = (-5u, 0u, -8u); size = (10u, 3u, 8u); surface = skin.lid; }\n          cube latch { origin = (-1u, -1u, -9u); size = (2u, 2u, 1u); surface = skin.latch; }\n        }\n      }\n    }\n  }\n}\n"},{"path":"library/std/model/prop/lighting.ashfox","source":"ashfox 1\nmodule lighting {\n  export rig contract LanternRig {\n    joint root { parent = none; role = root; channels = rotation; }\n    joint body { parent = root; role = prop; channels = rotation; }\n  }\n\n  export skeleton LanternSkeleton implements LanternRig {\n    bind root { parent_origin = (0u, 0u, 0u); }\n    bind body { parent_origin = (0u, 2u, 0u); }\n  }\n\n  export surface contract LanternSurface {\n    chart frame box { coverage = opaque; }\n    chart glass box { coverage = opaque; }\n    chart finial box { coverage = opaque; }\n    material = double;\n  }\n\n  export component IronLantern {\n    requires rig skeleton: LanternRig;\n    requires surface skin: LanternSurface;\n    bind bone root to skeleton.root;\n    bind bone body to skeleton.body;\n    geometry {\n      bone root {\n        cube base { origin = (-3u, 0u, -3u); size = (6u, 2u, 6u); surface = skin.frame; }\n        bone body {\n          cube core { origin = (-2u, 0u, -2u); size = (4u, 5u, 4u); surface = skin.glass; }\n          cube cap { origin = (-3u, 5u, -3u); size = (6u, 2u, 6u); surface = skin.frame; }\n          cube finial { origin = (-1u, 7u, -1u); size = (2u, 2u, 2u); surface = skin.finial; }\n        }\n      }\n    }\n  }\n}\n"},{"path":"library/std/model/rig/biped.ashfox","source":"ashfox 1\nmodule biped {\n  export socket contract HandGrip {\n  }\n\n  export socket contract CapeMount {\n  }\n\n  export rig contract BipedRig {\n    joint root { parent = none; role = root; channels = (rotation, scale); }\n    joint pelvis { parent = root; role = pelvis; channels = (position, rotation); }\n    joint torso { parent = pelvis; role = body; channels = rotation; }\n    joint head { parent = torso; role = head; channels = rotation; }\n    joint left_arm { parent = torso; role = arm; channels = rotation; mirror = right_arm; }\n    joint right_arm { parent = torso; role = arm; channels = rotation; mirror = left_arm; }\n    joint weapon { parent = right_arm; role = weapon; channels = rotation; }\n    joint left_leg { parent = pelvis; role = leg; channels = rotation; mirror = right_leg; }\n    joint right_leg { parent = pelvis; role = leg; channels = rotation; mirror = left_leg; }\n\n    chain spine = [pelvis, torso, head];\n    anchor weapon_tip { joint = weapon; offset = (0u, -8u, 0u); }\n    anchor foot_l { joint = left_leg; offset = (0u, -10u, 0u); }\n    anchor foot_r { joint = right_leg; offset = (0u, -10u, 0u); }\n    socket main_hand: HandGrip { joint = right_arm; capacity = one; }\n    socket off_hand: HandGrip { joint = left_arm; capacity = one; }\n    socket back_cape: CapeMount { joint = torso; capacity = one; }\n  }\n\n  export skeleton BipedSkeleton implements BipedRig {\n    bind root { parent_origin = (0u, 0u, 0u); }\n    bind pelvis { parent_origin = (0u, 12u, 0u); }\n    bind torso { parent_origin = (0u, 2u, 0u); }\n    bind head { parent_origin = (0u, 10u, 0u); }\n    bind left_arm { parent_origin = (-6u, 8u, 0u); }\n    bind right_arm { parent_origin = (6u, 8u, 0u); }\n    bind weapon { parent_origin = (0u, -9u, -1u); }\n    bind left_leg { parent_origin = (-2u, 0u, 0u); }\n    bind right_leg { parent_origin = (2u, 0u, 0u); }\n  }\n}\n"},{"path":"library/std/model/rig/quadruped.ashfox","source":"ashfox 1\nmodule quadruped {\n  export rig contract QuadrupedRig {\n    joint root { parent = none; role = root; channels = (rotation, scale); }\n    joint body { parent = root; role = body; channels = (position, rotation); }\n    joint neck { parent = body; role = neck; channels = rotation; }\n    joint head { parent = neck; role = head; channels = rotation; }\n    joint tail { parent = body; role = tail; channels = rotation; }\n    joint tail_tip { parent = tail; role = tail; channels = rotation; }\n    joint front_left_leg { parent = body; role = leg; channels = rotation; mirror = front_right_leg; }\n    joint front_right_leg { parent = body; role = leg; channels = rotation; mirror = front_left_leg; }\n    joint back_left_leg { parent = body; role = leg; channels = rotation; mirror = back_right_leg; }\n    joint back_right_leg { parent = body; role = leg; channels = rotation; mirror = back_left_leg; }\n\n    chain tail_chain = [tail, tail_tip];\n    anchor nose { joint = head; offset = (0u, 0u, -6u); }\n    anchor tail_end { joint = tail_tip; offset = (0u, 0u, 5u); }\n  }\n\n  export skeleton QuadrupedSkeleton implements QuadrupedRig {\n    bind root { parent_origin = (0u, 0u, 0u); }\n    bind body { parent_origin = (0u, 10u, 0u); }\n    bind neck { parent_origin = (0u, 2u, -6u); }\n    bind head { parent_origin = (0u, 3u, -3u); }\n    bind tail { parent_origin = (0u, 1u, 7u); }\n    bind tail_tip { parent_origin = (0u, 1u, 5.5u); }\n    bind front_left_leg { parent_origin = (-3u, -2u, -5u); }\n    bind front_right_leg { parent_origin = (3u, -2u, -5u); }\n    bind back_left_leg { parent_origin = (-3u, -2u, 5u); }\n    bind back_right_leg { parent_origin = (3u, -2u, 5u); }\n  }\n}\n"},{"path":"library/std/model/rig/winged.ashfox","source":"ashfox 1\nmodule winged {\n  export rig contract WingedRig {\n    joint root { parent = none; role = root; channels = (rotation, scale); }\n    joint torso { parent = root; role = body; channels = (position, rotation); }\n    joint head { parent = torso; role = head; channels = rotation; }\n    joint left_wing { parent = torso; role = wing; channels = rotation; }\n    joint left_wing_tip { parent = left_wing; role = wing; channels = rotation; }\n    joint right_wing { parent = torso; role = wing; channels = rotation; }\n    joint right_wing_tip { parent = right_wing; role = wing; channels = rotation; }\n    joint tail { parent = torso; role = tail; channels = rotation; }\n    joint left_leg { parent = torso; role = leg; channels = rotation; }\n    joint right_leg { parent = torso; role = leg; channels = rotation; }\n  }\n\n  export skeleton WingedSkeleton implements WingedRig {\n    bind root { parent_origin = (0u, 0u, 0u); }\n    bind torso { parent_origin = (0u, 12u, 0u); }\n    bind head { parent_origin = (0u, 5u, -5u); }\n    bind left_wing { parent_origin = (-4u, 4u, -1u); }\n    bind left_wing_tip { parent_origin = (-8u, 0u, 1u); }\n    bind right_wing { parent_origin = (4u, 4u, -1u); }\n    bind right_wing_tip { parent_origin = (8u, 0u, 1u); }\n    bind tail { parent_origin = (0u, -1u, 8u); }\n    bind left_leg { parent_origin = (-2.5u, -4u, 0u); }\n    bind right_leg { parent_origin = (2.5u, -4u, 0u); }\n  }\n}\n"},{"path":"library/std/model/rig/winged_quadruped.ashfox","source":"ashfox 1\nmodule winged_quadruped {\n  export socket contract WingMount {\n  }\n\n  export socket contract TailMount {\n  }\n\n  export rig contract WingedQuadrupedRig {\n    joint root { parent = none; role = root; channels = (position, rotation, scale); }\n    joint torso { parent = root; role = body; channels = (position, rotation, scale); limits { pitch = -25deg..30deg; } }\n    joint neck { parent = torso; role = neck; channels = rotation; limits { pitch = -30deg..35deg; yaw = -45deg..45deg; } }\n    joint head { parent = neck; role = head; channels = rotation; limits { pitch = -35deg..40deg; yaw = -60deg..60deg; } }\n    joint wing_l { parent = torso; role = wing; channels = rotation; mirror = wing_r; }\n    joint wing_tip_l { parent = wing_l; role = wing; channels = rotation; mirror = wing_tip_r; }\n    joint wing_r { parent = torso; role = wing; channels = rotation; mirror = wing_l; }\n    joint wing_tip_r { parent = wing_r; role = wing; channels = rotation; mirror = wing_tip_l; }\n    joint foreleg_l { parent = torso; role = leg; channels = rotation; mirror = foreleg_r; }\n    joint foreleg_r { parent = torso; role = leg; channels = rotation; mirror = foreleg_l; }\n    joint hindleg_l { parent = torso; role = leg; channels = rotation; mirror = hindleg_r; }\n    joint hindleg_r { parent = torso; role = leg; channels = rotation; mirror = hindleg_l; }\n    joint tail { parent = torso; role = tail; channels = rotation; limits { pitch = -35deg..45deg; } }\n    joint tail_tip { parent = tail; role = tail; channels = rotation; limits { pitch = -35deg..45deg; } }\n\n    chain tail_chain = [tail, tail_tip];\n    anchor beak { joint = head; offset = (0u, 0u, -8u); }\n    anchor wing_tip_anchor_l { joint = wing_tip_l; offset = (-10u, 0u, 0u); }\n    anchor wing_tip_anchor_r { joint = wing_tip_r; offset = (10u, 0u, 0u); }\n    socket wing_socket_l: WingMount { joint = wing_l; capacity = one; }\n    socket wing_socket_r: WingMount { joint = wing_r; capacity = one; }\n    socket tail_socket: TailMount { joint = tail; capacity = one; }\n  }\n\n  export skeleton WingedQuadrupedSkeleton implements WingedQuadrupedRig {\n    bind root { parent_origin = (0u, 0u, 0u); }\n    bind torso { parent_origin = (0u, 14u, 0u); }\n    bind neck { parent_origin = (0u, 5u, -6u); }\n    bind head { parent_origin = (0u, 3u, -2u); }\n    bind wing_l { parent_origin = (-5u, 6u, -2u); }\n    bind wing_tip_l { parent_origin = (-10u, 0u, 1u); }\n    bind wing_r { parent_origin = (5u, 6u, -2u); }\n    bind wing_tip_r { parent_origin = (10u, 0u, 1u); }\n    bind foreleg_l { parent_origin = (-3.5u, -4u, -7.5u); }\n    bind foreleg_r { parent_origin = (3.5u, -4u, -7.5u); }\n    bind hindleg_l { parent_origin = (-4.5u, -2u, 7u); }\n    bind hindleg_r { parent_origin = (4.5u, -2u, 7u); }\n    bind tail { parent_origin = (0u, -1u, 12u); }\n    bind tail_tip { parent_origin = (0u, 1u, 10u); }\n  }\n}\n"}],"lock":{"compilerFingerprint":"ashfox-asset-compiler:workspace+design+anchored-pixels+parent-space-rig+typed-hir+instantiation+canonical:v1","format":"ashfox-lock","packages":[{"contentHash":"sha256:7283434cd994d5b8d663b7fc008a330018a8e6d799e60884fe46e9a233b9bb7d","dependencies":[],"digest":null,"files":[{"contentHash":"sha256:cd1e35758d3d7aa67e5d6aa88ac169ef87858973cee3c12ce2a010cf3df9af85","path":"assets/module/griffin/griffin_plumage.ashfox"}],"interfaceHash":"sha256:18a5bba5789f701085658bf41cce43a06f604485330bdc8b3e006fd65ebc2ee9","manifest":{"dependencies":[],"entries":[],"format":"ashfox-package","modules":[{"path":"griffin_plumage.ashfox","subpath":"./plumage"}],"version":1},"manifestHash":"sha256:fb6b013f59d2130af8283e6ab02c85cc08bc570422f16fd999e3f9e7284e66a2","name":"griffin_plumage","root":"assets/module/griffin","source":"workspace"},{"contentHash":"sha256:e5a26b5b597c9a5726e54672dba706d56279362a9b8cb3705dad4322a7ab6dd6","dependencies":[{"contentHash":"sha256:7283434cd994d5b8d663b7fc008a330018a8e6d799e60884fe46e9a233b9bb7d","interfaceHash":"sha256:18a5bba5789f701085658bf41cce43a06f604485330bdc8b3e006fd65ebc2ee9","name":"griffin_plumage"}],"digest":null,"files":[{"contentHash":"sha256:983bf974f745a4d1d0ccc1bb5838e20dcc8519f5227db5bf88dd8e07efd8edaf","path":"assets/models/griffin_boss.ashfox"}],"interfaceHash":"sha256:cde996fc566f03482d4665be535e3d0a1b6ffaf8c7fe134d57a71d8ea0e5bf0f","manifest":{"dependencies":[{"name":"griffin_plumage"}],"entries":[{"name":"griffin_boss","path":"griffin_boss.ashfox"}],"format":"ashfox-package","modules":[],"version":1},"manifestHash":"sha256:81dba2699a38c13460e5907673cc82911bbcabadbb002a2f5e4fd970441191b1","name":"models","root":"assets/mo