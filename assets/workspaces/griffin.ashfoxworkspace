{"files":[{"path":"workbench/animation.ashfox","source":"ashfox-model 1\nmodule animation {\n  export rig contract GriffinRig {\n    handedness = right;\n    frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); }\n    joint root { parent = none; role = root; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = rotation; mirror = none; }\n    joint torso { parent = root; role = body; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = rotation; mirror = none; }\n    joint head { parent = torso; role = head; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = rotation; mirror = none; }\n    joint wing_left { parent = torso; role = wing; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = rotation; mirror = none; }\n    joint wing_right { parent = torso; role = wing; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = rotation; mirror = none; }\n    joint foreleg_left { parent = torso; role = leg; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = rotation; mirror = none; }\n    joint foreleg_right { parent = torso; role = leg; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = rotation; mirror = none; }\n    joint tail { parent = torso; role = tail; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = rotation; mirror = none; }\n    joint tail_tip { parent = tail; role = tail; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = rotation; mirror = none; }\n  }\n\n  export skeleton GriffinSkeleton implements GriffinRig {\n    bind root { parent-origin = (0u, 0u, 0u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }\n    bind torso { parent-origin = (0u, 14u, 0u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }\n    bind head { parent-origin = (0u, 8u, -8u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }\n    bind wing_left { parent-origin = (-5u, 6u, -2u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }\n    bind wing_right { parent-origin = (5u, 6u, -2u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }\n    bind foreleg_left { parent-origin = (-3.5u, -4u, -7.5u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }\n    bind foreleg_right { parent-origin = (3.5u, -4u, -7.5u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }\n    bind tail { parent-origin = (0u, -1u, 12u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }\n    bind tail_tip { parent-origin = (0u, 1u, 10u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }\n  }\n\n  export motion idle for GriffinRig {\n    duration = 3s; fps = 20; loop = loop; rest-relative = true;\n    track torso.rotation {\n      key 0s = (0deg, 0deg, 0deg) linear;\n      key 1.5s = (2deg, 0deg, 0deg) linear;\n      key 3s = (0deg, 0deg, 0deg) linear;\n    }\n    track head.rotation {\n      key 0s = (0deg, 0deg, 0deg) linear;\n      key 1.5s = (-2deg, 5deg, 0deg) linear;\n      key 3s = (0deg, 0deg, 0deg) linear;\n    }\n    track wing_left.rotation {\n      key 0s = (0deg, 0deg, 0deg) linear;\n      key 1.5s = (0deg, 0deg, -5deg) linear;\n      key 3s = (0deg, 0deg, 0deg) linear;\n    }\n    track wing_right.rotation {\n      key 0s = (0deg, 0deg, 0deg) linear;\n      key 1.5s = (0deg, 0deg, 5deg) linear;\n      key 3s = (0deg, 0deg, 0deg) linear;\n    }\n    track tail.rotation {\n      key 0s = (0deg, 0deg, 0deg) linear;\n      key 1.5s = (0deg, 7deg, 0deg) linear;\n      key 3s = (0deg, 0deg, 0deg) linear;\n    }\n    track tail_tip.rotation {\n      key 0s = (0deg, 0deg, 0deg) linear;\n      key 1.5s = (3deg, 10deg, 0deg) linear;\n      key 3s = (0deg, 0deg, 0deg) linear;\n    }\n  }\n\n  export motion look_around for GriffinRig {\n    duration = 4s; fps = 24; loop = loop; rest-relative = true;\n    track head.rotation {\n      key 0s = (0deg, 0deg, 0deg) catmullrom;\n      key 0.8s = (0deg, -22deg, -3deg) catmullrom;\n      key 1.4s = (0deg, -22deg, -3deg) catmullrom;\n      key 2.5s = (2deg, 22deg, 3deg) catmullrom;\n      key 3.1s = (2deg, 22deg, 3deg) catmullrom;\n      key 4s = (0deg, 0deg, 0deg) catmullrom;\n    }\n    track tail.rotation {\n      key 0s = (0deg, 0deg, 0deg) catmullrom;\n      key 1s = (0deg, 9deg, 0deg) catmullrom;\n      key 2s = (0deg, 0deg, 0deg) catmullrom;\n      key 3s = (0deg, -9deg, 0deg) catmullrom;\n      key 4s = (0deg, 0deg, 0deg) catmullrom;\n    }\n  }\n\n  export motion wing_display for GriffinRig {\n    duration = 3.6s; fps = 24; loop = loop; rest-relative = true;\n    track wing_left.rotation {\n      key 0s = (0deg, 0deg, 0deg) catmullrom;\n      key 0.9s = (0deg, 0deg, -22deg) catmullrom;\n      key 2.4s = (0deg, 0deg, -22deg) catmullrom;\n      key 3.6s = (0deg, 0deg, 0deg) catmullrom;\n    }\n    track wing_right.rotation {\n      key 0s = (0deg, 0deg, 0deg) catmullrom;\n      key 0.9s = (0deg, 0deg, 22deg) catmullrom;\n      key 2.4s = (0deg, 0deg, 22deg) catmullrom;\n      key 3.6s = (0deg, 0deg, 0deg) catmullrom;\n    }\n    track head.rotation {\n      key 0s = (0deg, 0deg, 0deg) catmullrom;\n      key 0.9s = (-7deg, 0deg, 0deg) catmullrom;\n      key 2.4s = (-7deg, 0deg, 0deg) catmullrom;\n      key 3.6s = (0deg, 0deg, 0deg) catmullrom;\n    }\n    track tail.rotation {\n      key 0s = (0deg, 0deg, 0deg) catmullrom;\n      key 1.2s = (-8deg, 0deg, 0deg) catmullrom;\n      key 2.4s = (-8deg, 0deg, 0deg) catmullrom;\n      key 3.6s = (0deg, 0deg, 0deg) catmullrom;\n    }\n  }\n\n  export motion wing_flap for GriffinRig {\n    duration = 1.6s; fps = 24; loop = loop; rest-relative = true;\n    track wing_left.rotation {\n      key 0s = (0deg, 0deg, 0deg) catmullrom;\n      key 0.4s = (0deg, 0deg, -18deg) catmullrom;\n      key 0.8s = (0deg, 0deg, 16deg) catmullrom;\n      key 1.2s = (0deg, 0deg, -18deg) catmullrom;\n      key 1.6s = (0deg, 0deg, 0deg) catmullrom;\n    }\n    track wing_right.rotation {\n      key 0s = (0deg, 0deg, 0deg) catmullrom;\n      key 0.4s = (0deg, 0deg, 18deg) catmullrom;\n      key 0.8s = (0deg, 0deg, -16deg) catmullrom;\n      key 1.2s = (0deg, 0deg, 18deg) catmullrom;\n      key 1.6s = (0deg, 0deg, 0deg) catmullrom;\n    }\n    track head.rotation {\n      key 0s = (0deg, 0deg, 0deg) catmullrom;\n      key 0.4s = (-3deg, 0deg, 0deg) catmullrom;\n      key 0.8s = (3deg, 0deg, 0deg) catmullrom;\n      key 1.2s = (-3deg, 0deg, 0deg) catmullrom;\n      key 1.6s = (0deg, 0deg, 0deg) catmullrom;\n    }\n  }\n\n  export motion greeting for GriffinRig {\n    duration = 3s; fps = 24; loop = loop; rest-relative = true;\n    track head.rotation {\n      key 0s = (0deg, 0deg, 0deg) catmullrom;\n      key 0.65s = (17deg, 0deg, 0deg) catmullrom;\n      key 1.1s = (2deg, 0deg, 0deg) catmullrom;\n      key 1.65s = (13deg, 0deg, 0deg) catmullrom;\n      key 2.2s = (0deg, 0deg, -6deg) catmullrom;\n      key 3s = (0deg, 0deg, 0deg) catmullrom;\n    }\n    track tail.rotation {\n      key 0s = (0deg, 0deg, 0deg) catmullrom;\n      key 0.5s = (0deg, 13deg, 0deg) catmullrom;\n      key 1s = (0deg, -13deg, 0deg) catmullrom;\n      key 1.5s = (0deg, 13deg, 0deg) catmullrom;\n      key 2s = (0deg, -13deg, 0deg) catmullrom;\n      key 2.5s = (0deg, 7deg, 0deg) catmullrom;\n      key 3s = (0deg, 0deg, 0deg) catmullrom;\n    }\n    track wing_left.rotation {\n      key 0s = (0deg, 0deg, 0deg) catmullrom;\n      key 1.5s = (0deg, 0deg, -5deg) catmullrom;\n      key 3s = (0deg, 0deg, 0deg) catmullrom;\n    }\n    track wing_right.rotation {\n      key 0s = (0deg, 0deg, 0deg) catmullrom;\n      key 1.5s = (0deg, 0deg, 5deg) catmullrom;\n      key 3s = (0deg, 0deg, 0deg) catmullrom;\n    }\n  }\n\n  export motion alert for GriffinRig {\n    duration = 2.4s; fps = 24; loop = loop; rest-relative = true;\n    track head.rotation {\n      key 0s = (0deg, 0deg, 0deg) catmullrom;\n      key 0.25s = (-8deg, -12deg, 0deg) catmullrom;\n      key 1.1s = (-8deg, -12deg, 0deg) catmullrom;\n      key 1.55s = (-6deg, 12deg, 0deg) catmullrom;\n      key 2.4s = (0deg, 0deg, 0deg) catmullrom;\n    }\n    track wing_left.rotation {\n      key 0s = (0deg, 0deg, 0deg) catmullrom;\n      key 0.3s = (0deg, 0deg, -10deg) catmullrom;\n      key 1.6s = (0deg, 0deg, -10deg) catmullrom;\n      key 2.4s = (0deg, 0deg, 0deg) catmullrom;\n    }\n    track wing_right.rotation {\n      key 0s = (0deg, 0deg, 0deg) catmullrom;\n      key 0.3s = (0deg, 0deg, 10deg) catmullrom;\n      key 1.6s = (0deg, 0deg, 10deg) catmullrom;\n      key 2.4s = (0deg, 0deg, 0deg) catmullrom;\n    }\n    track tail.rotation {\n      key 0s = (0deg, 0deg, 0deg) catmullrom;\n      key 0.3s = (-10deg, 0deg, 0deg) catmullrom;\n      key 1.6s = (-10deg, 0deg, 0deg) catmullrom;\n      key 2.4s = (0deg, 0deg, 0deg) catmullrom;\n    }\n  }\n}\n"},{"path":"workbench/main.ashfox","source":"ashfox-model 1\nasset griffin {\n  import \"./animation.ashfox\" as animation;\n  export surface contract Plumage {\n    chart haunch box { coverage = opaque; }\n    chart chest box { coverage = opaque; }\n    chart breast box { coverage = opaque; }\n    chart mantle box { coverage = opaque; }\n    chart skull box { coverage = opaque; }\n    chart brow box { coverage = opaque; }\n    chart beak box { coverage = opaque; }\n    chart beak_tip box { coverage = opaque; }\n    chart crest box { coverage = opaque; }\n    chart crest_plume flat { coverage = opaque; }\n    chart foreleg box { coverage = opaque; }\n    chart forefoot box { coverage = opaque; }\n    chart talon box { coverage = opaque; }\n    chart hind_thigh box { coverage = opaque; }\n    chart hind_shin box { coverage = opaque; }\n    chart hind_paw box { coverage = opaque; }\n    chart hind_claw box { coverage = opaque; }\n    chart shoulder box { coverage = opaque; }\n    chart wing_arm box { coverage = opaque; }\n    chart feather_a box { coverage = opaque; }\n    chart feather_b box { coverage = opaque; }\n    chart feather_c box { coverage = opaque; }\n    chart feather_tip box { coverage = opaque; }\n    chart tail_base box { coverage = opaque; }\n    chart tail_rise box { coverage = opaque; }\n    chart tail_tuft box { coverage = opaque; }\n    material = opaque;\n  }\n\n  export surface griffin_skin: Plumage {\n    material = opaque;\n    texture atlas {\n      background = shade; background-alpha = 255;\n      palette {\n        shade = #23262b;\n        eye = #102426;\n        gleam = #56d9c5;\n        gold = (#66411f, #ba8241, #e6b368);\n        gold_deep = (#452a13, #825526, #b87e3c);\n        ivory = (#8f8e82, #d8d5c2, #f8f2e2);\n        ivory_mid = (#6d6b62, #aaa698, #d9d3c3);\n        beak = (#8b551e, #dfa338, #ffd66e);\n        feather = (#645546, #b5a890, #e8dec5);\n        dark = (#24272c, #494947, #7a746a);\n        claw = (#1b1d20, #3f4247, #6d7076);\n      }\n      stamp eye_mark {\n        pixels = \"eee/egg/eee\";\n        e = eye;\n        g = gleam;\n      }\n      stamp breast_crest {\n        pixels = \"..gg../.gggg./gggggg/.gggg./..gg..\";\n        g = gold_deep;\n      }\n\n      chart haunch box {\n        fill = gold;\n        grain = clustered;\n        pattern gradient { from = gold_deep; to = gold; axis = y; space = model; soft = 0.25ratio; }\n        pattern ao { strength = 0.85ratio; radius = 2u; }\n        pattern stripe { paint = gold_deep; axis = u; period = 6px; width = 1px; phase = 1; }\n      }\n      chart chest box {\n        fill = ivory;\n        grain = soft;\n        pattern gradient { from = gold_deep; to = ivory; axis = y; space = model; soft = 0.25ratio; }\n        pattern ao { strength = 0.85ratio; radius = 2u; }\n        pattern border { paint = ivory_mid; width = 1px; edges = bottom; }\n      }\n      chart breast box {\n        fill = ivory;\n        grain = soft;\n        pattern gradient { from = ivory_mid; to = ivory; axis = y; space = local; soft = 0.2ratio; }\n        pattern ao { strength = 0.75ratio; radius = 2u; }\n        face north { stamp breast_crest { at = (1px, 1px); protect = true; } }\n      }\n      chart mantle box {\n        fill = ivory_mid;