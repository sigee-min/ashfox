{"files":[{"path":"creatures/goblin-body.ashfox","source":"ashfox-model 1\nmodule goblin_body {\n  import \"./goblin-rig.ashfox\" as rig;\n  import \"./goblin-surface.ashfox\" as surface;\n  export component GoblinRaider {\n    requires rig skeleton: rig.GoblinRig;\n    requires surface skin: surface.RaiderSkin;\n    bind bone pelvis to skeleton.pelvis;\n    bind bone torso to skeleton.torso;\n    bind bone head to skeleton.head;\n    bind bone left_arm to skeleton.left_arm;\n    bind bone right_arm to skeleton.right_arm;\n    bind bone weapon to skeleton.weapon;\n    bind bone left_leg to skeleton.left_leg;\n    bind bone right_leg to skeleton.right_leg;\n    geometry {\n      bone pelvis {\n        cube hips { origin = (-4u, 9u, -2.5u); size = (8u, 4u, 5u); surface = skin.pelvis; }\n        cube belt { origin = (-5u, 12u, -3.5u); size = (10u, 2u, 7u); surface = skin.belt; }\n        bone torso {\n          cube chest { origin = (-5u, 13u, -3u); size = (10u, 9u, 6u); surface = skin.torso; }\n          bone head {\n            cube skull { origin = (-4u, 21u, -5u); size = (8u, 8u, 8u); surface = skin.head; }\n            cube snout { origin = (-3u, 21u, -8u); size = (6u, 3u, 3u); surface = skin.snout; }\n            cube left_tusk { origin = (-3u, 20u, -8u); size = (1u, 2u, 1u); surface = skin.tusk; }\n            cube right_tusk { origin = (2u, 20u, -8u); size = (1u, 2u, 1u); surface = skin.tusk; }\n            cube left_ear { origin = (-7u, 23u, -2u); size = (3u, 4u, 2u); surface = skin.ear; }\n            cube right_ear { origin = (4u, 23u, -2u); size = (3u, 4u, 2u); surface = skin.ear; }\n            cube left_ear_tip { origin = (-9u, 24u, -1.5u); size = (2u, 3u, 2u); surface = skin.ear_tip; }\n            cube right_ear_tip { origin = (7u, 24u, -1.5u); size = (2u, 3u, 2u); surface = skin.ear_tip; }\n            cube mohawk { origin = (-1u, 29u, -4u); size = (2u, 3u, 7u); surface = skin.mohawk; }\n          }\n          bone left_arm {\n            cube pauldron { origin = (-9u, 18u, -2.5u); size = (5u, 3u, 5u); surface = skin.pauldron; }\n            cube arm { origin = (-8u, 10u, -1.5u); size = (3u, 9u, 3u); surface = skin.arm; }\n            cube hand { origin = (-8u, 8u, -2u); size = (3u, 3u, 3u); surface = skin.hand; }\n            cube shield { origin = (-12u, 8u, -4u); size = (8u, 10u, 2u); surface = skin.shield; }\n          }\n          bone right_arm {\n            cube pauldron { origin = (4u, 18u, -2.5u); size = (5u, 3u, 5u); surface = skin.pauldron; }\n            cube arm { origin = (5u, 10u, -1.5u); size = (3u, 9u, 3u); surface = skin.arm; }\n            cube hand { origin = (5u, 8u, -2u); size = (3u, 3u, 3u); surface = skin.hand; }\n            bone weapon {\n              cube grip { origin = (5.5u, 9u, -5u); size = (2u, 2u, 4u); surface = skin.grip; }\n              cube crossguard { origin = (2.5u, 9.5u, -6u); size = (8u, 1u, 1u); surface = skin.crossguard; }\n              cube blade { origin = (5.5u, 9u, -20u); size = (2u, 2u, 14u); surface = skin.blade; }\n              cube pommel { origin = (5u, 8.5u, -2u); size = (3u, 3u, 2u); surface = skin.pommel; }\n            }\n          }\n        }\n        bone left_leg {\n          cube leg { origin = (-4u, 2u, -2u); size = (4u, 9u, 4u); surface = skin.leg; }\n          cube boot { origin = (-4u, 0u, -4u); size = (4u, 3u, 6u); surface = skin.boot; }\n        }\n        bone right_leg {\n          cube leg { origin = (0u, 2u, -2u); size = (4u, 9u, 4u); surface = skin.leg; }\n          cube boot { origin = (0u, 0u, -4u); size = (4u, 3u, 6u); surface = skin.boot; }\n        }\n      }\n    }\n  }\n}\n"},{"path":"creatures/goblin-rig.ashfox","source":"ashfox-model 1\nmodule goblin_rig {\n  export rig contract GoblinRig {\n    handedness = right;\n    frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); }\n    joint root { parent = none; role = root; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = (rotation, scale); mirror = none; }\n    joint pelvis { parent = root; role = pelvis; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = rotation; mirror = none; }\n    joint torso { parent = pelvis; role = body; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = rotation; mirror = none; }\n    joint head { parent = torso; role = head; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = rotation; mirror = none; }\n    joint left_arm { parent = torso; role = arm; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = rotation; mirror = none; }\n    joint right_arm { parent = torso; role = arm; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = rotation; mirror = none; }\n    joint weapon { parent = right_arm; role = weapon; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = rotation; mirror = none; }\n    joint left_leg { parent = pelvis; role = leg; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = rotation; mirror = none; }\n    joint right_leg { parent = pelvis; role = leg; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = rotation; mirror = none; }\n  }\n\n  export skeleton RaiderSkeleton implements GoblinRig {\n    bind root { parent-origin = (0u, 0u, 0u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }\n    bind pelvis { parent-origin = (0u, 11u, 0u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }\n    bind torso { parent-origin = (0u, 2u, 0u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }\n    bind head { parent-origin = (0u, 10u, -1u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }\n    bind left_arm { parent-origin = (-6.5u, 6.5u, 0u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }\n    bind right_arm { parent-origin = (6.5u, 6.5u, 0u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }\n    bind weapon { parent-origin = (0u, -9.5u, -1u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }\n    bind left_leg { parent-origin = (-2u, -1u, 0u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }\n    bind right_leg { parent-origin = (2u, -1u, 0u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }\n  }\n\n  export motion idle for GoblinRig {\n    duration = 2s; fps = 20; loop = loop; rest-relative = true;\n    track torso.rotation {\n      key 0s = (0deg, 0deg, 0deg) catmullrom;\n      key 1s = (1deg, -2deg, 0deg) catmullrom;\n      key 2s = (0deg, 0deg, 0deg) catmullrom;\n    }\n    track head.rotation {\n      key 0s = (0deg, 0deg, 0deg) catmullrom;\n      key 1s = (0deg, 4deg, 0deg) catmullrom;\n      key 2s = (0deg, 0deg, 0deg) catmullrom;\n    }\n    track right_arm.rotation {\n      key 0s = (0deg, 0deg, 0deg) catmullrom;\n      key 1s = (-3deg, 2deg, 2deg) catmullrom;\n      key 2s = (0deg, 0deg, 0deg) catmullrom;\n    }\n    track left_arm.rotation {\n      key 0s = (0deg, 0deg, 0deg) catmullrom;\n      key 1s = (3deg, -2deg, -2deg) catmullrom;\n      key 2s = (0deg, 0deg, 0deg) catmullrom;\n    }\n  }\n  export motion lookout for GoblinRig {\n    duration = 4s; fps = 24; loop = loop; rest-relative = true;\n    track head.rotation {\n      key 0s = (0deg, 0deg, 0deg) catmullrom;\n      key 1s = (0deg, -22deg, 2deg) catmullrom;\n      key 2s = (0deg, -22deg, 2deg) catmullrom;\n      key 3s = (-3deg, 20deg, -2deg) catmullrom;\n      key 4s = (0deg, 0deg, 0deg) catmullrom;\n    }\n    track left_arm.rotation {\n      key 0s = (0deg, 0deg, 0deg) catmullrom;\n      key 1s = (-8deg, 0deg, -8deg) catmullrom;\n      key 3s = (-8deg, 0deg, -8deg) catmullrom;\n      key 4s = (0deg, 0deg, 0deg) catmullrom;\n    }\n  }\n  export motion challenge for GoblinRig {\n    duration = 3s; fps = 24; loop = loop; rest-relative = true;\n    track right_arm.rotation {\n      key 0s = (0deg, 0deg, 0deg) catmullrom;\n      key 0.8s = (35deg, -8deg, 12deg) catmullrom;\n      key 1.5s = (35deg, -8deg, 12deg) catmullrom;\n      key 2.4s = (3deg, 0deg, 2deg) catmullrom;\n      key 3s = (0deg, 0deg, 0deg) catmullrom;\n    }\n    track head.rotation {\n      key 0s = (0deg, 0deg, 0deg) catmullrom;\n      key 0.8s = (2deg, -8deg, -2deg) catmullrom;\n      key 1.5s = (2deg, -8deg, -2deg) catmullrom;\n      key 2.4s = (4deg, 0deg, 0deg) catmullrom;\n      key 3s = (0deg, 0deg, 0deg) catmullrom;\n    }\n    track left_arm.rotation {\n      key 0s = (0deg, 0deg, 0deg) catmullrom;\n      key 0.8s = (8deg, 0deg, -8deg) catmullrom;\n      key 1.5s = (8deg, 0deg, -8deg) catmullrom;\n      key 3s = (0deg, 0deg, 0deg) catmullrom;\n    }\n  }\n}\n"},{"path":"creatures/goblin-surface.ashfox","source":"ashfox-model 1\nmodule goblin_surface {\n  export surface contract RaiderSkin {\n    atlas { width = 128px; height = 64px; }\n    chart torso box { width = 32px; height = 15px; coverage = opaque; }\n    chart pelvis box { width = 26px; height = 9px; coverage = opaque; }\n    chart head box { width = 32px; height = 16px; coverage = opaque; }\n    chart snout box { width = 18px; height = 6px; coverage = opaque; }\n    chart ear box { width = 10px; height = 6px; coverage = opaque; }\n    chart ear_tip box { width = 8px; height = 5px; coverage = opaque; }\n    chart arm box { width = 12px; height = 12px; coverage = opaque; }\n    chart hand box { width = 12px; height = 6px; coverage = opaque; }\n    chart leg box { width = 16px; height = 13px; coverage = opaque; }\n    chart boot box { width = 20px; height = 9px; coverage = opaque; }\n    chart belt box { width = 34px; height = 9px; coverage = opaque; }\n    chart pauldron box { width = 20px; height = 8px; coverage = opaque; }\n    chart blade box { width = 32px; height = 16px; coverage = opaque; }\n    chart crossguard box { width = 18px; height = 2px; coverage = opaque; }\n    chart grip box { width = 12px; height = 6px; coverage = opaque; }\n    chart pommel box { width = 10px; height = 5px; coverage = opaque; }\n    chart shield box { width = 20px; height = 12px; coverage = opaque; }\n    chart tusk box { width = 4px; height = 3px; coverage = opaque; }\n    chart mohawk box { width = 18px; height = 10px; coverage = opaque; }\n    material = opaque;\n  }\n\n  export surface raider: RaiderSkin {\n    material = opaque;\n    texture atlas {\n      atlas = (128px, 64px); background = void; background-alpha = 255;\n      palette {\n        void = #090b09;\n        skin = (#263416, #526f2c, #8da64a);\n        skin_dark = (#18220f, #34471d, #607b32);\n        leather = (#24130d, #5c321d, #9a6031);\n        leather_dark = (#140b08, #352016, #65402a);\n        iron = (#343a3c, #778184, #c3c9c7);\n        iron_dark = (#1d2224, #4c5659, #818b8c);\n        cloth = (#210b0d, #76242c, #bd4e52);\n        eye = #eacb55;\n        pupil = #080908;\n        tooth = (#8b7b59, #d0bd8d, #f1e4bd);\n      }\n      stamp face {\n        pixels = \"......../dd....dd/.yk..ky./......../..d..d../...dd...\";\n        d = skin_dark;\n        y = eye;\n        k = pupil;\n      }\n      stamp armor_mark {\n        pixels = \"....ii..../...iiii.../..iiddi.../.iidddii../...iiii.../....ii....\";\n        i = iron;\n        d = iron_dark;\n      }\n      stamp shield_mark {\n        pixels = \"..iiii../.i....i./i..ii..i/i.iiii.i/i..ii..i/.i....i./..iiii..\";\n        i = iron;\n      }\n\n      chart torso box {\n        origin = (0px, 0px); fill = leather;\n        pattern blotch { paint = leather_dark; scale = (3px, 3px, 4px); density = 0.17ratio; phase = 19; }\n        face north { stamp armor_mark { at = (0px, 1px); } }\n      }\n      chart head box {\n        origin = (32px, 0px); fill = skin;\n        pattern blotch { paint = skin_dark; scale = (3px, 3px, 3px); density = 0.14ratio; phase = 41; }\n        face north { stamp face { at = (0px, 1px); } }\n      }\n      chart blade box {\n        origin = (64px, 0px); fill = iron;\n        pattern blotch { paint = iron_dark; scale = (2px, 5px, 4px); density = 0.12ratio; phase = 7; }\n      }\n      chart shield box {\n        origin = (96px, 0px); fill = leather_dark;\n        face north { stamp shield_mark { at = (0px, 1px); } }\n      }\n      chart pelvis box { origin = (0px, 20px); fill = cloth; }\n      chart belt box { origin = (26px, 20px); fill = leather_dark; }\n      chart boot box { origin = (60px, 20px); fill = leather_dark; }\n      chart leg box { origin = (80px, 20px); fill = cloth; }\n      chart pauldron box { origin = (96px, 20px); fill = iron_dark; }\n      chart snout box { origin = (0px, 35px); fill = skin_dark; }\n      chart ear box { origin = (18px, 35px); fill = skin; }\n      chart ear_tip box { origin = (28px, 35px); fill = skin_dark; }\n      chart arm box { origin = (36px, 35px); fill = skin; }\n      chart hand box { origin = (48px, 35px); fill = skin_dark; }\n      chart crossguard box { origin = (60px, 35px); fill = iron_dark; }\n      chart grip box { origin = (78px, 35px); fill = leather; }\n      chart pommel box { origin = (90px, 35px); fill = iron_dark; }\n      chart tusk box { origin = (100px, 35px); fill = tooth; }\n      chart mohawk box { origin = (104px, 35px); fill = cloth; }\n      grain clustered { seed = 44021; }\n      tone voxel;\n    }\n  }\n}\n"},{"path":"creatures/goblin.ashfox","source":"ashfox-model 1\nasset goblin {\n  import \"./goblin-rig.ashfox\" as rig;\n  import \"./goblin-surface.ashfox\" as surface;\n  import \"./goblin-body.ashfox\" as body;\n  export asset goblin {\n    settings { density = 16; forward = north; }\n    skeleton = rig.RaiderSkeleton;\n    motion = rig.idle;\n    motion = rig.lookout;\n    motion = rig.challenge;\n    use body.GoblinRaider as goblin { bind skeleton = rig.GoblinRig; bind skin = surface.raider; };\n  }\n}\n"}],"lock":{"compilerFingerprint":"ashfox-asset-compiler:workspace+design+anchored-pixels+parent-space-rig+typed-hir+instantiation+canonical:v1","format":"ashfox-lock","packages":[{"contentHash":"sha256:2edb6b9abf69752028f9db4307842851425a44011bd3de22ece91be37e2fc90e","dependencies":[],"digest":null,"files":[{"contentHash":"sha256:f7b3cde295