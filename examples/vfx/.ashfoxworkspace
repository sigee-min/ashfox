{
  "format": "ashfox-workspace",
  "version": 2,
  "name": "vfx-collection",
  "packages": [
    {
      "name": "vfx",
      "root": "assets",
      "manifest": {
        "format": "ashfox-package",
        "version": 1,
        "dependencies": [],
        "entries": [
          { "name": "flame_cleave", "path": "vfx/flame_cleave.ashfox" },
          { "name": "arcane_shockwave", "path": "vfx/arcane_shockwave.ashfox" },
          { "name": "lightning_strike", "path": "vfx/lightning_strike.ashfox" },
          { "name": "hearth_embers", "path": "vfx/hearth_embers.ashfox" }
        ],
        "modules": [
          { "subpath": "./palettes", "path": "module/palettes.ashfox" }
        ]
      }
    }
  ],
  "include": ["assets/**/*.ashfox"],
  "ignore": [],
  "build": { "directory": "dist/build" },
  "exports": [
    {
      "name": "flame_cleave",
      "entry": { "packageName": "vfx", "entryName": "flame_cleave" },
      "format": "glb",
      "directory": "exports/flame_cleave"
    },
    {
      "name": "arcane_shockwave",
      "entry": { "packageName": "vfx", "entryName": "arcane_shockwave" },
      "format": "glb",
      "directory": "exports/arcane_shockwave"
    },
    {
      "name": "lightning_strike",
      "entry": { "packageName": "vfx", "entryName": "lightning_strike" },
      "format": "glb",
      "directory": "exports/lightning_strike"
    },
    {
      "name": "hearth_embers",
      "entry": { "packageName": "vfx", "entryName": "hearth_embers" },
      "format": "glb",
      "directory": "exports/hearth_embers"
    }
  ]
}
