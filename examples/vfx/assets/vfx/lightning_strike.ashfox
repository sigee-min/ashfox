ashfox 1
vfx lightning_strike {
  import "../module/palettes.ashfox" as pal;

  duration = 0.55s;
  fps = 30;
  loop = once;
  palette = pal.StormArc;

  preview flipbook { sheet = flipbook; background = dark; width = 512; height = 512; }
  preview peak { time = 0.14s; background = dark; azimuth = 38; elevation = 18; width = 640; height = 480; }

  element main_bolt : beam {
    at = 0.02s..0.32s;
    blend = additive;
    start = (0u, 34u, 0u);
    end = (0u, 0u, 0u);
    width = 3.2u;
    style = lightning;
    jagged = 3.4u;
    forks = 4;
    seed = 91;
    texture slash_streak { posterize = 4; bristles = 18%; seed = 91; }
    dissolve simplex { frames = 6; edge_glow = core; }
    scale = 1.2 -> 0.95 snap -> 0.4;
    alpha = 1.0 -> 0.9 -> 0.0 ease_in;
  }

  element ground_flash : ring {
    at = 0.04s..0.38s;
    blend = additive;
    radius = 2u..13u;
    bevel = 0.8u;
    texture ring_wave { rings = 2; posterize = 4; seed = 93; }
    scale = 0.4 -> 1.15 ease_out -> 1.25;
    alpha = 1.0 -> 0.6 -> 0.0 ease_in;
  }

  emitter electric_sparks : voxel_burst {
    at = 0.04s..0.52s;
    seed = 109;
    count = 26;
    shape = sphere(3u);
    particle = shard;
    speed = 20u..38u;
    life = 0.18s..0.44s;
    gravity = -24u;
    drag = 1.6;
    ground { y = 0u; bounce = 55%; friction = 65%; }
    size_over_life = 1.0u -> 0.7u -> 0u;
    color_over_life = core -> mid -> edge;
    velocity_stretch = 1.6;
    blend = additive;
  }
}
