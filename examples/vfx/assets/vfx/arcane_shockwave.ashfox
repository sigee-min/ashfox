ashfox 1
vfx arcane_shockwave {
  import "../module/palettes.ashfox" as pal;

  duration = 0.80s;
  fps = 24;
  loop = once;
  palette = pal.ArcaneFrost;

  preview flipbook { sheet = flipbook; background = dark; width = 512; height = 512; }
  preview peak { time = 0.28s; background = dark; azimuth = 30; elevation = 32; width = 640; height = 480; }

  element pulse_ring : ring {
    at = 0.05s..0.62s;
    blend = additive;
    radius = 4u..18u;
    bevel = 1.4u;
    ripple_amp = 0.8u;
    ripple_freq = 8;
    texture magic_circle { runes = 12; rings = 3; seed = 23; }
    dissolve voronoi { frames = 12; edge_glow = core; edge_width = 0.08; }
    scale = 0.35 -> 1.15 ease_out -> 1.30;
    alpha = 0.3 -> 1.0 snap -> 0.0 ease_in;
  }

  element shock_dome : dome {
    at = 0.06s..0.44s;
    blend = additive;
    shape = hemisphere;
    radius = 12u;
    subdiv = 2;
    texture radial_flare { spikes = 10; posterize = 5; seed = 31; }
    dissolve radial_noise { frames = 9; edge_glow = mid; }
    scale = 0.25 -> 1.05 ease_out -> 1.20;
    alpha = 0.9 -> 0.5 -> 0.0 ease_in;
  }

  emitter runes_motes : voxel_burst {
    at = 0.08s..0.76s;
    seed = 77;
    count = 24;
    shape = ring(8u);
    particle = shard;
    speed = 10u..22u;
    life = 0.32s..0.68s;
    gravity = 4u;
    drag = 1.2;
    vortex { axis = (0, 1, 0); center = (0u, 3u, 0u); strength = 9; }
    size_over_life = 0.9u -> 1.1u -> 0u;
    color_over_life = core -> mid -> edge;
    blend = additive;
  }
}
