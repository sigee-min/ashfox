ashfox 1
sound wave_bell {
  profile = ui;
  duration = 2.2s;
  channels = 2;
  seed = 6024;
  space { preset = stone_hall; mix = 32%; }
  voice bronze_toll : material {
    material = bronze;
    pitch = 220hz;
    size = 1.6;
    hardness = 82%;
    damping = 24%;
    brightness = 76%;
    modes = 28;
    strike = mallet;
    filter lowpass {
      cutoff { domain = log; interpolation = smooth; points = [(0, 13500hz), (0.35, 4200hz), (1, 1100hz)]; }
      q = 1.1;
    }
    highpass = 40hz;
    drive = 1.5;
    pan = -0.14;
    gain { env = ad; attack = 3ms; peak = 1; curve = exp; }
  }
  voice war_horn : osc {
    waveform = saw;
    pitch { domain = log; interpolation = smooth; points = [(0, 110hz), (0.28, 146hz), (1, 138hz)]; }
    unison = 3;
    detune_cents = 18cents;
    filter lowpass {
      cutoff { domain = log; interpolation = smooth; points = [(0, 480hz), (0.3, 3200hz), (1, 540hz)]; }
      q = 1.25;
    }
    highpass = 45hz;
    drive = 1.4;
    pan = 0.14;
    gain { env = adsr; attack = 40ms; decay = 0.28s; sustain = 68%; release = 0.45s; peak = 0.78; }
  }
  voice mallet_sub : resonator {
    excitation mallet { duration = 10ms; hardness = 65%; }
    mode sub { hz = 65hz; decay = 0.42s; gain = 0.95; }
    mode body { hz = 130hz; decay = 0.34s; gain = 1; }
    mode ring { hz = 390hz; decay = 0.2s; gain = 0.5; }
    pitch_drop_cents = 45cents;
    pitch_drop_seconds = 20ms;
    highpass = 32hz;
    gain { env = ad; attack = 2ms; peak = 0.95; curve = exp; }
  }
  voice strike_air : noise {
    color = white;
    filter bandpass {
      cutoff { domain = log; interpolation = smooth; points = [(0, 9800hz), (1, 1800hz)]; }
      q = 1.3;
    }
    pan = 0.22;
    gain { env = ad; attack = 2ms; peak = 0.52; curve = exp; }
  }
  seq warning {
    start = 20ms;
    step toll { voice = bronze_toll; at = 0s; duration = 1.1s; vary_timing = -0.005s..5ms; vary_pitch = -55cents..55cents; vary_gain = 90%..110%; }
    step horn { voice = war_horn; at = 80ms; duration = 1.65s; vary_pitch = -45cents..45cents; }
    step thump { voice = mallet_sub; at = 0s; duration = 0.45s; vary_pitch = -45cents..45cents; }
    step air { voice = strike_air; at = 0s; duration = 0.22s; }
  }
  variant base { seed = 42; }
  variant alternate { seed = 43; }
  master { gain = 4db; peak = -1.5db; target = -12lufs; warmth = 25%; glue = 25%; limit = true; }
}
