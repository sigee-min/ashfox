ashfox 1
sound wave_bell {
  profile = ui;
  duration = 2.2s;
  seed = 6024;
  space { preset = stone_hall; mix = 32%; }

  voice bronze_toll : modal_plate {
    material = bronze;
    pitch = 220hz;
    size = 1.6;
    hardness = 0.82;
    damping = 0.24;
    brightness = 0.76;
    modes = 20;
    strike = mallet;
    twin_beat = 0.6;
    splash = 0.32;
    stereo_spread = 0.6;
    highpass = 40hz;
    filter : lowpass { cutoff = log(0: 13500hz -> 0.35: 4200hz -> 1: 1100hz); q = 1.1; }
    drive : tape { amount = 1.5; }
    fx : shimmer { mix = 16%; feedback = 24%; shift_semitones = 12st; }
    pan = -0.14;
    gain { env = ad; attack = 3ms; peak = 1.0; curve = exp; }
  }

  voice war_horn : osc {
    waveform = saw;
    pitch = log(0: 110hz -> 0.28: 146hz -> 1: 138hz);
    unison = 3;
    detune_cents = 18cents;
    filter : lowpass { cutoff = log(0: 480hz -> 0.3: 3200hz -> 1: 540hz); q = 1.25; }
    highpass = 45hz;
    drive : tube { amount = 1.4; }
    fx : chorus { mix = 26%; rate = 1.6hz; depth = 32%; }
    pan = 0.14;
    gain { env = adsr; attack = 40ms; decay = 280ms; sustain = 0.68; release = 450ms; peak = 0.78; }
  }

  voice mallet_sub : material {
    material = wood;
    pitch = 110hz;
    size = 1.8;
    hardness = 0.65;
    damping = 0.42;
    brightness = 0.45;
    modes = 8;
    strike = mallet;
    splash = 0.35;
    stereo_spread = 0.3;
    highpass = 32hz;
    eq { low = (95hz, 3db); }
    gain { env = ad; attack = 2ms; peak = 0.95; curve = exp; }
  }

  voice strike_air : noise {
    color = white;
    filter : bandpass { cutoff = log(0: 9800hz -> 1: 1800hz); q = 1.3; }
    pan = 0.28 -> -0.18;
    gain { env = ad; attack = 2ms; peak = 0.52; curve = exp; }
  }

  seq warning {
    start = 20ms;
    step toll { voice = bronze_toll; at = 0s; duration = 1.1s; vary_pitch = -55cents..55cents; vary_timing = -5ms..5ms; vary_gain = 90%..110%; }
    step horn { voice = war_horn; at = 80ms; duration = 1.65s; vary_pitch = -45cents..45cents; }
    step thump { voice = mallet_sub; at = 0s; duration = 450ms; vary_pitch = -45cents..45cents; }
    step air { voice = strike_air; at = 0s; duration = 220ms; }
  }

  variants { base = 42; alternate = 43; }
  master { gain = 4db; target = -12lufs; peak = -1.5db; warmth = 25%; glue = 25%; limit = true; }
}
