ashfox 1
sound charging_spell {
  profile = magic;
  duration = 2.4s;
  seed = 7349;
  space { preset = ethereal; mix = 32%; }

  voice arc_core : osc {
    waveform = saw;
    pitch = log(0: 110hz -> 0.7: 440hz -> 1: 1100hz);
    unison = 4;
    detune_cents = 24cents;
    filter : lowpass { cutoff = log(0: 900hz -> 1: 12000hz); q = 1.5; }
    drive : fold { amount = 1.4; }
    fx : phaser { mix = 36%; rate = 1.4hz; stages = 6; }
    pan = -0.35 -> 0.2;
    gain = smooth(0: 0 -> 0.15: 0.35 -> 0.88: 0.92 -> 1: 0);
  }

  voice fm_surge : fm {
    pitch = log(0: 420hz -> 1: 1480hz);
    ratio = 1.5;
    index = smooth(0: 0.4 -> 1: 4.2);
    vibrato_hz = 9hz;
    vibrato_cents = 28cents;
    filter : bandpass { cutoff = log(0: 1400hz -> 1: 9500hz); q = 1.4; }
    fx : shimmer { mix = 32%; feedback = 38%; shift_semitones = 12st; }
    pan = 0.35 -> -0.2;
    gain = smooth(0: 0 -> 0.25: 0.45 -> 0.85: 0.95 -> 1: 0);
  }

  voice sparkle_dust : granular {
    texture = spark;
    density = smooth(0: 18 -> 0.65: 110 -> 1: 260);
    grain_ms = 15ms;
    pitch = log(0: 900hz -> 0.65: 3200hz -> 1: 6800hz);
    spread = 0.82;
    burstiness = 0.45;
    turbulence = 0.55;
    stereo_width = 0.9;
    itd_ms = 0.35ms;
    highpass = 1200hz;
    fx : delay { mix = 22%; time_ms = 110ms; feedback = 30%; damping = 6500hz; ping_pong = true; }
    drift { target = pan; depth = 40%; rate = 2.2hz; }
    gain { env = adsr; attack = 80ms; decay = 250ms; sustain = 0.72; release = 220ms; peak = 0.78; }
  }

  seq surge {
    start = 40ms;
    step core { voice = arc_core; at = 0s; duration = 2.2s; vary_pitch = -55cents..55cents; }
    step choir { voice = fm_surge; at = 1.68s; duration = 560ms; vary_pitch = -55cents..55cents; }
    step sparks { voice = sparkle_dust; at = 0.06s; duration = 2.14s; vary_pitch = -70cents..70cents; vary_gain = 85%..115%; }
  }

  variants { base = 42; alternate = 43; }
  master { gain = 2db; target = -14lufs; peak = -1.5db; air = 35%; glue = 30%; width = 1.25; limit = true; }
}
