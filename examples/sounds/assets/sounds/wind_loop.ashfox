ashfox 1
sound wind_loop {
  profile = ambient;
  duration = 5s;
  channels = 2;
  seed = 7349;
  space { preset = courtyard; mix = 24%; }
  voice deep_gust : noise {
    color = brown;
    filter bandpass {
      cutoff { domain = log; interpolation = smooth; points = [(0, 160hz), (0.35, 420hz), (0.7, 220hz), (1, 160hz)]; }
      q = 1.1;
    }
    highpass = 38hz;
    pan = -0.2;
    gain { domain = linear; interpolation = smooth; points = [(0, 0.65), (0.35, 0.98), (0.7, 0.55), (1, 0.65)]; }
  }
  voice canopy_howl : noise {
    color = pink;
    filter bandpass {
      cutoff { domain = log; interpolation = smooth; points = [(0, 650hz), (0.32, 1850hz), (0.72, 880hz), (1, 650hz)]; }
      q = 1.8;
    }
    pan = 0.22;
    gain { domain = linear; interpolation = smooth; points = [(0, 0.42), (0.32, 0.88), (0.72, 0.38), (1, 0.42)]; }
  }
  voice wind_grains : granular {
    texture = wind;
    density { domain = linear; interpolation = smooth; points = [(0, 24), (0.34, 64), (0.72, 30), (1, 24)]; }
    grain_ms = 56ms;
    pitch { domain = log; interpolation = smooth; points = [(0, 420hz), (0.34, 980hz), (0.72, 520hz), (1, 420hz)]; }
    spread = 65%;
    turbulence = 72%;
    highpass = 120hz;
    pan = -0.08;
    gain { domain = linear; interpolation = smooth; points = [(0, 0.48), (0.35, 0.85), (0.72, 0.44), (1, 0.48)]; }
  }
  voice breeze_air : noise {
    color = white;
    highpass = 3200hz;
    lowpass = 12000hz;
    gain { domain = linear; interpolation = smooth; points = [(0, 0.14), (0.38, 0.32), (1, 0.14)]; }
  }
  seq phrase {
    start = 0.1s;
    step low { voice = deep_gust; at = 0s; duration = 4.8s; vary_gain = 90%..110%; }
    step mid { voice = canopy_howl; at = 0s; duration = 4.8s; vary_gain = 85%..115%; }
    step swirl { voice = wind_grains; at = 0s; duration = 4.8s; vary_pitch = -65cents..65cents; vary_gain = 85%..115%; }
    step air { voice = breeze_air; at = 0s; duration = 4.8s; }
  }
  variant base { seed = 42; }
  variant alternate { seed = 43; }
  loop { at = 0.5s..4.5s; xfade = 80ms; }
  master { gain = 4db; peak = -1.5db; target = -14lufs; warmth = 25%; air = 15%; glue = 20%; width = 1.15; limit = true; }
}
