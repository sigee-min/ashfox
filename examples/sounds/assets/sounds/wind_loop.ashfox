ashfox 1
sound wind_loop {
  profile = ambient;
  duration = 5s;
  seed = 7349;
  space { preset = courtyard; mix = 22%; width = 0.85; }

  voice deep_gust : noise {
    color = brown;
    filter : bandpass { cutoff = log(0: 170hz -> 0.35: 410hz -> 0.7: 230hz -> 1: 170hz); q = 1.1; }
    highpass = 38hz;
    drift { target = cutoff; depth = 35%; rate = 0.45hz; }
    pan = -0.18 -> 0.14;
    gain = smooth(0: 0.65 -> 0.35: 0.98 -> 0.7: 0.55 -> 1: 0.65);
  }

  voice canopy_howl : waveguide {
    model = pipe;
    pitch = log(0: 360hz -> 0.35: 580hz -> 0.72: 410hz -> 1: 360hz);
    damping = 0.45;
    brightness = 0.55;
    filter : bandpass { cutoff = log(0: 650hz -> 0.32: 1850hz -> 0.72: 880hz -> 1: 650hz); q = 1.6; }
    drift { target = pan; depth = 18%; rate = 0.35hz; }
    gain = smooth(0: 0.42 -> 0.32: 0.82 -> 0.72: 0.38 -> 1: 0.42);
  }

  voice wind_grains : granular {
    texture = wind;
    density = lin(0: 24 -> 0.34: 64 -> 0.72: 30 -> 1: 24);
    grain_ms = 56ms;
    pitch = log(0: 420hz -> 0.34: 980hz -> 0.72: 520hz -> 1: 420hz);
    spread = 0.55;
    turbulence = 0.72;
    stereo_width = 0.55;
    itd_ms = 0.15ms;
    highpass = 120hz;
    drift { target = gain; depth = 24%; rate = 0.4hz; }
    pan = -0.06;
    gain = smooth(0: 0.48 -> 0.35: 0.85 -> 0.72: 0.44 -> 1: 0.48);
  }

  voice breeze_air : noise {
    color = white;
    highpass = 3200hz;
    lowpass = 12000hz;
    drift { target = pan; depth = 22%; rate = 0.3hz; }
    gain = smooth(0: 0.14 -> 0.38: 0.32 -> 1: 0.14);
  }

  seq phrase {
    start = 100ms;
    step low { voice = deep_gust; at = 0s; duration = 4.8s; vary_gain = 90%..110%; }
    step mid { voice = canopy_howl; at = 0s; duration = 4.8s; vary_gain = 85%..115%; }
    step swirl { voice = wind_grains; at = 0s; duration = 4.8s; vary_pitch = -65cents..65cents; vary_gain = 85%..115%; }
    step air { voice = breeze_air; at = 0s; duration = 4.8s; }
  }

  variants { base = 42; alternate = 43; }
  loop { at = 0.5s..4.5s; xfade = 80ms; }
  master { gain = 4db; target = -14lufs; peak = -1.5db; warmth = 25%; air = 15%; glue = 20%; width = 1.0; limit = true; }
}
