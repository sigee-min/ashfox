ashfox-model 1
sound claw_hit {
  profile = "impact";
  duration = 0.58;
  sampleRate = 48000;
  channels = 2;
  seed = 42;
  space = { mix = 0.2; decay = 0.28; damping = 5200; size = 0.75; };
  voices = [{
    id = "flesh_thud";
    source = {
      kind = "resonator";
      excitation = { kind = "mallet"; duration = 0.011; hardness = 0.88; };
      modes = [
        { id = "sub"; hz = 88; decay = 0.24; gain = 1.0; },
        { id = "punch"; hz = 225; decay = 0.15; gain = 0.75; },
        { id = "crack"; hz = 1480; decay = 0.065; gain = 0.48; }
      ];
      pitchDropCents = 190;
      pitchDropSeconds = 0.035;
    };
    drive = 3.0;
    highpass = 32;
    lowpass = 11500;
    gain = { env = "ad"; attack = 0.003; peak = 1.0; curve = "exp"; };
  }, {
    id = "slash_tear";
    source = { kind = "noise"; color = "pink"; };
    filter = {
      kind = "bandpass";
      cutoff = { domain = "log"; interpolation = "smooth"; points = [{ at = 0; value = 6800; }, { at = 1; value = 720; }]; };
      q = 1.15;
    };
    drive = 2.0;
    pan = -0.18;
    gain = { env = "ad"; attack = 0.003; peak = 0.92; curve = "exp"; };
  }, {
    id = "blade_air";
    source = { kind = "noise"; color = "white"; };
    highpass = 4800;
    pan = 0.2;
    gain = { env = "ad"; attack = 0.002; peak = 0.4; curve = "exp"; };
  }];
  sequences = [{
    id = "hit";
    start = 0.01;
    steps = [
      { id = "impact"; voice = "flesh_thud"; at = 0; duration = 0.48; vary = { pitchCents = [-45, 45]; }; },
      { id = "slash"; voice = "slash_tear"; at = 0; duration = 0.32; vary = { duration = [0.9, 1.1]; gain = [0.9, 1.1]; }; },
      { id = "air"; voice = "blade_air"; at = 0; duration = 0.1; vary = { gain = [0.85, 1.15]; }; }
    ];
  }];
  variants = [{ id = "base"; seed = 42; }, { id = "alternate"; seed = 43; }];
  playback = { kind = "oneshot"; };
  output = { gainDb = 3; peakDb = -2; softClip = true; };
}
