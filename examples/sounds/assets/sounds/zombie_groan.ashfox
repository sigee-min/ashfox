ashfox 1
sound zombie_groan {
  profile = creature;
  duration = 1.65s;
  channels = 2;
  seed = 8421;
  space { preset = cavern; mix = 22%; }
  voice undead_throat : vocal {
    pitch { domain = log; interpolation = smooth; points = [(0, 118hz), (0.24, 136hz), (0.65, 92hz), (1, 72hz)]; }
    formant { domain = log; interpolation = smooth; points = [(0, 360hz), (0.3, 610hz), (0.72, 480hz), (1, 340hz)]; }
    formant { domain = log; interpolation = smooth; points = [(0, 840hz), (0.3, 1120hz), (0.72, 920hz), (1, 760hz)]; }
    formant { domain = log; interpolation = smooth; points = [(0, 2100hz), (0.35, 2480hz), (1, 1950hz)]; }
    formant { domain = log; interpolation = smooth; points = [(0, 3150hz), (0.35, 3550hz), (1, 2900hz)]; }
    bandwidths = [105hz, 180hz, 320hz, 440hz];
    breath = 28%;
    jitter = 24%;
    roughness = 60%;
    growl = 72%;
    chest = 65%;
    nasal = 25%;
    highpass = 52hz;
    lowpass { domain = log; interpolation = smooth; points = [(0, 4800hz), (0.35, 6500hz), (1, 2200hz)]; }
    drive = 2;
    pan = -0.1;
    gain { env = adsr; attack = 80ms; decay = 0.22s; sustain = 76%; release = 0.24s; peak = 0.98; }
  }
  voice rasp_breath : noise {
    color = pink;
    filter bandpass {
      cutoff { domain = log; interpolation = smooth; points = [(0, 1600hz), (0.3, 3400hz), (1, 900hz)]; }
      q = 1.25;
    }
    drive = 1.6;
    pan = 0.16;
    gain { env = adsr; attack = 60ms; decay = 0.2s; sustain = 52%; release = 0.22s; peak = 0.55; }
  }
  voice chest_rasp : noise {
    color = brown;
    filter lowpass {
      cutoff { domain = log; interpolation = smooth; points = [(0, 260hz), (0.4, 420hz), (1, 160hz)]; }
      q = 1;
    }
    highpass = 36hz;
    gain { env = adsr; attack = 80ms; decay = 0.25s; sustain = 60%; release = 0.24s; peak = 0.62; }
  }
  seq groan {
    start = 30ms;
    step voice { voice = undead_throat; at = 0s; duration = 1.48s; vary_timing = 0s..30ms; vary_pitch = -65cents..65cents; }
    step rasp { voice = rasp_breath; at = 20ms; duration = 1.4s; vary_gain = 85%..115%; }
    step sub { voice = chest_rasp; at = 0s; duration = 1.45s; }
  }
  variant base { seed = 42; }
  variant alternate { seed = 43; }
  master { gain = 5db; peak = -1.5db; target = -14lufs; warmth = 30%; glue = 20%; limit = true; }
}
