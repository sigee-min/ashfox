ashfox 1
sound zombie_groan {
  profile = creature;
  duration = 1.65s;
  seed = 8421;
  space { preset = cavern; mix = 22%; }

  voice undead_throat : vocal {
    pitch = log(0: 118hz -> 0.24: 136hz -> 0.65: 92hz -> 1: 72hz);
    vowels = uh -> aa -> er -> oo;
    breath = 0.28;
    jitter = 0.24;
    roughness = 0.62;
    growl = 0.78;
    chest = 0.68;
    nasal = 0.28;
    rattle = 0.72;
    highpass = 52hz;
    lowpass = log(0: 4800hz -> 0.35: 6500hz -> 1: 2200hz);
    eq { low = (120hz, 2.5db); }
    drive : tube { amount = 2.1; }
    pan = -0.1;
    gain { env = adsr; attack = 80ms; decay = 220ms; sustain = 0.76; release = 240ms; peak = 0.98; }
  }

  voice rasp_breath : noise {
    color = pink;
    filter : bandpass { cutoff = log(0: 1600hz -> 0.3: 3400hz -> 1: 900hz); q = 1.25; }
    drive : grit { amount = 1.6; }
    pan = 0.28 -> -0.18;
    gain { env = adsr; attack = 60ms; decay = 200ms; sustain = 0.52; release = 220ms; peak = 0.55; }
  }

  voice chest_rasp : noise {
    color = brown;
    filter : lowpass { cutoff = log(0: 260hz -> 0.4: 420hz -> 1: 160hz); q = 1.0; }
    highpass = 36hz;
    duck { by = undead_throat; amount = 25%; release_ms = 100ms; }
    gain { env = adsr; attack = 80ms; decay = 250ms; sustain = 0.6; release = 240ms; peak = 0.62; }
  }

  seq groan {
    start = 30ms;
    step voice { voice = undead_throat; at = 0s; duration = 1.48s; vary_pitch = -65cents..65cents; vary_timing = 0ms..30ms; }
    step rasp { voice = rasp_breath; at = 20ms; duration = 1.4s; vary_gain = 85%..115%; }
    step sub { voice = chest_rasp; at = 0s; duration = 1.45s; }
  }

  variants { base = 42; alternate = 43; }
  master { gain = 5db; target = -14lufs; peak = -1.5db; warmth = 30%; glue = 20%; limit = true; }
}
