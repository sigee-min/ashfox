ashfox 1
sound metal_strike {
  profile = impact;
  duration = 2.55s;
  channels = 2;
  seed = 7349;
  space { preset = stone_hall; mix = 22%; }
  voice steel_ring : material {
    material = steel;
    pitch = 310hz;
    size = 1.2;
    hardness = 92%;
    damping = 36%;
    brightness = 80%;
    modes = 26;
    strike = mallet;
    filter lowpass {
      cutoff { domain = log; interpolation = smooth; points = [(0, 14500hz), (0.35, 3400hz), (1, 950hz)]; }
      q = 1.1;
    }
    highpass = 50hz;
    drive = 1.8;
    pan = -0.14;
    gain { env = ad; attack = 2ms; peak = 0.95; curve = exp; }
  }
  voice iron_anvil : resonator {
    excitation mallet { duration = 8ms; hardness = 88%; }
    mode sub { hz = 78hz; decay = 0.32s; gain = 0.9; }
    mode low { hz = 156hz; decay = 0.36s; gain = 1; }
    mode mid { hz = 468hz; decay = 0.24s; gain = 0.6; }
    mode bite { hz = 1120hz; decay = 0.14s; gain = 0.38; }
    pitch_drop_cents = 85cents;
    pitch_drop_seconds = 22ms;
    highpass = 35hz;
    drive = 1.5;
    pan = 0.08;
    gain { env = ad; attack = 2ms; peak = 0.92; curve = exp; }
  }
  voice clang_spark : granular {
    texture = spark;
    density = 135;
    grain_ms = 12ms;
    pitch { domain = log; interpolation = smooth; points = [(0, 8500hz), (1, 1200hz)]; }
    spread = 72%;
    burstiness = 65%;
    turbulence = 55%;
    highpass = 600hz;
    pan = 0.2;
    gain { env = ad; attack = 2ms; peak = 0.7; curve = exp; }
  }
  seq forge {
    start = 20ms;
    repeat { count = 4; period = 0.64s; }
    step ring { voice = steel_ring; at = 0s; duration = 0.36s; vary_timing = -0.005s..5ms; vary_pitch = -55cents..55cents; vary_gain = 90%..110%; }
    step anvil { voice = iron_anvil; at = 0s; duration = 0.34s; vary_pitch = -55cents..55cents; vary_gain = 90%..110%; }
    step hit { voice = clang_spark; at = 0s; duration = 0.22s; vary_pitch = -80cents..80cents; }
  }
  variant base { seed = 42; }
  variant alternate { seed = 43; }
  master { gain = 5db; peak = -1.5db; target = -12lufs; punch = 40%; air = 20%; glue = 20%; limit = true; }
}
