ashfox 1
sound metal_strike {
  profile = impact;
  duration = 2.55s;
  seed = 7349;
  space { preset = stone_hall; mix = 22%; }

  voice steel_ring : modal_plate {
    material = steel;
    pitch = 310hz;
    size = 1.2;
    hardness = 0.92;
    damping = 0.36;
    brightness = 0.8;
    modes = 20;
    strike = mallet;
    twin_beat = 0.6;
    splash = 0.48;
    stereo_spread = 0.62;
    highpass = 50hz;
    filter : lowpass { cutoff = log(0: 14500hz -> 0.35: 3400hz -> 1: 950hz); q = 1.1; }
    eq { mid = (1400hz, 2db, 1.1); high = (5500hz, 2db); }
    drive : tube { amount = 1.8; }
    pan = -0.14;
    gain { env = ad; attack = 2ms; peak = 0.95; curve = exp; }
  }

  voice iron_anvil : waveguide {
    model = blade;
    pitch = log(0: 168hz -> 0.15: 156hz -> 1: 156hz);
    damping = 0.28;
    stiffness = 0.72;
    brightness = 0.68;
    highpass = 45hz;
    eq { low = (140hz, 3db); }
    drive : tape { amount = 1.5; }
    pan = 0.08;
    gain { env = ad; attack = 2ms; peak = 0.92; curve = exp; }
  }

  voice clang_spark : granular {
    texture = spark;
    density = 135;
    grain_ms = 12ms;
    pitch = log(0: 8500hz -> 1: 1200hz);
    spread = 0.72;
    burstiness = 0.65;
    turbulence = 0.55;
    stereo_width = 0.82;
    itd_ms = 0.3ms;
    highpass = 600hz;
    duck { by = steel_ring; amount = 28%; release_ms = 70ms; }
    pan = 0.2;
    gain { env = ad; attack = 2ms; peak = 0.85; curve = exp; }
  }

  seq forge {
    start = 20ms;
    repeat { count = 4; period = 640ms; }
    step ring { voice = steel_ring; at = 0s; duration = 360ms; vary_timing = -5ms..5ms; vary_pitch = -55cents..55cents; vary_gain = 90%..110%; }
    step anvil { voice = iron_anvil; at = 0s; duration = 340ms; vary_pitch = -55cents..55cents; vary_gain = 90%..110%; }
    step hit { voice = clang_spark; at = 0s; duration = 220ms; vary_pitch = -80cents..80cents; }
  }

  variants { base = 42; alternate = 43; }
  master { gain = 6db; target = -12lufs; peak = -1.5db; punch = 40%; air = 20%; glue = 20%; limit = true; }
}
