ashfox 1
sound mechanical_loop {
  profile = ambient;
  duration = 3s;
  seed = 7349;
  space { preset = timber_room; mix = 18%; }

  voice turbine_hum : osc {
    waveform = saw;
    pitch = log(0: 88hz -> 0.5: 112hz -> 1: 88hz);
    unison = 3;
    detune_cents = 18cents;
    filter : lowpass { cutoff = log(0: 480hz -> 0.5: 3800hz -> 1: 480hz); q = 1.6; }
    highpass = 35hz;
    drive : tape { amount = 2.0; }
    drift { target = cutoff; depth = 28%; rate = 0.6hz; }
    pan = -0.15;
    gain = smooth(0: 0.45 -> 0.5: 0.65 -> 1: 0.45);
  }

  voice gear_ratchet : modal_plate {
    material = iron;
    pitch = 340hz;
    size = 0.85;
    hardness = 0.9;
    damping = 0.58;
    brightness = 0.78;
    modes = 20;
    strike = mallet;
    twin_beat = 0.25;
    splash = 0.3;
    stereo_spread = 0.55;
    highpass = 60hz;
    filter : lowpass { cutoff = log(0: 12000hz -> 1: 2400hz); q = 1.0; }
    drive : grit { amount = 1.6; }
    pan = 0.2;
    gain { env = ad; attack = 2ms; peak = 1.0; curve = exp; }
  }

  voice steam_chuff : noise {
    color = white;
    filter : bandpass { cutoff = log(0: 8500hz -> 1: 680hz); q = 1.1; }
    duck { by = gear_ratchet; amount = 32%; release_ms = 85ms; }
    pan = -0.3 -> 0.2;
    gain { env = ad; attack = 6ms; peak = 0.95; curve = exp; }
  }

  seq bed {
    start = 50ms;
    step motor { voice = turbine_hum; at = 0s; duration = 2.85s; vary_pitch = -35cents..35cents; }
  }

  seq cogs {
    start = 60ms;
    repeat { count = 7; period = 360ms; }
    step tick { voice = gear_ratchet; at = 0s; duration = 140ms; vary_pitch = -55cents..55cents; vary_timing = -4ms..4ms; }
    step chuff { voice = steam_chuff; at = 140ms; duration = 220ms; vary_gain = 85%..115%; }
  }

  variants { base = 42; alternate = 43; }
  loop { at = 0.35s..2.55s; xfade = 80ms; }
  master { gain = 3db; target = -14lufs; peak = -1.5db; punch = 25%; warmth = 20%; glue = 25%; limit = true; }
}
