ashfox-model 1
sound mechanical_loop {
  profile = "ambient";
  duration = 3.0;
  sampleRate = 48000;
  channels = 2;
  seed = 7349;
  space = { preset = "timber_room"; mix = 0.18; };
  voices = [{
    id = "turbine_hum";
    source = {
      kind = "osc";
      waveform = "saw";
      pitch = { domain = "log"; interpolation = "smooth"; points = [{ at = 0; value = 88; }, { at = 0.5; value = 112; }, { at = 1; value = 88; }]; };
      unison = 3;
      detuneCents = 18;
    };
    filter = { kind = "lowpass"; cutoff = { domain = "log"; interpolation = "smooth"; points = [{ at = 0; value = 480; }, { at = 0.5; value = 3800; }, { at = 1; value = 480; }]; }; q = 1.6; };
    drive = 2.0;
    highpass = 35;
    pan = -0.15;
    gain = { domain = "linear"; interpolation = "smooth"; points = [{ at = 0; value = 0.45; }, { at = 0.5; value = 0.65; }, { at = 1; value = 0.45; }]; };
  }, {
    id = "gear_ratchet";
    source = {
      kind = "material";
      material = "iron";
      pitch = 340;
      size = 0.85;
      hardness = 0.9;
      damping = 0.58;
      brightness = 0.78;
      modes = 20;
      strike = "mallet";
    };
    drive = 1.6;
    highpass = 60;
    filter = { kind = "lowpass"; cutoff = { domain = "log"; interpolation = "smooth"; points = [{ at = 0; value = 12000; }, { at = 1; value = 2400; }]; }; q = 1.0; };
    pan = 0.2;
    gain = { env = "ad"; attack = 0.002; peak = 1.0; curve = "exp"; };
  }, {
    id = "steam_chuff";
    source = { kind = "noise"; color = "white"; };
    filter = { kind = "bandpass"; cutoff = { domain = "log"; interpolation = "smooth"; points = [{ at = 0; value = 8500; }, { at = 1; value = 680; }]; }; q = 1.1; };
    pan = -0.2;
    gain = { env = "ad"; attack = 0.006; peak = 0.95; curve = "exp"; };
  }];
  sequences = [{
    id = "bed";
    start = 0.05;
    steps = [
      { id = "motor"; voice = "turbine_hum"; at = 0; duration = 2.85; vary = { pitchCents = [-35, 35]; }; }
    ];
  }, {
    id = "cogs";
    start = 0.06;
    repeat = { count = 7; period = 0.36; };
    steps = [
      { id = "tick"; voice = "gear_ratchet"; at = 0; duration = 0.14; vary = { pitchCents = [-55, 55]; timing = [-0.004, 0.004]; }; },
      { id = "chuff"; voice = "steam_chuff"; at = 0.14; duration = 0.22; vary = { gain = [0.85, 1.15]; }; }
    ];
  }];
  variants = [{ id = "base"; seed = 42; }, { id = "alternate"; seed = 43; }];
  playback = { kind = "loop"; start = 0.35; end = 2.55; crossfade = 0.08; };
  output = { gainDb = 3; peakDb = -1.5; targetLufs = -14; punch = 0.25; warmth = 0.2; glue = 0.25; limit = true; };
