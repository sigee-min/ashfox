ashfox 1
sound griffin_call {
  profile = creature;
  duration = 1.45s;
  channels = 2;
  seed = 42;
  space { preset = cavern; mix = 24%; }
  voice shriek : vocal {
    pitch { domain = log; interpolation = smooth; points = [(0, 240hz), (0.22, 430hz), (0.82, 165hz), (1, 130hz)]; }
    formant { domain = log; interpolation = smooth; points = [(0, 540hz), (0.25, 780hz), (1, 460hz)]; }
    formant { domain = log; interpolation = smooth; points = [(0, 1520hz), (0.25, 2150hz), (1, 1340hz)]; }
    formant { domain = log; interpolation = smooth; points = [(0, 2780hz), (0.25, 3450hz), (1, 2520hz)]; }
    formant { domain = log; interpolation = smooth; points = [(0, 3950hz), (0.25, 4600hz), (1, 3650hz)]; }
    bandwidths = [110hz, 210hz, 340hz, 460hz];
    breath = 24%;
    jitter = 24%;
    roughness = 45%;
    growl = 35%;
    chest = 40%;
    highpass = 60hz;
    lowpass { domain = log; interpolation = smooth; points = [(0, 9000hz), (1, 3200hz)]; }
    drive = 1.6;
    pan = -0.12;
    gain { env = adsr; attack = 25ms; decay = 0.16s; sustain = 72%; release = 0.18s; peak = 0.95; }
  }
  voice eagle_overtone : chirp {
    pitch { domain = log; interpolation = smooth; points = [(0, 1400hz), (0.25, 2500hz), (1, 980hz)]; }
    trill_hz = 14hz;
    trill_cents = 35cents;
    trill_depth = 16%;
    breath = 14%;
    jitter_cents = 35cents;
    brightness = 62%;
    filter bandpass {
      cutoff { domain = log; interpolation = smooth; points = [(0, 3800hz), (1, 1500hz)]; }
      q = 1.1;
    }
    pan = 0.18;
    gain { env = ad; attack = 20ms; peak = 0.38; curve = exp; }
  }
  voice wind_air : granular {
    texture = wind;
    density = 36;
    grain_ms = 45ms;
    pitch { domain = log; interpolation = smooth; points = [(0, 1800hz), (1, 650hz)]; }
    spread = 60%;
    turbulence = 50%;
    highpass = 120hz;
    pan = 0.1;
    gain { env = adsr; attack = 20ms; decay = 0.2s; sustain = 48%; release = 0.18s; peak = 0.42; }
  }
  seq cry {
    start = 20ms;
    step roar { voice = shriek; at = 0s; duration = 1.25s; vary_timing = 0s..20ms; vary_pitch = -65cents..65cents; }
    step scream { voice = eagle_overtone; at = 20ms; duration = 0.9s; vary_pitch = -70cents..70cents; }
    step air { voice = wind_air; at = 0s; duration = 1.2s; vary_pitch = -60cents..60cents; }
  }
  variant base { seed = 42; }
  variant alternate { seed = 43; }
  master { gain = 4db; peak = -1.5db; target = -14lufs; punch = 20%; warmth = 25%; glue = 25%; limit = true; }
}
