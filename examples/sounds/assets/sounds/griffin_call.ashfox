ashfox 1
sound griffin_call {
  profile = creature;
  duration = 1.45s;
  seed = 42;
  space { preset = cavern; mix = 24%; }

  voice shriek : vocal {
    pitch = log(0: 240hz -> 0.22: 430hz -> 0.82: 165hz -> 1: 130hz);
    vowels = ee -> aa -> aw -> oo;
    breath = 0.24;
    jitter = 0.24;
    roughness = 0.45;
    growl = 0.38;
    chest = 0.45;
    rattle = 0.35;
    highpass = 60hz;
    lowpass = log(0: 9000hz -> 1: 3200hz);
    eq { mid = (2200hz, 2db, 1.4); }
    drive : tube { amount = 1.7; }
    pan = -0.12;
    gain { env = adsr; attack = 25ms; decay = 160ms; sustain = 0.72; release = 180ms; peak = 0.95; }
  }

  voice eagle_overtone : chirp {
    pitch = log(0: 1400hz -> 0.25: 2500hz -> 1: 980hz);
    brightness = 0.62;
    trill_hz = 14hz;
    trill_cents = 35cents;
    trill_depth = 0.16;
    breath = 0.14;
    jitter_cents = 35cents;
    filter : bandpass { cutoff = log(0: 3800hz -> 1: 1500hz); q = 1.1; }
    fx : chorus { mix = 22%; rate = 2.4hz; depth = 35%; }
    pan = 0.18;
    gain { env = ad; attack = 20ms; peak = 0.42; curve = exp; }
  }

  voice wind_air : granular {
    texture = wind;
    density = 36;
    grain_ms = 45ms;
    pitch = log(0: 1800hz -> 1: 650hz);
    spread = 0.6;
    turbulence = 0.5;
    stereo_width = 0.78;
    itd_ms = 0.25ms;
    highpass = 120hz;
    pan = 0.1;
    gain { env = adsr; attack = 20ms; decay = 200ms; sustain = 0.48; release = 180ms; peak = 0.42; }
  }

  seq cry {
    start = 20ms;
    step roar { voice = shriek; at = 0s; duration = 1.25s; vary_pitch = -65cents..65cents; vary_timing = 0ms..20ms; }
    step scream { voice = eagle_overtone; at = 20ms; duration = 900ms; vary_pitch = -70cents..70cents; }
    step air { voice = wind_air; at = 0s; duration = 1.2s; vary_pitch = -60cents..60cents; }
  }

  variants { base = 42; alternate = 43; }
  master { gain = 4db; target = -14lufs; peak = -1.5db; punch = 20%; warmth = 25%; glue = 25%; limit = true; }
}
