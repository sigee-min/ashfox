ashfox 1
sound bow_shot {
  import "../module/foley_kit.ashfox" as fk { pitch = 190hz; damping = 0.48; spread = 0.4; };

  profile = foley;
  duration = 0.85s;
  seed = 6421;
  space { preset = courtyard; mix = 18%; }

  voice bowstring : waveguide {
    model = string;
    pitch = log(0: 245hz -> 0.25: 210hz -> 1: 192hz);
    damping = 0.32;
    stiffness = 0.25;
    brightness = 0.72;
    highpass = 55hz;
    eq { low = (180hz, 2db); }
    drive : tape { amount = 1.4; }
    pan = -0.15;
    gain { env = ad; attack = 2ms; peak = 0.95; curve = exp; }
  }

  voice arrow_whoosh : aero_whoosh {
    velocity = lin(0: 0.35 -> 0.18: 3.0 -> 0.7: 1.2 -> 1: 0.15);
    thickness = 0.015;
    doppler = 0.9;
    sweep_pan = -0.65 -> 0.85;
    noise_tone = 0.68;
    highpass = 120hz;
    duck { by = bowstring; amount = 22%; release_ms = 45ms; }
    gain { env = ad; attack = 4ms; peak = 0.92; curve = exp; }
  }

  seq release {
    start = 10ms;
    step string { voice = bowstring; at = 0s; duration = 420ms; vary_pitch = -55cents..55cents; vary_gain = 90%..110%; }
    step limb { voice = fk.wood_resonance; at = 0s; duration = 240ms; vary_pitch = -45cents..45cents; }
    step snap { voice = fk.air_transient; at = 0s; duration = 120ms; vary_gain = 85%..115%; }
    step flight { voice = arrow_whoosh; at = 12ms; duration = 680ms; vary_duration = 92%..108%; vary_gain = 90%..110%; }
  }

  variants { base = 42; alternate = 43; }
  master { gain = 5db; target = -12lufs; peak = -1.5db; punch = 40%; air = 25%; limit = true; }
}
