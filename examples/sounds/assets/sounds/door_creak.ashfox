ashfox 1
sound door_creak {
  import "../module/foley_kit.ashfox" as fk { pitch = 135hz; damping = 0.52; spread = 0.45; };

  profile = foley;
  duration = 1.85s;
  seed = 7713;
  space { preset = timber_room; mix = 28%; decay = 480ms; damping = 4800hz; size = 0.95; }

  voice hinge_creak : waveguide {
    model = creak;
    pitch = log(0: 195hz -> 0.28: 310hz -> 0.62: 245hz -> 1: 165hz);
    damping = 0.38;
    stiffness = 0.45;
    bow_pressure = 0.78;
    brightness = 0.64;
    highpass = 85hz;
    eq { mid = (1400hz, 2db, 1.2); }
    drive : grit { amount = 1.6; }
    drift { target = pitch; depth = 18%; rate = 3.2hz; }
    pan = -0.35 -> 0.15;
    gain { env = adsr; attack = 45ms; decay = 280ms; sustain = 0.75; release = 220ms; peak = 0.95; }
  }

  seq swing {
    start = 25ms;
    step creak { voice = hinge_creak; at = 0s; duration = 1.65s; vary_pitch = -75cents..75cents; vary_timing = 0ms..20ms; }
    step wood { voice = fk.wood_resonance; at = 10ms; duration = 460ms; vary_pitch = -45cents..45cents; vary_gain = 85%..110%; }
    step grit { voice = fk.hinge_grit; at = 20ms; duration = 1.45s; vary_gain = 85%..115%; }
  }

  variants { base = 42; alternate = 43; }
  master { gain = 5db; target = -13lufs; peak = -1.5db; warmth = 25%; glue = 20%; limit = true; }
}
