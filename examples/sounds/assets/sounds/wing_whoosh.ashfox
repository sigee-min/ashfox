ashfox 1
sound wing_whoosh {
  profile = foley;
  duration = 0.72s;
  channels = 2;
  seed = 42;
  space { preset = courtyard; mix = 20%; }
  voice air_sweep : noise {
    color = pink;
    filter bandpass {
      cutoff { domain = log; interpolation = smooth; points = [(0, 160hz), (0.35, 2400hz), (1, 360hz)]; }
      q = 1.1;
    }
    highpass = 45hz;
    pan = -0.18;
    gain { env = adsr; attack = 40ms; decay = 0.16s; sustain = 55%; release = 0.18s; peak = 0.95; }
  }
  voice feather_flutter : granular {
    texture = foliage;
    density = 110;
    grain_ms = 20ms;
    pitch { domain = log; interpolation = smooth; points = [(0, 2200hz), (0.35, 6400hz), (1, 1500hz)]; }
    spread = 72%;
    turbulence = 58%;
    highpass = 550hz;
    pan = 0.22;
    gain { env = adsr; attack = 30ms; decay = 0.14s; sustain = 45%; release = 0.14s; peak = 0.85; }
  }
  voice wing_thump : material {
    material = leather;
    pitch = 74hz;
    size = 1.5;
    hardness = 55%;
    damping = 76%;
    brightness = 52%;
    modes = 12;
    strike = mallet;
    highpass = 30hz;
    gain { env = ad; attack = 5ms; peak = 0.95; curve = exp; }
  }
  voice wing_air : noise {
    color = white;
    filter bandpass {
      cutoff { domain = log; interpolation = smooth; points = [(0, 6200hz), (1, 1800hz)]; }
      q = 1.1;
    }
    pan = 0.14;
    gain { env = ad; attack = 4ms; peak = 0.48; curve = exp; }
  }
  seq flap {
    start = 15ms;
    step thump { voice = wing_thump; at = 0s; duration = 0.38s; vary_pitch = -65cents..65cents; vary_gain = 90%..110%; }
    step air { voice = wing_air; at = 0s; duration = 0.16s; }
    step sweep { voice = air_sweep; at = 10ms; duration = 0.62s; vary_gain = 90%..110%; vary_duration = 92%..108%; }
    step flutter { voice = feather_flutter; at = 20ms; duration = 0.54s; vary_pitch = -65cents..65cents; }
  }
  variant base { seed = 42; }
  variant alternate { seed = 43; }
  master { gain = 5db; peak = -1.5db; target = -13lufs; punch = 30%; air = 25%; warmth = 20%; limit = true; }
}
