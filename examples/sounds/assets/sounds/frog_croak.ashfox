ashfox 1
sound frog_croak {
  profile = creature;
  duration = 1.15s;
  channels = 2;
  seed = 42;
  space { preset = courtyard; mix = 22%; }
  voice throat : vocal {
    pitch { domain = log; interpolation = smooth; points = [(0, 112hz), (0.35, 92hz), (1, 64hz)]; }
    formant { domain = log; interpolation = smooth; points = [(0, 380hz), (0.3, 540hz), (1, 360hz)]; }
    formant { domain = log; interpolation = smooth; points = [(0, 960hz), (0.3, 1280hz), (1, 920hz)]; }
    formant { domain = log; interpolation = smooth; points = [(0, 2150hz), (0.3, 2600hz), (1, 2050hz)]; }
    bandwidths = [75hz, 140hz, 260hz];
    breath = 14%;
    jitter = 18%;
    roughness = 72%;
    growl = 45%;
    chest = 30%;
    highpass = 55hz;
    lowpass { domain = log; interpolation = smooth; points = [(0, 5400hz), (1, 1800hz)]; }
    drive = 2;
    pan = -0.1;
    gain { env = adsr; attack = 25ms; decay = 0.12s; sustain = 72%; release = 80ms; peak = 0.95; }
  }
  voice pond_water : granular {
    texture = water;
    density = 28;
    grain_ms = 24ms;
    pitch { domain = log; interpolation = smooth; points = [(0, 1400hz), (1, 650hz)]; }
    spread = 65%;
    turbulence = 45%;
    highpass = 180hz;
    pan = 0.16;
    gain { env = ad; attack = 15ms; peak = 0.42; curve = exp; }
  }
  seq ribbit {
    start = 20ms;
    repeat { count = 2; period = 0.52s; }
    step croak { voice = throat; at = 0s; duration = 0.44s; vary_timing = -0.01s..10ms; vary_pitch = -65cents..65cents; vary_gain = 90%..110%; }
    step splash { voice = pond_water; at = 10ms; duration = 0.36s; vary_pitch = -60cents..60cents; }
  }
  variant base { seed = 42; }
  variant alternate { seed = 43; }
  master { gain = 8db; peak = -1.5db; target = -14lufs; warmth = 20%; punch = 20%; limit = true; }
}
