ashfox 1
sound frog_croak {
  profile = creature;
  duration = 1.15s;
  seed = 42;
  space { preset = courtyard; mix = 22%; }

  voice throat : vocal {
    pitch = log(0: 112hz -> 0.35: 92hz -> 1: 64hz);
    vowels = oo -> aw -> uh;
    breath = 0.14;
    jitter = 0.18;
    roughness = 0.72;
    growl = 0.48;
    chest = 0.35;
    rattle = 0.65;
    highpass = 55hz;
    lowpass = log(0: 5400hz -> 1: 1800hz);
    eq { low = (140hz, 2db); }
    drive : tube { amount = 2.0; }
    pan = -0.1;
    gain { env = adsr; attack = 25ms; decay = 120ms; sustain = 0.72; release = 80ms; peak = 0.95; }
  }

  voice pond_water : granular {
    texture = water;
    density = 28;
    grain_ms = 24ms;
    pitch = log(0: 1400hz -> 1: 650hz);
    spread = 0.65;
    turbulence = 0.45;
    stereo_width = 0.78;
    itd_ms = 0.25ms;
    highpass = 180hz;
    duck { by = throat; amount = 25%; release_ms = 80ms; }
    pan = 0.16;
    gain { env = ad; attack = 15ms; peak = 0.45; curve = exp; }
  }

  seq ribbit {
    start = 20ms;
    repeat { count = 2; period = 520ms; }
    step croak { voice = throat; at = 0s; duration = 440ms; vary_pitch = -65cents..65cents; vary_timing = -10ms..10ms; vary_gain = 90%..110%; }
    step splash { voice = pond_water; at = 10ms; duration = 360ms; vary_pitch = -60cents..60cents; }
  }

  variants { base = 42; alternate = 43; }
  master { gain = 8db; target = -14lufs; peak = -1.5db; punch = 20%; warmth = 20%; limit = true; }
}
