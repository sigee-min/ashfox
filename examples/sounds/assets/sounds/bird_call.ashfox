ashfox-model 1
sound bird_call {
  import "../module/bird_voices.ashfox" as bv;
  profile = "creature";
  duration = 2.2;
  sampleRate = 48000;
  channels = 2;
  seed = 7349;
  space = { mix = 0.22; decay = 0.35; damping = 7200; size = 1.1; };
  voices = [bv.opening_whistle, bv.answering_trill, bv.forest_air, bv.canopy_low];
  sequences = [{
    id = "phrase";
    start = 0.04;
    steps = [
      { id = "call1"; voice = "opening_whistle"; at = 0; duration = 0.42; vary = { pitchCents = [-80, 80]; timing = [0, 0.03]; }; },
      { id = "reply1"; voice = "answering_trill"; at = 0.54; duration = 0.45; vary = { pitchCents = [-90, 90]; gain = [0.85, 1.15]; }; },
      { id = "call2"; voice = "opening_whistle"; at = 1.12; duration = 0.36; pitchCents = 120; vary = { pitchCents = [-60, 60]; }; },
      { id = "reply2"; voice = "answering_trill"; at = 1.56; duration = 0.48; pitchCents = -100; vary = { pitchCents = [-80, 80]; }; },
      { id = "bed"; voice = "forest_air"; at = 0; duration = 2.0; },
      { id = "low"; voice = "canopy_low"; at = 0; duration = 2.0; }
    ];
  }];
  variants = [{ id = "base"; seed = 218; }, { id = "alternate"; seed = 907; }];
  playback = { kind = "oneshot"; };
  output = { gainDb = 0; peakDb = -2; softClip = true; };
}
