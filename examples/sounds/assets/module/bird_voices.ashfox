ashfox 1
module bird_voices {
  export voice opening_whistle : chirp {
    trill_hz = 11hz;
    trill_cents = 38cents;
    trill_depth = 14%;
    breath = 8%;
    jitter_cents = 42cents;
    brightness = 65%;
    pitch { domain = log; interpolation = smooth; points = [(0, 2200hz), (0.25, 4400hz), (0.65, 5200hz), (1, 2900hz)]; }
    filter bandpass {
      cutoff { domain = log; interpolation = smooth; points = [(0, 2600hz), (1, 6400hz)]; }
      q = 0.9;
    }
    pan = -0.2;
    gain { env = adsr; attack = 15ms; decay = 80ms; sustain = 72%; release = 60ms; peak = 0.9; curve = exp; }
  }
  export voice answering_trill : chirp {
    trill_hz = 18hz;
    trill_cents = 55cents;
    trill_depth = 22%;
    breath = 12%;
    jitter_cents = 30cents;
    brightness = 75%;
    pitch { domain = log; interpolation = smooth; points = [(0, 3600hz), (0.35, 5600hz), (1, 2400hz)]; }
    highpass = 900hz;
    pan = 0.22;
    gain { env = ad; attack = 10ms; peak = 0.85; curve = exp; }
  }
  export voice forest_air : noise {
    color = white;
    filter bandpass {
      cutoff { domain = log; interpolation = smooth; points = [(0, 4800hz), (0.5, 8200hz), (1, 4800hz)]; }
      q = 0.9;
    }
    gain { env = adsr; attack = 40ms; decay = 0.2s; sustain = 55%; release = 0.2s; peak = 0.35; }
  }
  export voice canopy_low : noise {
    color = brown;
    filter lowpass {
      cutoff { domain = log; interpolation = smooth; points = [(0, 220hz), (0.5, 420hz), (1, 220hz)]; }
      q = 1;
    }
    highpass = 45hz;
    gain { env = adsr; attack = 40ms; decay = 0.2s; sustain = 72%; release = 0.2s; peak = 0.85; }
  }
}
