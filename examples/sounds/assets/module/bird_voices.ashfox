ashfox 1
module bird_voices {
  params {
    bright = 0.68;
  }

  export voice opening_whistle : chirp {
    pitch = log(0: 2200hz -> 0.25: 4400hz -> 0.65: 5200hz -> 1: 2900hz);
    brightness = bright;
    trill_hz = 11hz;
    trill_cents = 38cents;
    trill_depth = 0.14;
    breath = 0.08;
    jitter_cents = 42cents;
    filter : bandpass { cutoff = log(0: 2600hz -> 1: 6400hz); q = 0.9; }
    pan = -0.35 -> 0.05;
    gain { env = adsr; attack = 15ms; decay = 80ms; sustain = 0.72; release = 60ms; peak = 0.9; curve = exp; }
  }

  export voice answering_trill : chirp {
    pitch = log(0: 3600hz -> 0.35: 5600hz -> 1: 2400hz);
    brightness = 0.75;
    trill_hz = 18hz;
    trill_cents = 55cents;
    trill_depth = 0.22;
    breath = 0.12;
    jitter_cents = 30cents;
    highpass = 900hz;
    fx : delay { mix = 16%; time_ms = 85ms; feedback = 22%; damping = 4800hz; ping_pong = true; }
    pan = 0.35 -> -0.05;
    gain { env = ad; attack = 10ms; peak = 0.85; curve = exp; }
  }

  export voice forest_air : noise {
    color = white;
    filter : bandpass { cutoff = log(0: 4200hz -> 0.5: 7800hz -> 1: 4200hz); q = 0.9; }
    drift { target = cutoff; depth = 25%; rate = 0.8hz; }
    pan = -0.15;
    gain { env = adsr; attack = 40ms; decay = 200ms; sustain = 0.55; release = 200ms; peak = 0.35; }
  }

  export voice canopy_low : noise {
    color = brown;
    filter : lowpass { cutoff = log(0: 240hz -> 0.5: 460hz -> 1: 240hz); q = 1.0; }
    highpass = 45hz;
    drift { target = gain; depth = 18%; rate = 0.6hz; }
    pan = 0.12;
    gain { env = adsr; attack = 40ms; decay = 200ms; sustain = 0.72; release = 200ms; peak = 0.85; }
  }
}
