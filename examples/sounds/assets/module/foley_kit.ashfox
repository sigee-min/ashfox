ashfox 1
module foley_kit {
  params {
    pitch = 140hz;
    damping = 0.58;
    spread = 0.35;
  }

  export voice wood_resonance : modal_plate {
    material = wood;
    pitch = pitch;
    size = 0.95;
    hardness = 0.72;
    damping = damping;
    brightness = 0.65;
    modes = 12;
    strike = mallet;
    twin_beat = 0.22;
    splash = 0.25;
    stereo_spread = spread;
    highpass = 45hz;
    eq { low = (160hz, 2db); high = (5500hz, 1.5db); }
    gain { env = ad; attack = 3ms; peak = 0.88; curve = exp; }
  }

  export voice air_transient : noise {
    color = pink;
    filter : bandpass { cutoff = log(0: 3600hz -> 1: 620hz); q = 1.1; }
    highpass = 80hz;
    pan = -0.2 -> 0.2;
    gain { env = ad; attack = 2ms; peak = 0.65; curve = exp; }
  }

  export voice hinge_grit : granular {
    texture = gravel;
    density = 75;
    grain_ms = 16ms;
    pitch = log(0: 2200hz -> 1: 950hz);
    spread = 0.65;
    burstiness = 0.55;
    turbulence = 0.45;
    stereo_width = 0.7;
    itd_ms = 0.25ms;
    highpass = 280hz;
    gain { env = adsr; attack = 15ms; decay = 120ms; sustain = 0.65; release = 140ms; peak = 0.58; }
  }
}
