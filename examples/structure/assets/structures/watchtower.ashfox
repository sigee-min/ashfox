ashfox 1
structure watchtower {
  import "../module/furnishings.ashfox" as deco;
  import "../models/props/wall_lantern.ashfox" as beacon;
  import "../models/props/rune_pillar.ashfox" as ward;

  density = 2;
  seed = 202;
  size = (13b, 27b, 13b);
  data_version = 3955;

  params {
    w = 13;
    d = 13;
  }

  outputs = [java_structure, glb];

  preview exterior { sheet = exterior; }
  preview cutaway { sheet = cutaway; }
  preview interior { sheet = interior; }

  palette {
    moss_cobble = "minecraft:mossy_cobblestone";
    brick = mix("minecraft:stone_bricks" * 70%, "minecraft:mossy_stone_bricks" * 20%, "minecraft:cracked_stone_bricks" * 10%);
    deepslate = "minecraft:deepslate_bricks";
    oak = "minecraft:oak_planks";
    spruce = "minecraft:spruce_planks";
    timber = "minecraft:dark_oak_log[axis=y]";
    beam = "minecraft:dark_oak_log[axis=x]";
    oak_stair = "minecraft:oak_stairs";
    roof_stair = "minecraft:deepslate_brick_stairs";
    trim_stair = "minecraft:spruce_stairs";
    ridge = "minecraft:deepslate_brick_slab[type=bottom]";
    porch_stair = "minecraft:stone_brick_stairs[facing=north,half=bottom]";
    fence = "minecraft:spruce_fence";
    bars = "minecraft:iron_bars";
    glass = "minecraft:glass_pane";
    slab = "minecraft:stone_brick_slab[type=top]";
    door = "minecraft:spruce_door[facing=north,half=lower,hinge=left,open=false]";
    hang_lantern = "minecraft:lantern[hanging=true]";
    lantern = asset(beacon, "minecraft:lantern[hanging=false]");
    ward_stone = asset(ward, "minecraft:chiseled_stone_bricks");
  }

  floor base {
    y = 0b;
    height = 5b;
    room guardroom { from = (2b, 2b); size = (9b, 9b); kind = tower; shape = octagon; plinth = moss_cobble; floor = brick; wall = brick; frame = deepslate; ceiling = oak; }
    facade guardroom.south {
      door {
        at = center;
        width = 1b;
        height = 2b;
        block = door;
        hinge = left;
        frame = deepslate;
        lintel = beam;
        porch {
          depth = 2;
          floor = deepslate;
          pillars = deepslate;
          lamps = lantern;
          steps = porch_stair;
        }
      }
    }
    facade facade_1 {
      on = [guardroom.north, guardroom.east, guardroom.west];
      window { at = center; width = 1b; height = 2b; y_offset = 1b; glass = bars; recess = 1b; sill = slab; lintel = beam; }
    }
  }
  floor mid {
    y = 5b;
    height = 5b;
    room barracks { from = (2b, 2b); size = (9b, 9b); kind = bedroom; shape = octagon; floor = oak; wall = brick; frame = deepslate; ceiling = spruce; }
    facade facade_1 {
      on = [barracks.north, barracks.south, barracks.east, barracks.west];
      window { at = center; width = 1b; height = 2b; y_offset = 1b; glass = bars; recess = 1b; sill = slab; lintel = beam; }
    }
  }
  floor top {
    y = 10b;
    height = 5b;
    jetty = 1b;
    room lookout { from = (2b, 2b); size = (9b, 9b); kind = tower; shape = octagon; floor = spruce; wall = brick; frame = timber; ceiling = deepslate; }
    facade facade_1 {
      on = [lookout.north, lookout.south, lookout.east, lookout.west];
      window { symmetric = 1b; width = 1b; height = 2b; y_offset = 1b; glass = glass; sill = slab; lintel = beam; }
    }
  }
  staircase { in_room = guardroom; style = spiral; at = (6b, 6b); y_from = 0b; y_to = 5b; facing = east; width = 1b; stair = oak_stair; landing = oak; rail = fence; headroom = 3b; }
  staircase { in_room = barracks; style = spiral; at = (6b, 6b); y_from = 5b; y_to = 10b; facing = east; width = 1b; stair = oak_stair; landing = spruce; rail = fence; headroom = 3b; }
  roof { on = lookout; style = spire; axis = x; overhang = 0b; pitch = steep; stair = roof_stair; trim = trim_stair; ridge = ridge; gable = deepslate; battlement = true; }
  furnish guardroom {
    place_anchor { prefab = deco.StudyCorner; on = north; offset = (0b, 0b); rotate = 0; }
    hang { block = hang_lantern; at = ceiling_center; drop = 1b; }
  }
  furnish barracks {
    place_anchor { prefab = deco.GuardBunk; on = north; offset = (0b, 0b); rotate = 0; }
    hang { block = hang_lantern; at = ceiling_center; drop = 1b; }
  }
  furnish lookout {
    hang { block = hang_lantern; at = ceiling_center; drop = 1b; }
  }
  weathering {
    ground_moss { height = 3b; target = brick; into = moss_cobble; rate = 30%; }
    corner_quoin { target = brick; corners = deepslate; }
  }
  box { from = (4b, 0b, 11b); to = (4b, 0b, 11b); block = moss_cobble; }
  box { from = (8b, 0b, 11b); to = (8b, 0b, 11b); block = moss_cobble; }
  set { at = (4b, 1b, 11b); block = ward_stone; }
  set { at = (8b, 1b, 11b); block = ward_stone; }
  anchor gate_entry : std.entry { at = (6b, 1b, 10b); facing = south; pool = "village:streets"; target = "road_join"; }
  anchor west_wall : std.wall_join { at = (0b, 0b, 6b); facing = west; pool = "village:walls"; target = "wall_join"; }
}
