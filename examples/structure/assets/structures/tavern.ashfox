ashfox 1
structure tavern {
  import "../module/furnishings.ashfox" as deco;
  import "../module/arch_kit.ashfox" as kit;
  import "../models/props/wall_lantern.ashfox" as custom_lantern;
  import "../models/props/rune_pillar.ashfox" as custom_pillar;
  import "../models/props/hanging_sign.ashfox" as custom_sign;

  density = 2;
  seed = 404;
  size = (19b, 22b, 17b);
  data_version = 3955;

  params {
    w = 19;
    d = 17;
  }

  outputs = [java_structure, glb];

  preview exterior { sheet = exterior; }
  preview cutaway { sheet = cutaway; }
  preview interior { sheet = interior; }

  palette {
    moss_stone = "minecraft:mossy_stone_bricks";
    stone_brick = mix("minecraft:stone_bricks" * 75%, "minecraft:mossy_stone_bricks" * 15%, "minecraft:cracked_stone_bricks" * 10%);
    plaster = mix("minecraft:white_terracotta" * 85%, "minecraft:calcite" * 15%);
    timber = "minecraft:dark_oak_log[axis=y]";
    beam = "minecraft:dark_oak_log[axis=x]";
    oak_floor = "minecraft:oak_planks";
    spruce_plank = "minecraft:spruce_planks";
    roof_stair = "minecraft:dark_oak_stairs";
    trim_stair = "minecraft:spruce_stairs";
    ridge = "minecraft:dark_oak_slab[type=bottom]";
    porch_stair = "minecraft:stone_brick_stairs[facing=north,half=bottom]";
    oak_stair = "minecraft:oak_stairs";
    fence = "minecraft:dark_oak_fence";
    glass = "minecraft:glass_pane";
    sill = "minecraft:spruce_slab[type=top]";
    shutter = "minecraft:spruce_trapdoor[facing=south,half=bottom,open=true]";
    door = "minecraft:dark_oak_door[facing=north,half=lower,hinge=left,open=false]";
    chimney_brick = "minecraft:bricks";
    hang_lantern = "minecraft:lantern[hanging=true]";
    lantern = asset(custom_lantern, "minecraft:lantern[hanging=false]");
    pillar = asset(custom_pillar, "minecraft:chiseled_stone_bricks");
    sign = asset(custom_sign, "minecraft:oak_wall_sign[facing=south]");
  }

  floor ground {
    y = 0b;
    height = 5b;
    room taproom { from = (1b, 1b); size = (15b, 9b); kind = tavern; plinth = stone_brick; floor = oak_floor; wall = plaster; frame = timber; ceiling = spruce_plank; }
    room snug { from = (8b, 9b); size = (8b, 4b); kind = living; plinth = stone_brick; floor = oak_floor; wall = plaster; frame = timber; ceiling = spruce_plank; }
    facade taproom.south {
      door {
        at = 2b;
        width = 2b;
        height = 2b;
        block = door;
        hinge = left;
        frame = timber;
        lintel = beam;
        porch {
          depth = 2;
          floor = stone_brick;
          pillars = timber;
          lamps = lantern;
          steps = porch_stair;
        }
      }
      arch { at = 8b; width = 2b; height = 3b; frame = timber; lintel = beam; }
    }
    facade snug.south {
      bay_window { at = center; width = 3b; height = 2b; y_offset = 1b; glass = glass; frame = timber; sill = sill; lintel = roof_stair; }
    }
    facade facade_1 {
      on = [taproom.north, taproom.east, taproom.west];
      window { symmetric = 1b; width = 2b; height = 2b; y_offset = 1b; glass = glass; recess = 1b; sill = sill; shutter = shutter; lintel = beam; }
    }
    facade snug.east {
      window { at = center; width = 2b; height = 2b; y_offset = 1b; glass = glass; sill = sill; shutter = shutter; lintel = beam; }
    }
  }
  floor upper {
    y = 5b;
    height = 4b;
    jetty_s = 1b;
    jetty_e = 1b;
    room inn_hall { from = (1b, 1b); size = (15b, 9b); kind = hallway; floor = oak_floor; wall = plaster; frame = timber; ceiling = spruce_plank; }
    room inn_suite { from = (8b, 9b); size = (8b, 4b); kind = bedroom; floor = oak_floor; wall = plaster; frame = timber; ceiling = spruce_plank; }
    facade inn_hall.south {
      arch { at = 8b; width = 2b; height = 3b; frame = timber; lintel = beam; }
    }
    facade inn_hall.north {
      window { symmetric = 2b; width = 2b; height = 2b; y_offset = 1b; glass = glass; sill = sill; shutter = shutter; lintel = beam; }
    }
    facade inn_suite.south {
      bay_window { at = center; width = 3b; height = 2b; y_offset = 1b; glass = glass; frame = timber; sill = sill; lintel = roof_stair; }
    }
    facade inn_suite.east {
      window { at = center; width = 2b; height = 2b; y_offset = 1b; glass = glass; sill = sill; shutter = shutter; lintel = beam; }
    }
  }
  staircase { in_room = taproom; style = u_turn; at = (11b, 3b); y_from = 0b; y_to = 5b; facing = west; width = 1b; stair = oak_stair; landing = oak_floor; rail = fence; headroom = 3b; }
  roof {
    on = inn_hall;
    style = gable;
    axis = x;
    overhang = 1b;
    pitch = standard;
    stair = roof_stair;
    trim = trim_stair;
    ridge = ridge;
    gable = plaster;
    under_eave = true;
    chimney { room = taproom; corner = nw; offset = (1b, 1b); width = 2b; rise = 2b; block = chimney_brick; cap = true; }
  }
  roof {
    on = inn_suite;
    style = gable;
    axis = z;
    overhang = 1b;
    pitch = standard;
    stair = roof_stair;
    trim = trim_stair;
    ridge = ridge;
    gable = plaster;
    under_eave = true;
    dormer { wall = east; offset = 0b; width = 3b; height = 3b; window = glass; }
  }
  furnish taproom {
    place_anchor { prefab = deco.TavernBar; on = nw; offset = (0b, 0b); rotate = 0; }
    place_anchor { prefab = deco.DiningTable; on = sw; offset = (1b, 0b); rotate = 0; }
    hang { block = hang_lantern; at = ceiling_center; drop = 1b; }
  }
  furnish snug {
    place_anchor { prefab = deco.StudyCorner; on = se; offset = (0b, 0b); rotate = 0; }
    hang { block = hang_lantern; at = ceiling_center; drop = 1b; }
  }
  furnish inn_hall {
    place_anchor { prefab = deco.GuardBunk; on = ne; offset = (0b, 0b); rotate = 0; }
    hang { block = hang_lantern; at = ceiling_center; drop = 1b; }
  }
  furnish inn_suite {
    place_anchor { prefab = deco.CozyBedroom; on = sw; offset = (0b, 0b); rotate = 0; }
    hang { block = hang_lantern; at = ceiling_center; drop = 1b; }
  }
  weathering {
    ground_moss { height = 2b; target = stone_brick; into = moss_stone; rate = 35%; }
    corner_quoin { target = plaster; corners = stone_brick; }
    chimney_soot { radius = 2b; rate = 45%; }
  }
  box { from = (2b, 0b, 10b); to = (2b, 0b, 10b); block = stone_brick; }
  box { from = (16b, 0b, 13b); to = (17b, 0b, 14b); block = stone_brick; }
  place kit.CrateStack { at = (16b, 1b, 13b); rotate = 0; }
  set { at = (2b, 1b, 10b); block = pillar; }
  set { at = (7b, 3b, 10b); block = sign; facing = south; }
  socket tavern_entry { kind = entry; room = taproom; wall = south; normal = south; pool = "village:streets"; target = "road_join"; }
  socket east_lane { kind = road; at = (w - 1, 0, floor(d / 2)); normal = east; pool = "village:streets"; target = "road_join"; }
}
