ashfox-model 1
structure tavern {
  outputs {
    java_structure;
    glb;
  }
  preview exterior {
    azimuth = 145;
    elevation = 24;
    width = 640;
    height = 360;
    environment = studio;
  }
  preview interior {
    azimuth = 145;
    elevation = 48;
    width = 640;
    height = 360;
    cutaway = 5;
    environment = studio;
  }
  preview upper {
    azimuth = 145;
    elevation = 45;
    width = 640;
    height = 360;
    cutaway = 9;
    environment = studio;
  }
  import "../module/furnishings.ashfox" as deco;
  import "../models/props/wall_lantern.ashfox" as custom_lantern;
  import "../models/props/hanging_sign.ashfox" as inn_sign;
  import "../models/props/rune_pillar.ashfox" as entry_pillar;

  size = (15, 15, 13);
  data_version = 3955;

  palette {
    cobble = "minecraft:cobblestone";
    stone_brick = "minecraft:stone_bricks";
    chimney = "minecraft:bricks";
    plaster = "minecraft:white_terracotta";
    timber = "minecraft:dark_oak_log[axis=y]";
    beam_x = "minecraft:dark_oak_log[axis=x]";
    beam_z = "minecraft:dark_oak_log[axis=z]";
    oak_floor = "minecraft:oak_planks";
    spruce_plank = "minecraft:spruce_planks";
    roof_stair = "minecraft:spruce_stairs";
    ridge = "minecraft:spruce_slab[type=bottom]";
    porch_stair = "minecraft:stone_brick_stairs[facing=south,half=bottom]";
    balcony_fence = "minecraft:dark_oak_fence";
    glass = "minecraft:glass_pane";
    door_bot = "minecraft:dark_oak_door[facing=north,half=lower,hinge=left,open=false]";
    door_top = "minecraft:dark_oak_door[facing=north,half=upper,hinge=left,open=false]";
    balcony_door_bot = "minecraft:spruce_door[facing=north,half=lower,hinge=left,open=false]";
    balcony_door_top = "minecraft:spruce_door[facing=north,half=upper,hinge=left,open=false]";
    shutter = "minecraft:dark_oak_trapdoor[facing=north,half=bottom,open=true]";
    ladder = "minecraft:ladder[facing=west]";
    carpet = "minecraft:red_carpet";
    lantern = asset custom_lantern as "minecraft:lantern[hanging=false]";
    sign = asset inn_sign as "minecraft:dark_oak_fence";
    pillar = asset entry_pillar as "minecraft:chiseled_stone_bricks";
  }

  build {
    box from = (1, 0, 1) to = (13, 0, 11) block = cobble;
    box from = (2, 0, 2) to = (12, 0, 10) block = oak_floor;
    box from = (5, 0, 12) to = (9, 0, 12) block = stone_brick;
    box from = (6, 0, 12) to = (8, 0, 12) block = porch_stair;
    mirror axis = x center = 7 {
      set at = (5, 1, 12) block = pillar;
      set at = (5, 2, 12) block = lantern;
    }

    walls from = (1, 1, 1) to = (13, 4, 11) block = stone_brick;
    frame from = (1, 1, 1) to = (13, 4, 11) block = timber;
    carve from = (2, 1, 2) to = (12, 4, 10);

    box from = (2, 5, 2) to = (12, 5, 10) block = spruce_plank;
    carve from = (12, 5, 5) to = (12, 5, 5);
    walls from = (1, 5, 1) to = (13, 8, 10) block = plaster;
    frame from = (1, 5, 1) to = (13, 8, 10) block = timber;
    carve from = (2, 6, 2) to = (12, 8, 9);

    box from = (2, 5, 1) to = (12, 5, 1) block = beam_x;
    box from = (2, 5, 10) to = (12, 5, 10) block = beam_x;
    box from = (1, 5, 2) to = (1, 5, 9) block = beam_z;
    box from = (13, 5, 2) to = (13, 5, 9) block = beam_z;
    box from = (2, 5, 11) to = (12, 5, 11) block = oak_floor;
    box from = (2, 6, 11) to = (12, 6, 11) block = balcony_fence;
    carve from = (6, 6, 11) to = (8, 6, 11);

    set at = (7, 1, 11) block = door_bot;
    set at = (7, 2, 11) block = door_top;
    set at = (7, 3, 12) block = sign;
    set at = (7, 6, 10) block = balcony_door_bot;
    set at = (7, 7, 10) block = balcony_door_top;

    mirror axis = x center = 7 {
      box from = (3, 2, 11) to = (4, 3, 11) block = glass;
      box from = (2, 2, 12) to = (2, 3, 12) block = shutter;
      box from = (3, 7, 10) to = (4, 7, 10) block = glass;
      box from = (3, 2, 1) to = (4, 3, 1) block = glass;
      box from = (3, 7, 1) to = (4, 7, 1) block = glass;
    }
    repeat axis = z count = 2 step = 4 {
      box from = (1, 2, 4) to = (1, 3, 4) block = glass;
      box from = (13, 2, 4) to = (13, 3, 4) block = glass;
      box from = (1, 7, 4) to = (1, 7, 4) block = glass;
      box from = (13, 7, 4) to = (13, 7, 4) block = glass;
    }

    roof style = gable axis = x from = (0, 9, 0) to = (14, 14, 11) stair = roof_stair ridge = ridge gable = spruce_plank;
    box from = (10, 1, 1) to = (11, 14, 2) block = chimney;
    set at = (10, 14, 1) block = cobble;
    set at = (11, 14, 2) block = cobble;

    box from = (6, 1, 5) to = (8, 1, 10) block = carpet;
    repeat axis = y count = 5 step = 1 {
      set at = (12, 1, 5) block = ladder;
    }
    set at = (7, 4, 6) block = lantern;
    box from = (2, 8, 6) to = (12, 8, 6) block = beam_x;
    set at = (7, 7, 6) block = lantern;
    set at = (5, 7, 11) block = lantern;
    set at = (9, 7, 11) block = lantern;

    place deco.TavernBarCounter at = (2, 1, 2) rotate = 0;
    place deco.KitchenHearth at = (9, 1, 2) rotate = 0;
    place deco.TavernDiningBooth at = (2, 1, 7) rotate = 0;
    place deco.TavernDiningBooth at = (9, 1, 7) rotate = 0;

    place deco.CozyBedroom at = (2, 6, 2) rotate = 0;
    place deco.GuardBunk at = (9, 6, 2) rotate = 0;
    place deco.StudyCorner at = (2, 6, 6) rotate = 0;
  }
}
