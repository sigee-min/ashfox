ashfox-model 1
compound village_compound {
  import "./medieval_cottage.ashfox" as cottage;
  import "./watchtower.ashfox" as tower;
  import "./blacksmith.ashfox" as smith;
  import "./tavern.ashfox" as tavern;
  import "../module/arch_kit.ashfox" as kit;

  density = 2;
  seed = 505;
  size = (48, 28, 40);
  data_version = 3955;

  outputs {
    java_structure;
    glb;
  }

  preview exterior { sheet = exterior; }
  preview cutaway { sheet = cutaway; }

  palette {
    cobble = mix("minecraft:cobblestone" * 0.65, "minecraft:mossy_cobblestone" * 0.25, "minecraft:stone_bricks" * 0.1);
    moss_cobble = "minecraft:mossy_cobblestone";
    road_stone = mix("minecraft:stone_bricks" * 0.7, "minecraft:cobblestone" * 0.3);
    grass = "minecraft:grass_block";
    wall = "minecraft:stone_brick_wall";
  }

  build {
    box from = (0, 0, 19) to = (47, 0, 22) block = road_stone;
    box from = (16, 0, 16) to = (23, 0, 25) block = cobble;
    box from = (8, 0, 16) to = (11, 0, 25) block = road_stone;
    box from = (28, 0, 17) to = (31, 0, 25) block = road_stone;
    box from = (1, 0, 1) to = (46, 0, 1) block = wall;
    box from = (1, 0, 38) to = (46, 0, 38) block = wall;
    box from = (40, 0, 13) to = (45, 0, 17) block = grass;
    box from = (40, 0, 24) to = (45, 0, 28) block = grass;

    compound_place cottage at = (2, 0, 2) rotate = 0;
    compound_place tavern at = (20, 0, 2) rotate = 0;
    compound_place tower at = (3, 0, 25) rotate = 180;
    compound_place smith at = (22, 0, 24) rotate = 180;

    place kit.WellHead at = (18, 1, 19) rotate = 0;
    place kit.LampPost at = (16, 1, 18) rotate = 0;
    place kit.LampPost at = (23, 1, 22) rotate = 0;
    place kit.LampPost at = (7, 1, 19) rotate = 0;
    place kit.LampPost at = (33, 1, 22) rotate = 0;
    place kit.MarketCart at = (40, 1, 19) rotate = 0;
    place kit.CrateStack at = (44, 1, 19) rotate = 0;
    place kit.GardenTree at = (41, 1, 14) rotate = 0;
    place kit.GardenTree at = (41, 1, 25) rotate = 0;

    weathering {
      ground_moss height = 2 target = cobble into = moss_cobble rate = 0.3;
    }

    socket west_gate kind = road at = (0, 0, 20) normal = west pool = "village:streets" target = "road_join";
    socket east_gate kind = road at = (47, 0, 20) normal = east pool = "village:streets" target = "road_join";
  }
}
