ashfox 1
structure village_compound {
  import "./medieval_cottage.ashfox" as cottage;
  import "./watchtower.ashfox" as tower;
  import "./blacksmith.ashfox" as smith;
  import "./tavern.ashfox" as tavern;
  import "../module/arch_kit.ashfox" as kit;

  density = 2;
  seed = 505;
  size = (48b, 28b, 40b);
  data_version = 3955;

  outputs = [java_structure, glb];

  preview exterior { sheet = exterior; }
  preview cutaway { sheet = cutaway; }

  palette {
    cobble = mix("minecraft:cobblestone" * 65%, "minecraft:mossy_cobblestone" * 25%, "minecraft:stone_bricks" * 10%);
    moss_cobble = "minecraft:mossy_cobblestone";
    road_stone = mix("minecraft:stone_bricks" * 70%, "minecraft:cobblestone" * 30%);
    grass = "minecraft:grass_block";
    wall = "minecraft:stone_brick_wall";
  }

  box { from = (0b, 0b, 19b); to = (47b, 0b, 22b); block = road_stone; }
  box { from = (16b, 0b, 16b); to = (23b, 0b, 25b); block = cobble; }
  box { from = (8b, 0b, 16b); to = (11b, 0b, 25b); block = road_stone; }
  box { from = (28b, 0b, 17b); to = (31b, 0b, 25b); block = road_stone; }
  box { from = (1b, 0b, 1b); to = (46b, 0b, 1b); block = wall; }
  box { from = (1b, 0b, 38b); to = (46b, 0b, 38b); block = wall; }
  box { from = (40b, 0b, 13b); to = (45b, 0b, 17b); block = grass; }
  box { from = (40b, 0b, 24b); to = (45b, 0b, 28b); block = grass; }
  compound_place cottage { at = (2b, 0b, 2b); rotate = 0; }
  compound_place tavern { at = (20b, 0b, 2b); rotate = 0; }
  compound_place tower { at = (3b, 0b, 25b); rotate = 180; }
  compound_place smith { at = (22b, 0b, 24b); rotate = 180; }
  place kit.WellHead { at = (18b, 1b, 19b); rotate = 0; }
  place kit.LampPost { at = (16b, 1b, 18b); rotate = 0; }
  place kit.LampPost { at = (23b, 1b, 22b); rotate = 0; }
  place kit.LampPost { at = (7b, 1b, 19b); rotate = 0; }
  place kit.LampPost { at = (33b, 1b, 22b); rotate = 0; }
  place kit.MarketCart { at = (40b, 1b, 19b); rotate = 0; }
  place kit.CrateStack { at = (44b, 1b, 19b); rotate = 0; }
  place kit.GardenTree { at = (41b, 1b, 14b); rotate = 0; }
  place kit.GardenTree { at = (41b, 1b, 25b); rotate = 0; }
  weathering {
    ground_moss { height = 2b; target = cobble; into = moss_cobble; rate = 30%; }
  }
  anchor west_gate : std.road { at = (0b, 0b, 20b); facing = west; pool = "village:streets"; target = "road_join"; }
  anchor east_gate : std.road { at = (47b, 0b, 20b); facing = east; pool = "village:streets"; target = "road_join"; }
}
