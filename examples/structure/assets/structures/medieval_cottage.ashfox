ashfox 1
structure medieval_cottage {
  import "../module/furnishings.ashfox" as deco;
  import "../models/props/wall_lantern.ashfox" as custom_lantern;
  import "../models/props/rune_pillar.ashfox" as custom_pillar;
  import "../models/props/hanging_sign.ashfox" as custom_sign;

  density = 2;
  seed = 101;
  size = (15b, 20b, 15b);
  data_version = 3955;

  params {
    w = 15;
    d = 15;
    mid_x = floor(w / 2);
  }

  outputs = [java_structure, glb];

  preview exterior { sheet = exterior; }
  preview cutaway { sheet = cutaway; }
  preview interior { sheet = interior; }

  palette {
    cobble = mix("minecraft:cobblestone" * 70%, "minecraft:mossy_cobblestone" * 30%);
    moss_cobble = "minecraft:mossy_cobblestone";
    stone_brick = mix("minecraft:stone_bricks" * 75%, "minecraft:cracked_stone_bricks" * 15%, "minecraft:mossy_stone_bricks" * 10%);
    plaster = mix("minecraft:white_terracotta" * 85%, "minecraft:calcite" * 15%);
    timber = "minecraft:oak_log[axis=y]";
    beam = "minecraft:oak_log[axis=x]";
    oak_floor = "minecraft:oak_planks";
    spruce_plank = "minecraft:spruce_planks";
    roof_stair = "minecraft:spruce_stairs";
    trim_stair = "minecraft:dark_oak_stairs";
    ridge = "minecraft:spruce_slab[type=bottom]";
    porch_stair = "minecraft:cobblestone_stairs[facing=north,half=bottom]";
    porch_floor = "minecraft:stone_bricks";
    oak_stair = "minecraft:oak_stairs";
    fence = "minecraft:oak_fence";
    glass = "minecraft:glass_pane";
    sill = "minecraft:spruce_slab[type=top]";
    shutter = "minecraft:oak_trapdoor[facing=south,half=bottom,open=true]";
    door = "minecraft:spruce_door[facing=north,half=lower,hinge=left,open=false]";
    chimney_brick = "minecraft:bricks";
    carpet = "minecraft:red_carpet";
    garden_grass = "minecraft:grass_block";
    shrub = "minecraft:oak_leaves";
    hang_lantern = "minecraft:lantern[hanging=true]";
    lantern = asset(custom_lantern, "minecraft:lantern[hanging=false]");
    pillar = asset(custom_pillar, "minecraft:chiseled_stone_bricks");
    sign = asset(custom_sign, "minecraft:oak_wall_sign[facing=south]");
  }

  floor ground {
    y = 0b;
    height = 4b;
    room hall {
      from = (1b, 1b); size = (8b, 10b); kind = living; plinth = cobble; floor = oak_floor; wall = plaster; frame = timber; ceiling = spruce_plank;
      interior {
        dna { arch = rustic; mood = warm_hearth; }
        architecture { floor_pattern = plank; baseboard = trim; wainscot = paneled; ceiling = beamed; }
        alcove hearth_niche { kind = fireplace; wall = north; at = 2; width = 2; height = 3; }
        centerpiece {
          on = center;
          dining_set hall_table { seats = 4; }
          story tavern_meal { on = hall_table; }
        }
        drapery curtains { on = windows; tieback = true; color = "#923a2e"; }
        lighting { bounces = 2; ambient_floor = 0.14; }
        sun_shaft { enabled = true; sun_dir = (0.35, -0.72, 0.58); intensity = 0.45; shaft_length = 5.0; }
      }
    }
    room kitchen { from = (8b, 1b); size = (6b, 10b); kind = workshop; plinth = cobble; floor = stone_brick; wall = plaster; frame = timber; ceiling = spruce_plank; }
    facade hall.south {
      door {
        at = center;
        width = 1b;
        height = 2b;
        block = door;
        hinge = left;
        frame = timber;
        lintel = beam;
        porch {
          depth = 2;
          floor = porch_floor;
          pillars = timber;
          lamps = lantern;
          steps = porch_stair;
        }
      }
    }
    facade hall.east {
      arch { at = center; width = 2b; height = 3b; frame = timber; lintel = beam; }
    }
    facade kitchen.south {
      bay_window { at = center; width = 3b; height = 2b; y_offset = 1b; glass = glass; frame = timber; sill = sill; lintel = roof_stair; }
    }
    facade facade_1 {
      on = [hall.west, kitchen.east, hall.north, kitchen.north];
      window { at = center; width = 2b; height = 2b; y_offset = 1b; glass = glass; sill = sill; shutter = shutter; lintel = beam; }
    }
  }
  floor loft {
    y = 4b;
    height = 4b;
    room bedroom {
      from = (1b, 1b); size = (13b, 10b); kind = bedroom; floor = oak_floor; wall = plaster; frame = timber; ceiling = spruce_plank;
      interior {
        dna { arch = rustic; mood = warm_hearth; }
        architecture { floor_pattern = herringbone; baseboard = trim; wainscot = paneled; ceiling = open_truss; }
        platform study_dais {
          on = east; size = (4, 3); height = 0.25; step_facing = west;
          table desk { size = (2, 1); }
          story scholar_study { on = desk; }
        }
        partition screen { style = colonnade; axis = z; at = 8; span_from = 2; span_to = 10; doorway_at = 5; doorway_width = 2; }
        alcove shrine_niche { kind = display; wall = north; width = 2; height = 2; }
        drapery curtains { on = windows; tieback = true; color = "#7c2d2d"; }
        lighting { bounces = 2; ambient_floor = 0.14; }
        sun_shaft { enabled = true; sun_dir = (0.35, -0.72, 0.58); intensity = 0.46; shaft_length = 5.0; }
      }
    }
    facade facade_1 {
      on = [bedroom.south, bedroom.north];
      window { symmetric = 2b; width = 2b; height = 2b; y_offset = 1b; glass = glass; sill = sill; shutter = shutter; lintel = beam; }
    }
  }
  staircase { in_room = hall; style = l_turn; at = (3b, 8b); y_from = 0b; y_to = 4b; facing = north; width = 1b; stair = oak_stair; landing = oak_floor; rail = fence; headroom = 3b; }
  roof {
    on = bedroom;
    style = gable;
    axis = z;
    overhang = 1b;
    pitch = standard;
    stair = roof_stair;
    trim = trim_stair;
    ridge = ridge;
    gable = plaster;
    under_eave = true;
    dormer { wall = south; offset = 0b; width = 3b; height = 3b; window = glass; }
    chimney { room = kitchen; corner = ne; offset = (1b, 1b); width = 1b; rise = 1b; block = chimney_brick; cap = true; }
  }
  furnish hall {
    place_anchor { prefab = deco.StudyCorner; on = nw; offset = (0b, 0b); rotate = 0; }
    hang { block = hang_lantern; at = ceiling_center; drop = 1b; }
  }
  furnish kitchen {
    place_anchor { prefab = deco.KitchenHearth; on = ne; offset = (0b, 0b); rotate = 0; }
    hang { block = hang_lantern; at = ceiling_center; drop = 1b; }
  }
  furnish bedroom {
    place_anchor { prefab = deco.CozyBedroom; on = nw; offset = (0b, 0b); rotate = 0; }
    hang { block = hang_lantern; at = ceiling_center; drop = 1b; }
  }
  weathering {
    ground_moss { height = 2b; target = cobble; into = moss_cobble; rate = 35%; }
    corner_quoin { target = plaster; corners = stone_brick; }
    chimney_soot { radius = 2b; rate = 40%; }
  }
  box { from = (4b, 1b, 8b); to = (6b, 1b, 9b); block = carpet; }
  box { from = (1b, 0b, 11b); to = (2b, 0b, 12b); block = garden_grass; }
  box { from = (12b, 0b, 11b); to = (13b, 0b, 12b); block = garden_grass; }
  set { at = (1b, 1b, 11b); block = shrub; }
  set { at = (13b, 1b, 11b); block = shrub; }
  set { at = (2b, 1b, 12b); block = pillar; }
  set { at = (mid_x - 1b, 2b, 11b); block = sign; facing = south; }
  anchor front_entry : std.entry { at = (4b, 1b, 10b); facing = south; pool = "village:streets"; target = "road_join"; }
  anchor east_path : std.road { at = (14b, 0b, 7b); facing = east; pool = "village:streets"; target = "road_join"; }
}
