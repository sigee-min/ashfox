ashfox-model 1
structure medieval_cottage {
  outputs {
    java_structure;
    glb;
  }
  preview exterior {
    azimuth = 145;
    elevation = 26;
    width = 640;
    height = 360;
    environment = studio;
  }
  preview interior {
    azimuth = 145;
    elevation = 46;
    width = 640;
    height = 360;
    cutaway = 4;
    environment = studio;
  }
  import "../module/furnishings.ashfox" as deco;
  import "../models/props/wall_lantern.ashfox" as custom_lantern;
  import "../models/props/rune_pillar.ashfox" as custom_pillar;

  size = (13, 12, 13);
  data_version = 3955;

  palette {
    cobble = "minecraft:cobblestone";
    moss_cobble = "minecraft:mossy_cobblestone";
    stone_brick = "minecraft:stone_bricks";
    chimney = "minecraft:bricks";
    timber = "minecraft:spruce_log[axis=y]";
    beam_x = "minecraft:spruce_log[axis=x]";
    beam_z = "minecraft:spruce_log[axis=z]";
    plaster = "minecraft:white_terracotta";
    oak_floor = "minecraft:oak_planks";
    spruce_plank = "minecraft:spruce_planks";
    roof_stair = "minecraft:spruce_stairs";
    ridge = "minecraft:spruce_slab[type=bottom]";
    porch_stair = "minecraft:cobblestone_stairs[facing=south,half=bottom]";
    porch_fence = "minecraft:spruce_fence";
    glass = "minecraft:glass_pane";
    door_bot = "minecraft:spruce_door[facing=north,half=lower,hinge=left,open=false]";
    door_top = "minecraft:spruce_door[facing=north,half=upper,hinge=left,open=false]";
    shutter = "minecraft:oak_trapdoor[facing=north,half=bottom,open=true]";
    carpet = "minecraft:red_carpet";
    lantern = asset custom_lantern as "minecraft:lantern[hanging=false]";
    pillar = asset custom_pillar as "minecraft:chiseled_stone_bricks";
    leaf = "minecraft:oak_leaves";
  }

  build {
    box from = (1, 0, 1) to = (11, 0, 11) block = cobble;
    box from = (2, 0, 2) to = (10, 0, 10) block = oak_floor;
    box from = (4, 0, 12) to = (8, 0, 12) block = stone_brick;
    box from = (5, 0, 12) to = (7, 0, 12) block = porch_stair;
    mirror axis = x center = 6 {
      set at = (3, 0, 12) block = moss_cobble;
      set at = (3, 1, 12) block = porch_fence;
      set at = (4, 1, 12) block = pillar;
      set at = (4, 2, 12) block = lantern;
      set at = (2, 1, 11) block = leaf;
    }

    walls from = (1, 1, 1) to = (11, 4, 11) block = plaster;
    frame from = (1, 1, 1) to = (11, 4, 11) block = timber;
    carve from = (2, 1, 2) to = (10, 4, 10);

    box from = (2, 4, 1) to = (10, 4, 1) block = beam_x;
    box from = (2, 4, 11) to = (10, 4, 11) block = beam_x;
    box from = (1, 4, 2) to = (1, 4, 10) block = beam_z;
    box from = (11, 4, 2) to = (11, 4, 10) block = beam_z;

    set at = (6, 1, 11) block = door_bot;
    set at = (6, 2, 11) block = door_top;

    mirror axis = x center = 6 {
      box from = (3, 2, 11) to = (3, 3, 11) block = glass;
      box from = (2, 2, 12) to = (2, 3, 12) block = shutter;
      box from = (4, 2, 12) to = (4, 3, 12) block = shutter;
      box from = (3, 2, 1) to = (3, 3, 1) block = glass;
    }
    repeat axis = z count = 2 step = 4 {
      box from = (1, 2, 4) to = (1, 3, 4) block = glass;
      box from = (11, 2, 4) to = (11, 3, 4) block = glass;
    }

    box from = (2, 4, 6) to = (10, 4, 6) block = beam_x;
    box from = (1, 5, 1) to = (1, 5, 11) block = beam_z;
    box from = (11, 5, 1) to = (11, 5, 11) block = beam_z;
    set at = (6, 3, 6) block = lantern;

    roof style = gable axis = z from = (0, 5, 0) to = (12, 11, 12) stair = roof_stair ridge = ridge gable = spruce_plank;
    box from = (2, 3, 2) to = (2, 4, 2) block = chimney;
    box from = (2, 5, 2) to = (3, 11, 3) block = chimney;
    box from = (2, 11, 2) to = (2, 11, 2) block = moss_cobble;

    box from = (5, 1, 7) to = (7, 1, 10) block = carpet;
    place deco.KitchenHearth at = (2, 1, 2) rotate = 0;
    place deco.CozyBedroom at = (8, 1, 2) rotate = 0;
    place deco.StudyCorner at = (2, 1, 7) rotate = 0;
  }
}
