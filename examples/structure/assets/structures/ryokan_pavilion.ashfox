ashfox 1
structure ryokan_pavilion {
  import "../module/arch_kit.ashfox" as kit;
  import "../models/props/wall_lantern.ashfox" as custom_lantern;
  import "../models/props/hanging_sign.ashfox" as custom_sign;

  density = 2;
  seed = 606;
  size = (17b, 18b, 17b);
  data_version = 3955;

  params {
    w = 17;
    d = 17;
  }

  outputs = [java_structure, glb];

  preview exterior { sheet = exterior; }
  preview cutaway { sheet = cutaway; }
  preview interior { sheet = interior; }

  palette {
    stone_plinth = mix("minecraft:andesite" * 70%, "minecraft:polished_andesite" * 20%, "minecraft:mossy_cobblestone" * 10%);
    moss_stone = "minecraft:mossy_cobblestone";
    plaster = mix("minecraft:white_concrete_powder" * 80%, "minecraft:calcite" * 20%);
    oak_floor = "minecraft:oak_planks";
    spruce_plank = "minecraft:spruce_planks";
    dark_timber = "minecraft:dark_oak_log[axis=y]";
    dark_beam = "minecraft:dark_oak_log[axis=x]";
    roof_stair = "minecraft:deepslate_tile_stairs";
    trim_stair = "minecraft:spruce_stairs";
    ridge = "minecraft:deepslate_tile_slab[type=bottom]";
    porch_stair = "minecraft:stone_brick_stairs[facing=north,half=bottom]";
    oak_stair = "minecraft:oak_stairs";
    fence = "minecraft:spruce_fence";
    shoji_glass = "minecraft:glass_pane";
    sill = "minecraft:spruce_slab[type=top]";
    shutter = "minecraft:spruce_trapdoor[facing=south,half=bottom,open=true]";
    door = "minecraft:birch_door[facing=north,half=lower,hinge=left,open=false]";
    hang_lantern = "minecraft:lantern[hanging=true]";
    lantern = asset(custom_lantern, "minecraft:lantern[hanging=false]");
    sign = asset(custom_sign, "minecraft:oak_wall_sign[facing=south]");
    stone_brick = "minecraft:stone_bricks";
  }

  floor ground {
    y = 0b;
    height = 6b;
    room tea_hall {
      from = (1b, 1b); size = (15b, 11b); kind = living; plinth = stone_plinth; floor = oak_floor; wall = plaster; frame = dark_timber; ceiling = spruce_plank;
      interior {
        dna { arch = japanese; mood = zen_daylight; }
        architecture { floor_pattern = tatami; baseboard = trim; wainscot = shoji_lattice; molding = timber_cornice; ceiling = slatted; }
        platform tokonoma_dais {
          on = north; size = (5, 2); height = 0.25; step_facing = south;
          alcove tokonoma { kind = tokonoma; wall = north; width = 3; height = 3; }
        }
        partition shoji_screen { style = sliding_shoji; axis = x; at = 5; span_from = 2; span_to = 14; doorway_at = 7; doorway_width = 3; open_ratio = 0.6; }
        centerpiece {
          on = center;
          low_table chabudai { size = (2, 2); }
          cushion { on = west; }
          cushion { on = east; }
          story tea_ceremony { on = chabudai; }
        }
        wall_line {
          on = west;
          shelving { size = (2, 1); }
          cabinet { size = (2, 1); }
        }
        drapery noren { kind = noren; on = doors; split_panels = 3; color = "#243b55"; }
        lighting { bounces = 2; ambient_floor = 0.16; stained_glass_boost = 1.25; }
        sun_shaft { enabled = true; sun_dir = (0.3, -0.75, 0.58); intensity = 0.34; shaft_length = 5.5; }
      }
    }
    room engawa {
      from = (1b, 11b); size = (15b, 4b); kind = hallway; plinth = stone_plinth; floor = spruce_plank; wall = plaster; frame = dark_timber; ceiling = spruce_plank;
      interior {
        dna { arch = japanese; mood = zen_daylight; }
        architecture { floor_pattern = plank; baseboard = trim; wainscot = shoji_lattice; molding = timber_cornice; ceiling = slatted; }
        platform tatami_step {
          on = east; size = (4, 2); height = 0.25; step_facing = west;
          low_table engawa_table { size = (2, 1); }
          cushion { on = west; }
          story tea_ceremony { on = engawa_table; }
        }
        alcove shrine_alcove { kind = tokonoma; wall = east; width = 2; height = 2; }
        wall_line {
          on = west;
          cabinet { size = (2, 1); }
        }
        lighting { bounces = 2; ambient_floor = 0.14; stained_glass_boost = 1.45; }
        sun_shaft { enabled = true; sun_dir = (0.3, -0.75, -0.58); intensity = 0.55; shaft_length = 4.5; }
      }
    }
    facade engawa.south {
      door {
        at = 3b; width = 2b; height = 2b; block = door; hinge = left; frame = dark_timber; lintel = dark_beam;
        porch { depth = 2; floor = stone_plinth; pillars = dark_timber; lamps = lantern; steps = porch_stair; }
      }
      bay_window { at = 9b; width = 3b; height = 2b; y_offset = 1b; glass = shoji_glass; frame = dark_timber; sill = sill; lintel = roof_stair; stained_glass_color = "#f2b85b"; }
    }
    facade tea_hall.south {
      arch { at = center; width = 2b; height = 3b; frame = dark_timber; lintel = dark_beam; }
    }
    facade facade_1 {
      on = [tea_hall.north, tea_hall.east, tea_hall.west];
      window { symmetric = 1b; width = 2b; height = 2b; y_offset = 1b; glass = shoji_glass; sill = sill; shutter = shutter; lintel = dark_beam; stained_glass_color = "#f6eed8"; }
    }
  }

  floor attic {
    y = 6b;
    height = 4b;
    jetty_s = 1b;
    room tatami_loft {
      from = (3b, 2b); size = (11b, 10b); kind = bedroom; floor = oak_floor; wall = plaster; frame = dark_timber; ceiling = spruce_plank;
      interior {
        dna { arch = japanese; mood = zen_daylight; }
        architecture { floor_pattern = tatami; baseboard = trim; wainscot = shoji_lattice; ceiling = open_truss; }
        alcove alcove_1 { kind = tokonoma; wall = north; width = 2; height = 2; }
        centerpiece {
          on = center;
          low_table loft_table { size = (2, 1); }
          story scholar_study { on = loft_table; }
        }
        lighting { bounces = 2; ambient_floor = 0.16; }
        sun_shaft { enabled = true; sun_dir = (0.3, -0.75, 0.58); intensity = 0.45; shaft_length = 4.5; }
      }
    }
    facade facade_loft {
      on = [tatami_loft.north, tatami_loft.south];
      window { symmetric = 2b; width = 2b; height = 2b; y_offset = 1b; glass = shoji_glass; sill = sill; shutter = shutter; lintel = dark_beam; stained_glass_color = "#f6eed8"; }
    }
  }

  staircase { in_room = tea_hall; style = straight; at = (13b, 3b); y_from = 0b; y_to = 6b; facing = south; width = 1b; stair = oak_stair; landing = oak_floor; rail = fence; headroom = 3b; }

  roof {
    on = tatami_loft;
    style = hip;
    axis = x;
    overhang = 2b;
    pitch = shallow;
    stair = roof_stair;
    trim = trim_stair;
    ridge = ridge;
    gable = plaster;
    under_eave = true;
  }

  roof {
    on = tea_hall;
    style = gable;
    axis = x;
    overhang = 1b;
    pitch = shallow;
    stair = roof_stair;
    trim = trim_stair;
    ridge = ridge;
    gable = plaster;
    under_eave = true;
  }

  roof {
    on = engawa;
    style = gable;
    axis = x;
    overhang = 1b;
    pitch = shallow;
    stair = roof_stair;
    trim = trim_stair;
    ridge = ridge;
    gable = plaster;
  }

  furnish tea_hall { hang { block = hang_lantern; at = ceiling_center; drop = 1b; } }
  furnish engawa { hang { block = hang_lantern; at = ceiling_center; drop = 1b; } }
  furnish tatami_loft { hang { block = hang_lantern; at = ceiling_center; drop = 1b; } }

  weathering {
    ground_moss { height = 2b; target = stone_plinth; into = moss_stone; rate = 25%; }
    corner_quoin { target = plaster; corners = stone_brick; }
  }

  box { from = (1b, 0b, 15b); to = (2b, 0b, 16b); block = stone_brick; }
  place kit.GardenTree { at = (1b, 1b, 14b); rotate = 0; }
  set { at = (5b, 3b, 15b); block = sign; facing = south; }

  anchor south_entry : std.entry { at = (4b, 1b, 14b); facing = south; pool = "village:streets"; target = "road_join"; }
  anchor east_garden : std.road { at = (16b, 0b, 8b); facing = east; pool = "village:streets"; target = "road_join"; }
}
