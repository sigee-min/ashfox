ashfox-model 1
structure blacksmith {
  import "../module/furnishings.ashfox" as deco;
  import "../module/arch_kit.ashfox" as kit;
  import "../models/props/wall_lantern.ashfox" as custom_lantern;
  import "../models/props/hanging_sign.ashfox" as custom_sign;

  density = 2;
  seed = 303;
  size = (16, 19, 15);
  data_version = 3955;

  params {
    w = 16;
    d = 15;
  }

  outputs {
    java_structure;
    glb;
  }

  preview exterior { sheet = exterior; }
  preview cutaway { sheet = cutaway; }
  preview interior { sheet = interior; }

  palette {
    cobble = mix("minecraft:cobblestone" * 0.65, "minecraft:mossy_cobblestone" * 0.2, "minecraft:andesite" * 0.15);
    moss_cobble = "minecraft:mossy_cobblestone";
    stone_brick = mix("minecraft:stone_bricks" * 0.75, "minecraft:cracked_stone_bricks" * 0.25);
    deepslate = "minecraft:deepslate_bricks";
    plaster = mix("minecraft:white_terracotta" * 0.85, "minecraft:calcite" * 0.15);
    timber = "minecraft:spruce_log[axis=y]";
    beam = "minecraft:spruce_log[axis=x]";
    oak_floor = "minecraft:oak_planks";
    spruce_plank = "minecraft:spruce_planks";
    roof_stair = "minecraft:deepslate_tile_stairs";
    trim_stair = "minecraft:spruce_stairs";
    ridge = "minecraft:deepslate_tile_slab[type=bottom]";
    porch_stair = "minecraft:stone_brick_stairs[facing=north,half=bottom]";
    oak_stair = "minecraft:oak_stairs";
    fence = "minecraft:spruce_fence";
    glass = "minecraft:glass_pane";
    bars = "minecraft:iron_bars";
    sill = "minecraft:spruce_slab[type=top]";
    shutter = "minecraft:spruce_trapdoor[facing=south,half=bottom,open=true]";
    door = "minecraft:spruce_door[facing=north,half=lower,hinge=left,open=false]";
    chimney_brick = "minecraft:deepslate_tiles";
    hang_lantern = "minecraft:lantern[hanging=true]";
    lantern = asset custom_lantern as "minecraft:lantern[hanging=false]";
    sign = asset custom_sign as "minecraft:oak_wall_sign[facing=south]";
  }

  build {
    floor ground y = 0 height = 5 {
      room smithy from = (1, 1) size = (8, 11) kind = workshop plinth = deepslate floor = stone_brick wall = cobble frame = deepslate ceiling = spruce_plank;
      room shop from = (8, 1) size = (7, 10) kind = living plinth = cobble floor = oak_floor wall = plaster frame = timber ceiling = spruce_plank;

      facade on smithy.east {
        arch at = center width = 2 height = 3 frame = timber lintel = beam;
      }

      facade on smithy.south {
        arcade at = center width = 3 height = 3 frame = deepslate lintel = beam;
      }

      facade on smithy.west {
        arcade at = 2 width = 3 height = 3 frame = deepslate lintel = beam;
      }

      facade on smithy.north {
        window at = center width = 2 height = 2 y_offset = 1 glass = bars recess = 1 sill = sill lintel = beam;
      }

      facade on shop.south {
        door at = center width = 1 height = 2 block = door hinge = left frame = timber lintel = beam porch {
          depth = 2;
          floor = stone_brick;
          pillars = timber;
          lamps = lantern;
          steps = porch_stair;
        }
      }

      facade on shop.east, shop.north {
        window at = center width = 2 height = 2 y_offset = 1 glass = glass sill = sill shutter = shutter lintel = beam;
      }
    }

    floor upper y = 5 height = 4 jetty_s = 1 {
      room loft from = (8, 1) size = (7, 10) kind = bedroom floor = oak_floor wall = plaster frame = timber ceiling = spruce_plank;

      facade on loft.south, loft.north {
        window at = center width = 2 height = 2 y_offset = 1 glass = glass sill = sill shutter = shutter lintel = beam;
      }
    }

    staircase in_room = shop style = straight at = (12, 3) y_from = 0 y_to = 5 facing = south width = 1 stair = oak_stair landing = oak_floor rail = fence headroom = 3;

    roof on = smithy style = gable axis = x overhang = 1 pitch = shallow stair = roof_stair trim = trim_stair ridge = ridge gable = cobble under_eave = true {
      chimney room = smithy corner = nw offset = (1, 1) width = 2 rise = 4 block = chimney_brick cap = true;
    }

    roof on = loft style = gable axis = z overhang = 1 pitch = standard stair = roof_stair trim = trim_stair ridge = ridge gable = plaster under_eave = true;

    furnish room = smithy {
      place_anchor prefab = deco.ForgeArea on = nw offset = (0, 0) rotate = 0;
      hang block = hang_lantern at = ceiling_center drop = 1;
    }

    furnish room = shop {
      place_anchor prefab = deco.StudyCorner on = ne offset = (0, 0) rotate = 0;
      hang block = hang_lantern at = ceiling_center drop = 1;
    }

    furnish room = loft {
      place_anchor prefab = deco.CozyBedroom on = ne offset = (0, 0) rotate = 0;
      hang block = hang_lantern at = ceiling_center drop = 1;
    }

    weathering {
      ground_moss height = 2 target = cobble into = moss_cobble rate = 0.35;
      corner_quoin target = plaster corners = stone_brick;
      chimney_soot radius = 2 rate = 0.5;
    }

    box from = (1, 0, 12) to = (7, 0, 13) block = stone_brick;
    place kit.OutdoorForge at = (3, 1, 13) rotate = 0;
    place kit.CrateStack at = (1, 1, 12) rotate = 0;
    set at = (13, 3, 11) block = sign facing = south;

    socket forge_entry kind = entry room = shop wall = south normal = south pool = "village:streets" target = "road_join";
    socket west_yard kind = courtyard at = (0, 0, floor(d / 2)) normal = west pool = "village:courtyards" target = "courtyard";
  }
}
