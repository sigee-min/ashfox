ashfox 1
module furnishings {
  palette {
    bed_h = "minecraft:red_bed[facing=north,part=head]";
    bed_f = "minecraft:red_bed[facing=north,part=foot]";
    bunk_h = "minecraft:blue_bed[facing=east,part=head]";
    bunk_f = "minecraft:blue_bed[facing=east,part=foot]";
    chest_n = "minecraft:chest[facing=north]";
    chest_s = "minecraft:chest[facing=south]";
    barrel = "minecraft:barrel[facing=up]";
    craft = "minecraft:crafting_table";
    furnace = "minecraft:furnace[facing=south,lit=true]";
    blast = "minecraft:blast_furnace[facing=south,lit=true]";
    anvil = "minecraft:anvil[facing=east]";
    cauldron = "minecraft:cauldron";
    brick = "minecraft:bricks";
    deepslate = "minecraft:deepslate_bricks";
    pot = "minecraft:flower_pot";
    plank = "minecraft:oak_planks";
    book = "minecraft:bookshelf";
    carpet_r = "minecraft:red_carpet";
    carpet_b = "minecraft:blue_carpet";
    torch = "minecraft:torch";
    lantern = "minecraft:lantern[hanging=false]";
  }

  export prefab CozyBedroom {
    layer {
      y = 0b;
      origin = (0b, 0b);
      rows = ["ab.", "ed.", "cc."];
      map { a = chest_n; b = bed_h; d = bed_f; e = plank; c = carpet_r; }
    }
    set { at = (0b, 1b, 1b); block = pot; }
  }

  export prefab KitchenHearth {
    box { from = (0b, 0b, 0b); to = (2b, 1b, 0b); block = brick; }
    set { at = (1b, 0b, 0b); block = furnace; }
    set { at = (0b, 0b, 1b); block = barrel; }
    set { at = (2b, 0b, 1b); block = craft; }
    set { at = (1b, 2b, 0b); block = lantern; }
  }

  export prefab StudyCorner {
    box { from = (0b, 0b, 0b); to = (2b, 1b, 0b); block = book; }
    set { at = (0b, 0b, 1b); block = craft; }
    set { at = (2b, 0b, 1b); block = barrel; }
    set { at = (0b, 1b, 1b); block = torch; }
    set { at = (1b, 0b, 1b); block = carpet_b; }
  }

  export prefab GuardBunk {
    layer {
      y = 0b;
      origin = (0b, 0b);
      rows = ["abd", "c.e"];
      map { a = bunk_f; b = bunk_h; d = chest_s; e = barrel; c = carpet_b; }
    }
    set { at = (2b, 1b, 0b); block = lantern; }
  }

  export prefab ForgeArea {
    box { from = (0b, 0b, 0b); to = (2b, 1b, 0b); block = deepslate; }
    set { at = (1b, 0b, 0b); block = blast; }
    set { at = (0b, 0b, 1b); block = cauldron; }
    set { at = (1b, 0b, 2b); block = anvil; }
    set { at = (2b, 0b, 1b); block = barrel; }
    set { at = (2b, 1b, 1b); block = lantern; }
  }

  export prefab TavernBar {
    box { from = (0b, 0b, 0b); to = (3b, 0b, 0b); block = barrel; }
    box { from = (0b, 0b, 1b); to = (3b, 0b, 1b); block = plank; }
    box { from = (0b, 1b, 0b); to = (3b, 1b, 0b); block = book; }
    set { at = (0b, 1b, 1b); block = lantern; }
    set { at = (3b, 1b, 1b); block = pot; }
