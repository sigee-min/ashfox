ashfox 1
module arch_kit {
  import "../models/props/wall_lantern.ashfox" as lantern_prop;

  palette {
    cobble = mix("minecraft:cobblestone" * 70%, "minecraft:mossy_cobblestone" * 30%);
    stone_brick = "minecraft:stone_bricks";
    timber = "minecraft:spruce_log[axis=y]";
    oak_log = "minecraft:oak_log[axis=y]";
    leaves = "minecraft:oak_leaves";
    plank = "minecraft:oak_planks";
    slab = "minecraft:spruce_slab[type=bottom]";
    fence = "minecraft:spruce_fence";
    barrel = "minecraft:barrel[facing=up]";
    chest = "minecraft:chest[facing=south]";
    cauldron = "minecraft:cauldron";
    campfire = "minecraft:campfire[lit=true]";
    anvil = "minecraft:anvil[facing=east]";
    hay = "minecraft:hay_block";
    lantern = asset(lantern_prop, "minecraft:lantern[hanging=false]");
  }

  export prefab WellHead {
    walls { from = (0b, 0b, 0b); to = (2b, 0b, 2b); block = cobble; }
    set { at = (1b, 0b, 1b); block = cauldron; }
    set { at = (0b, 1b, 0b); block = fence; }
    set { at = (2b, 1b, 0b); block = fence; }
    set { at = (0b, 2b, 0b); block = fence; }
    set { at = (2b, 2b, 0b); block = fence; }
    box { from = (0b, 3b, 0b); to = (2b, 3b, 2b); block = slab; }
    set { at = (1b, 2b, 1b); block = lantern; }
  }

  export prefab CrateStack {
    set { at = (0b, 0b, 0b); block = barrel; }
    set { at = (1b, 0b, 0b); block = plank; }
    set { at = (0b, 0b, 1b); block = chest; }
    set { at = (1b, 1b, 0b); block = barrel; }
  }

  export prefab LampPost {
    set { at = (0b, 0b, 0b); block = stone_brick; }
    set { at = (0b, 1b, 0b); block = timber; }
    set { at = (0b, 2b, 0b); block = fence; }
    set { at = (0b, 3b, 0b); block = lantern; }
  }

  export prefab GardenTree {
    set { at = (1b, 0b, 1b); block = oak_log; }
    set { at = (1b, 1b, 1b); block = oak_log; }
    box { from = (0b, 2b, 0b); to = (2b, 3b, 2b); block = leaves; }
    set { at = (1b, 4b, 1b); block = leaves; }
  }

  export prefab MarketCart {
    set { at = (0b, 0b, 0b); block = fence; }
    set { at = (2b, 0b, 0b); block = fence; }
    set { at = (0b, 1b, 0b); block = fence; }
    set { at = (2b, 1b, 0b); block = fence; }
    set { at = (0b, 0b, 1b); block = plank; }
    set { at = (1b, 0b, 1b); block = hay; }
    set { at = (2b, 0b, 1b); block = barrel; }
    set { at = (1b, 1b, 1b); block = hay; }
    box { from = (0b, 2b, 0b); to = (2b, 2b, 1b); block = slab; }
  }

  export prefab OutdoorForge {
    set { at = (0b, 0b, 0b); block = campfire; }
    set { at = (1b, 0b, 0b); block = anvil; }
    set { at = (2b, 0b, 0b); block = cauldron; }
  }
}
