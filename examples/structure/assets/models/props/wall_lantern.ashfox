ashfox 1
model wall_lantern {
  rig contract LanternRig {
    joint root {
      parent = none;
      role = root;
      channels = rotation;
    }
  }

  skeleton LanternSkeleton implements LanternRig {
    bind root {
      parent_origin = (0u, 0u, 0u);
    }
  }

  surface contract LanternFrame {
    chart plate box { coverage = opaque; }
    chart arm box { coverage = opaque; }
    chart brace box { coverage = opaque; }
    chart base box { coverage = opaque; }
    chart strut box { coverage = opaque; }
    chart hood box { coverage = opaque; }
    chart collar box { coverage = opaque; }
    chart ring flat { coverage = binary; }
    material = double;
  }

  surface contract LanternGlow {
    chart core box { coverage = opaque; }
    material = opaque;
  }

  surface forged_iron: LanternFrame {
    material = double;
    texture atlas {
      atlas = (128px, 64px);
      density = 2;
      background = slate;
      background_alpha = 255;
      palette {
        slate = #2a303b;
        iron = (#2e3545, #475269, #6f80a1);
        brass = (#8a581c, #d48c32, #ffd675);
      }
      chart plate box {
        fill = iron;
        grain = soft;
        pattern border { paint = brass; width = 1px; edges = all; }
        pattern ao { strength = 0.35; radius = 0.5u; }
      }
      chart arm box {
        fill = iron;
        grain = none;
        pattern border { paint = brass; width = 1px; edges = top; }
        pattern ao { strength = 0.3; radius = 0.5u; }
      }
      chart brace box {
        fill = iron;
        grain = none;
        pattern ao { strength = 0.3; radius = 0.5u; }
      }
      chart base box {
        fill = iron;
        grain = none;
        pattern border { paint = brass; width = 1px; edges = top; }
        pattern ao { strength = 0.35; radius = 0.5u; }
      }
      chart strut box {
        fill = iron;
        grain = none;
        pattern ao { strength = 0.3; radius = 0.4u; }
      }
      chart hood box {
        fill = iron;
        grain = soft;
        pattern border { paint = brass; width = 1px; edges = bottom; }
        pattern ao { strength = 0.35; radius = 0.5u; }
      }
      chart collar box {
        fill = brass;
        grain = none;
        pattern ao { strength = 0.25; radius = 0.4u; }
      }
      chart ring flat {
        fill = iron;
        coverage = 011110110011100001100001110011011110;
        grain = none;
        pattern border { paint = brass; width = 1px; edges = bottom; }
      }
      grain soft { seed = 707; }
      tone painterly;
    }
  }

  surface warm_amber: LanternGlow {
    material = opaque;
    texture atlas {
      atlas = (128px, 64px);
      density = 2;
      render_mode = emissive;
      background = ember;
      background_alpha = 255;
      palette {
        ember = #bd5816;
        amber = (#a64a14, #eb8a24, #ffde66);
        flame = (#db721a, #ffba3d, #fff7b8);
      }
      stamp heart {
        pixels = ".cccc./cccccc/cccccc/cccccc/cccccc/.cccc.";
        c = flame;
      }
      chart core box {
        fill = amber;
        grain = soft;
        pattern gradient { from = amber; to = flame; axis = y; space = local; soft = 0.15; }
        face north { stamp heart { at = (1px, 3px); protect = true; } }
        face south { stamp heart { at = (1px, 3px); protect = true; } }
        face east { stamp heart { at = (1px, 3px); protect = true; } }
        face west { stamp heart { at = (1px, 3px); protect = true; } }
      }
      grain soft { seed = 709; }
      tone painterly;
    }
  }

  component WallLantern {
    requires rig skel: LanternRig;
    requires surface frame: LanternFrame;
    requires surface glow: LanternGlow;
    bind bone root to skel.root;
    geometry {
      bone root {
        cube backplate { origin = (-2u, 6u, 5u); size = (4u, 7u, 1u); surface = frame.plate; }
        cube top_arm { origin = (-1u, 11u, -1u); size = (2u, 2u, 6u); surface = frame.arm; }
        cube brace { origin = (-1u, 8u, 1u); size = (2u, 1u, 5u); pivot = (0u, 8u, 5u); rotation = (-22.5deg, 0deg, 0deg); surface = frame.brace; }
        cube base { origin = (-4u, 0u, -4u); size = (8u, 2u, 8u); surface = frame.base; }
        cube collar { origin = (-3u, 2u, -3u); size = (6u, 1u, 6u); surface = frame.collar; }
        cube core { origin = (-2u, 3u, -2u); size = (4u, 5u, 4u); surface = glow.core; }
        cube strut_fl { origin = (-3u, 3u, -3u); size = (1u, 5u, 1u); mirror_x = strut_fr; surface = frame.strut; }
        cube strut_bl { origin = (-3u, 3u, 2u); size = (1u, 5u, 1u); mirror_x = strut_br; surface = frame.strut; }
        cube hood { origin = (-4u, 8u, -4u); size = (8u, 2u, 8u); surface = frame.hood; }
        cube cap { origin = (-3u, 10u, -3u); size = (6u, 1u, 6u); surface = frame.collar; }
        plane ring_x { origin = (-1.5u, 11u, 0u); size = (3u, 3u); u_axis = (1u, 0u, 0u); v_axis = (0u, 1u, 0u); surface = frame.ring; }
        plane ring_z { origin = (0u, 11u, -1.5u); size = (3u, 3u); u_axis = (0u, 0u, 1u); v_axis = (0u, 1u, 0u); surface = frame.ring; }
      }
    }
  }

  settings { density = 16; forward = north; profile = prop; }
  skeleton = LanternSkeleton;
  use WallLantern as model { skel = LanternRig; frame = forged_iron; glow = warm_amber; }
}
