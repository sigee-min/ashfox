ashfox-model 1
asset wall_lantern {
  export rig contract R {
    handedness = right;
    frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); }
    joint root {
      parent = none;
      role = root;
      frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); }
      channels = rotation;
      mirror = none;
    }
  }

  export skeleton Skel implements R {
    bind root {
      parent-origin = (0u, 0u, 0u);
      frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); }
    }
  }

  export surface contract LanternSkin {
    chart iron_base box { coverage = opaque; }
    chart glass_core box { coverage = opaque; }
    chart brass_cap box { coverage = opaque; }
    material = opaque;
  }

  export surface BrassLantern: LanternSkin {
    material = opaque;
    texture atlas {
      atlas = (128px, 128px);
      density = 2;
      render-mode = emissive;
      background = iron;
      background-alpha = 255;
      palette {
        iron = (#262c36, #3e4756, #5e6b80);
        brass = (#7d561c, #cc8e30, #ffd466);
        amber = (#cc6c14, #ffb038, #fff2a6);
      }
      chart iron_base box {
        fill = iron;
        grain = none;
        pattern border { paint = brass; width = 1px; edges = top; }
        pattern ao { strength = 0.35ratio; radius = 0.5u; }
      }
      chart glass_core box {
        fill = amber;
        grain = soft;
        pattern border { paint = brass; width = 1px; edges = all; }
      }
      chart brass_cap box {
        fill = iron;
        grain = none;
        pattern border { paint = brass; width = 1px; edges = bottom; }
        pattern ao { strength = 0.35ratio; radius = 0.5u; }
      }
      grain soft { seed = 707; }
      tone painterly;
    }
  }

  export component Body {
    requires rig skel: R;
    requires surface skin: LanternSkin;
    bind bone root to skel.root;
    geometry {
      bone root {
        cube base { origin = (-4u, 0u, -4u); size = (8u, 2u, 8u); surface = skin.iron_base; }
        cube core { origin = (-3u, 2u, -3u); size = (6u, 7u, 6u); surface = skin.glass_core; }
        cube cap { origin = (-4u, 9u, -4u); size = (8u, 2u, 8u); surface = skin.brass_cap; }
      }
    }
  }

  export asset wall_lantern {
    settings { density = 16; forward = north; profile = prop; }
    skeleton = Skel;
    use Body as body { bind skel = R; bind skin = BrassLantern; };
  }
}
