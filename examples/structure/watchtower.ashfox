ashfox-model 1
structure watchtower {
  import "./furnishings.ashfox" as deco;
  import "./props/wall_lantern.ashfox" as beacon;
  import "./props/rune_pillar.ashfox" as ward;

  size = (11, 18, 11);
  data_version = 3955;

  palette {
    moss_cobble = "minecraft:mossy_cobblestone";
    brick = "minecraft:stone_bricks";
    moss_brick = "minecraft:mossy_stone_bricks";
    deepslate = "minecraft:deepslate_bricks";
    oak = "minecraft:oak_planks";
    spruce = "minecraft:spruce_planks";
    log = "minecraft:dark_oak_log[axis=y]";
    stair_n = "minecraft:oak_stairs[facing=north,half=bottom]";
    wall = "minecraft:stone_brick_wall";
    bars = "minecraft:iron_bars";
    door_bot = "minecraft:spruce_door[facing=north,half=lower,hinge=left,open=false]";
    door_top = "minecraft:spruce_door[facing=north,half=upper,hinge=left,open=false]";
    ladder = "minecraft:ladder[facing=south]";
    torch = "minecraft:torch";
    lantern = asset beacon as "minecraft:lantern[hanging=false]";
    ward_stone = asset ward as "minecraft:chiseled_stone_bricks";
    slab = "minecraft:stone_brick_slab[type=bottom]";
  }

  build {
    box from = (1, 0, 1) to = (9, 1, 9) block = moss_cobble;
    box from = (2, 0, 2) to = (8, 0, 8) block = brick;
    set at = (5, 0, 10) block = stair_n;

    walls from = (2, 1, 2) to = (8, 12, 8) block = brick;
    frame from = (2, 1, 2) to = (8, 12, 8) block = moss_brick;
    carve from = (3, 1, 3) to = (7, 12, 7);

    mirror axis = x center = 5 {
      box from = (1, 1, 1) to = (2, 10, 2) block = deepslate;
      box from = (1, 1, 8) to = (2, 10, 9) block = deepslate;
      set at = (1, 11, 1) block = slab;
      set at = (1, 11, 9) block = slab;
    }

    set at = (5, 1, 8) block = door_bot;
    set at = (5, 2, 8) block = door_top;
    set at = (4, 3, 9) block = lantern;
    set at = (6, 3, 9) block = lantern;

    box from = (3, 5, 3) to = (7, 5, 7) block = oak;
    box from = (3, 10, 3) to = (7, 10, 7) block = spruce;
    carve from = (4, 5, 4) to = (4, 5, 4);
    carve from = (4, 10, 4) to = (4, 10, 4);
    repeat axis = y count = 11 step = 1 {
      set at = (4, 1, 3) block = ladder;
    }

    repeat axis = y count = 2 step = 5 {
      set at = (5, 3, 2) block = bars;
      set at = (5, 3, 8) block = bars;
      set at = (2, 3, 5) block = bars;
      set at = (8, 3, 5) block = bars;
    }

    box from = (1, 12, 1) to = (9, 12, 9) block = deepslate;
    box from = (2, 12, 2) to = (8, 12, 8) block = brick;
    walls from = (1, 13, 1) to = (9, 13, 9) block = wall;
    mirror axis = x center = 5 {
      set at = (1, 14, 1) block = brick;
      set at = (1, 15, 1) block = lantern;
      set at = (1, 14, 9) block = brick;
      set at = (1, 15, 9) block = lantern;
    }

    set at = (5, 13, 5) block = log;
    set at = (5, 14, 5) block = ward_stone;
    set at = (5, 15, 5) block = lantern;
    set at = (7, 13, 3) block = torch;
    set at = (3, 13, 7) block = torch;

    place deco.StudyCorner at = (5, 1, 3) rotate = 0;
    place deco.GuardBunk at = (5, 6, 3) rotate = 0;
  }
}
