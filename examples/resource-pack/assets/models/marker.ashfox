ashfox 1
model marker {
  rig contract MarkerRig {
    joint root {
      parent = none;
      role = root;
      channels = rotation;
    }
  }

  skeleton MarkerSkeleton implements MarkerRig {
    bind root { parent_origin = (0u, 0u, 0u); }
  }

  surface contract RuneStone {
    chart plinth box { coverage = opaque; }
    chart core box { coverage = opaque; }
    chart pilaster box { coverage = opaque; }
    chart collar box { coverage = opaque; }
    chart cornice box { coverage = opaque; }
    chart seal_cap box { coverage = opaque; }
    material = opaque;
  }

  surface carved_marker: RuneStone {
    material = opaque;
    texture atlas {
      density = 1;
      background = shade;
      background_alpha = 255;
      palette {
        shade = #2e3440;
        slate = (#384152, #5a667d, #8493ad);
        limestone = (#6c727a, #a2a8b0, #d6dce3);
        bronze = (#734e26, #ba823c, #eab668);
        rune = (#2c8580, #48cfc7, #a4faec);
        moss = (#436343, #6b965d, #9bc97e);
      }

      stamp rune_glyph {
        pixels = ".rrrr./rr..rr/.rrrr./..rr../.rrrr./rr..rr/.rrrr.";
        r = rune;
      }
      stamp top_seal {
        pixels = "..rr../.r..r./r.rr.r/r.rr.r/.r..r./..rr..";
        r = rune;
      }

      chart plinth box {
        fill = slate;
        grain = clustered;
        pattern border { paint = moss; width = 1px; edges = bottom; }
        pattern ao { strength = 0.35; radius = 0.6u; }
      }
      chart core box {
        fill = limestone;
        grain = soft;
        pattern gradient { from = slate; to = limestone; axis = y; space = local; soft = 0.15; }
        pattern ao { strength = 0.35; radius = 0.6u; }
        face north { stamp rune_glyph { at = (2px, 1px); protect = true; } }
        face south { stamp rune_glyph { at = (2px, 1px); protect = true; } }
        face east { stamp rune_glyph { at = (2px, 1px); protect = true; } }
        face west { stamp rune_glyph { at = (2px, 1px); protect = true; } }
      }
      chart pilaster box {
        fill = slate;
        grain = clustered;
        pattern border { paint = limestone; width = 1px; edges = top; }
        pattern ao { strength = 0.35; radius = 0.6u; }
      }
      chart collar box {
        fill = bronze;
        grain = none;
        pattern ao { strength = 0.35; radius = 0.6u; }
      }
      chart cornice box {
        fill = slate;
        grain = clustered;
        pattern border { paint = limestone; width = 1px; edges = top; }
        pattern ao { strength = 0.35; radius = 0.6u; }
      }
      chart seal_cap box {
        fill = limestone;
        grain = soft;
        pattern border { paint = slate; width = 1px; edges = all; }
        face up { stamp top_seal { at = (1px, 1px); protect = true; } }
      }
      grain clustered { seed = 4201; }
      tone painterly;
    }
  }

  component MarkerBody {
    requires rig skeleton: MarkerRig;
    requires surface skin: RuneStone;
    bind bone root to skeleton.root;
    geometry {
      bone root {
        cube plinth { origin = (-8u, 0u, -8u); size = (16u, 3u, 16u); surface = skin.plinth; }
        cube core { origin = (-5u, 3u, -5u); size = (10u, 9u, 10u); surface = skin.core; }
        cube pilaster_fl { origin = (-7u, 3u, -7u); size = (3u, 9u, 3u); mirror_x = pilaster_fr; surface = skin.pilaster; }
        cube pilaster_bl { origin = (-7u, 3u, 4u); size = (3u, 9u, 3u); mirror_x = pilaster_br; surface = skin.pilaster; }
        cube collar { origin = (-6u, 12u, -6u); size = (12u, 2u, 12u); surface = skin.collar; }
        cube cornice { origin = (-7u, 14u, -7u); size = (14u, 1u, 14u); surface = skin.cornice; }
        cube seal_cap { origin = (-4u, 15u, -4u); size = (8u, 1u, 8u); surface = skin.seal_cap; }
      }
    }
  }

  settings { density = 16; forward = north; profile = block; }
  skeleton = MarkerSkeleton;
  use MarkerBody as model { skeleton = MarkerRig; skin = carved_marker; }
}
