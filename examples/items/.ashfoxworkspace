{
  "format": "ashfox-workspace",
  "version": 2,
  "name": "item-collection",
  "packages": [
    {
      "name": "items",
      "root": "src",
      "manifest": {
        "format": "ashfox-package",
        "version": 1,
        "entries": [
          {
            "name": "apple",
            "path": "apple.ashfox"
          },
          {
            "name": "green_apple",
            "path": "green_apple.ashfox"
          },
          {
            "name": "golden_apple",
            "path": "golden_apple.ashfox"
          },
          {
            "name": "iron_sword",
            "path": "iron_sword.ashfox"
          },
          {
            "name": "copper_sword",
            "path": "copper_sword.ashfox"
          },
          {
            "name": "crystal_sword",
            "path": "crystal_sword.ashfox"
          },
          {
            "name": "ruby_potion",
            "path": "ruby_potion.ashfox"
          },
          {
            "name": "blue_potion",
            "path": "blue_potion.ashfox"
          },
          {
            "name": "amber_potion",
            "path": "amber_potion.ashfox"
          },
          {
            "name": "amethyst",
            "path": "amethyst.ashfox"
          }
        ],
        "modules": [
          {
            "subpath": "./shared",
            "path": "shared.ashfox"
          }
        ],
        "dependencies": []
      }
    }
  ],
  "include": [
    "src/**/*.ashfox"
  ],
  "ignore": [
    "src/drafts/**"
  ],
  "build": {
    "directory": "build"
  },
  "exports": [
    {
      "name": "apple",
      "entry": {
        "packageName": "items",
        "entryName": "apple"
      },
      "format": "png",
      "directory": "exports/apple"
    },
    {
      "name": "green_apple",
      "entry": {
        "packageName": "items",
        "entryName": "green_apple"
      },
      "format": "png",
      "directory": "exports/green_apple"
    },
    {
      "name": "golden_apple",
      "entry": {
        "packageName": "items",
        "entryName": "golden_apple"
      },
      "format": "png",
      "directory": "exports/golden_apple"
    },
    {
      "name": "iron_sword",
      "entry": {
        "packageName": "items",
        "entryName": "iron_sword"
      },
      "format": "png",
      "directory": "exports/iron_sword"
    },
    {
      "name": "copper_sword",
      "entry": {
        "packageName": "items",
        "entryName": "copper_sword"
      },
      "format": "png",
      "directory": "exports/copper_sword"
    },
    {
      "name": "crystal_sword",
      "entry": {
        "packageName": "items",
        "entryName": "crystal_sword"
      },
      "format": "png",
      "directory": "exports/crystal_sword"
    },
    {
      "name": "ruby_potion",
      "entry": {
        "packageName": "items",
        "entryName": "ruby_potion"
      },
      "format": "png",
      "directory": "exports/ruby_potion"
    },
    {
      "name": "blue_potion",
      "entry": {
        "packageName": "items",
        "entryName": "blue_potion"
      },
      "format": "png",
      "directory": "exports/blue_potion"
    },
    {
      "name": "amber_potion",
      "entry": {
        "packageName": "items",
        "entryName": "amber_potion"
      },
      "format": "png",
      "directory": "exports/amber_potion"
    },
    {
      "name": "amethyst",
      "entry": {
        "packageName": "items",
        "entryName": "amethyst"
      },
      "format": "png",
      "directory": "exports/amethyst"
    }
  ]
}
