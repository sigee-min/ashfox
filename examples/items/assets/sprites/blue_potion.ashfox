ashfox 1
sprite blue_potion {
  import "../module/shared.ashfox" as shared;
  profile = item;
  canvas = (32px, 32px);
  palette {
    shine = #ffffff;
    bubble = #b6f5ff;
  }
  rect cork {
    x = 14px; y = 4px; width = 4px; height = 4px;
    material = shared.cork_wood;
    shade { form = cylinder; light = top_left; contrast = 2; axis = [(16px, 4px), (16px, 8px)]; }
  }
  rect bottle_neck {
    x = 13px; y = 8px; width = 6px; height = 5px;
    material = shared.glass;
    shade { form = cylinder; light = top_left; contrast = 2; axis = [(16px, 8px), (16px, 13px)]; }
  }
  capsule bottle_lip {
    from = (12px, 8px); to = (19px, 8px); radius = 1.1px;
    material = shared.glass;
    shade { form = cylinder; light = top_left; contrast = 2; specular = 1; }
  }
  ellipse bottle_body {
    cx = 15.5px; cy = 19.5px; rx = 8.3px; ry = 7.9px;
    material = shared.glass;
    shade { form = round; light = top_left; contrast = 2; specular = 2; }
  }
  ellipse liquid {
    cx = 15.5px; cy = 20.8px; rx = 6.7px; ry = 5.8px;
    material = shared.blue_liquid;
    shade { form = round; light = top_left; contrast = 2; specular = 2; }
    pattern gradient { axis = y; to_material = shared.amethyst_glow; dither = false; seed = 9; }
  }
  paint spec {
    at = (10px, 14px);
    rows = [
      ".ss...",
      "s.....",
      "s.....",
      "......",
      "....b.",
      ".....b"
    ];
    colors { s = shine; b = bubble; }
  }
  outline edge { mode = sel_out; strength = 2; inner_rim = true; }
}
