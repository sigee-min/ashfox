ashfox-model 1
sprite blue_potion {
  import "../module/shared.ashfox" as shared;
  profile = item;
  canvas = (32px, 32px);
  palette {
    shine = #ffffff;
    bubble = #b6f5ff;
  }
  shape cork {
    shape { kind = rect; x = 14; y = 4; width = 4; height = 4; }
    material = shared.cork_wood;
    shade { form = cylinder; light = top_left; contrast = 2; axis = [(16, 4), (16, 8)]; }
  }
  shape bottle_neck {
    shape { kind = rect; x = 13; y = 8; width = 6; height = 5; }
    material = shared.glass;
    shade { form = cylinder; light = top_left; contrast = 2; axis = [(16, 8), (16, 13)]; }
  }
  shape bottle_lip {
    shape { kind = capsule; x1 = 12; y1 = 8; x2 = 19; y2 = 8; radius = 1.1; }
    material = shared.glass;
    shade { form = cylinder; light = top_left; contrast = 2; specular = 1; axis = [(12, 8), (19, 8)]; }
  }
  shape bottle_body {
    shape { kind = ellipse; cx = 15.5; cy = 19.5; rx = 8.3; ry = 7.9; }
    material = shared.glass;
    shade { form = round; light = top_left; contrast = 2; specular = 2; }
  }
  shape liquid {
    shape { kind = ellipse; cx = 15.5; cy = 20.8; rx = 6.7; ry = 5.8; }
    material = shared.blue_liquid;
    shade { form = round; light = top_left; contrast = 2; specular = 2; }
    pattern { kind = gradient; axis = y; toMaterial = shared.amethyst_glow; dither = false; seed = 9; }
  }
  paint spec {
    at = (10px, 14px);
    rows = [
      ".ss...",
      "s.....",
      "s.....",
      "......",
      "....b.",
      ".....b"
    ];
    colors { s = shine; b = bubble; }
  }
  outline edge { mode = sel_out; strength = 2; innerRim = true; }
}
