ashfox-model 1
sprite apple {
  import "../module/shared.ashfox" as shared;
  profile = item;
  canvas = (32px, 32px);
  palette {
    spec = #fff4de;
    vein = #a8eb82;
    dimple = #782026;
  }
  shape body {
    shape { kind = polygon; points = [(11, 10), (14, 12), (17, 12), (20, 10), (22, 12), (23, 15), (23, 19), (21, 23), (18, 25), (13, 25), (10, 23), (8, 19), (8, 15), (9, 12)]; }
    material = shared.apple_red;
    shade { form = round; light = top_left; contrast = 2; specular = 2; }
    pattern { kind = gradient; axis = radial; toMaterial = shared.apple_blush; dither = false; seed = 5; }
  }
  shape stem {
    shape { kind = capsule; x1 = 15.5; y1 = 11.5; x2 = 16.5; y2 = 5.5; radius = 1.05; }
    material = shared.stem_wood;
    shade { form = cylinder; light = top_left; contrast = 2; axis = [(15, 11), (16, 5)]; }
  }
  shape leaf {
    shape { kind = polygon; points = [(17, 9), (21, 5), (26, 6), (22, 10)]; }
    material = shared.leaf_green;
    shade { form = bevel; light = top_left; contrast = 2; axis = [(17, 9), (25, 6)]; }
  }
  paint highlights {
    at = (9px, 7px);
    rows = [
      "............vvv..",
      ".................",
      ".................",
      ".................",
      ".....dd..........",
      ".................",
      ".sss.............",
      "ss...............",
      "s................"
    ];
    colors { s = spec; v = vein; d = dimple; }
  }
  outline edge { mode = sel_out; strength = 2; innerRim = true; }
}
