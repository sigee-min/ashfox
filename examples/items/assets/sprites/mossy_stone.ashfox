ashfox 1
sprite mossy_stone {
  import "../module/shared.ashfox" as shared;
  export material cobblestone {
    ramp { mode = auto; base = #7b818c; preset = stone; }
  }
  export material mortar_dark {
    ramp { mode = auto; base = #4a505a; preset = stone; }
  }
  export material moss_dark {
    ramp { mode = auto; base = #46763c; preset = organic; }
  }
  profile = tile;
  canvas = (32px, 32px);
  palette {}
  fill stone_blocks {
    material = cobblestone;
    pattern voronoi { cells = 9; jitter = 0.62; edge_width = 1px; seed = 37; edge_material = mortar_dark; }
    grain soft { amount = 1; seed = 19; }
  }
  pattern moss_overgrowth {
    material = cobblestone;
    pattern blotch { scale = 6px; density = 0.3; seed = 53; to_material = shared.moss_flora; }
    clip = canvas;
  }
  pattern moss_accent {
    material = shared.moss_flora;
    pattern dither { mode = cluster; density = 0.24; seed = 71; to_material = moss_dark; }
    clip = canvas;
  }
  pattern stone_fissures {
    material = mortar_dark;
    pattern crack { count = 3; seed = 89; }
    clip = canvas;
  }
}
