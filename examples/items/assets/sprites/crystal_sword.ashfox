ashfox 1
sprite crystal_sword {
  import "../module/shared.ashfox" as shared;
  profile = item;
  canvas = (32px, 32px);
  palette {
    spark = #f2ffff;
    prism = #a6f7ff;
  }
  polygon blade_body {
    points = [(11px, 16px), (15px, 20px), (26px, 9px), (28px, 3px), (22px, 5px)];
    material = shared.crystal;
    shade { form = bevel; light = top_left; contrast = 2; specular = 2; axis = [(13px, 18px), (28px, 3px)]; }
    pattern gradient { axis = radial; to_material = shared.crystal_core; dither = false; seed = 41; }
  }
  line core_beam {
    from = (15px, 16px); to = (25px, 6px); thickness = 1px;
    material = shared.crystal_core;
    shade { form = bevel; light = top_left; contrast = 2; specular = 2; axis = [(15px, 16px), (25px, 6px)]; }
  }
  capsule grip {
    from = (5px, 26px); to = (12px, 19px); radius = 1.4px;
    material = shared.steel;
    shade { form = cylinder; light = top_left; contrast = 2; }
    pattern stripe { axis = diag_neg; period = 3px; width = 1px; }
  }
  polygon crossguard {
    points = [(7px, 13px), (10px, 14px), (17px, 21px), (18px, 24px), (15px, 23px), (8px, 16px)];
    material = shared.gold;
    shade { form = cylinder; light = top_left; contrast = 2; specular = 2; axis = [(8px, 14px), (17px, 23px)]; }
  }
  ellipse pommel {
    cx = 4.5px; cy = 26.5px; rx = 1.9px; ry = 1.9px;
    material = shared.crystal;
    shade { form = facet; light = top_left; contrast = 2; specular = 2; }
  }
  paint sparkles {
    at = (12px, 4px);
    rows = [
      "...............s",
      "..............ps",
      "................",
      "................",
      "................",
      "................",
      "................",
      "................",
      "................",
      "................",
      "................",
      "................",
      "................",
      "................",
      "s...............",
      "pp.............."
    ];
    colors { s = spark; p = prism; }
  }
  outline edge { mode = sel_out; strength = 2; inner_rim = true; }
}
