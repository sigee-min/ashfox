ashfox 1
sprite golden_apple {
  import "../module/shared.ashfox" as shared;
  profile = item;
  canvas = (32px, 32px);
  palette {
    spec = #fffbe0;
    leaf_glint = #c2f59c;
    dimple = #87551c;
  }
  polygon body {
    points = [(11px, 10px), (14px, 12px), (17px, 12px), (20px, 10px), (22px, 12px), (23px, 15px), (23px, 19px), (21px, 23px), (18px, 25px), (13px, 25px), (10px, 23px), (8px, 19px), (8px, 15px), (9px, 12px)];
    material = shared.apple_gold;
    shade { form = round; light = top_left; contrast = 2; specular = 2; }
    pattern gradient { axis = radial; to_material = shared.copper; dither = false; seed = 9; }
  }
  capsule stem {
    from = (15.5px, 11.5px); to = (16.5px, 5.5px); radius = 1.05px;
    material = shared.stem_wood;
    shade { form = cylinder; light = top_left; contrast = 2; axis = [(15px, 11px), (16px, 5px)]; }
  }
  polygon leaf {
    points = [(17px, 9px), (21px, 5px), (26px, 6px), (22px, 10px)];
    material = shared.leaf_green;
    shade { form = bevel; light = top_left; contrast = 2; axis = [(17px, 9px), (25px, 6px)]; }
  }
  paint glint {
    at = (9px, 7px);
    rows = [
      "............aaa..",
      ".................",
      ".................",
      ".................",
      ".....dd..........",
      ".................",
      ".sss.............",
      "ss...............",
      "s................"
    ];
    colors { s = spec; a = leaf_glint; d = dimple; }
  }
  outline edge { mode = sel_out; strength = 2; inner_rim = true; }
}
