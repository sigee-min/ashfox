ashfox 1
sprite oak_planks {
  import "../module/shared.ashfox" as shared;
  export material plank_light {
    ramp { mode = auto; base = #99643a; preset = wood; }
  }
  profile = tile;
  canvas = (32px, 32px);
  palette {}
  fill timber_base {
    material = shared.oak_timber;
    pattern plank { height = 8px; joint = 1px; seed = 23; mortar_material = shared.oak_joint; }
    grain none { amount = 0; seed = 41; }
  }
  pattern grain_variation {
    material = shared.oak_timber;
    pattern blotch { scale = 6px; density = 0.22; seed = 67; to_material = plank_light; }
    clip = canvas;
  }
}
