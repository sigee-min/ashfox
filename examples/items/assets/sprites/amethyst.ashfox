ashfox 1
sprite amethyst {
  import "../module/shared.ashfox" as shared;
  profile = item;
  canvas = (32px, 32px);
  palette {
    spark = #fff2ff;
  }
  capsule host_rock {
    from = (8px, 23px); to = (23px, 23px); radius = 3.5px;
    material = shared.stone_host;
    shade { form = round; light = top_left; contrast = 2; specular = 0; }
    grain clustered { amount = 1; seed = 7; }
  }
  polygon left_spire {
    points = [(7px, 22px), (8px, 12px), (11px, 10px), (14px, 22px)];
    material = shared.amethyst_gem;
    shade { form = facet; light = top_left; contrast = 2; specular = 2; }
  }
  polygon right_spire {
    points = [(18px, 22px), (20px, 11px), (24px, 13px), (23px, 22px)];
    material = shared.amethyst_gem;
    shade { form = facet; light = top_left; contrast = 2; specular = 1; }
  }
  polygon main_spire {
    points = [(12px, 23px), (13px, 8px), (16px, 4px), (19px, 8px), (19px, 23px)];
    material = shared.amethyst_gem;
    shade { form = facet; light = top_left; contrast = 3; specular = 2; }
    pattern gradient { axis = y; to_material = shared.amethyst_glow; dither = false; seed = 19; }
  }
  paint glint {
    at = (9px, 6px);
    rows = [
      "......s..",
      ".....ss..",
      ".........",
      ".........",
      ".........",
      "s........",
      ".s......."
    ];
    colors { s = spark; }
  }
  outline edge { mode = sel_out; strength = 2; inner_rim = true; }
}
