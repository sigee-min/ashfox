{"files":[{"path":"creatures/body.ashfox","source":"ashfox-model 1\nmodule body {\n  import \"./rig.ashfox\" as rig;\n  import \"./surface.ashfox\" as surface;\n  export component FoxBody {\n    requires rig skeleton: rig.CreatureRig;\n    requires surface skin: surface.Fur;\n    bind bone body to skeleton.body;\n    bind bone head to skeleton.head;\n    bind bone tail to skeleton.tail;\n    bind bone front_left to skeleton.front_left;\n    bind bone front_right to skeleton.front_right;\n    bind bone back_left to skeleton.back_left;\n    bind bone back_right to skeleton.back_right;\n    geometry {\n      bone body {\n        cube torso { origin = (-4u, 7u, -4u); size = (8u, 6u, 12u); surface = skin.torso; }\n        cube chest { origin = (-3u, 6u, -8u); size = (6u, 7u, 5u); surface = skin.chest; }\n        cube throat { origin = (-2u, 7u, -10u); size = (4u, 5u, 3u); surface = skin.throat; }\n        bone head {\n          cube skull { origin = (-4u, 11u, -12u); size = (8u, 7u, 8u); surface = skin.head; }\n          cube muzzle { origin = (-3u, 10u, -16u); size = (6u, 3u, 5u); surface = skin.muzzle; }\n          cube nose { origin = (-1u, 11u, -17u); size = (2u, 1u, 1u); surface = skin.nose; }\n          cube left_ear_base { origin = (-4u, 17u, -10u); size = (3u, 3u, 3u); surface = skin.ear_base; }\n          cube right_ear_base { origin = (1u, 17u, -10u); size = (3u, 3u, 3u); surface = skin.ear_base; }\n          cube left_ear_tip { origin = (-3.5u, 20u, -9.5u); size = (2u, 2u, 2u); surface = skin.ear_tip; }\n          cube right_ear_tip { origin = (1.5u, 20u, -9.5u); size = (2u, 2u, 2u); surface = skin.ear_tip; }\n          cube left_ear_inner { origin = (-3.5u, 18u, -11u); size = (2u, 2u, 1u); surface = skin.ear_inner; }\n          cube right_ear_inner { origin = (1.5u, 18u, -11u); size = (2u, 2u, 1u); surface = skin.ear_inner; }\n        }\n        bone tail {\n          cube tail_base { origin = (-2.5u, 8u, 7u); size = (5u, 5u, 8u); surface = skin.tail_main; }\n          cube tail_mid { origin = (-2.5u, 10u, 13u); size = (5u, 5u, 8u); surface = skin.tail_main; }\n          cube tail_tip { origin = (-2u, 12u, 19u); size = (4u, 4u, 6u); surface = skin.tail_tip; }\n        }\n        bone front_left {\n          cube leg { origin = (-3.5u, 2u, -6u); size = (3u, 7u, 3u); surface = skin.front_leg; }\n          cube paw { origin = (-3.5u, 0u, -7u); size = (3u, 2u, 4u); surface = skin.front_paw; }\n        }\n        bone front_right {\n          cube leg { origin = (0.5u, 2u, -6u); size = (3u, 7u, 3u); surface = skin.front_leg; }\n          cube paw { origin = (0.5u, 0u, -7u); size = (3u, 2u, 4u); surface = skin.front_paw; }\n        }\n        bone back_left {\n          cube leg { origin = (-4u, 2u, 4u); size = (4u, 7u, 4u); surface = skin.back_leg; }\n          cube paw { origin = (-4u, 0u, 3u); size = (4u, 2u, 5u); surface = skin.back_paw; }\n        }\n        bone back_right {\n          cube leg { origin = (0u, 2u, 4u); size = (4u, 7u, 4u); surface = skin.back_leg; }\n          cube paw { origin = (0u, 0u, 3u); size = (4u, 2u, 5u); surface = skin.back_paw; }\n        }\n      }\n    }\n  }\n}\n"},{"path":"creatures/fox.ashfox","source":"ashfox-model 1\nasset fox {\n  import \"./rig.ashfox\" as rig;\n  import \"./surface.ashfox\" as surface;\n  import \"./body.ashfox\" as body;\n  export asset fox {\n    settings { density = 16; forward = north; }\n    skeleton = rig.CreatureSkeleton;\n    motion = rig.idle;\n    motion = rig.curious;\n    motion = rig.tail_wag;\n    use body.FoxBody as fox { bind skeleton = rig.CreatureRig; bind skin = surface.red_fox; };\n  }\n}\n"},{"path":"creatures/rig.ashfox","source":"ashfox-model 1\nmodule rig {\n  export rig contract CreatureRig {\n    handedness = right;\n    frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); }\n    joint root { parent = none; role = root; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = (rotation, scale); mirror = none; }\n    joint body { parent = root; role = body; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = rotation; mirror = none; }\n    joint head { parent = body; role = head; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = rotation; mirror = none; }\n    joint tail { parent = body; role = tail; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = rotation; mirror = none; }\n    joint front_left { parent = body; role = leg; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = rotation; mirror = none; }\n    joint front_right { parent = body; role = leg; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = rotation; mirror = none; }\n    joint back_left { parent = body; role = leg; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = rotation; mirror = none; }\n    joint back_right { parent = body; role = leg; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = rotation; mirror = none; }\n  }\n  export skeleton CreatureSkeleton implements CreatureRig {\n    bind root { parent-origin = (0u, 0u, 0u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }\n    bind body { parent-origin = (0u, 10u, 0u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }\n    bind head { parent-origin = (0u, 3u, -6u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }\n    bind tail { parent-origin = (0u, 0u, 7u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }\n    bind front_left { parent-origin = (-2u, -2u, -4.5u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }\n    bind front_right { parent-origin = (2u, -2u, -4.5u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }\n    bind back_left { parent-origin = (-2u, -2u, 6u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }\n    bind back_right { parent-origin = (2u, -2u, 6u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }\n  }\n  export motion idle for CreatureRig {\n    duration = 2s; fps = 20; loop = loop; rest-relative = true;\n    track head.rotation {\n      key 0s = (0deg, 0deg, 0deg) catmullrom;\n      key 1s = (0deg, 3deg, 0deg) catmullrom;\n      key 2s = (0deg, 0deg, 0deg) catmullrom;\n    }\n    track tail.rotation {\n      key 0s = (0deg, 0deg, 0deg) catmullrom;\n      key 1s = (3deg, 8deg, 0deg) catmullrom;\n      key 2s = (0deg, 0deg, 0deg) catmullrom;\n    }\n  }\n  export motion curious for CreatureRig {\n    duration = 4s; fps = 24; loop = loop; rest-relative = true;\n    track head.rotation {\n      key 0s = (0deg, 0deg, 0deg) catmullrom;\n      key 1s = (6deg, -18deg, -7deg) catmullrom;\n      key 2s = (6deg, -18deg, -7deg) catmullrom;\n      key 3s = (-3deg, 12deg, 5deg) catmullrom;\n      key 4s = (0deg, 0deg, 0deg) catmullrom;\n    }\n    track tail.rotation {\n      key 0s = (0deg, 0deg, 0deg) catmullrom;\n      key 1s = (3deg, 10deg, 0deg) catmullrom;\n      key 2s = (0deg, -8deg, 0deg) catmullrom;\n      key 3s = (3deg, 6deg, 0deg) catmullrom;\n      key 4s = (0deg, 0deg, 0deg) catmullrom;\n    }\n  }\n  export motion tail_wag for CreatureRig {\n    duration = 2.4s; fps = 24; loop = loop; rest-relative = true;\n    track tail.rotation {\n      key 0s = (0deg, 0deg, 0deg) catmullrom;\n      key 0.3s = (2deg, 18deg, 0deg) catmullrom;\n      key 0.9s = (2deg, -18deg, 0deg) catmullrom;\n      key 1.5s = (2deg, 18deg, 0deg) catmullrom;\n      key 2.1s = (2deg, -18deg, 0deg) catmullrom;\n      key 2.4s = (0deg, 0deg, 0deg) catmullrom;\n    }\n    track head.rotation {\n      key 0s = (0deg, 0deg, 0deg) catmullrom;\n      key 0.6s = (-4deg, 0deg, -3deg) catmullrom;\n      key 1.8s = (-4deg, 0deg, 3deg) catmullrom;\n      key 2.4s = (0deg, 0deg, 0deg) catmullrom;\n    }\n  }\n}\n"},{"path":"creatures/surface.ashfox","source":"ashfox-model 1\nmodule surface {\n  export surface contract Fur {\n    atlas { width = 128px; height = 64px; }\n\n    chart torso box { width = 40px; height = 18px; coverage = opaque; }\n    chart chest box { width = 22px; height = 12px; coverage = opaque; }\n    chart throat box { width = 14px; height = 8px; coverage = opaque; }\n    chart head box { width = 32px; height = 15px; coverage = opaque; }\n    chart muzzle box { width = 22px; height = 8px; coverage = opaque; }\n    chart ear_base box { width = 12px; height = 6px; coverage = opaque; }\n    chart ear_tip box { width = 8px; height = 4px; coverage = opaque; }\n    chart ear_inner box { width = 6px; height = 3px; coverage = opaque; }\n    chart front_leg box { width = 12px; height = 10px; coverage = opaque; }\n    chart front_paw box { width = 14px; height = 6px; coverage = opaque; }\n    chart back_leg box { width = 16px; height = 11px; coverage = opaque; }\n    chart back_paw box { width = 18px; height = 7px; coverage = opaque; }\n    chart tail_main box { width = 26px; height = 13px; coverage = opaque; }\n    chart tail_tip box { width = 20px; height = 10px; coverage = opaque; }\n    chart nose box { width = 6px; height = 2px; coverage = opaque; }\n    material = opaque;\n  }\n\n  export surface red_fox: Fur {\n    material = opaque;\n    texture atlas {\n      atlas = (128px, 64px); background = deep; background-alpha = 255;\n      palette {\n        deep = #140b0a;\n        coat = (#5a1c10, #b94722, #ef8040);\n        coat_dark = (#32100b, #6a2417, #a74325);\n        cream = (#7d4b28, #d29a62, #ffe1a8);\n        leg = (#1c0d0c, #43201a, #754034);\n        paw = (#120908, #2c1714, #523029);\n        inner = (#67282a, #a94c4d, #dc7a72);\n        eye_white = #fff2d6;\n        eye_dark = (#090707, #171011, #302020);\n        nose = (#080606, #160d0b, #321a13);\n      }\n      stamp face_mask {\n        pixels = \"......../cc....cc/ccc..ccc/cc....cc\";\n        c = cream;\n      }\n      stamp chest_blaze {\n        pixels = \"..cc../.cccc./cccccc/cccccc/.cccc./..cc../..cc..\";\n        c = cream;\n      }\n      stamp mouth_mark {\n        pixels = \"....../....../..dd..\";\n        d = eye_dark;\n      }\n      stamp eye_pair {\n        pixels = \".wk..kw./.wk..kw.\";\n        w = eye_white;\n        k = eye_dark;\n      }\n\n      chart torso box {\n        origin = (0px, 0px); fill = coat;\n        pattern blotch { paint = coat_dark; scale = (4px, 3px, 5px); density = 0.18ratio; phase = 11; }\n      }\n      chart head box {\n        origin = (40px, 0px); fill = coat;\n        pattern blotch { paint = coat_dark; scale = (3px, 3px, 3px); density = 0.14ratio; phase = 37; }\n        face north {\n          stamp eye_pair { at = (0px, 1px); }\n          stamp face_mask { at = (0px, 3px); }\n        }\n      }\n      chart chest box {\n        origin = (72px, 0px); fill = coat;\n        face north { stamp chest_blaze { at = (0px, 0px); } }\n      }\n      chart tail_main box {\n        origin = (94px, 0px); fill = coat;\n        pattern blotch { paint = coat_dark; scale = (4px, 4px, 5px); density = 0.16ratio; phase = 73; }\n      }\n      chart muzzle box {\n        origin = (0px, 20px); fill = cream;\n        face north { stamp mouth_mark { at = (0px, 0px); } }\n      }\n      chart throat box { origin = (22px, 20px); fill = cream; }\n      chart back_leg box { origin = (36px, 20px); fill = leg; }\n      chart front_leg box { origin = (52px, 20px); fill = leg; }\n      chart tail_tip box { origin = (64px, 20px); fill = cream; }\n      chart back_paw box { origin = (84px, 20px); fill = paw; }\n      chart front_paw box { origin = (102px, 20px); fill = paw; }\n      chart ear_base box { origin = (116px, 20px); fill = coat; }\n      chart ear_tip box { origin = (0px, 33px); fill = coat_dark; }\n      chart ear_inner box { origin = (8px, 33px); fill = inner; }\n      chart nose box { origin = (26px, 33px); fill = nose; }\n      grain clustered { seed = 8923; }\n      tone voxel;\n    }\n  }\n\n}\n"}],"lock":{"compilerFingerprint":"ashfox-asset-compiler:workspace+design+anchored-pixels+parent-space-rig+typed-hir+instantiation+canonical:v1","format":"ashfox-lock","packages":[{"contentHash":"sha256:b6674ce