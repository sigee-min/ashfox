ashfox 1
sound claw_hit {
  profile = impact;
  duration = 0.58s;
  seed = 42;
  space { preset = dry_close; mix = 15%; }

  voice leather_thud : modal_plate {
    material = leather;
    pitch = 82hz;
    size = 1.3;
    hardness = 0.82;
    damping = 0.65;
    brightness = 0.6;
    modes = 14;
    strike = mallet;
    splash = 0.52;
    stereo_spread = 0.35;
    highpass = 32hz;
    lowpass = 9500hz;
    eq { low = (110hz, 2.5db); }
    drive : tube { amount = 2.2; }
    pan = -0.06;
    gain { env = ad; attack = 3ms; peak = 1.0; curve = exp; }
  }

  voice bone_slash : modal_plate {
    material = bone;
    pitch = 680hz;
    size = 0.8;
    hardness = 0.88;
    damping = 0.58;
    brightness = 0.82;
    modes = 16;
    strike = scrape;
    twin_beat = 0.28;
    splash = 0.45;
    stereo_spread = 0.65;
    highpass = 220hz;
    filter : lowpass { cutoff = log(0: 11000hz -> 1: 1400hz); q = 1.1; }
    pan = 0.14;
    gain { env = ad; attack = 2ms; peak = 0.82; curve = exp; }
  }

  voice slash_tear : aero_whoosh {
    velocity = lin(0: 0.4 -> 0.25: 2.2 -> 1: 0.25);
    thickness = 0.035;
    doppler = 0.65;
    sweep_pan = -0.6 -> 0.55;
    noise_tone = 0.72;
    filter : bandpass { cutoff = log(0: 8500hz -> 1: 520hz); q = 1.2; }
    drive : grit { amount = 1.8; }
    duck { by = leather_thud; amount = 30%; release_ms = 70ms; }
    gain { env = ad; attack = 3ms; peak = 0.9; curve = exp; }
  }

  voice blade_air : noise {
    color = white;
    filter : bandpass { cutoff = log(0: 9500hz -> 1: 2400hz); q = 1.1; }
    pan = 0.3 -> -0.2;
    gain { env = ad; attack = 2ms; peak = 0.48; curve = exp; }
  }

  seq hit {
    start = 10ms;
    step impact { voice = leather_thud; at = 0s; duration = 440ms; vary_pitch = -65cents..65cents; }
    step bone { voice = bone_slash; at = 0s; duration = 300ms; vary_pitch = -70cents..70cents; vary_gain = 90%..110%; }
    step slash { voice = slash_tear; at = 0s; duration = 360ms; vary_duration = 90%..110%; vary_gain = 90%..110%; }
    step air { voice = blade_air; at = 0s; duration = 140ms; vary_gain = 85%..115%; }
  }

  variants { base = 42; alternate = 43; }
  master { gain = 5db; target = -12lufs; peak = -1.5db; punch = 45%; warmth = 20%; glue = 15%; limit = true; }
}
