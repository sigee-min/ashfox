ashfox 1
sound claw_hit {
  profile = impact;
  duration = 0.58s;
  channels = 2;
  seed = 42;
  space { preset = dry_close; mix = 15%; }
  voice leather_thud : material {
    material = leather;
    pitch = 82hz;
    size = 1.3;
    hardness = 82%;
    damping = 65%;
    brightness = 60%;
    modes = 14;
    strike = mallet;
    highpass = 32hz;
    lowpass = 9500hz;
    drive = 2.2;
    pan = -0.06;
    gain { env = ad; attack = 3ms; peak = 1; curve = exp; }
  }
  voice bone_slash : material {
    material = bone;
    pitch = 680hz;
    size = 0.8;
    hardness = 88%;
    damping = 58%;
    brightness = 82%;
    modes = 16;
    strike = scrape;
    filter lowpass {
      cutoff { domain = log; interpolation = smooth; points = [(0, 11000hz), (1, 1400hz)]; }
      q = 1.1;
    }
    highpass = 220hz;
    pan = 0.14;
    gain { env = ad; attack = 2ms; peak = 0.82; curve = exp; }
  }
  voice slash_tear : noise {
    color = pink;
    filter bandpass {
      cutoff { domain = log; interpolation = smooth; points = [(0, 8500hz), (1, 520hz)]; }
      q = 1.2;
    }
    drive = 1.8;
    pan = -0.18;
    gain { env = ad; attack = 3ms; peak = 0.9; curve = exp; }
  }
  voice blade_air : noise {
    color = white;
    filter bandpass {
      cutoff { domain = log; interpolation = smooth; points = [(0, 9500hz), (1, 2400hz)]; }
      q = 1.1;
    }
    pan = 0.2;
    gain { env = ad; attack = 2ms; peak = 0.48; curve = exp; }
  }
  seq hit {
    start = 10ms;
    step impact { voice = leather_thud; at = 0s; duration = 0.44s; vary_pitch = -65cents..65cents; }
    step bone { voice = bone_slash; at = 0s; duration = 0.3s; vary_pitch = -70cents..70cents; vary_gain = 90%..110%; }
    step slash { voice = slash_tear; at = 0s; duration = 0.36s; vary_gain = 90%..110%; vary_duration = 90%..110%; }
    step air { voice = blade_air; at = 0s; duration = 0.14s; vary_gain = 85%..115%; }
  }
  variant base { seed = 42; }
  variant alternate { seed = 43; }
  master { gain = 5db; peak = -1.5db; target = -12lufs; punch = 45%; warmth = 20%; glue = 15%; limit = true; }
}
