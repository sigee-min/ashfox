ashfox-model 1
asset griffin {
  import "./animation.ashfox" as animation;
  export surface contract Plumage {
    chart haunch box { coverage = opaque; }
    chart chest box { coverage = opaque; }
    chart breast box { coverage = opaque; }
    chart mantle box { coverage = opaque; }
    chart skull box { coverage = opaque; }
    chart brow box { coverage = opaque; }
    chart beak box { coverage = opaque; }
    chart beak_tip box { coverage = opaque; }
    chart crest box { coverage = opaque; }
    chart crest_plume flat { coverage = opaque; }
    chart foreleg box { coverage = opaque; }
    chart forefoot box { coverage = opaque; }
    chart talon box { coverage = opaque; }
    chart hind_thigh box { coverage = opaque; }
    chart hind_shin box { coverage = opaque; }
    chart hind_paw box { coverage = opaque; }
    chart hind_claw box { coverage = opaque; }
    chart shoulder box { coverage = opaque; }
    chart wing_arm box { coverage = opaque; }
    chart feather_a box { coverage = opaque; }
    chart feather_b box { coverage = opaque; }
    chart feather_c box { coverage = opaque; }
    chart feather_tip box { coverage = opaque; }
    chart tail_base box { coverage = opaque; }
    chart tail_rise box { coverage = opaque; }
    chart tail_tuft box { coverage = opaque; }
    material = opaque;
  }

  export surface griffin_skin: Plumage {
    material = opaque;
    texture atlas {
      background = shade; background-alpha = 255;
      palette {
        shade = #23262b;
        eye = #102426;
        gleam = #56d9c5;
        gold = (#66411f, #ba8241, #e6b368);
        gold_deep = (#452a13, #825526, #b87e3c);
        ivory = (#8f8e82, #d8d5c2, #f8f2e2);
        ivory_mid = (#6d6b62, #aaa698, #d9d3c3);
        beak = (#8b551e, #dfa338, #ffd66e);
        feather = (#645546, #b5a890, #e8dec5);
        dark = (#24272c, #494947, #7a746a);
        claw = (#1b1d20, #3f4247, #6d7076);
      }
      stamp eye_mark {
        pixels = "eee/egg/eee";
        e = eye;
        g = gleam;
      }
      stamp breast_crest {
        pixels = "..gg../.gggg./gggggg/.gggg./..gg..";
        g = gold_deep;
      }

      chart haunch box {
        fill = gold;
        grain = clustered;
        pattern gradient { from = gold_deep; to = gold; axis = y; space = model; soft = 0.25ratio; }
        pattern ao { strength = 0.85ratio; radius = 2u; }
        pattern stripe { paint = gold_deep; axis = u; period = 6px; width = 1px; phase = 1; }
      }
      chart chest box {
        fill = ivory;
        grain = soft;
        pattern gradient { from = gold_deep; to = ivory; axis = y; space = model; soft = 0.25ratio; }
        pattern ao { strength = 0.85ratio; radius = 2u; }
        pattern border { paint = ivory_mid; width = 1px; edges = bottom; }
      }
      chart breast box {
        fill = ivory;
        grain = soft;
        pattern gradient { from = ivory_mid; to = ivory; axis = y; space = local; soft = 0.2ratio; }
        pattern ao { strength = 0.75ratio; radius = 2u; }
        face north { stamp breast_crest { at = (1px, 1px); protect = true; } }
      }
      chart mantle box {
        fill = ivory_mid;
        grain = soft;
        pattern gradient { from = feather; to = ivory; axis = y; space = local; soft = 0.2ratio; }
        pattern border { paint = gold; width = 1px; edges = bottom; }
        pattern ao { strength = 0.8ratio; radius = 2u; }
      }
      chart skull box {
        fill = ivory;
        grain = soft;
        pattern gradient { from = ivory_mid; to = ivory; axis = y; space = local; soft = 0.2ratio; }
        pattern border { paint = feather; width = 1px; edges = bottom; }
        pattern ao { strength = 0.75ratio; radius = 2u; }
        face west { stamp eye_mark { anchor = top_left; offset = (1px, 2px); protect = true; } }
        face east { stamp eye_mark { anchor = top_right; offset = (-1px, 2px); flip = x; protect = true; } }
      }
      chart brow box {
        fill = ivory_mid;
        grain = soft;
        pattern border { paint = gold; width = 1px; edges = bottom; }
      }
      chart beak box {
        fill = beak;
        grain = none;
        pattern gradient { from = gold_deep; to = beak; axis = y; space = local; soft = 0.2ratio; }
        pattern border { paint = gold_deep; width = 1px; edges = bottom; }
      }
      chart beak_tip box {
        fill = beak;
        grain = none;
        pattern border { paint = dark; width = 1px; edges = bottom; }
      }
      chart crest box {
        fill = ivory;
        grain = soft;
        pattern gradient { from = feather; to = ivory; axis = y; space = local; soft = 0.25ratio; }
        pattern border { paint = dark; width = 1px; edges = top; }
      }
      chart crest_plume flat {
        fill = feather;
        grain = soft;
        pattern gradient { from = dark; to = ivory; axis = y; space = local; soft = 0.25ratio; }
      }
      chart foreleg box {
        fill = beak;
        grain = none;
        pattern gradient { from = gold_deep; to = beak; axis = y; space = model; soft = 0.2ratio; }
        pattern ao { strength = 0.8ratio; radius = 2u; }
      }
      chart forefoot box {
        fill = beak;
        grain = none;
        pattern border { paint = gold_deep; width = 1px; edges = bottom; }
        pattern ao { strength = 0.75ratio; radius = 2u; }
      }
      chart talon box {
        fill = claw;
        grain = none;
        pattern border { paint = dark; width = 1px; edges = top; }
      }
      chart hind_thigh box {
        fill = gold;
        grain = clustered;
        pattern gradient { from = gold_deep; to = gold; axis = y; space = model; soft = 0.25ratio; }
        pattern ao { strength = 0.85ratio; radius = 2u; }
      }
      chart hind_shin box {
        fill = gold_deep;
        grain = clustered;
        pattern gradient { from = gold_deep; to = gold; axis = y; space = model; soft = 0.2ratio; }
        pattern ao { strength = 0.75ratio; radius = 2u; }
      }
      chart hind_paw box {
        fill = gold;
        grain = clustered;
        pattern border { paint = gold_deep; width = 1px; edges = bottom; }
        pattern ao { strength = 0.75ratio; radius = 2u; }
      }
      chart hind_claw box {
        fill = claw;
        grain = none;
        pattern border { paint = dark; width = 1px; edges = top; }
      }
      chart shoulder box {
        fill = ivory;
        grain = soft;
        pattern gradient { from = feather; to = ivory; axis = y; space = local; soft = 0.25ratio; }
        pattern border { paint = gold; width = 1px; edges = bottom; }
        pattern ao { strength = 0.85ratio; radius = 2u; }
      }
      chart wing_arm box {
        fill = ivory_mid;
        grain = soft;
        pattern gradient { from = dark; to = ivory; axis = y; space = local; soft = 0.25ratio; }
        pattern ao { strength = 0.8ratio; radius = 2u; }
      }
      chart feather_a box {
        fill = feather;
        grain = soft;
        pattern gradient { from = dark; to = ivory; axis = y; space = local; soft = 0.25ratio; }
        pattern stripe { paint = ivory_mid; axis = v; period = 3px; width = 1px; phase = 0; }
        pattern ao { strength = 0.75ratio; radius = 2u; }
      }
      chart feather_b box {
        fill = feather;
        grain = soft;
        pattern gradient { from = dark; to = feather; axis = y; space = local; soft = 0.25ratio; }
        pattern stripe { paint = ivory; axis = v; period = 3px; width = 1px; phase = 1; }
      }
      chart feather_c box {
        fill = feather;
        grain = soft;
        pattern gradient { from = dark; to = feather; axis = y; space = local; soft = 0.25ratio; }
        pattern border { paint = ivory_mid; width = 1px; edges = top; }
      }
      chart feather_tip box {
        fill = dark;
        grain = none;
        pattern gradient { from = claw; to = dark; axis = y; space = local; soft = 0.2ratio; }
        pattern border { paint = feather; width = 1px; edges = top; }
      }
      chart tail_base box {
        fill = gold;
        grain = clustered;
        pattern gradient { from = gold_deep; to = gold; axis = y; space = local; soft = 0.25ratio; }
        pattern ao { strength = 0.8ratio; radius = 2u; }
      }
      chart tail_rise box {
        fill = gold;
        grain = clustered;
        pattern gradient { from = gold_deep; to = gold; axis = y; space = local; soft = 0.25ratio; }
      }
      chart tail_tuft box {
        fill = dark;
        grain = clustered;
        pattern gradient { from = claw; to = feather; axis = y; space = local; soft = 0.25ratio; }
        pattern border { paint = gold; width = 1px; edges = bottom; }
      }
      grain clustered { seed = 7319; }
      tone painterly;
    }
  }

  export component Griffin {
    requires rig skeleton: animation.GriffinRig;
    requires surface skin: Plumage;
    bind bone root to skeleton.root;
    bind bone torso to skeleton.torso;
    bind bone head to skeleton.head;
    bind bone wing_left to skeleton.wing_left;
    bind bone wing_right to skeleton.wing_right;
    bind bone foreleg_left to skeleton.foreleg_left;
    bind bone foreleg_right to skeleton.foreleg_right;
    bind bone tail to skeleton.tail;
    bind bone tail_tip to skeleton.tail_tip;
    geometry {
      bone root {
        bone torso {
          cube haunch { origin = (-5u, 10u, 0u); size = (10u, 9u, 13u); surface = skin.haunch; }
          cube chest { origin = (-6u, 10u, -8u); size = (12u, 12u, 10u); pivot = (0u, 16u, -3u); rotation = (4deg, 0deg, 0deg); surface = skin.chest; }
          cube breast { origin = (-4u, 11u, -11u); size = (8u, 9u, 4u); pivot = (0u, 15.5u, -9u); rotation = (12deg, 0deg, 0deg); surface = skin.breast; }
          cube mantle { origin = (-6.5u, 18.5u, -9u); size = (13u, 4u, 7u); pivot = (0u, 20u, -6u); rotation = (-12deg, 0deg, 0deg); surface = skin.mantle; }

          cube hind_thigh_l { origin = (-6u, 6u, 7u); size = (4u, 8u, 6u); pivot = (-4u, 12u, 10u); rotation = (-10deg, 0deg, 0deg); mirror-x = hind_thigh_r; surface = skin.hind_thigh; }
          cube hind_shin_l { origin = (-5.5u, 2u, 9u); size = (3u, 5u, 3u); mirror-x = hind_shin_r; surface = skin.hind_shin; }
          cube hind_paw_l { origin = (-6u, 0u, 6u); size = (5u, 3u, 7u); mirror-x = hind_paw_r; surface = skin.hind_paw; }
          cube hind_claw_l0 { origin = (-6u, 0u, 4u); size = (1u, 1u, 3u); mirror-x = hind_claw_r0; surface = skin.hind_claw; }
          cube hind_claw_l1 { origin = (-4u, 0u, 4u); size = (1u, 1u, 3u); mirror-x = hind_claw_r1; surface = skin.hind_claw; }
          cube hind_claw_l2 { origin = (-2u, 0u, 4u); size = (1u, 1u, 3u); mirror-x = hind_claw_r2; surface = skin.hind_claw; }

          bone foreleg_left {
            cube foreleg_l { origin = (-5u, 3u, -9u); size = (3u, 9u, 3u); pivot = (-3.5u, 11u, -7.5u); rotation = (-5deg, 0deg, 0deg); surface = skin.foreleg; }
            cube forefoot_l { origin = (-6u, 1u, -12u); size = (5u, 3u, 6u); surface = skin.forefoot; }
            cube talon_l0 { origin = (-6u, 0u, -14u); size = (1u, 2u, 3u); surface = skin.talon; }
            cube talon_l1 { origin = (-4u, 0u, -14u); size = (1u, 2u, 3u); surface = skin.talon; }
            cube talon_l2 { origin = (-2u, 0u, -14u); size = (1u, 2u, 3u); surface = skin.talon; }
          }
          bone foreleg_right {
            cube foreleg_r { origin = (2u, 3u, -9u); size = (3u, 9u, 3u); pivot = (3.5u, 11u, -7.5u); rotation = (-5deg, 0deg, 0deg); surface = skin.foreleg; }
            cube forefoot_r { origin = (1u, 1u, -12u); size = (5u, 3u, 6u); surface = skin.forefoot; }
            cube talon_r0 { origin = (1u, 0u, -14u); size = (1u, 2u, 3u); surface = skin.talon; }
            cube talon_r1 { origin = (3u, 0u, -14u); size = (1u, 2u, 3u); surface = skin.talon; }
            cube talon_r2 { origin = (5u, 0u, -14u); size = (1u, 2u, 3u); surface = skin.talon; }
          }

          bone head {
            cube skull { origin = (-4u, 21u, -13u); size = (8u, 8u, 8u); pivot = (0u, 24u, -9u); rotation = (4deg, 0deg, 0deg); surface = skin.skull; }
            cube brow_l { origin = (-4.2u, 26.5u, -13.5u); size = (3u, 2u, 4u); pivot = (-3u, 27u, -11.5u); rotation = (8deg, 0deg, -12deg); mirror-x = brow_r; surface = skin.brow; }
            cube beak { origin = (-3u, 21.5u, -18u); size = (6u, 4u, 6u); surface = skin.beak; }
            cube beak_tip { origin = (-2u, 20.5u, -19.5u); size = (4u, 3u, 3u); pivot = (0u, 22.5u, -18u); rotation = (16deg, 0deg, 0deg); surface = skin.beak_tip; }
            cube crest_l { origin = (-4u, 28u, -9u); size = (2u, 3u, 4u); pivot = (-3u, 28u, -7u); rotation = (-16deg, 0deg, -14deg); mirror-x = crest_r; surface = skin.crest; }
            plane crest_plume_l { origin = (-3.5u, 27u, -8u); size = (4u, 4u); u-axis = (0u, 0u, 1u); v-axis = (0u, 1u, 0u); rotation = (-12deg, 0deg, -14deg); mirror-x = crest_plume_r; surface = skin.crest_plume; }
          }

          bone wing_left {
            cube shoulder_l { origin = (-13u, 19u, -5u); size = (8u, 5u, 7u); surface = skin.shoulder; rotation = (-20deg, 0deg, -30deg); pivot = (-5u, 20u, -2u); }
            cube wing_arm_l { origin = (-23u, 19u, -3u); size = (11u, 4u, 6u); surface = skin.wing_arm; rotation = (-20deg, 0deg, -30deg); pivot = (-5u, 20u, -2u); }
            cube feather_l0 { origin = (-12u, 20u, 0u); size = (4u, 2u, 16u); surface = skin.feather_a; rotation = (-20deg, 0deg, -30deg); pivot = (-5u, 20u, -2u); }
            cube tip_l0 { origin = (-12u, 20u, 16u); size = (4u, 2u, 4u); surface = skin.feather_tip; rotation = (-20deg, 0deg, -30deg); pivot = (-5u, 20u, -2u); }
            cube feather_l1 { origin = (-15u, 20u, 1u); size = (4u, 2u, 16u); surface = skin.feather_a; rotation = (-20deg, 0deg, -30deg); pivot = (-5u, 20u, -2u); }
            cube tip_l1 { origin = (-15u, 20u, 17u); size = (4u, 2u, 4u); surface = skin.feather_tip; rotation = (-20deg, 0deg, -30deg); pivot = (-5u, 20u, -2u); }
            cube feather_l2 { origin = (-18u, 20u, 2u); size = (4u, 2u, 14u); surface = skin.feather_b; rotation = (-20deg, 0deg, -30deg); pivot = (-5u, 20u, -2u); }
            cube tip_l2 { origin = (-18u, 20u, 16u); size = (4u, 2u, 4u); surface = skin.feather_tip; rotation = (-20deg, 0deg, -30deg); pivot = (-5u, 20u, -2u); }
            cube feather_l3 { origin = (-21u, 20u, 3u); size = (4u, 2u, 14u); surface = skin.feather_b; rotation = (-20deg, 0deg, -30deg); pivot = (-5u, 20u, -2u); }
            cube tip_l3 { origin = (-21u, 20u, 17u); size = (4u, 2u, 4u); surface = skin.feather_tip; rotation = (-20deg, 0deg, -30deg); pivot = (-5u, 20u, -2u); }
            cube feather_l4 { origin = (-24u, 20u, 4u); size = (4u, 2u, 12u); surface = skin.feather_c; rotation = (-20deg, 0deg, -30deg); pivot = (-5u, 20u, -2u); }
            cube tip_l4 { origin = (-24u, 20u, 16u); size = (4u, 2u, 4u); surface = skin.feather_tip; rotation = (-20deg, 0deg, -30deg); pivot = (-5u, 20u, -2u); }
            cube feather_l5 { origin = (-27u, 20u, 5u); size = (4u, 2u, 12u); surface = skin.feather_c; rotation = (-20deg, 0deg, -30deg); pivot = (-5u, 20u, -2u); }
            cube tip_l5 { origin = (-27u, 20u, 17u); size = (4u, 2u, 4u); surface = skin.feather_tip; rotation = (-20deg, 0deg, -30deg); pivot = (-5u, 20u, -2u); }
          }

          bone wing_right {
            cube shoulder_r { origin = (5u, 19u, -5u); size = (8u, 5u, 7u); surface = skin.shoulder; rotation = (-20deg, 0deg, 30deg); pivot = (5u, 20u, -2u); }
            cube wing_arm_r { origin = (12u, 19u, -3u); size = (11u, 4u, 6u); surface = skin.wing_arm; rotation = (-20deg, 0deg, 30deg); pivot = (5u, 20u, -2u); }
            cube feather_r0 { origin = (8u, 20u, 0u); size = (4u, 2u, 16u); surface = skin.feather_a; rotation = (-20deg, 0deg, 30deg); pivot = (5u, 20u, -2u); }
            cube tip_r0 { origin = (8u, 20u, 16u); size = (4u, 2u, 4u); surface = skin.feather_tip; rotation = (-20deg, 0deg, 30deg); pivot = (5u, 20u, -2u); }
            cube feather_r1 { origin = (11u, 20u, 1u); size = (4u, 2u, 16u); surface = skin.feather_a; rotation = (-20deg, 0deg, 30deg); pivot = (5u, 20u, -2u); }
            cube tip_r1 { origin = (11u, 20u, 17u); size = (4u, 2u, 4u); surface = skin.feather_tip; rotation = (-20deg, 0deg, 30deg); pivot = (5u, 20u, -2u); }
            cube feather_r2 { origin = (14u, 20u, 2u); size = (4u, 2u, 14u); surface = skin.feather_b; rotation = (-20deg, 0deg, 30deg); pivot = (5u, 20u, -2u); }
            cube tip_r2 { origin = (14u, 20u, 16u); size = (4u, 2u, 4u); surface = skin.feather_tip; rotation = (-20deg, 0deg, 30deg); pivot = (5u, 20u, -2u); }
            cube feather_r3 { origin = (17u, 20u, 3u); size = (4u, 2u, 14u); surface = skin.feather_b; rotation = (-20deg, 0deg, 30deg); pivot = (5u, 20u, -2u); }
            cube tip_r3 { origin = (17u, 20u, 17u); size = (4u, 2u, 4u); surface = skin.feather_tip; rotation = (-20deg, 0deg, 30deg); pivot = (5u, 20u, -2u); }
            cube feather_r4 { origin = (20u, 20u, 4u); size = (4u, 2u, 12u); surface = skin.feather_c; rotation = (-20deg, 0deg, 30deg); pivot = (5u, 20u, -2u); }
            cube tip_r4 { origin = (20u, 20u, 16u); size = (4u, 2u, 4u); surface = skin.feather_tip; rotation = (-20deg, 0deg, 30deg); pivot = (5u, 20u, -2u); }
            cube feather_r5 { origin = (23u, 20u, 5u); size = (4u, 2u, 12u); surface = skin.feather_c; rotation = (-20deg, 0deg, 30deg); pivot = (5u, 20u, -2u); }
            cube tip_r5 { origin = (23u, 20u, 17u); size = (4u, 2u, 4u); surface = skin.feather_tip; rotation = (-20deg, 0deg, 30deg); pivot = (5u, 20u, -2u); }
          }

          bone tail {
            cube tail_base { origin = (-1.5u, 12u, 12u); size = (3u, 3u, 10u); pivot = (0u, 13.5u, 12u); rotation = (-10deg, 0deg, 0deg); surface = skin.tail_base; }
            bone tail_tip {
              cube tail_rise { origin = (-1u, 12u, 21u); size = (2u, 5u, 2u); pivot = (0u, 14u, 22u); rotation = (18deg, 0deg, 0deg); surface = skin.tail_rise; }
              cube tail_tuft { origin = (-2u, 16u, 21u); size = (4u, 5u, 4u); surface = skin.tail_tuft; }
            }
          }
        }
      }
    }
  }

  export asset griffin {
    settings { density = 16; forward = north; profile = creature; }
    skeleton = animation.GriffinSkeleton;
    motion = animation.idle;
    motion = animation.look_around;
    motion = animation.wing_display;
    motion = animation.wing_flap;
    motion = animation.greeting;
    motion = animation.alert;
    use Griffin as griffin { bind skeleton = animation.GriffinRig; bind skin = griffin_skin; };
  }
}
