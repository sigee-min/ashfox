ashfox 1
module griffin_body {
  import "./animation.ashfox" as animation;
  import "./surface.ashfox" as surface;

  export component Griffin {
    requires rig skeleton: animation.GriffinRig;
    requires surface skin: surface.Plumage;
    bind bone root to skeleton.root;
    bind bone torso to skeleton.torso;
    bind bone head to skeleton.head;
    bind bone wing_left to skeleton.wing_left;
    bind bone wing_right to skeleton.wing_right;
    bind bone foreleg_left to skeleton.foreleg_left;
    bind bone foreleg_right to skeleton.foreleg_right;
    bind bone tail to skeleton.tail;
    bind bone tail_tip to skeleton.tail_tip;
    geometry {
      bone root {
        bone torso {
          cube haunch { origin = (-5u, 10u, 1u); size = (10u, 9u, 12u); surface = skin.haunch; }
          cube chest { origin = (-6u, 10u, -8u); size = (12u, 11u, 9u); pivot = (0u, 16u, -3u); rotation = (4deg, 0deg, 0deg); surface = skin.chest; }
          cube breast { origin = (-4u, 11u, -12u); size = (8u, 8u, 4u); pivot = (0u, 15u, -10u); rotation = (12deg, 0deg, 0deg); surface = skin.breast; }
          cube mantle { origin = (-6u, 20.5u, -9.5u); size = (12u, 3u, 8u); pivot = (0u, 21.5u, -5.5u); rotation = (-12deg, 0deg, 0deg); surface = skin.mantle; }

          cube hind_thigh_l { origin = (-6.5u, 6u, 7u); size = (4u, 7u, 6u); pivot = (-4.5u, 12u, 10u); rotation = (-10deg, 0deg, 0deg); mirror_x = hind_thigh_r; surface = skin.hind_thigh; }
          cube hind_shin_l { origin = (-6.5u, 2u, 9u); size = (3u, 4u, 3u); mirror_x = hind_shin_r; surface = skin.hind_shin; }
          cube hind_paw_l { origin = (-7u, 0u, 6u); size = (5u, 2u, 6u); mirror_x = hind_paw_r; surface = skin.hind_paw; }
          cube hind_claw_l0 { origin = (-7u, 0u, 2u); size = (2u, 2u, 4u); mirror_x = hind_claw_r0; surface = skin.hind_claw; }
          cube hind_claw_l1 { origin = (-4u, 0u, 2u); size = (2u, 2u, 4u); mirror_x = hind_claw_r1; surface = skin.hind_claw; }

          bone foreleg_left {
            cube foreleg_l { origin = (-5u, 3u, -9u); size = (3u, 8u, 3u); pivot = (-3.5u, 10u, -7.5u); rotation = (-5deg, 0deg, 0deg); surface = skin.foreleg; }
            cube forefoot_l { origin = (-6u, 1u, -12u); size = (5u, 2u, 5u); surface = skin.forefoot; }
            cube talon_l0 { origin = (-6u, 0u, -16u); size = (2u, 2u, 4u); surface = skin.talon; }
            cube talon_l1 { origin = (-3u, 0u, -16u); size = (2u, 2u, 4u); surface = skin.talon; }
          }
          bone foreleg_right {
            cube foreleg_r { origin = (2u, 3u, -9u); size = (3u, 8u, 3u); pivot = (3.5u, 10u, -7.5u); rotation = (-5deg, 0deg, 0deg); surface = skin.foreleg; }
            cube forefoot_r { origin = (1u, 1u, -12u); size = (5u, 2u, 5u); surface = skin.forefoot; }
            cube talon_r0 { origin = (1u, 0u, -16u); size = (2u, 2u, 4u); surface = skin.talon; }
            cube talon_r1 { origin = (4u, 0u, -16u); size = (2u, 2u, 4u); surface = skin.talon; }
          }

          bone head {
            cube skull { origin = (-4u, 22u, -13u); size = (8u, 8u, 8u); pivot = (0u, 25u, -9u); rotation = (4deg, 0deg, 0deg); surface = skin.skull; }
            cube beak { origin = (-3u, 22.5u, -19u); size = (6u, 4u, 6u); surface = skin.beak; }
            cube beak_tip { origin = (-2u, 21.5u, -21u); size = (4u, 3u, 2u); pivot = (0u, 23u, -19.5u); rotation = (16deg, 0deg, 0deg); surface = skin.beak_tip; }
            cube crest_l { origin = (-4u, 29u, -9u); size = (2u, 3u, 4u); pivot = (-3u, 29u, -7u); rotation = (-16deg, 0deg, -14deg); mirror_x = crest_r; surface = skin.crest; }
            plane crest_plume_l { origin = (-3.5u, 28u, -7u); size = (4u, 4u); u_axis = (0u, 0u, 1u); v_axis = (0u, 1u, 0u); rotation = (-12deg, 0deg, -14deg); mirror_x = crest_plume_r; surface = skin.crest_plume; }
          }

          bone wing_left {
            cube shoulder_l { origin = (-13u, 19u, -5u); size = (7u, 5u, 7u); surface = skin.shoulder; rotation = (-20deg, 0deg, -30deg); pivot = (-5u, 20u, -2u); }
            cube wing_arm_l { origin = (-23u, 19u, -3u); size = (10u, 4u, 6u); surface = skin.wing_arm; rotation = (-20deg, 0deg, -30deg); pivot = (-5u, 20u, -2u); }
            cube feather_l0 { origin = (-12u, 20u, 3u); size = (3u, 2u, 14u); surface = skin.feather_a; rotation = (-20deg, 0deg, -30deg); pivot = (-5u, 20u, -2u); }
            cube tip_l0 { origin = (-12u, 20u, 17u); size = (3u, 2u, 4u); surface = skin.feather_tip; rotation = (-20deg, 0deg, -30deg); pivot = (-5u, 20u, -2u); }
            cube feather_l1 { origin = (-15u, 20u, 3u); size = (3u, 2u, 14u); surface = skin.feather_a; rotation = (-20deg, 0deg, -30deg); pivot = (-5u, 20u, -2u); }
            cube tip_l1 { origin = (-15u, 20u, 17u); size = (3u, 2u, 4u); surface = skin.feather_tip; rotation = (-20deg, 0deg, -30deg); pivot = (-5u, 20u, -2u); }
            cube feather_l2 { origin = (-18u, 20u, 3u); size = (3u, 2u, 13u); surface = skin.feather_b; rotation = (-20deg, 0deg, -30deg); pivot = (-5u, 20u, -2u); }
            cube tip_l2 { origin = (-18u, 20u, 16u); size = (3u, 2u, 4u); surface = skin.feather_tip; rotation = (-20deg, 0deg, -30deg); pivot = (-5u, 20u, -2u); }
            cube feather_l3 { origin = (-21u, 20u, 3u); size = (3u, 2u, 13u); surface = skin.feather_b; rotation = (-20deg, 0deg, -30deg); pivot = (-5u, 20u, -2u); }
            cube tip_l3 { origin = (-21u, 20u, 16u); size = (3u, 2u, 4u); surface = skin.feather_tip; rotation = (-20deg, 0deg, -30deg); pivot = (-5u, 20u, -2u); }
            cube feather_l4 { origin = (-24u, 20u, 3u); size = (3u, 2u, 12u); surface = skin.feather_c; rotation = (-20deg, 0deg, -30deg); pivot = (-5u, 20u, -2u); }
            cube tip_l4 { origin = (-24u, 20u, 15u); size = (3u, 2u, 4u); surface = skin.feather_tip; rotation = (-20deg, 0deg, -30deg); pivot = (-5u, 20u, -2u); }
            cube feather_l5 { origin = (-27u, 20u, 3u); size = (3u, 2u, 12u); surface = skin.feather_c; rotation = (-20deg, 0deg, -30deg); pivot = (-5u, 20u, -2u); }
            cube tip_l5 { origin = (-27u, 20u, 15u); size = (3u, 2u, 4u); surface = skin.feather_tip; rotation = (-20deg, 0deg, -30deg); pivot = (-5u, 20u, -2u); }
          }

          bone wing_right {
            cube shoulder_r { origin = (6u, 19u, -5u); size = (7u, 5u, 7u); surface = skin.shoulder; rotation = (-20deg, 0deg, 30deg); pivot = (5u, 20u, -2u); }
            cube wing_arm_r { origin = (13u, 19u, -3u); size = (10u, 4u, 6u); surface = skin.wing_arm; rotation = (-20deg, 0deg, 30deg); pivot = (5u, 20u, -2u); }
            cube feather_r0 { origin = (9u, 20u, 3u); size = (3u, 2u, 14u); surface = skin.feather_a; rotation = (-20deg, 0deg, 30deg); pivot = (5u, 20u, -2u); }
            cube tip_r0 { origin = (9u, 20u, 17u); size = (3u, 2u, 4u); surface = skin.feather_tip; rotation = (-20deg, 0deg, 30deg); pivot = (5u, 20u, -2u); }
            cube feather_r1 { origin = (12u, 20u, 3u); size = (3u, 2u, 14u); surface = skin.feather_a; rotation = (-20deg, 0deg, 30deg); pivot = (5u, 20u, -2u); }
            cube tip_r1 { origin = (12u, 20u, 17u); size = (3u, 2u, 4u); surface = skin.feather_tip; rotation = (-20deg, 0deg, 30deg); pivot = (5u, 20u, -2u); }
            cube feather_r2 { origin = (15u, 20u, 3u); size = (3u, 2u, 13u); surface = skin.feather_b; rotation = (-20deg, 0deg, 30deg); pivot = (5u, 20u, -2u); }
            cube tip_r2 { origin = (15u, 20u, 16u); size = (3u, 2u, 4u); surface = skin.feather_tip; rotation = (-20deg, 0deg, 30deg); pivot = (5u, 20u, -2u); }
            cube feather_r3 { origin = (18u, 20u, 3u); size = (3u, 2u, 13u); surface = skin.feather_b; rotation = (-20deg, 0deg, 30deg); pivot = (5u, 20u, -2u); }
            cube tip_r3 { origin = (18u, 20u, 16u); size = (3u, 2u, 4u); surface = skin.feather_tip; rotation = (-20deg, 0deg, 30deg); pivot = (5u, 20u, -2u); }
            cube feather_r4 { origin = (21u, 20u, 3u); size = (3u, 2u, 12u); surface = skin.feather_c; rotation = (-20deg, 0deg, 30deg); pivot = (5u, 20u, -2u); }
            cube tip_r4 { origin = (21u, 20u, 15u); size = (3u, 2u, 4u); surface = skin.feather_tip; rotation = (-20deg, 0deg, 30deg); pivot = (5u, 20u, -2u); }
            cube feather_r5 { origin = (24u, 20u, 3u); size = (3u, 2u, 12u); surface = skin.feather_c; rotation = (-20deg, 0deg, 30deg); pivot = (5u, 20u, -2u); }
            cube tip_r5 { origin = (24u, 20u, 15u); size = (3u, 2u, 4u); surface = skin.feather_tip; rotation = (-20deg, 0deg, 30deg); pivot = (5u, 20u, -2u); }
          }

          bone tail {
            cube tail_base { origin = (-1.5u, 12u, 13u); size = (3u, 3u, 9u); pivot = (0u, 13.5u, 13u); rotation = (-10deg, 0deg, 0deg); surface = skin.tail_base; }
            bone tail_tip {
              cube tail_rise { origin = (-1u, 12u, 21u); size = (2u, 5u, 2u); pivot = (0u, 14u, 22u); rotation = (18deg, 0deg, 0deg); surface = skin.tail_rise; }
              cube tail_tuft { origin = (-2u, 17u, 21u); size = (4u, 5u, 4u); surface = skin.tail_tuft; }
            }
          }
        }
      }
    }
  }
}
