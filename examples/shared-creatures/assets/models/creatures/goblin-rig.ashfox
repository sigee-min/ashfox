ashfox 1
module goblin_rig {
  export rig contract GoblinRig {
    joint root { parent = none; role = root; channels = (rotation, scale); }
    joint pelvis { parent = root; role = pelvis; channels = rotation; }
    joint torso { parent = pelvis; role = body; channels = rotation; }
    joint head { parent = torso; role = head; channels = rotation; }
    joint left_arm { parent = torso; role = arm; channels = rotation; }
    joint right_arm { parent = torso; role = arm; channels = rotation; }
    joint weapon { parent = right_arm; role = weapon; channels = rotation; }
    joint left_leg { parent = pelvis; role = leg; channels = rotation; }
    joint right_leg { parent = pelvis; role = leg; channels = rotation; }
  }

  export skeleton RaiderSkeleton implements GoblinRig {
    bind root { parent_origin = (0u, 0u, 0u); }
    bind pelvis { parent_origin = (0u, 11u, 0u); }
    bind torso { parent_origin = (0u, 2u, 0u); }
    bind head { parent_origin = (0u, 10u, -1u); }
    bind left_arm { parent_origin = (-6.5u, 6.5u, 0u); }
    bind right_arm { parent_origin = (6.5u, 6.5u, 0u); }
    bind weapon { parent_origin = (0u, -9.5u, -1u); }
    bind left_leg { parent_origin = (-2u, -1u, 0u); }
    bind right_leg { parent_origin = (2u, -1u, 0u); }
  }

  export motion idle for GoblinRig {
    duration = 2s; fps = 20; loop = loop;track pelvis.rotation {
      key 0s = (0deg, 0deg, 0deg) catmullrom;
      key 1s = (2deg, 0deg, 0deg) catmullrom;
      key 2s = (0deg, 0deg, 0deg) catmullrom;
    }
    track torso.rotation {
      key 0s = (0deg, 0deg, 0deg) catmullrom;
      key 1s = (2deg, -3deg, 0deg) catmullrom;
      key 2s = (0deg, 0deg, 0deg) catmullrom;
    }
    track head.rotation {
      key 0s = (0deg, 0deg, 0deg) catmullrom;
      key 1s = (-2deg, 5deg, 0deg) catmullrom;
      key 2s = (0deg, 0deg, 0deg) catmullrom;
    }
    track right_arm.rotation {
      key 0s = (0deg, 0deg, 0deg) catmullrom;
      key 1s = (-4deg, 3deg, 3deg) catmullrom;
      key 2s = (0deg, 0deg, 0deg) catmullrom;
    }
    track left_arm.rotation {
      key 0s = (0deg, 0deg, 0deg) catmullrom;
      key 1s = (4deg, -3deg, -3deg) catmullrom;
      key 2s = (0deg, 0deg, 0deg) catmullrom;
    }
  }

  export motion lookout for GoblinRig {
    duration = 4s; fps = 24; loop = loop;track head.rotation {
      key 0s = (0deg, 0deg, 0deg) catmullrom;
      key 1s = (0deg, -22deg, 2deg) catmullrom;
      key 2s = (0deg, -22deg, 2deg) catmullrom;
      key 3s = (-3deg, 20deg, -2deg) catmullrom;
      key 4s = (0deg, 0deg, 0deg) catmullrom;
    }
    track left_arm.rotation {
      key 0s = (0deg, 0deg, 0deg) catmullrom;
      key 1s = (-8deg, 0deg, -8deg) catmullrom;
      key 3s = (-8deg, 0deg, -8deg) catmullrom;
      key 4s = (0deg, 0deg, 0deg) catmullrom;
    }
  }

  export motion challenge for GoblinRig {
    duration = 3s; fps = 24; loop = loop;track right_arm.rotation {
      key 0s = (0deg, 0deg, 0deg) catmullrom;
      key 0.8s = (35deg, -8deg, 12deg) catmullrom;
      key 1.5s = (35deg, -8deg, 12deg) catmullrom;
      key 2.4s = (3deg, 0deg, 2deg) catmullrom;
      key 3s = (0deg, 0deg, 0deg) catmullrom;
    }
    track head.rotation {
      key 0s = (0deg, 0deg, 0deg) catmullrom;
      key 0.8s = (2deg, -8deg, -2deg) catmullrom;
      key 1.5s = (2deg, -8deg, -2deg) catmullrom;
      key 2.4s = (4deg, 0deg, 0deg) catmullrom;
      key 3s = (0deg, 0deg, 0deg) catmullrom;
    }
    track left_arm.rotation {
      key 0s = (0deg, 0deg, 0deg) catmullrom;
      key 0.8s = (8deg, 0deg, -8deg) catmullrom;
      key 1.5s = (8deg, 0deg, -8deg) catmullrom;
      key 3s = (0deg, 0deg, 0deg) catmullrom;
    }
  }
}
