ashfox 1
module goblin_surface {
  export surface contract RaiderSkin {
    chart torso box { coverage = opaque; }
    chart pelvis box { coverage = opaque; }
    chart head box { coverage = opaque; }
    chart snout box { coverage = opaque; }
    chart ear box { coverage = opaque; }
    chart ear_tip box { coverage = opaque; }
    chart arm box { coverage = opaque; }
    chart bracer box { coverage = opaque; }
    chart hand box { coverage = opaque; }
    chart leg box { coverage = opaque; }
    chart cuff box { coverage = opaque; }
    chart boot box { coverage = opaque; }
    chart belt box { coverage = opaque; }
    chart buckle box { coverage = opaque; }
    chart loincloth flat { coverage = binary; }
    chart pauldron box { coverage = opaque; }
    chart blade box { coverage = opaque; }
    chart blade_tip box { coverage = opaque; }
    chart crossguard box { coverage = opaque; }
    chart grip box { coverage = opaque; }
    chart pommel box { coverage = opaque; }
    chart shield box { coverage = opaque; }
    chart boss box { coverage = opaque; }
    chart tusk box { coverage = opaque; }
    chart mohawk box { coverage = opaque; }
    material = double;
  }

  export surface raider: RaiderSkin {
    material = double;
    texture atlas {
      density = 2;
      background = void; background_alpha = 255;
      palette {
        void = #2a3324;
        skin = (#3c5c22, #6f9c3b, #a7cf5e);
        skin_dark = (#2c441a, #50752b, #7ea644);
        leather = (#4c2c1b, #7e4b2c, #b57644);
        leather_dark = (#362017, #593525, #84533c);
        iron = (#4e5861, #8b98a6, #cdd7e0);
        iron_dark = (#343b42, #5c6670, #8a95a1);
        cloth = (#521f24, #9c3842, #d9646b);
        brass = (#7a551c, #c99232, #f5cb64);
        eye = #ffd94a;
        glint = #fff9e6;
        pupil = #211a14;
        tooth = (#9c8b68, #d9c79b, #f8edd4);
      }
      stamp goblin_face {
        pixels = "..dddd....dddd../...dddd..dddd.../..kgyk....kygk../..kkdk....kdkk../................/....dd....dd....";
        d = skin_dark;
        y = eye;
        g = glint;
        k = pupil;
      }
      stamp armor_strap {
        pixels = "llbb................/..llll............../....llbb............/......llii........../........iidii......./..........iiiii...../............bbll..../..............llll../................bbll";
        l = leather_dark;
        b = brass;
        i = iron;
        d = iron_dark;
      }
      stamp shield_crest {
        pixels = "..iiii../.i....i./i..bb..i/i.bbbb.i/i..bb..i/.i....i./..iiii..";
        i = iron;
        b = brass;
      }

      chart torso box {
        fill = leather;
        grain = soft;
        pattern gradient { to = leather_dark; axis = y; space = local; soft = 0.2; }
        pattern ao { strength = 0.45; radius = 0.9u; }
        face north { stamp armor_strap { at = (0px, 2px); protect = true; } }
      }
      chart head box {
        fill = skin;
        grain = soft;
        pattern gradient { to = skin_dark; axis = y; space = local; soft = 0.2; }
        pattern ao { strength = 0.4; radius = 0.9u; }
        face north { stamp goblin_face { at = (0px, 3px); protect = true; } }
      }
      chart blade box {
        fill = iron;
        grain = none;
      }
      chart blade_tip box {
        fill = iron;
        grain = none;
      }
      chart shield box {
        fill = leather_dark;
        grain = clustered;
        pattern border { paint = iron; width = 1px; edges = all; }
        pattern ao { strength = 0.4; radius = 0.9u; }
        face west { stamp shield_crest { at = (4px, 6px); protect = true; } }
      }
      chart boss box {
        fill = iron;
        grain = none;
        pattern border { paint = brass; width = 1px; edges = all; }
      }
      chart pelvis box {
        fill = cloth;
        grain = soft;
      }
      chart belt box {
        fill = leather_dark;
        grain = clustered;
      }
      chart buckle box {
        fill = brass;
        grain = none;
      }
      chart loincloth flat {
        coverage = 111111111111111111111111111111111111111111111111111111111111111111111111011111111110011111111110001111111100001100110011;
        fill = cloth;
        grain = soft;
        pattern border { paint = brass; width = 1px; edges = top; }
      }
      chart boot box {
        fill = leather_dark;
        grain = clustered;
      }
      chart cuff box {
        fill = leather;
        grain = soft;
      }
      chart leg box {
        fill = cloth;
        grain = soft;
        pattern gradient { to = leather_dark; axis = y; space = local; soft = 0.2; }
      }
      chart pauldron box {
        fill = iron_dark;
        grain = none;
        pattern border { paint = brass; width = 1px; edges = bottom; }
      }
      chart bracer box {
        fill = iron_dark;
        grain = none;
      }
      chart snout box {
        fill = skin;
        grain = soft;
      }
      chart ear box {
        fill = skin;
        grain = soft;
      }
      chart ear_tip box {
        fill = skin_dark;
        grain = soft;
      }
      chart arm box {
        fill = skin;
        grain = soft;
        pattern gradient { to = skin_dark; axis = y; space = local; soft = 0.2; }
      }
      chart hand box {
        fill = skin_dark;
        grain = soft;
      }
      chart crossguard box {
        fill = brass;
        grain = none;
      }
      chart grip box {
        fill = leather_dark;
        grain = soft;
      }
      chart pommel box {
        fill = iron_dark;
        grain = none;
      }
      chart tusk box {
        fill = tooth;
        grain = none;
      }
      chart mohawk box {
        fill = cloth;
        grain = clustered;
        pattern gradient { to = brass; axis = y; space = local; soft = 0.3; }
      }
      grain soft { seed = 44021; }
      tone painterly;
    }
  }
}
