ashfox 1
model lantern {
  rig contract LanternRig {
    joint root {
      parent = none;
      role = root;
      channels = rotation;
    }
  }
  skeleton LanternSkeleton implements LanternRig {
    bind root { parent_origin = (0u, 0u, 0u); }
  }
  surface contract LanternFrameSurface {
    chart base box { coverage = opaque; }
    chart foot box { coverage = opaque; }
    chart collar box { coverage = opaque; }
    chart strut box { coverage = opaque; }
    chart hood box { coverage = opaque; }
    chart eave box { coverage = opaque; }
    chart bracket box { coverage = opaque; }
    chart crown box { coverage = opaque; }
    chart hoop flat { coverage = binary; }
    material = double;
  }
  surface contract LanternCoreSurface {
    chart core box { coverage = opaque; }
    material = opaque;
  }
  surface iron_amber: LanternFrameSurface {
    material = double;
    texture atlas {
      atlas = (128px, 64px);
      density = 2;
      background = slate;
      background_alpha = 255;
      palette {
        slate = #2c313d;
        iron = (#2e3545, #475269, #7080a1);
        stone = (#383b45, #5d6270, #8a91a3);
        brass = (#8c5a1e, #d48c32, #ffd675);
      }
      chart base box {
        fill = stone;
        grain = clustered;
        pattern border { paint = iron; width = 1px; edges = top; }
        pattern ao { strength = 0.35; radius = 0.6u; }
      }
      chart foot box {
        fill = iron;
        grain = none;
        pattern border { paint = stone; width = 1px; edges = top; }
      }
      chart collar box {
        fill = iron;
        grain = none;
        pattern border { paint = brass; width = 1px; edges = top; }
        pattern ao { strength = 0.35; radius = 0.6u; }
      }
      chart strut box {
        fill = iron;
        grain = none;
        pattern ao { strength = 0.3; radius = 0.5u; }
      }
      chart hood box {
        fill = iron;
        grain = none;
        pattern border { paint = brass; width = 1px; edges = bottom; }
        pattern ao { strength = 0.35; radius = 0.6u; }
      }
      chart eave box {
        fill = iron;
        grain = soft;
        pattern border { paint = brass; width = 1px; edges = bottom; }
        pattern ao { strength = 0.3; radius = 0.5u; }
      }
      chart bracket box {
        fill = brass;
        grain = none;
        pattern ao { strength = 0.3; radius = 0.5u; }
      }
      chart crown box {
        fill = iron;
        grain = none;
        pattern border { paint = brass; width = 1px; edges = top; }
      }
      chart hoop flat {
        fill = iron;
        coverage = 011110110011100001100001110011011110;
        grain = none;
        pattern border { paint = brass; width = 1px; edges = bottom; }
      }
      grain clustered { seed = 5107; }
      tone painterly;
    }
  }
  surface amber_glow: LanternCoreSurface {
    material = opaque;
    texture atlas {
      atlas = (128px, 64px);
      density = 2;
      render_mode = emissive;
      background = glow_base;
      background_alpha = 255;
      palette {
        glow_base = #c95f18;
        amber = (#a84b14, #eb8a24, #ffe066);
        amber_core = (#d9701a, #ffba3d, #fff7b8);
      }
      stamp heart_glow {
        pixels = ".cccc./cccccc/cccccc/cccccc/cccccc/.cccc.";
        c = amber_core;
      }
      chart core box {
        fill = amber;
        grain = soft;
        pattern gradient { from = amber; to = amber_core; axis = y; space = local; soft = 0.15; }
        face north { stamp heart_glow { at = (1px, 3px); protect = true; } }
        face south { stamp heart_glow { at = (1px, 3px); protect = true; } }
        face east { stamp heart_glow { at = (1px, 3px); protect = true; } }
        face west { stamp heart_glow { at = (1px, 3px); protect = true; } }
      }
      grain soft { seed = 5109; }
      tone painterly;
    }
  }
  component Lantern {
    requires rig skeleton: LanternRig;
    requires surface skin: LanternFrameSurface;
    requires surface glow: LanternCoreSurface;
    bind bone root to skeleton.root;
    geometry {
      bone root {
        cube base { origin = (-4u, 0u, -4u); size = (8u, 2u, 8u); surface = skin.base; }
        cube foot_fl { origin = (-5u, 0u, -5u); size = (2u, 2u, 2u); mirror_x = foot_fr; surface = skin.foot; }
        cube foot_bl { origin = (-5u, 0u, 3u); size = (2u, 2u, 2u); mirror_x = foot_br; surface = skin.foot; }
        cube collar { origin = (-3u, 2u, -3u); size = (6u, 2u, 6u); surface = skin.collar; }
        cube core { origin = (-2u, 4u, -2u); size = (4u, 5u, 4u); surface = glow.core; }
        cube strut_fl { origin = (-3u, 4u, -3u); size = (1u, 5u, 1u); mirror_x = strut_fr; surface = skin.strut; }
        cube strut_bl { origin = (-3u, 4u, 2u); size = (1u, 5u, 1u); mirror_x = strut_br; surface = skin.strut; }
        cube hood { origin = (-4u, 9u, -4u); size = (8u, 2u, 8u); surface = skin.hood; }
        cube bracket_l { origin = (-5u, 8.5u, -1u); size = (2u, 2u, 2u); pivot = (-4u, 9.5u, 0u); rotation = (0deg, 0deg, 22.5deg); mirror_x = bracket_r; surface = skin.bracket; }
        cube eave { origin = (-3u, 11u, -3u); size = (6u, 1u, 6u); surface = skin.eave; }
        cube crown { origin = (-2u, 12u, -2u); size = (4u, 2u, 4u); surface = skin.crown; }
        plane hoop_x { origin = (-1.5u, 14u, 0u); size = (3u, 3u); u_axis = (1u, 0u, 0u); v_axis = (0u, 1u, 0u); surface = skin.hoop; }
        plane hoop_z { origin = (0u, 14u, -1.5u); size = (3u, 3u); u_axis = (0u, 0u, 1u); v_axis = (0u, 1u, 0u); surface = skin.hoop; }
      }
    }
  }
  settings { density = 16; forward = north; profile = prop; }
  skeleton = LanternSkeleton;
  use Lantern as model { skeleton = LanternRig; skin = iron_amber; glow = amber_glow; }
}
