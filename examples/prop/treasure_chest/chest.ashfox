ashfox 1
model treasure_chest {
  import "./rig.ashfox" as rig;
  import "./surface.ashfox" as surface;
  import "./body.ashfox" as body;

  settings { density = 16; forward = north; profile = prop; }
  skeleton = rig.ChestSkeleton;
  motions = [rig.idle, rig.open];
use body.ChestBody as chest {
    skeleton = rig.ChestRig;
    skin = surface.oak_iron;
  }
  use body.ClaspMount as clasp {
    skin = surface.brass_gem;
  }
  connect chest.lock_mount -> clasp.mount;
}
