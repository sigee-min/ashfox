ashfox 1
module chest_body {
  import "./rig.ashfox" as rig;
  import "./surface.ashfox" as surface;

  export design ChestDims {
    width: unit = 10u;
    body_h: unit = 4u;
    depth: unit = 8u;
    check grounded_width = ChestDims.width >= 10u;
  }

  export component ChestBody {
    requires rig skeleton: rig.ChestRig;
    requires surface skin: surface.ChestSurface;
    provides socket lock_mount: rig.LockSocket capacity = one;
    bind bone root to skeleton.root;
    bind bone lid to skeleton.lid;
    bind socket lock_mount to bone root {
      frame {
        origin = (0u, 5.5u, -4.1u);
        x = (1, 0, 0);
        y = (0, 1, 0);
        z = (0, 0, 1);
      }
    }
    geometry {
      bone root {
        cube plinth { origin = (-5u, 0u, -4u); size = (ChestDims.width, 2u, ChestDims.depth); surface = skin.base; }
        cube hull { origin = (-4.5u, 2u, -3.5u); size = (9u, ChestDims.body_h, 7u); surface = skin.wall; }
        cube rim { origin = (-5u, 6u, -4u); size = (10u, 1u, 8u); surface = skin.rim; }
        cube corner_fl { origin = (-5.5u, 2u, -4.5u); size = (1u, 4u, 1u); mirror_x = corner_fr; surface = skin.band; }
        cube corner_bl { origin = (-5.5u, 2u, 3.5u); size = (1u, 4u, 1u); mirror_x = corner_br; surface = skin.band; }
        cube handle_l { origin = (-5.5u, 3.5u, -1.5u); size = (1u, 1u, 3u); pivot = (-4.5u, 4u, 0u); rotation = (0deg, 0deg, 22.5deg); mirror_x = handle_r; surface = skin.handle; }
        bone lid {
          cube lid_main { origin = (-5u, 7u, -4u); size = (10u, 3u, 8u); surface = skin.lid; }
          cube lid_crown { origin = (-4u, 10u, -3u); size = (8u, 2u, 6u); surface = skin.lid_crown; }
          cube lid_eave_front { origin = (-4u, 10u, -4u); size = (8u, 1u, 1u); pivot = (0u, 10u, -3u); rotation = (-22.5deg, 0deg, 0deg); surface = skin.lid_slope; }
          cube lid_eave_back { origin = (-4u, 10u, 3u); size = (8u, 1u, 1u); pivot = (0u, 10u, 3u); rotation = (22.5deg, 0deg, 0deg); surface = skin.lid_slope; }
          cube lid_strap_front_l { origin = (-3.5u, 7u, -5u); size = (2u, 3u, 1u); mirror_x = lid_strap_front_r; surface = skin.strap; }
          cube lid_strap_back_l { origin = (-3.5u, 7u, 4u); size = (2u, 3u, 1u); mirror_x = lid_strap_back_r; surface = skin.strap; }
          cube lid_strap_top_l { origin = (-3.5u, 12u, -3u); size = (2u, 1u, 6u); mirror_x = lid_strap_top_r; surface = skin.strap_top; }
        }
      }
    }
  }

  export component ClaspMount {
    requires socket mount: rig.LockSocket;
    requires surface skin: surface.ClaspSurface;
    bind socket mount to bone anchor {
      frame {
        origin = (0u, 0u, 0u);
        x = (1, 0, 0);
        y = (0, 1, 0);
        z = (0, 0, 1);
      }
    }
    geometry {
      bone anchor {
        cube lockplate { origin = (-2u, -1.5u, -1u); size = (4u, 3u, 1u); surface = skin.plate; }
        cube gem { origin = (-0.5u, 0.5u, -2u); size = (1u, 1u, 1u); surface = skin.gem; }
      }
    }
  }
}
