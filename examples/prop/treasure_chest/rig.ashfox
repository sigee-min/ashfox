ashfox 1
module chest_rig {
  export socket contract LockSocket {
  }

  export rig contract ChestRig {
    joint root {
      parent = none;
      role = root;
      channels = rotation;
    }
    joint lid {
      parent = root;
      role = head;
      channels = rotation;
    }
  }

  export skeleton ChestSkeleton implements ChestRig {
    bind root { parent_origin = (0u, 0u, 0u); }
    bind lid { parent_origin = (0u, 8u, 5u); }
  }

  export motion idle for ChestRig {
    duration = 2s;
    fps = 20;
    loop = loop;
track lid.rotation {
      key 0s = (0deg, 0deg, 0deg) linear;
      key 1s = (2deg, 0deg, 0deg) linear;
      key 2s = (0deg, 0deg, 0deg) linear;
    }
  }

  export motion open for ChestRig {
    duration = 1.6s;
    fps = 20;
    loop = loop;
track lid.rotation {
      key 0s = (0deg, 0deg, 0deg) linear;
      key 0.6s = (52deg, 0deg, 0deg) catmullrom;
      key 1.1s = (52deg, 0deg, 0deg) linear;
      key 1.6s = (0deg, 0deg, 0deg) linear;
    }
  }
}
