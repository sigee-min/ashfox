ashfox 1
module animation {
  export rig contract GriffinRig {
    joint root { parent = none; role = root; channels = rotation; }
    joint torso { parent = root; role = body; channels = rotation; }
    joint head { parent = torso; role = head; channels = rotation; }
    joint wing_left { parent = torso; role = wing; channels = rotation; }
    joint wing_right { parent = torso; role = wing; channels = rotation; }
    joint foreleg_left { parent = torso; role = leg; channels = rotation; }
    joint foreleg_right { parent = torso; role = leg; channels = rotation; }
    joint tail { parent = torso; role = tail; channels = rotation; }
    joint tail_tip { parent = tail; role = tail; channels = rotation; }
  }

  export skeleton GriffinSkeleton implements GriffinRig {
    bind root { parent_origin = (0u, 0u, 0u); }
    bind torso { parent_origin = (0u, 14u, 0u); }
    bind head { parent_origin = (0u, 8u, -8u); }
    bind wing_left { parent_origin = (-5u, 6u, -2u); }
    bind wing_right { parent_origin = (5u, 6u, -2u); }
    bind foreleg_left { parent_origin = (-3.5u, -4u, -7.5u); }
    bind foreleg_right { parent_origin = (3.5u, -4u, -7.5u); }
    bind tail { parent_origin = (0u, -1u, 12u); }
    bind tail_tip { parent_origin = (0u, 1u, 10u); }
  }

  export motion idle for GriffinRig {
    duration = 3s; fps = 20; loop = loop;track torso.rotation {
      key 0s = (0deg, 0deg, 0deg) linear;
      key 1.5s = (2deg, 0deg, 0deg) linear;
      key 3s = (0deg, 0deg, 0deg) linear;
    }
    track head.rotation {
      key 0s = (0deg, 0deg, 0deg) linear;
      key 1.5s = (-2deg, 5deg, 0deg) linear;
      key 3s = (0deg, 0deg, 0deg) linear;
    }
    track wing_left.rotation {
      key 0s = (0deg, 0deg, 0deg) linear;
      key 1.5s = (0deg, 0deg, -5deg) linear;
      key 3s = (0deg, 0deg, 0deg) linear;
    }
    track wing_right.rotation {
      key 0s = (0deg, 0deg, 0deg) linear;
      key 1.5s = (0deg, 0deg, 5deg) linear;
      key 3s = (0deg, 0deg, 0deg) linear;
    }
    track tail.rotation {
      key 0s = (0deg, 0deg, 0deg) linear;
      key 1.5s = (0deg, 7deg, 0deg) linear;
      key 3s = (0deg, 0deg, 0deg) linear;
    }
    track tail_tip.rotation {
      key 0s = (0deg, 0deg, 0deg) linear;
      key 1.5s = (3deg, 10deg, 0deg) linear;
      key 3s = (0deg, 0deg, 0deg) linear;
    }
  }

  export motion look_around for GriffinRig {
    duration = 4s; fps = 24; loop = loop;track head.rotation {
      key 0s = (0deg, 0deg, 0deg) catmullrom;
      key 0.8s = (0deg, -22deg, -3deg) catmullrom;
      key 1.4s = (0deg, -22deg, -3deg) catmullrom;
      key 2.5s = (2deg, 22deg, 3deg) catmullrom;
      key 3.1s = (2deg, 22deg, 3deg) catmullrom;
      key 4s = (0deg, 0deg, 0deg) catmullrom;
    }
    track tail.rotation {
      key 0s = (0deg, 0deg, 0deg) catmullrom;
      key 1s = (0deg, 9deg, 0deg) catmullrom;
      key 2s = (0deg, 0deg, 0deg) catmullrom;
      key 3s = (0deg, -9deg, 0deg) catmullrom;
      key 4s = (0deg, 0deg, 0deg) catmullrom;
    }
  }

  export motion wing_display for GriffinRig {
    duration = 3.6s; fps = 24; loop = loop;track wing_left.rotation {
      key 0s = (0deg, 0deg, 0deg) catmullrom;
      key 0.9s = (0deg, 0deg, -22deg) catmullrom;
      key 2.4s = (0deg, 0deg, -22deg) catmullrom;
      key 3.6s = (0deg, 0deg, 0deg) catmullrom;
    }
    track wing_right.rotation {
      key 0s = (0deg, 0deg, 0deg) catmullrom;
      key 0.9s = (0deg, 0deg, 22deg) catmullrom;
      key 2.4s = (0deg, 0deg, 22deg) catmullrom;
      key 3.6s = (0deg, 0deg, 0deg) catmullrom;
    }
    track head.rotation {
      key 0s = (0deg, 0deg, 0deg) catmullrom;
      key 0.9s = (-7deg, 0deg, 0deg) catmullrom;
      key 2.4s = (-7deg, 0deg, 0deg) catmullrom;
      key 3.6s = (0deg, 0deg, 0deg) catmullrom;
    }
    track tail.rotation {
      key 0s = (0deg, 0deg, 0deg) catmullrom;
      key 1.2s = (-8deg, 0deg, 0deg) catmullrom;
      key 2.4s = (-8deg, 0deg, 0deg) catmullrom;
      key 3.6s = (0deg, 0deg, 0deg) catmullrom;
    }
  }

  export motion wing_flap for GriffinRig {
    duration = 1.6s; fps = 24; loop = loop;track wing_left.rotation {
      key 0s = (0deg, 0deg, 0deg) catmullrom;
      key 0.4s = (0deg, 0deg, -18deg) catmullrom;
      key 0.8s = (0deg, 0deg, 16deg) catmullrom;
      key 1.2s = (0deg, 0deg, -18deg) catmullrom;
      key 1.6s = (0deg, 0deg, 0deg) catmullrom;
    }
    track wing_right.rotation {
      key 0s = (0deg, 0deg, 0deg) catmullrom;
      key 0.4s = (0deg, 0deg, 18deg) catmullrom;
      key 0.8s = (0deg, 0deg, -16deg) catmullrom;
      key 1.2s = (0deg, 0deg, 18deg) catmullrom;
      key 1.6s = (0deg, 0deg, 0deg) catmullrom;
    }
    track head.rotation {
      key 0s = (0deg, 0deg, 0deg) catmullrom;
      key 0.4s = (-3deg, 0deg, 0deg) catmullrom;
      key 0.8s = (3deg, 0deg, 0deg) catmullrom;
      key 1.2s = (-3deg, 0deg, 0deg) catmullrom;
      key 1.6s = (0deg, 0deg, 0deg) catmullrom;
    }
  }

  export motion greeting for GriffinRig {
    duration = 3s; fps = 24; loop = loop;track head.rotation {
      key 0s = (0deg, 0deg, 0deg) catmullrom;
      key 0.65s = (17deg, 0deg, 0deg) catmullrom;
      key 1.1s = (2deg, 0deg, 0deg) catmullrom;
      key 1.65s = (13deg, 0deg, 0deg) catmullrom;
      key 2.2s = (0deg, 0deg, -6deg) catmullrom;
      key 3s = (0deg, 0deg, 0deg) catmullrom;
    }
    track tail.rotation {
      key 0s = (0deg, 0deg, 0deg) catmullrom;
      key 0.5s = (0deg, 13deg, 0deg) catmullrom;
      key 1s = (0deg, -13deg, 0deg) catmullrom;
      key 1.5s = (0deg, 13deg, 0deg) catmullrom;
      key 2s = (0deg, -13deg, 0deg) catmullrom;
      key 2.5s = (0deg, 7deg, 0deg) catmullrom;
      key 3s = (0deg, 0deg, 0deg) catmullrom;
    }
    track wing_left.rotation {
      key 0s = (0deg, 0deg, 0deg) catmullrom;
      key 1.5s = (0deg, 0deg, -5deg) catmullrom;
      key 3s = (0deg, 0deg, 0deg) catmullrom;
    }
    track wing_right.rotation {
      key 0s = (0deg, 0deg, 0deg) catmullrom;
      key 1.5s = (0deg, 0deg, 5deg) catmullrom;
      key 3s = (0deg, 0deg, 0deg) catmullrom;
    }
  }

  export motion alert for GriffinRig {
    duration = 2.4s; fps = 24; loop = loop;track head.rotation {
      key 0s = (0deg, 0deg, 0deg) catmullrom;
      key 0.25s = (-8deg, -12deg, 0deg) catmullrom;
      key 1.1s = (-8deg, -12deg, 0deg) catmullrom;
      key 1.55s = (-6deg, 12deg, 0deg) catmullrom;
      key 2.4s = (0deg, 0deg, 0deg) catmullrom;
    }
    track wing_left.rotation {
      key 0s = (0deg, 0deg, 0deg) catmullrom;
      key 0.3s = (0deg, 0deg, -10deg) catmullrom;
      key 1.6s = (0deg, 0deg, -10deg) catmullrom;
      key 2.4s = (0deg, 0deg, 0deg) catmullrom;
    }
    track wing_right.rotation {
      key 0s = (0deg, 0deg, 0deg) catmullrom;
      key 0.3s = (0deg, 0deg, 10deg) catmullrom;
      key 1.6s = (0deg, 0deg, 10deg) catmullrom;
      key 2.4s = (0deg, 0deg, 0deg) catmullrom;
    }
    track tail.rotation {
      key 0s = (0deg, 0deg, 0deg) catmullrom;
      key 0.3s = (-10deg, 0deg, 0deg) catmullrom;
      key 1.6s = (-10deg, 0deg, 0deg) catmullrom;
      key 2.4s = (0deg, 0deg, 0deg) catmullrom;
    }
  }
}
