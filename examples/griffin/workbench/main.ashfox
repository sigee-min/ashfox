ashfox 1
model griffin {
  import "./animation.ashfox" as animation;
  import "./surface.ashfox" as surface;
  import "./body.ashfox" as body;

  settings { density = 16; forward = north; profile = creature; }
  skeleton = animation.GriffinSkeleton;
  motions = [animation.idle, animation.look_around, animation.wing_display, animation.wing_flap, animation.greeting, animation.alert];
use body.Griffin as griffin { skeleton = animation.GriffinRig; skin = surface.griffin_skin; }
}
