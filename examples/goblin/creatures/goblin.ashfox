ashfox 1
model goblin {
  import "./goblin-rig.ashfox" as rig;
  import "./goblin-surface.ashfox" as surface;
  import "./goblin-body.ashfox" as body;
  settings { density = 16; forward = north; profile = creature; }
  skeleton = rig.RaiderSkeleton;
  motions = [rig.idle, rig.lookout, rig.challenge];
use body.GoblinRaider as goblin { skeleton = rig.GoblinRig; skin = surface.raider; }
}
