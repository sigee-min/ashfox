ashfox-model 1
module surface {
  export surface contract Fur {
    chart torso box { coverage = opaque; }
    chart chest box { coverage = opaque; }
    chart ruff box { coverage = opaque; }
    chart throat box { coverage = opaque; }
    chart head box { coverage = opaque; }
    chart muzzle box { coverage = opaque; }
    chart brow box { coverage = opaque; }
    chart ear_base box { coverage = opaque; }
    chart ear_tip box { coverage = opaque; }
    chart ear_inner box { coverage = opaque; }
    chart cheek_tuft flat { coverage = opaque; }
    chart front_leg box { coverage = opaque; }
    chart front_paw box { coverage = opaque; }
    chart back_leg box { coverage = opaque; }
    chart back_shin box { coverage = opaque; }
    chart back_paw box { coverage = opaque; }
    chart tail_base box { coverage = opaque; }
    chart tail_main box { coverage = opaque; }
    chart tail_tip box { coverage = opaque; }
    chart tail_plume flat { coverage = opaque; }
    chart nose box { coverage = opaque; }
    material = opaque;
  }

  export surface red_fox: Fur {
    material = opaque;
    texture atlas {
      background = deep; background-alpha = 255;
      palette {
        deep = #140b0a;
        coat = (#612012, #c44c24, #f08946);
        coat_dark = (#38130c, #742818, #af4827);
        coat_warm = (#7d2d16, #db652c, #f8a45c);
        cream = (#8a5b35, #d9a772, #ffe8bd);
        leg = (#24110f, #4c251d, #804738);
        paw = (#120908, #2b1713, #502f28);
        inner = (#743032, #b85555, #e8897e);
        eye_white = #fff4db;
        eye_dark = (#090707, #171011, #302020);
        nose = (#080606, #18100d, #362018);
      }
      stamp eye_pair {
        pixels = ".wk..kw./.wk..kw.";
        w = eye_white;
        k = eye_dark;
      }
      stamp face_mask {
        pixels = "......../cc....cc/ccc..ccc";
        c = cream;
      }
      stamp brow_tuft {
        pixels = ".ll../..ll.";
        l = coat_warm;
      }
      stamp chest_blaze {
        pixels = "..cc../.cccc./cccccc/cccccc/.cccc./..cc..";
        c = cream;
      }
      stamp mouth_mark {
        pixels = ".../.d.";
        d = eye_dark;
      }

      chart torso box {
        fill = coat;
        grain = clustered;
        pattern gradient { from = coat_dark; to = coat_warm; axis = y; space = model; soft = 0.25ratio; }
        pattern ao { strength = 0.85ratio; radius = 2u; }
        pattern stripe { paint = coat_dark; axis = u; period = 5px; width = 1px; phase = 1; }
      }
      chart chest box {
        fill = coat;
        grain = clustered;
        pattern gradient { from = cream; to = coat_warm; axis = y; space = model; soft = 0.2ratio; }
        pattern ao { strength = 0.8ratio; radius = 2u; }
        face north { stamp chest_blaze { at = (0px, 0px); protect = true; } }
      }
      chart ruff box {
        fill = coat_warm;
        grain = clustered;
        pattern gradient { from = cream; to = coat; axis = y; space = local; soft = 0.2ratio; }
        pattern border { paint = coat_dark; width = 1px; edges = bottom; }
        pattern ao { strength = 0.75ratio; radius = 2u; }
      }
      chart throat box {
        fill = cream;
        grain = soft;
        pattern gradient { from = coat_warm; to = cream; axis = y; space = local; soft = 0.25ratio; }
        pattern ao { strength = 0.7ratio; radius = 2u; }
      }
      chart head box {
        fill = coat;
        grain = soft;
        pattern gradient { from = coat_dark; to = coat_warm; axis = y; space = local; soft = 0.2ratio; }
        pattern border { paint = coat_dark; width = 1px; edges = bottom; }
        pattern ao { strength = 0.7ratio; radius = 2u; }
        face north {
          stamp eye_pair { at = (0px, 2px); protect = true; }
          stamp face_mask { at = (0px, 4px); protect = true; }
          stamp brow_tuft { at = (1px, 0px); }
        }
      }
      chart muzzle box {
        fill = cream;
        grain = soft;
        pattern gradient { from = cream; to = coat_warm; axis = y; space = local; soft = 0.3ratio; }
        pattern ao { strength = 0.7ratio; radius = 2u; }
        face north { stamp mouth_mark { at = (1px, 1px); protect = true; } }
      }
      chart brow box {
        fill = coat_warm;
        grain = soft;
        pattern border { paint = cream; width = 1px; edges = bottom; }
      }
      chart ear_base box {
        fill = coat;
        grain = soft;
        pattern gradient { from = coat_dark; to = coat_warm; axis = y; space = local; soft = 0.2ratio; }
        pattern ao { strength = 0.75ratio; radius = 2u; }
      }
      chart ear_tip box {
        fill = coat_dark;
        grain = none;
        pattern border { paint = paw; width = 1px; edges = top; }
      }
      chart ear_inner box {
        fill = inner;
        grain = soft;
        pattern border { paint = cream; width = 1px; edges = bottom; }
      }
      chart cheek_tuft flat {
        fill = cream;
        grain = soft;
        pattern gradient { from = coat; to = cream; axis = y; space = local; soft = 0.25ratio; }
      }
      chart back_leg box {
        fill = coat;
        grain = clustered;
        pattern gradient { from = leg; to = coat; axis = y; space = model; soft = 0.25ratio; }
        pattern ao { strength = 0.85ratio; radius = 2u; }
      }
      chart back_shin box {
        fill = leg;
        grain = clustered;
        pattern gradient { from = paw; to = leg; axis = y; space = model; soft = 0.2ratio; }
        pattern ao { strength = 0.8ratio; radius = 2u; }
      }
      chart front_leg box {
        fill = leg;
        grain = clustered;
        pattern gradient { from = paw; to = coat; axis = y; space = model; soft = 0.25ratio; }
        pattern ao { strength = 0.85ratio; radius = 2u; }
      }
      chart front_paw box {
        fill = paw;
        grain = none;
        pattern border { paint = leg; width = 1px; edges = top; }
        pattern ao { strength = 0.7ratio; radius = 2u; }
      }
      chart back_paw box {
        fill = paw;
        grain = none;
        pattern border { paint = leg; width = 1px; edges = top; }
        pattern ao { strength = 0.7ratio; radius = 2u; }
      }
      chart tail_base box {
        fill = coat;
        grain = clustered;
        pattern gradient { from = coat_dark; to = coat_warm; axis = y; space = local; soft = 0.25ratio; }
        pattern ao { strength = 0.85ratio; radius = 2u; }
      }
      chart tail_main box {
        fill = coat_warm;
        grain = clustered;
        pattern gradient { from = coat_dark; to = coat_warm; axis = y; space = local; soft = 0.25ratio; }
        pattern stripe { paint = coat; axis = v; period = 3px; width = 1px; phase = 0; }
      }
      chart tail_tip box {
        fill = cream;
        grain = soft;
        pattern gradient { from = coat_warm; to = cream; axis = y; space = local; soft = 0.2ratio; }
        pattern border { paint = coat_warm; width = 1px; edges = sides; }
      }
      chart tail_plume flat {
        fill = cream;
        grain = soft;
        pattern gradient { from = coat; to = cream; axis = y; space = local; soft = 0.2ratio; }
      }
      chart nose box {
        fill = nose;
        grain = none;
        pattern border { paint = leg; width = 1px; edges = top; }
      }
      grain clustered { seed = 8923; }
      tone painterly;
    }
  }
}
