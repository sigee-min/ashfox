ashfox-model 1
module surface {
  export surface contract Fur {
    chart torso box { coverage = opaque; }
    chart pelvis box { coverage = opaque; }
    chart chest box { coverage = opaque; }
    chart ruff box { coverage = opaque; }
    chart head box { coverage = opaque; }
    chart muzzle box { coverage = opaque; }
    chart nose box { coverage = opaque; }
    chart ear_base box { coverage = opaque; }
    chart ear_tip box { coverage = opaque; }
    chart ear_inner box { coverage = opaque; }
    chart cheek_tuft flat { coverage = binary; }
    chart front_shoulder box { coverage = opaque; }
    chart front_leg box { coverage = opaque; }
    chart front_paw box { coverage = opaque; }
    chart back_leg box { coverage = opaque; }
    chart back_shin box { coverage = opaque; }
    chart back_hock box { coverage = opaque; }
    chart back_paw box { coverage = opaque; }
    chart tail_base box { coverage = opaque; }
    chart tail_main box { coverage = opaque; }
    chart tail_tip box { coverage = opaque; }
    chart tail_tip_fine box { coverage = opaque; }
    chart tail_plume flat { coverage = binary; }
    material = double;
  }

  export surface red_fox: Fur {
    material = double;
    texture atlas {
      density = 2;
      background = bg; background-alpha = 255;
      palette {
        bg = #4d261a;
        coat = (#9b3b1e, #d9642c, #f49b56);
        coat_deep = (#6d2718, #a94322, #d46b37);
        cream = (#b68d65, #e6c69c, #fff1d4);
        sock = (#3d2420, #5c3831, #845549);
        paw = (#2e1c1a, #492d28, #6b453e);
        ear_pink = (#8c4842, #c9786e, #efb3a8);
        nose_tone = (#261918, #3d2725, #5e3e3a);
        eye_dark = #211514;
        eye_amber = #d47b2c;
        eye_glint = #fff7e6;
        brow_soft = #e8cfa6;
      }

      stamp fox_eyes {
        pixels = "..bbb......bbb../..kwa......awk../..kka......akk../..kkk......kkk..";
        b = brow_soft;
        k = eye_dark;
        w = eye_glint;
        a = eye_amber;
      }
      stamp cheek_blaze {
        pixels = "cc............cc/cccc........cccc/ccccc......ccccc/cccccc....cccccc";
        c = cream;
      }
      stamp muzzle_cleft {
        pixels = "......../...kk.../........";
        k = eye_dark;
      }
      stamp chest_heart {
        pixels = "....cccccccc..../..cccccccccccc../.cccccccccccccc./.cccccccccccccc./..cccccccccccc../...cccccccccc.../.....cccccc...../.......cc.......";
        c = cream;
      }

      chart torso box {
        fill = coat;
        grain = soft;
        pattern gradient { to = coat_deep; axis = y; space = local; soft = 0.25ratio; }
        pattern ao { strength = 0.45ratio; radius = 1u; }
      }
      chart pelvis box {
        fill = coat;
        grain = soft;
        pattern gradient { to = coat_deep; axis = y; space = local; soft = 0.25ratio; }
        pattern ao { strength = 0.45ratio; radius = 1u; }
      }
      chart chest box {
        fill = coat;
        grain = soft;
        pattern ao { strength = 0.45ratio; radius = 1u; }
        face north { stamp chest_heart { at = (0px, 2px); protect = true; } }
      }
      chart ruff box {
        fill = cream;
        grain = soft;
        pattern ao { strength = 0.4ratio; radius = 1u; }
      }
      chart head box {
        fill = coat;
        grain = soft;
        pattern gradient { to = coat_deep; axis = y; space = local; soft = 0.2ratio; }
        pattern ao { strength = 0.4ratio; radius = 1u; }
        face north {
          stamp fox_eyes { at = (0px, 3px); protect = true; }
          stamp cheek_blaze { at = (0px, 8px); protect = true; }
        }
      }
      chart muzzle box {
        fill = cream;
        grain = soft;
        pattern ao { strength = 0.4ratio; radius = 1u; }
        face north { stamp muzzle_cleft { at = (0px, 2px); protect = true; } }
      }
      chart nose box {
        fill = nose_tone;
        grain = none;
      }
      chart ear_base box {
        fill = coat;
        grain = soft;
        pattern ao { strength = 0.45ratio; radius = 1u; }
      }
      chart ear_tip box {
        fill = sock;
        grain = none;
      }
      chart ear_inner box {
        fill = ear_pink;
        grain = soft;
        pattern ao { strength = 0.4ratio; radius = 1u; }
      }
      chart cheek_tuft flat {
        coverage = 111000111110111111111111011110001100;
        fill = cream;
        grain = soft;
      }
      chart front_shoulder box {
        fill = coat;
        grain = clustered;
        pattern gradient { to = sock; axis = y; space = local; soft = 0.25ratio; }
        pattern ao { strength = 0.45ratio; radius = 1u; }
      }
      chart front_leg box {
        fill = sock;
        grain = soft;
        pattern gradient { to = paw; axis = y; space = local; soft = 0.2ratio; }
        pattern ao { strength = 0.4ratio; radius = 1u; }
      }
      chart front_paw box {
        fill = paw;
        grain = none;
        pattern border { paint = sock; width = 1px; edges = top; }
      }
      chart back_leg box {
        fill = coat;
        grain = clustered;
        pattern gradient { to = coat_deep; axis = y; space = local; soft = 0.25ratio; }
        pattern ao { strength = 0.45ratio; radius = 1u; }
      }
      chart back_shin box {
        fill = coat_deep;
        grain = soft;
        pattern gradient { to = sock; axis = y; space = local; soft = 0.2ratio; }
        pattern ao { strength = 0.4ratio; radius = 1u; }
      }
      chart back_hock box {
        fill = sock;
        grain = soft;
      }
      chart back_paw box {
        fill = paw;
        grain = none;
        pattern border { paint = sock; width = 1px; edges = top; }
      }
      chart tail_base box {
        fill = coat_deep;
        grain = soft;
        pattern ao { strength = 0.45ratio; radius = 1u; }
      }
      chart tail_main box {
        fill = coat;
        grain = soft;
        pattern gradient { to = coat_deep; axis = y; space = local; soft = 0.25ratio; }
        pattern ao { strength = 0.4ratio; radius = 1u; }
      }
      chart tail_tip box {
        fill = cream;
        grain = soft;
      }
      chart tail_tip_fine box {
        fill = cream;
        grain = none;
      }
      chart tail_plume flat {
        coverage = 111110001111110011111110111111110111111000111100;
        fill = cream;
        grain = soft;
      }

      grain soft { seed = 8923; }
      tone painterly;
    }
  }
}
