ashfox 1
module rig {
  export rig contract CreatureRig {
    joint root { parent = none; role = root; channels = (rotation, scale); }
    joint body { parent = root; role = body; channels = rotation; }
    joint head { parent = body; role = head; channels = rotation; }
    joint tail { parent = body; role = tail; channels = rotation; }
    joint tail_tip { parent = tail; role = tail; channels = rotation; }
    joint front_left { parent = body; role = leg; channels = rotation; }
    joint front_right { parent = body; role = leg; channels = rotation; }
    joint back_left { parent = body; role = leg; channels = rotation; }
    joint back_right { parent = body; role = leg; channels = rotation; }
  }

  export skeleton CreatureSkeleton implements CreatureRig {
    bind root { parent_origin = (0u, 0u, 0u); }
    bind body { parent_origin = (0u, 10u, 0u); }
    bind head { parent_origin = (0u, 3.5u, -7u); }
    bind tail { parent_origin = (0u, 1u, 7.5u); }
    bind tail_tip { parent_origin = (0u, 1u, 5.5u); }
    bind front_left { parent_origin = (-2.2u, -1u, -4.5u); }
    bind front_right { parent_origin = (2.2u, -1u, -4.5u); }
    bind back_left { parent_origin = (-2.2u, -1u, 5.5u); }
    bind back_right { parent_origin = (2.2u, -1u, 5.5u); }
  }

  export motion idle for CreatureRig {
    duration = 2s; fps = 20; loop = loop;track body.rotation {
      key 0s = (0deg, 0deg, 0deg) catmullrom;
      key 1s = (2deg, 0deg, 0deg) catmullrom;
      key 2s = (0deg, 0deg, 0deg) catmullrom;
    }
    track head.rotation {
      key 0s = (0deg, 0deg, 0deg) catmullrom;
      key 1s = (-2deg, 5deg, 2deg) catmullrom;
      key 2s = (0deg, 0deg, 0deg) catmullrom;
    }
    track tail.rotation {
      key 0s = (0deg, 0deg, 0deg) catmullrom;
      key 1s = (4deg, 8deg, 0deg) catmullrom;
      key 2s = (0deg, 0deg, 0deg) catmullrom;
    }
    track tail_tip.rotation {
      key 0s = (0deg, 0deg, 0deg) catmullrom;
      key 1s = (6deg, 10deg, 0deg) catmullrom;
      key 2s = (0deg, 0deg, 0deg) catmullrom;
    }
    track front_left.rotation {
      key 0s = (0deg, 0deg, 0deg) catmullrom;
      key 1s = (-3deg, 0deg, 0deg) catmullrom;
      key 2s = (0deg, 0deg, 0deg) catmullrom;
    }
  }

  export motion curious for CreatureRig {
    duration = 4s; fps = 24; loop = loop;track head.rotation {
      key 0s = (0deg, 0deg, 0deg) catmullrom;
      key 1s = (6deg, -18deg, -7deg) catmullrom;
      key 2s = (6deg, -18deg, -7deg) catmullrom;
      key 3s = (-3deg, 12deg, 5deg) catmullrom;
      key 4s = (0deg, 0deg, 0deg) catmullrom;
    }
    track tail.rotation {
      key 0s = (0deg, 0deg, 0deg) catmullrom;
      key 1s = (3deg, 10deg, 0deg) catmullrom;
      key 2s = (0deg, -8deg, 0deg) catmullrom;
      key 3s = (3deg, 6deg, 0deg) catmullrom;
      key 4s = (0deg, 0deg, 0deg) catmullrom;
    }
    track tail_tip.rotation {
      key 0s = (0deg, 0deg, 0deg) catmullrom;
      key 1.2s = (6deg, 14deg, 0deg) catmullrom;
      key 2.2s = (2deg, -12deg, 0deg) catmullrom;
      key 4s = (0deg, 0deg, 0deg) catmullrom;
    }
  }

  export motion tail_wag for CreatureRig {
    duration = 2.4s; fps = 24; loop = loop;track tail.rotation {
      key 0s = (0deg, 0deg, 0deg) catmullrom;
      key 0.3s = (2deg, 18deg, 0deg) catmullrom;
      key 0.9s = (2deg, -18deg, 0deg) catmullrom;
      key 1.5s = (2deg, 18deg, 0deg) catmullrom;
      key 2.1s = (2deg, -18deg, 0deg) catmullrom;
      key 2.4s = (0deg, 0deg, 0deg) catmullrom;
    }
    track tail_tip.rotation {
      key 0s = (0deg, 0deg, 0deg) catmullrom;
      key 0.4s = (4deg, 22deg, 0deg) catmullrom;
      key 1s = (4deg, -22deg, 0deg) catmullrom;
      key 1.6s = (4deg, 22deg, 0deg) catmullrom;
      key 2.2s = (4deg, -22deg, 0deg) catmullrom;
      key 2.4s = (0deg, 0deg, 0deg) catmullrom;
    }
    track head.rotation {
      key 0s = (0deg, 0deg, 0deg) catmullrom;
      key 0.6s = (-4deg, 0deg, -3deg) catmullrom;
      key 1.8s = (-4deg, 0deg, 3deg) catmullrom;
      key 2.4s = (0deg, 0deg, 0deg) catmullrom;
    }
  }
}
