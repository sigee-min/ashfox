ashfox 1
module rig {
  export rig contract CreatureRig {
    joint root { parent = none; role = root; channels = (position, rotation, scale); }
    joint body { parent = root; role = body; channels = (position, rotation, scale); limits { pitch = -25deg..25deg; } }
    joint head { parent = body; role = head; channels = rotation; limits { pitch = -35deg..40deg; yaw = -55deg..55deg; } }
    joint tail { parent = body; role = tail; channels = rotation; limits { pitch = -35deg..45deg; } }
    joint tail_tip { parent = tail; role = tail; channels = rotation; limits { pitch = -35deg..45deg; } }
    joint front_left { parent = body; role = leg; channels = rotation; mirror = front_right; }
    joint front_right { parent = body; role = leg; channels = rotation; mirror = front_left; }
    joint back_left { parent = body; role = leg; channels = rotation; mirror = back_right; }
    joint back_right { parent = body; role = leg; channels = rotation; mirror = back_left; }

    chain tail_chain = [tail, tail_tip];
    anchor nose { joint = head; offset = (0u, 0u, -6u); }
    anchor tail_end { joint = tail_tip; offset = (0u, 0u, 5u); }
  }

  export skeleton CreatureSkeleton implements CreatureRig {
    bind root { parent_origin = (0u, 0u, 0u); }
    bind body { parent_origin = (0u, 10u, 0u); }
    bind head { parent_origin = (0u, 3.5u, -7u); }
    bind tail { parent_origin = (0u, 1u, 7.5u); }
    bind tail_tip { parent_origin = (0u, 1u, 5.5u); }
    bind front_left { parent_origin = (-2.2u, -1u, -4.5u); }
    bind front_right { parent_origin = (2.2u, -1u, -4.5u); }
    bind back_left { parent_origin = (-2.2u, -1u, 5.5u); }
    bind back_right { parent_origin = (2.2u, -1u, 5.5u); }
  }

  export motion idle for CreatureRig {
    duration = 2s;
    fps = 24;
    loop = loop;
    rest_relative = true;

    track root.position {
      key 0s = (0u, 0u, 0u) smooth;
      key 0.85s = (0u, -0.35u, 0u) ease_in_out;
      key 2s = (0u, 0u, 0u) ease_out;
    }
    track body.rotation {
      key 0s = (0deg, 0deg, 0deg) smooth;
      key 0.9s = (3deg, 0deg, 0deg) ease_in_out;
      key 2s = (0deg, 0deg, 0deg) ease_out;
    }
    track head.rotation {
      key 0s = (0deg, 0deg, 0deg) smooth;
      key 0.9s = (-3deg, 8deg, 3deg) ease_in_out;
      key 2s = (0deg, 0deg, 0deg) ease_out;
    }
    track tail.rotation {
      key 0s = (0deg, 0deg, 0deg) smooth;
      key 0.8s = (5deg, 12deg, 0deg) ease_in_out;
      key 2s = (0deg, 0deg, 0deg) ease_out;
    }
    track front_left.rotation {
      key 0s = (0deg, 0deg, 0deg) smooth;
      key 0.9s = (-4deg, 0deg, 0deg) ease_in_out;
      key 2s = (0deg, 0deg, 0deg) ease_out;
    }
    track back_right.rotation {
      key 0s = (0deg, 0deg, 0deg) smooth;
      key 0.9s = (4deg, 0deg, 0deg) ease_in_out;
      key 2s = (0deg, 0deg, 0deg) ease_out;
    }

    wave body.rotation.x = breath(2s, inhale = 0.42) * 2deg;
    wave head.rotation.y = simplex(1.0, 2deg, 7) * 1.5deg;
    secondary chain tail_chain { stiffness = 15; damping = 0.34; gravity = 0.25; }
    cue 0.4s sound "fox_breath" at nose;
    cue 1.2s sound "fox_step" at nose;
  }

  export motion curious for CreatureRig {
    duration = 4s;
    fps = 24;
    loop = loop;
    rest_relative = true;

    pose alert_left { head.rotation = (6deg, -22deg, -10deg); body.rotation = (-3deg, -6deg, 0deg); }
    pose alert_right { head.rotation = (-4deg, 16deg, 7deg); body.rotation = (2deg, 5deg, 0deg); }

    at 0s pose alert_right smooth;
    at 1s pose alert_left anticipate(0.25);
    at 2s pose alert_left smooth;
    at 3s pose alert_right overshoot(0.2);
    at 4s pose alert_right ease_out;

    track root.position {
      key 0s = (0u, 0u, 0u) smooth;
      key 1s = (0u, 0.5u, -0.4u) ease_out;
      key 2.6s = (0u, -0.4u, 0u) ease_in_out;
      key 4s = (0u, 0u, 0u) ease_out;
    }
    secondary chain tail_chain { stiffness = 16; damping = 0.32; gravity = 0.22; }
    secondary joint head { stiffness = 20; damping = 0.42; lag = 0.06s; }
    cue 1s sound "fox_chirp" at nose;
  }

  export motion tail_wag for CreatureRig {
    duration = 2.4s;
    fps = 24;
    loop = loop;
    rest_relative = true;

    track root.position {
      key 0s = (0u, 0u, 0u) smooth;
      key 0.6s = (0u, -0.5u, 0u) ease_in_out;
      key 1.2s = (0u, 0.2u, 0u) ease_out;
      key 1.8s = (0u, -0.5u, 0u) ease_in_out;
      key 2.4s = (0u, 0u, 0u) ease_out;
    }
    track tail.rotation {
      key 0s = (0deg, 0deg, 0deg) smooth;
      key 0.35s = (3deg, 22deg, 0deg) ease_in_out;
      key 0.95s = (3deg, -22deg, 0deg) ease_in_out;
      key 1.55s = (3deg, 22deg, 0deg) ease_in_out;
      key 2.1s = (3deg, -22deg, 0deg) ease_in_out;
      key 2.4s = (0deg, 0deg, 0deg) ease_out;
    }
    track head.rotation {
      key 0s = (0deg, 0deg, 0deg) smooth;
      key 0.6s = (-6deg, 0deg, -5deg) ease_out;
      key 1.8s = (-6deg, 0deg, 5deg) ease_out;
      key 2.4s = (0deg, 0deg, 0deg) ease_out;
    }

    secondary chain tail_chain { stiffness = 20; damping = 0.28; gravity = 0.18; }
    cue 0.35s sound "fox_rustle" at tail_end;
  }
}
