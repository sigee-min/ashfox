ashfox 1
module servo {
  params {
    motor_pitch = 180hz;
    rotor_cutoff = 520hz;
    shield_pitch = 420hz;
  }

  export voice servo_whir : fm {
    pitch = log(0: motor_pitch -> 0.45: 340hz -> 1: motor_pitch);
    ratio = 1.5;
    index = lin(0: 1.6 -> 0.5: 2.8 -> 1: 1.4);
    vibrato_hz = 8hz;
    vibrato_cents = 15cents;
    highpass = 65hz;
    drive : tape { amount = 1.4; }
    pan = -0.22 -> 0.22;
    gain { env = adsr; attack = 25ms; decay = 110ms; sustain = 0.65; release = 90ms; peak = 0.84; }
  }

  export voice rotor_chop : noise {
    color = pink;
    filter : bandpass { cutoff = log(0: 260hz -> 0.5: rotor_cutoff -> 1: 260hz); q = 1.3; }
    highpass = 48hz;
    drift { target = gain; depth = 42%; rate = 12hz; }
    fx : phaser { mix = 28%; rate = 3.2hz; stages = 4; }
    pan = -0.15;
    gain = smooth(0: 0.72 -> 0.5: 0.92 -> 1: 0.72);
  }

  export voice shield_hum : osc {
    waveform = triangle;
    pitch = log(0: shield_pitch -> 0.5: 465hz -> 1: shield_pitch);
    unison = 3;
    detune_cents = 14cents;
    highpass = 80hz;
    lowpass = 3600hz;
    fx : chorus { mix = 34%; rate = 1.1hz; depth = 0.4; }
    gain = smooth(0: 0.62 -> 0.5: 0.82 -> 1: 0.62);
  }

  export voice shield_shatter : modal_plate {
    material = glass;
    pitch = 1280hz;
    size = 1.1;
    hardness = 0.96;
    damping = 0.24;
    brightness = 0.92;
    modes = 20;
    strike = mallet;
    twin_beat = 0.6;
    splash = 0.48;
    stereo_spread = 0.72;
    highpass = 180hz;
    fx : shimmer { mix = 22%; feedback = 24%; shift_semitones = 7st; }
    gain { env = ad; attack = 2ms; peak = 0.9; curve = exp; }
  }
}
