ashfox 1
module fire {
  params {
    roar_cutoff = 360hz;
    ember_density = 42;
  }

  export voice hearth_roar : noise {
    color = brown;
    filter : bandpass { cutoff = log(0: 210hz -> 0.45: roar_cutoff -> 1: 210hz); q = 0.9; }
    highpass = 42hz;
    drive : tape { amount = 1.3; }
    drift { target = cutoff; depth = 34%; rate = 0.65hz; }
    gain = smooth(0: 0.68 -> 0.35: 0.94 -> 0.7: 0.58 -> 1: 0.68);
  }

  export voice flame_flutter : noise {
    color = pink;
    filter : bandpass { cutoff = log(0: 1100hz -> 0.5: 2400hz -> 1: 1100hz); q = 1.1; }
    drift { target = pan; depth = 35%; rate = 0.85hz; }
    pan = -0.2;
    gain = smooth(0: 0.42 -> 0.5: 0.72 -> 1: 0.42);
  }

  export voice ember_crackle : granular {
    texture = ember;
    density = ember_density;
    grain_ms = 14ms;
    pitch = log(0: 2400hz -> 0.5: 4400hz -> 1: 2400hz);
    spread = 0.84;
    burstiness = 0.64;
    turbulence = 0.68;
    stereo_width = 0.86;
    itd_ms = 0.28ms;
    highpass = 900hz;
    drift { target = pitch; depth = 20%; rate = 1.1hz; }
    pan = 0.2;
    gain = smooth(0: 0.72 -> 0.45: 0.92 -> 1: 0.72);
  }
}
