ashfox 1
module room {
  params {
    air_cutoff = 380hz;
    tone_level = 0.48;
  }

  export voice room_bed : noise {
    color = brown;
    filter : bandpass { cutoff = log(0: 140hz -> 0.5: air_cutoff -> 1: 140hz); q = 0.85; }
    highpass = 35hz;
    lowpass = 2400hz;
    drift { target = cutoff; depth = 22%; rate = 0.25hz; }
    gain = smooth(0: tone_level -> 0.5: 0.62 -> 1: tone_level);
  }

  export voice draft_hiss : noise {
    color = pink;
    highpass = 1200hz;
    lowpass = 6800hz;
    drift { target = pan; depth = 20%; rate = 0.28hz; }
    gain = smooth(0: 0.16 -> 0.5: 0.26 -> 1: 0.16);
  }
}
