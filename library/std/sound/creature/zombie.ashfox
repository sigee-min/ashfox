ashfox 1
module zombie {
  params {
    growl_pitch = 105hz;
    snarl_pitch = 185hz;
    horde_density = 28;
  }

  export voice zombie_groan : vocal {
    pitch = log(0: growl_pitch -> 0.35: 132hz -> 1: 86hz);
    vowels = uh -> aa -> oh -> er;
    breath = 0.36;
    jitter = 0.45;
    roughness = 0.74;
    growl = 0.78;
    chest = 0.82;
    rattle = 0.48;
    highpass = 45hz;
    drive : grit { amount = 1.5; }
    pan = -0.18;
    gain { env = adsr; attack = 45ms; decay = 180ms; sustain = 0.62; release = 160ms; peak = 0.9; }
  }

  export voice zombie_bite : modal_plate {
    material = bone;
    pitch = 290hz;
    size = 0.78;
    hardness = 0.88;
    damping = 0.62;
    brightness = 0.74;
    modes = 12;
    strike = mallet;
    splash = 0.42;
    stereo_spread = 0.36;
    highpass = 65hz;
    drive : grit { amount = 1.8; }
    gain { env = ad; attack = 2ms; peak = 0.92; curve = exp; }
  }

  export voice zombie_roar : vocal {
    pitch = log(0: 130hz -> 0.28: snarl_pitch -> 0.75: 145hz -> 1: 95hz);
    vowels = aa -> oh -> uh;
    breath = 0.44;
    jitter = 0.52;
    roughness = 0.86;
    growl = 0.9;
    chest = 0.88;
    rattle = 0.64;
    highpass = 50hz;
    drive : tube { amount = 2.0; }
    fx : delay { mix = 18%; time_ms = 34ms; feedback = 22%; ping_pong = true; }
    gain { env = adsr; attack = 24ms; decay = 160ms; sustain = 0.72; release = 180ms; peak = 0.95; }
  }

  export voice horde_ambience : granular {
    texture = wind;
    density = horde_density;
    grain_ms = 92ms;
    pitch = log(0: 195hz -> 0.5: 255hz -> 1: 195hz);
    spread = 0.78;
    burstiness = 0.42;
    turbulence = 0.56;
    stereo_width = 0.85;
    itd_ms = 0.3ms;
    highpass = 60hz;
    lowpass = 3400hz;
    drift { target = pitch; depth = 18%; rate = 0.55hz; }
    gain = smooth(0: 0.66 -> 0.5: 0.92 -> 1: 0.66);
  }
}
