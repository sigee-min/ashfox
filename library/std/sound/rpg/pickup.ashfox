ashfox 1
module pickup {
  params {
    coin_pitch = 1580hz;
    pop_pitch = 680hz;
    gulp_pitch = 380hz;
  }

  export voice coin_jingle : modal_plate {
    material = bronze;
    pitch = coin_pitch;
    size = 0.62;
    hardness = 0.92;
    damping = 0.2;
    brightness = 0.88;
    modes = 16;
    strike = bounce;
    bounces = 2;
    twin_beat = 0.5;
    splash = 0.34;
    stereo_spread = 0.48;
    highpass = 220hz;
    eq { low = (260hz, 2db); mid = (3200hz, -1.5db, 1.1); high = (7200hz, 1.5db); }
    drive : tape { amount = 1.3; }
    fx : shimmer { mix = 18%; feedback = 22%; shift_semitones = 12st; }
    gain { env = ad; attack = 2ms; peak = 0.96; curve = exp; }
  }

  export voice item_pop : chirp {
    pitch = log(0: pop_pitch -> 0.55: 1360hz -> 1: 1120hz);
    brightness = 0.72;
    trill_hz = 18hz;
    trill_cents = 25cents;
    trill_depth = 0.14;
    breath = 0.12;
    highpass = 120hz;
    eq { low = (240hz, 2.5db); }
    fx : chorus { mix = 24%; rate = 2.2hz; depth = 0.38; }
    pan = -0.1 -> 0.1;
    gain { env = ad; attack = 3ms; peak = 0.94; curve = exp; }
  }

  export voice potion_gulp : granular {
    texture = bubble;
    density = 68;
    grain_ms = 22ms;
    pitch = log(0: gulp_pitch -> 0.45: 760hz -> 1: 480hz);
    spread = 0.64;
    burstiness = 0.55;
    turbulence = 0.48;
    stereo_width = 0.64;
    itd_ms = 0.22ms;
    highpass = 90hz;
    lowpass = 4600hz;
    eq { low = (180hz, 3db); }
    drive : tape { amount = 1.4; }
    gain { env = adsr; attack = 10ms; decay = 95ms; sustain = 0.55; release = 85ms; peak = 0.95; }
  }

  export seq coin_pickup {
    start = 6ms;
    step cling { voice = coin_jingle; at = 0ms; duration = 340ms; vary_pitch = -35cents..35cents; }
  }

  export seq item_pickup {
    start = 6ms;
    step pop { voice = item_pop; at = 0ms; duration = 220ms; vary_pitch = -40cents..40cents; }
  }

  export seq potion_drink {
    start = 8ms;
    step gulp { voice = potion_gulp; at = 0ms; duration = 380ms; vary_pitch = -45cents..45cents; }
  }
}
