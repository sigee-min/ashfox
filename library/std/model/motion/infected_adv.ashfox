  export motion sprint_frenzy for biped.BipedRig {
    duration = 0.56s; fps = 30; loop = loop;
    track pelvis.position {
      key 0s = (0u, -0.8u, 0u) catmullrom;
      key 0.14s = (0u, 0.7u, 0u) catmullrom;
      key 0.28s = (0u, -0.8u, 0u) catmullrom;
      key 0.42s = (0u, 0.7u, 0u) catmullrom;
      key 0.56s = (0u, -0.8u, 0u) catmullrom;
    }
    track torso.rotation {
      key 0s = (-24deg, -10deg, 5deg) catmullrom;
      key 0.28s = (-26deg, 10deg, -5deg) catmullrom;
      key 0.56s = (-24deg, -10deg, 5deg) catmullrom;
    }
    track head.rotation {
      key 0s = (16deg, 8deg, -4deg) catmullrom;
      key 0.28s = (18deg, -8deg, 4deg) catmullrom;
      key 0.56s = (16deg, 8deg, -4deg) catmullrom;
    }
    track left_arm.rotation {
      key 0s = (82deg, 0deg, -8deg) catmullrom;
      key 0.28s = (-38deg, 0deg, -10deg) catmullrom;
      key 0.56s = (82deg, 0deg, -8deg) catmullrom;
    }
    track right_arm.rotation {
      key 0s = (-38deg, 0deg, 10deg) catmullrom;
      key 0.28s = (82deg, 0deg, 8deg) catmullrom;
      key 0.56s = (-38deg, 0deg, 10deg) catmullrom;
    }
    track left_leg.rotation {
      key 0s = (-46deg, 0deg, -3deg) catmullrom;
      key 0.28s = (48deg, 0deg, -3deg) catmullrom;
      key 0.56s = (-46deg, 0deg, -3deg) catmullrom;
    }
    track right_leg.rotation {
      key 0s = (48deg, 0deg, 3deg) catmullrom;
      key 0.28s = (-46deg, 0deg, 3deg) catmullrom;
      key 0.56s = (48deg, 0deg, 3deg) catmullrom;
    }
  }

