ashfox 1
module monster_cute {
  import "std/model/rig/mushroom" as mushroom;

  // Squash-stretch motions for MushroomRig (forward = north (-Z), right-handed).
  export motion hop_bounce for mushroom.MushroomRig {
    duration = 0.8s; fps = 24; loop = loop;
    track root.position {
      key 0s = (0u, 0u, 0u) ease_in;
      key 0.15s = (0u, 0u, 0u) ease_out;
      key 0.4s = (0u, 6u, 0u) ease_in;
      key 0.65s = (0u, 0u, 0u) smooth;
      key 0.8s = (0u, 0u, 0u) smooth;
    }
    track root.scale {
      key 0s = (1.12, 0.84, 1.12) ease_in;
      key 0.15s = (1.22, 0.74, 1.22) ease_out;
      key 0.32s = (0.90, 1.16, 0.90) smooth;
      key 0.58s = (0.94, 1.08, 0.94) ease_in;
      key 0.68s = (1.24, 0.72, 1.24) ease_out;
      key 0.8s = (1.12, 0.84, 1.12) smooth;
    }
    track stem.rotation {
      key 0s = (-6deg, 0deg, 0deg) smooth;
      key 0.35s = (8deg, 0deg, 0deg) smooth;
      key 0.65s = (-10deg, 0deg, 0deg) smooth;
      key 0.8s = (-6deg, 0deg, 0deg) smooth;
    }
    track cap.rotation {
      key 0s = (4deg, 0deg, -3deg) smooth;
      key 0.4s = (-10deg, 0deg, 4deg) smooth;
      key 0.8s = (4deg, 0deg, -3deg) smooth;
    }
    track cap.scale {
      key 0s = (1.06, 0.92, 1.06) smooth;
      key 0.4s = (0.95, 1.08, 0.95) smooth;
      key 0.8s = (1.06, 0.92, 1.06) smooth;
    }
  }

  export motion squish_hit for mushroom.MushroomRig {
    duration = 0.5s; fps = 30; loop = once;
    track root.position {
      key 0s = (0u, 0u, 0u) snap;
      key 0.1s = (0u, 0u, 2u) ease_out;
      key 0.5s = (0u, 0u, 0u) smooth;
    }
    track root.scale {
      key 0s = (1, 1, 1) snap;
      key 0.08s = (1.45, 0.48, 1.45) ease_out;
      key 0.24s = (0.88, 1.16, 0.88) elastic;
      key 0.5s = (1, 1, 1) smooth;
    }
    track stem.rotation {
      key 0s = (0deg, 0deg, 0deg) snap;
      key 0.1s = (22deg, 0deg, -12deg) ease_out;
      key 0.3s = (-8deg, 0deg, 6deg) smooth;
      key 0.5s = (0deg, 0deg, 0deg) smooth;
    }
    track cap.rotation {
      key 0s = (0deg, 0deg, 0deg) snap;
      key 0.12s = (18deg, 0deg, 16deg) ease_out;
      key 0.32s = (-10deg, 0deg, -8deg) smooth;
      key 0.5s = (0deg, 0deg, 0deg) smooth;
    }
  }

  export motion poof_die for mushroom.MushroomRig {
    duration = 0.6s; fps = 30; loop = hold_on_last_frame;
    track root.position {
      key 0s = (0u, 0u, 0u) snap;
      key 0.15s = (0u, 0u, 0u) ease_out;
      key 0.45s = (0u, 3u, 0u) ease_in;
      key 0.6s = (0u, 3.5u, 0u) smooth;
    }
    track root.scale {
      key 0s = (1, 1, 1) snap;
      key 0.15s = (1.38, 0.45, 1.38) ease_out;
      key 0.35s = (1.18, 1.18, 1.18) anticipate;
      key 0.6s = (0.02, 0.02, 0.02) ease_in;
    }
    track stem.rotation {
      key 0s = (0deg, 0deg, 0deg) snap;
      key 0.2s = (0deg, 25deg, 14deg) ease_out;
      key 0.6s = (0deg, 110deg, 0deg) ease_in;
    }
    track cap.rotation {
      key 0s = (0deg, 0deg, 0deg) snap;
      key 0.18s = (-16deg, -20deg, -12deg) ease_out;
      key 0.6s = (12deg, -110deg, 0deg) ease_in;
    }
  }
}
