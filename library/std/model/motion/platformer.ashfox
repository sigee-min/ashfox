      key 0.14s = (42deg, 0deg, 55deg) ease_out;
      key 0.55s = (0deg, 0deg, 0deg) smooth;
    }
    track left_leg.rotation {
      key 0s = (0deg, 0deg, 0deg) snap;
      key 0.14s = (34deg, 0deg, -10deg) ease_out;
      key 0.55s = (0deg, 0deg, 0deg) smooth;
    }
    track right_leg.rotation {
      key 0s = (0deg, 0deg, 0deg) snap;
      key 0.14s = (18deg, 0deg, 10deg) ease_out;
      key 0.55s = (0deg, 0deg, 0deg) smooth;
    }
  }

  export motion biped_sit_chair for biped.BipedRig {
    duration = 2.4s; fps = 20; loop = loop;
    track pelvis.position {
