ashfox 1
module platformer {
  import "std/model/rig/chibi" as chibi;
  import "std/model/rig/biped" as biped;

  // ChibiRig platformer motions (forward = north (-Z), right-handed).
  export motion jump_rise for chibi.ChibiRig {
    duration = 0.45s; fps = 30; loop = hold_on_last_frame;
    track pelvis.position {
      key 0s = (0u, -1.5u, 0u) ease_out;
      key 0.12s = (0u, 1.5u, 0u) ease_out;
      key 0.45s = (0u, 2.2u, 0u) smooth;
    }
    track torso.rotation {
      key 0s = (-12deg, 0deg, 0deg) ease_out;
      key 0.15s = (6deg, 0deg, 0deg) ease_out;
      key 0.45s = (-4deg, 0deg, 0deg) smooth;
    }
    track head.rotation {
      key 0s = (8deg, 0deg, 0deg) ease_out;
      key 0.2s = (-8deg, 0deg, 0deg) smooth;
      key 0.45s = (0deg, 0deg, 0deg) smooth;
    }
    track left_arm.rotation {
      key 0s = (-25deg, 0deg, -10deg) ease_out;
      key 0.18s = (135deg, 0deg, -18deg) ease_out;
      key 0.45s = (120deg, 0deg, -16deg) smooth;
    }
    track right_arm.rotation {
      key 0s = (-25deg, 0deg, 10deg) ease_out;
      key 0.18s = (135deg, 0deg, 18deg) ease_out;
      key 0.45s = (120deg, 0deg, 16deg) smooth;
    }
    track left_leg.rotation {
      key 0s = (32deg, 0deg, 0deg) ease_out;
      key 0.15s = (-18deg, 0deg, 0deg) ease_out;
      key 0.45s = (35deg, 0deg, 0deg) smooth;
    }
    track right_leg.rotation {
      key 0s = (32deg, 0deg, 0deg) ease_out;
      key 0.15s = (-24deg, 0deg, 0deg) ease_out;
      key 0.45s = (-15deg, 0deg, 0deg) smooth;
    }
  }

  export motion double_jump for chibi.ChibiRig {
    duration = 0.5s; fps = 30; loop = once;
    track pelvis.position {
      key 0s = (0u, 0u, 0u) ease_out;
      key 0.25s = (0u, 2.5u, 0u) smooth;
      key 0.5s = (0u, 0u, 0u) ease_in;
    }
    track pelvis.rotation {
      key 0s = (0deg, 0deg, 0deg) linear;
      key 0.12s = (-90deg, 0deg, 0deg) linear;
      key 0.25s = (-180deg, 0deg, 0deg) linear;
      key 0.38s = (-270deg, 0deg, 0deg) linear;
      key 0.5s = (-360deg, 0deg, 0deg) ease_out;
    }
    track torso.rotation {
      key 0s = (-10deg, 0deg, 0deg) ease_out;
      key 0.25s = (-24deg, 0deg, 0deg) smooth;
      key 0.5s = (0deg, 0deg, 0deg) smooth;
    }
    track left_arm.rotation {
      key 0s = (45deg, 0deg, -14deg) ease_out;
      key 0.25s = (65deg, 0deg, -8deg) smooth;
      key 0.5s = (60deg, 0deg, -28deg) ease_out;
    }
    track right_arm.rotation {
      key 0s = (45deg, 0deg, 14deg) ease_out;
      key 0.25s = (65deg, 0deg, 8deg) smooth;
      key 0.5s = (60deg, 0deg, 28deg) ease_out;
    }
    track left_leg.rotation {
      key 0s = (45deg, 0deg, 0deg) ease_out;
      key 0.25s = (60deg, 0deg, 0deg) smooth;
      key 0.5s = (16deg, 0deg, 0deg) smooth;
    }
    track right_leg.rotation {
      key 0s = (45deg, 0deg, 0deg) ease_out;
      key 0.25s = (60deg, 0deg, 0deg) smooth;
      key 0.5s = (-12deg, 0deg, 0deg) smooth;
    }
  }

