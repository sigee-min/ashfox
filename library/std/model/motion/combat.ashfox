ashfox 1
module combat {
  import "std/model/rig/biped" as biped;

  export motion slash for biped.BipedRig {
    duration = 0.7s; fps = 30; loop = once;
    track torso.rotation {
      key 0s = (0deg, 0deg, 0deg) catmullrom;
      key 0.2s = (8deg, -22deg, 0deg) catmullrom;
      key 0.45s = (-12deg, 28deg, 0deg) catmullrom;
      key 0.7s = (0deg, 0deg, 0deg) catmullrom;
    }
    track right_arm.rotation {
      key 0s = (0deg, 0deg, 0deg) catmullrom;
      key 0.2s = (115deg, -24deg, 16deg) catmullrom;
      key 0.45s = (36deg, 16deg, 6deg) catmullrom;
      key 0.7s = (0deg, 0deg, 0deg) catmullrom;
    }
    track left_arm.rotation {
      key 0s = (0deg, 0deg, 0deg) catmullrom;
      key 0.2s = (14deg, 8deg, -10deg) catmullrom;
      key 0.45s = (-10deg, -8deg, -12deg) catmullrom;
      key 0.7s = (0deg, 0deg, 0deg) catmullrom;
    }
    track weapon.rotation {
      key 0s = (0deg, 0deg, 0deg) linear;
      key 0.45s = (-12deg, 0deg, 0deg) linear;
      key 0.7s = (0deg, 0deg, 0deg) linear;
    }
  }

  export motion thrust for biped.BipedRig {
    duration = 0.6s; fps = 30; loop = once;
    track torso.rotation {
      key 0s = (0deg, 0deg, 0deg) catmullrom;
      key 0.15s = (4deg, -18deg, 0deg) catmullrom;
      key 0.35s = (-10deg, 14deg, 0deg) catmullrom;
      key 0.6s = (0deg, 0deg, 0deg) catmullrom;
    }
    track right_arm.rotation {
      key 0s = (0deg, 0deg, 0deg) catmullrom;
      key 0.15s = (-28deg, 0deg, 10deg) catmullrom;
      key 0.35s = (75deg, 0deg, 4deg) catmullrom;
      key 0.6s = (0deg, 0deg, 0deg) catmullrom;
    }
    track left_arm.rotation {
      key 0s = (0deg, 0deg, 0deg) catmullrom;
      key 0.15s = (12deg, 0deg, -8deg) catmullrom;
      key 0.35s = (-14deg, 0deg, -10deg) catmullrom;
      key 0.6s = (0deg, 0deg, 0deg) catmullrom;
    }
  }

  export motion guard for biped.BipedRig {
    duration = 1s; fps = 24; loop = loop;
    track left_arm.rotation {
      key 0s = (48deg, 26deg, -8deg) linear;
      key 0.5s = (52deg, 28deg, -8deg) linear;
      key 1s = (48deg, 26deg, -8deg) linear;
    }
    track right_arm.rotation {
      key 0s = (14deg, -8deg, 8deg) linear;
      key 0.5s = (16deg, -8deg, 8deg) linear;
      key 1s = (14deg, -8deg, 8deg) linear;
    }
    track torso.rotation {
      key 0s = (-4deg, -16deg, 0deg) linear;
      key 0.5s = (-6deg, -16deg, 0deg) linear;
      key 1s = (-4deg, -16deg, 0deg) linear;
    }
  }
}
