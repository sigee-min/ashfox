ashfox 1
module tail {
  export socket contract TailSocket {
  }

  export surface contract FoxPlumeTailSurface {
    chart base box { coverage = opaque; }
    chart mid box { coverage = opaque; }
    chart tip box { coverage = opaque; }
    chart tip_fine box { coverage = opaque; }
    chart plume flat { coverage = binary; }
    material = double;
  }

  export surface contract LionTailSurface {
    chart base box { coverage = opaque; }
    chart rise box { coverage = opaque; }
    chart tuft box { coverage = opaque; }
    material = double;
  }

  export component FoxPlumeTail {
    requires socket mount: TailSocket;
    requires surface skin: FoxPlumeTailSurface;
    bind socket mount to bone root {
      frame { origin = (0u, 0u, 0u); x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); }
    }
    geometry {
      bone root {
        cube base { origin = (-1.5u, -1.5u, 0u); size = (3u, 3u, 6u); pivot = (0u, 0u, 0u); rotation = (-12deg, 0deg, 0deg); surface = skin.base; }
        cube mid { origin = (-2.5u, -1.7u, 5u); size = (5u, 5u, 7u); pivot = (0u, 0.8u, 5.4u); rotation = (12deg, 0deg, 0deg); surface = skin.mid; }
        cube tip { origin = (-2u, 0.1u, 11.2u); size = (4u, 4u, 5u); pivot = (0u, 2.1u, 11.4u); rotation = (18deg, 0deg, 0deg); surface = skin.tip; }
        cube tip_fine { origin = (-1u, 2.3u, 15.2u); size = (2u, 2u, 3u); pivot = (0u, 3.3u, 15.4u); rotation = (22deg, 0deg, 0deg); surface = skin.tip_fine; }
        plane plume_l { origin = (-2.55u, -1.1u, 5.9u); size = (4u, 3u); u_axis = (0u, 0u, 1u); v_axis = (0u, 1u, 0u); rotation = (0deg, -14deg, 0deg); mirror_x = plume_r; surface = skin.plume; }
      }
    }
  }

  export component LionTuftTail {
    requires socket mount: TailSocket;
    requires surface skin: LionTailSurface;
    bind socket mount to bone root {
      frame { origin = (0u, 0u, 0u); x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); }
    }
    geometry {
      bone root {
        cube base { origin = (-1.5u, -1.5u, 0u); size = (3u, 3u, 9u); pivot = (0u, 0u, 0u); rotation = (-10deg, 0deg, 0deg); surface = skin.base; }
        cube rise { origin = (-1u, -1.5u, 8u); size = (2u, 5u, 2u); pivot = (0u, 0.5u, 9u); rotation = (18deg, 0deg, 0deg); surface = skin.rise; }
        cube tuft { origin = (-2u, 3.5u, 8u); size = (4u, 5u, 4u); surface = skin.tuft; }
      }
    }
  }
}
