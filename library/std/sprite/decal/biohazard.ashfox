ashfox 1
module biohazard {
  export material blood_crimson {
    ramp { mode = auto; base = #a62e3a; preset = vivid; }
  }
  export material dried_smear {
    ramp { mode = auto; base = #6e2c30; preset = warm; }
  }
  export material scorch_char {
    ramp { mode = auto; base = #524a48; preset = stone; }
  }
  export material acid_caustic {
    ramp { mode = auto; base = #6bc242; preset = organic; }
  }
  export material bile_glow {
    ramp { mode = auto; base = #8de352; preset = emissive; }
  }

  export mask blood_splatter {
    rows = [
      "...111....",
      ".111111...",
      "11111111..",
      "111111111.",
      ".1111111..",
      "..1111111.",
      "..111..11.",
      "...11....."
    ];
  }

  export mask handprint_smear {
    rows = [
      ".1.1.1.1..",
      ".1.1.1.1.1",
      ".111111111",
      ".11111111.",
      "..111111..",
      "..111111..",
      "..11111...",
      "...1111...",
      "...111...."
    ];
  }

  export mask scorch_mark {
    rows = [
      "...1111...",
      ".11111111.",
      "1111111111",
      "1111111111",
      "1111111111",
      ".11111111.",
      "..111111..",
      "...1111..."
    ];
  }

  export mask acid_stain {
    rows = [
      "..11111...",
      ".1111111..",
      "111111111.",
      "1111111111",
      ".11111111.",
      "..111111..",
      "...11.11.."
    ];
  }

  export stamp splatter_drops {
    rows = [
      ".d..",
      "dcc.",
      ".cc.",
      "...d"
    ];
    slots = [d, c];
  }

  export stamp smear_streak {
    rows = [
      "ss..",
      ".ss.",
      "..ss"
    ];
    slots = [s];
  }

  export stamp acid_bubbles {
    rows = [
      ".hh.",
      "hbbh",
      ".hh."
    ];
    slots = [h, b];
  }
}
