module signage {
  export material saferoom_amber {
    ramp { mode = auto; base = #e69c38; preset = warm; }
  }
  export material exit_emerald {
    ramp { mode = auto; base = #48c96b; preset = emissive; }
  }
  export material hazard_yellow {
    ramp { mode = auto; base = #ebc23d; preset = warm; }
  }
