ashfox 1
module caustic_pool {
  params {
    radius = 15u;
    duration = 1.15s;
    seed = 541;
  }

  export palette AcidCaustic {
    core = #f4ffdb;
    mid = #7ae038;
    edge = #2b7a1a;
    smoke = #1f2e1d;
  }

  export palette BileMist {
    core = #f2ffde;
    mid = #6cd442;
    edge = #246321;
    smoke = #1e2b1d;
  }

  export element acid_pool : ring {
    at = 0s..(duration * 0.88);
    blend = blend;
    radius = (radius * 0.2)..radius;
    segments = 24;
    ripple_amp = 0.36;
    ripple_freq = 6;
    color = mid;
    texture ring_wave { rings = 3; seed = seed; }
    dissolve voronoi { frames = 10; edge_glow = core; seed = seed; }
    scale = 0.25 -> 1.15 ease_out -> 0;
    alpha = 0.85 -> 0.7 -> 0;
  }

  export emitter caustic_bubbles : voxel_burst {
    at = 0.04s..(duration * 0.72);
    seed = seed;
    count = 24;
    shape = ring(radius * 0.65);
    particle = puff;
    speed = 4u..11u;
    life = 0.26s..0.5s;
    gravity = 8u;
    drag = 2.1;
    turbulence = curl(1.8, 5u);
    size_over_life = 0.8u -> 2.0u ease_out -> 0u;
    color_over_life = core -> mid -> edge -> smoke;
    blend = blend;
  }

  export element bile_ring : ring {
    at = 0s..0.72s;
    blend = premul;
    radius = 2u..(radius * 0.95);
    segments = 20;
    ripple_amp = 0.4;
    ripple_freq = 5;
    color = mid;
    texture stylized_smoke { curl_scale = 2.4; seed = seed + 5; }
    dissolve voronoi { frames = 8; edge_glow = core; seed = seed + 5; }
    scale = 0.3 -> 1.12 ease_out -> 0;
    alpha = 0.9 -> 0.55 -> 0;
  }

  export element bile_plume : dome {
    at = 0s..0.48s;
    blend = premul;
    shape = hemisphere;
    radius = radius * 0.55;
    subdiv = 1;
    color = core;
    texture radial_flare { spikes = 6; seed = seed + 11; posterize = 4; }
    dissolve radial_noise { frames = 6; edge_glow = core; seed = seed + 11; }
    scale = 0.25 -> 1.05 ease_out -> 0;
    alpha = 0.95 -> 0.7 -> 0;
  }

  export emitter bile_droplets : voxel_burst {
    at = 0s..0.52s;
    seed = seed + 17;
    count = 28;
    shape = cone(50deg, 2.5u);
    particle = shard;
    speed = 12u..24u;
    life = 0.2s..0.38s;
    gravity = -34u;
    drag = 1.5;
    ground { y = 0u; bounce = 24%; friction = 82%; }
    size_over_life = 1.0u -> 0u;
    color_over_life = core -> mid -> edge;
    velocity_stretch = 1.4;
    blend = premul;
  }

  export recipe CausticPuddle {
    duration = duration;
    fps = 30;
    loop = once;
    palette = AcidCaustic;
    element acid_pool : ring {
      at = 0s..(duration * 0.88);
      blend = blend;
      radius = (radius * 0.2)..radius;
      segments = 24;
      ripple_amp = 0.36;
      ripple_freq = 6;
      color = mid;
      texture ring_wave { rings = 3; seed = seed; }
      dissolve voronoi { frames = 10; edge_glow = core; seed = seed; }
      scale = 0.25 -> 1.15 ease_out -> 0;
      alpha = 0.85 -> 0.7 -> 0;
    }
    emitter caustic_bubbles : voxel_burst {
      at = 0.04s..(duration * 0.72);
      seed = seed;
      count = 24;
      shape = ring(radius * 0.65);
      particle = puff;
      speed = 4u..11u;
      life = 0.26s..0.5s;
      gravity = 8u;
      drag = 2.1;
      turbulence = curl(1.8, 5u);
      size_over_life = 0.8u -> 2.0u ease_out -> 0u;
      color_over_life = core -> mid -> edge -> smoke;
      blend = blend;
    }
  }

  export recipe BileSplash {
    duration = 0.85s;
    fps = 30;
    loop = once;
    palette = BileMist;
    element bile_plume : dome {
      at = 0s..0.48s;
      blend = premul;
      shape = hemisphere;
      radius = radius * 0.55;
      subdiv = 1;
      color = core;
      texture radial_flare { spikes = 6; seed = seed + 11; posterize = 4; }
      dissolve radial_noise { frames = 6; edge_glow = core; seed = seed + 11; }
      scale = 0.25 -> 1.05 ease_out -> 0;
      alpha = 0.95 -> 0.7 -> 0;
    }
    element bile_ring : ring {
      at = 0s..0.72s;
      blend = premul;
      radius = 2u..(radius * 0.95);
      segments = 20;
      ripple_amp = 0.4;
      ripple_freq = 5;
      color = mid;
      texture stylized_smoke { curl_scale = 2.4; seed = seed + 5; }
      dissolve voronoi { frames = 8; edge_glow = core; seed = seed + 5; }
      scale = 0.3 -> 1.12 ease_out -> 0;
      alpha = 0.9 -> 0.55 -> 0;
    }
    emitter bile_droplets : voxel_burst {
      at = 0s..0.52s;
      seed = seed + 17;
      count = 28;
      shape = cone(50deg, 2.5u);
      particle = shard;
      speed = 12u..24u;
      life = 0.2s..0.38s;
      gravity = -34u;
      drag = 1.5;
      ground { y = 0u; bounce = 24%; friction = 82%; }
      size_over_life = 1.0u -> 0u;
      color_over_life = core -> mid -> edge;
      velocity_stretch = 1.4;
      blend = premul;
    }
  }
}
