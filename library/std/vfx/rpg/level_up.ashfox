ashfox 1
module level_up {
  params {
    radius = 12u;
    height = 36u;
    duration = 1.0s;
    seed = 487;
  }

  export palette AscensionGold {
    core = #fffbe6;
    mid = #f2c44d;
    edge = #9e651c;
    smoke = #362e24;
  }

  export palette RadiantCyan {
    core = #ebffff;
    mid = #52dede;
    edge = #236399;
    smoke = #1f2e42;
  }

  export palette ValorEmerald {
    core = #ebffef;
    mid = #59e388;
    edge = #1f7d47;
    smoke = #1b3328;
  }

  export element pillar_beam : beam {
    at = 0s..(duration * 0.88);
    blend = additive;
    start = (0u, 0u, 0u);
    end = (0u, height, 0u);
    width = 5u;
    style = column;
    seed = seed;
    color = core;
    texture slash_streak { bristles = 42%; seed = seed; posterize = 4; }
    dissolve directional_wipe { frames = 8; edge_glow = core; seed = seed; }
    scale = 0.5 -> 1.15 ease_out -> 0;
    alpha = 0.4 -> 1.0 -> 0;
  }

  export element halo_ring : ring {
    at = 0.04s..(duration * 0.85);
    blend = additive;
    radius = (radius * 0.3)..radius;
    segments = 24;
    bevel = 0.4;
    color = mid;
    spin = 180deg;
    texture magic_circle { runes = 10; rings = 2; seed = seed + 3; }
    dissolve radial_noise { frames = 8; edge_glow = core; seed = seed + 3; }
    scale = 0.35 -> 1.15 ease_out -> 0;
    alpha = 0.85 -> 0.5 -> 0;
  }

  export emitter rising_sparks : voxel_burst {
    at = 0.04s..(duration * 0.72);
    seed = seed;
    count = 24;
    shape = ring(radius * 0.65);
    particle = cross_card;
    speed = 10u..22u;
    life = 0.24s..0.45s;
    gravity = 16u;
    drag = 1.8;
    vortex { axis = (0, 1, 0); center = (0u, height * 0.4, 0u); strength = 6; }
    size_over_life = 0.95u -> 0u;
    color_over_life = core -> mid -> edge;
    blend = additive;
  }

  export recipe LevelUpPillar {
    duration = duration;
    fps = 30;
    loop = once;
    palette = AscensionGold;
    element pillar_beam : beam {
      at = 0s..(duration * 0.88);
      blend = additive;
      start = (0u, 0u, 0u);
      end = (0u, height, 0u);
      width = 5u;
      style = column;
      seed = seed;
      color = core;
      texture slash_streak { bristles = 42%; seed = seed; posterize = 4; }
      dissolve directional_wipe { frames = 8; edge_glow = core; seed = seed; }
      scale = 0.5 -> 1.15 ease_out -> 0;
      alpha = 0.4 -> 1.0 -> 0;
    }
    element halo_ring : ring {
      at = 0.04s..(duration * 0.85);
      blend = additive;
      radius = (radius * 0.3)..radius;
      segments = 24;
      bevel = 0.4;
      color = mid;
      spin = 180deg;
      texture magic_circle { runes = 10; rings = 2; seed = seed + 3; }
      dissolve radial_noise { frames = 8; edge_glow = core; seed = seed + 3; }
      scale = 0.35 -> 1.15 ease_out -> 0;
      alpha = 0.85 -> 0.5 -> 0;
    }
    emitter rising_sparks : voxel_burst {
      at = 0.04s..(duration * 0.72);
      seed = seed;
      count = 24;
      shape = ring(radius * 0.65);
      particle = cross_card;
      speed = 10u..22u;
      life = 0.24s..0.45s;
      gravity = 16u;
      drag = 1.8;
      vortex { axis = (0, 1, 0); center = (0u, height * 0.4, 0u); strength = 6; }
      size_over_life = 0.95u -> 0u;
      color_over_life = core -> mid -> edge;
      blend = additive;
    }
  }
}
