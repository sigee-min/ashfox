ashfox 1
module skill_nova {
  params {
    radius = 16u;
    height = 36u;
    duration = 0.95s;
    seed = 613;
  }

  export palette MeteorCrimson {
    core = #fff6d9;
    mid = #ff7d26;
    edge = #a82214;
    smoke = #362522;
  }

  export palette GlacialStorm {
    core = #f0fdff;
    mid = #6bc7f5;
    edge = #2b59a8;
    smoke = #1f2b40;
  }

  export palette ArcaneNova {
    core = #faf0ff;
    mid = #c76bf5;
    edge = #6228a8;
    smoke = #281e38;
  }

  export element meteor_streak : beam {
    at = 0s..(duration * 0.42);
    blend = additive;
    start = (8u, height, -6u);
    end = (0u, 0u, 0u);
    width = 5.5u;
    style = column;
    seed = seed;
    color = core;
    texture slash_streak { bristles = 45%; seed = seed; posterize = 4; }
    dissolve directional_wipe { frames = 8; edge_glow = core; seed = seed; }
    scale = 0.7 -> 1.15 ease_out -> 0;
    alpha = 0.8 -> 1.0 snap -> 0;
  }

  export element impact_dome : dome {
    at = (duration * 0.24)..(duration * 0.85);
    blend = additive;
    shape = hemisphere;
    radius = radius;
    subdiv = 1;
    color = core;
    texture radial_flare { spikes = 8; seed = seed + 3; posterize = 4; }
    dissolve radial_noise { frames = 8; edge_glow = core; seed = seed + 3; }
    scale = 0.25 -> 1.2 ease_out -> 0;
    alpha = 0.9 -> 1.0 snap -> 0;
  }

  export emitter meteor_debris : voxel_burst {
    at = (duration * 0.26)..(duration * 0.78);
    seed = seed;
    count = 32;
    shape = sphere(radius * 0.25);
    particle = shard;
    speed = 18u..36u;
    life = 0.22s..0.46s;
    gravity = -26u;
    drag = 1.4;
    ground { y = 0u; bounce = 42%; friction = 70%; }
    size_over_life = 1.15u -> 0u;
    color_over_life = core -> mid -> edge;
    velocity_stretch = 1.5;
    blend = additive;
  }

  export element blizzard_sigil : ring {
    at = 0s..(duration * 0.92);
    blend = additive;
    radius = (radius * 0.25)..radius;
    segments = 24;
    bevel = 0.35;
    color = mid;
    spin = 180deg;
    texture magic_circle { runes = 12; rings = 3; seed = seed + 7; }
    dissolve voronoi { frames = 8; edge_glow = core; seed = seed + 7; }
    scale = 0.4 -> 1.12 ease_out -> 0;
    alpha = 0.5 -> 0.95 -> 0;
  }

  export element blizzard_cyclone : dome {
    at = 0.06s..(duration * 0.88);
    blend = blend;
    shape = cone;
    radius = radius * 0.72;
    height = height * 0.65;
    subdiv = 1;
    color = mid;
    spin = -240deg;
    texture stylized_smoke { curl_scale = 2.4; seed = seed + 11; }
    dissolve radial_noise { frames = 8; edge_glow = core; seed = seed + 11; }
    scale = 0.45 -> 1.08 ease_out -> 0;
    alpha = 0.65 -> 0.45 -> 0;
  }

  export emitter frost_vortex : voxel_burst {
    at = 0.04s..(duration * 0.8);
    seed = seed + 13;
    count = 30;
    shape = ring(radius * 0.75);
    particle = shard;
    speed = 8u..18u;
    life = 0.26s..0.52s;
    gravity = -8u;
    drag = 1.8;
    vortex { axis = (0, 1, 0); center = (0u, height * 0.3, 0u); strength = 8; }
    turbulence = curl(1.8, 6u);
    size_over_life = 1.0u -> 0u;
    color_over_life = core -> mid -> edge;
    blend = additive;
  }

  export recipe MeteorDrop {
    duration = duration;
    fps = 30;
    loop = once;
    palette = MeteorCrimson;
    element meteor_streak : beam {
      at = 0s..(duration * 0.42);
      blend = additive;
      start = (8u, height, -6u);
      end = (0u, 0u, 0u);
      width = 5.5u;
      style = column;
      seed = seed;
      color = core;
      texture slash_streak { bristles = 45%; seed = seed; posterize = 4; }
      dissolve directional_wipe { frames = 8; edge_glow = core; seed = seed; }
      scale = 0.7 -> 1.15 ease_out -> 0;
      alpha = 0.8 -> 1.0 snap -> 0;
    }
    element impact_dome : dome {
      at = (duration * 0.24)..(duration * 0.85);
      blend = additive;
      shape = hemisphere;
      radius = radius;
      subdiv = 1;
      color = core;
      texture radial_flare { spikes = 8; seed = seed + 3; posterize = 4; }
      dissolve radial_noise { frames = 8; edge_glow = core; seed = seed + 3; }
      scale = 0.25 -> 1.2 ease_out -> 0;
      alpha = 0.9 -> 1.0 snap -> 0;
    }
    emitter meteor_debris : voxel_burst {
      at = (duration * 0.26)..(duration * 0.78);
      seed = seed;
      count = 32;
      shape = sphere(radius * 0.25);
      particle = shard;
      speed = 18u..36u;
      life = 0.22s..0.46s;
      gravity = -26u;
      drag = 1.4;
      ground { y = 0u; bounce = 42%; friction = 70%; }
      size_over_life = 1.15u -> 0u;
      color_over_life = core -> mid -> edge;
      velocity_stretch = 1.5;
      blend = additive;
    }
  }

  export recipe BlizzardField {
    duration = 1.1s;
    fps = 30;
    loop = once;
    palette = GlacialStorm;
    element blizzard_sigil : ring {
      at = 0s..1.0s;
      blend = additive;
      radius = (radius * 0.25)..radius;
      segments = 24;
      bevel = 0.35;
      color = mid;
      spin = 180deg;
      texture magic_circle { runes = 12; rings = 3; seed = seed + 7; }
      dissolve voronoi { frames = 8; edge_glow = core; seed = seed + 7; }
      scale = 0.4 -> 1.12 ease_out -> 0;
      alpha = 0.5 -> 0.95 -> 0;
    }
    element blizzard_cyclone : dome {
      at = 0.06s..0.95s;
      blend = blend;
      shape = cone;
      radius = radius * 0.72;
      height = height * 0.65;
      subdiv = 1;
      color = mid;
      spin = -240deg;
      texture stylized_smoke { curl_scale = 2.4; seed = seed + 11; }
      dissolve radial_noise { frames = 8; edge_glow = core; seed = seed + 11; }
      scale = 0.45 -> 1.08 ease_out -> 0;
      alpha = 0.65 -> 0.45 -> 0;
    }
    emitter frost_vortex : voxel_burst {
      at = 0.04s..0.88s;
      seed = seed + 13;
      count = 30;
      shape = ring(radius * 0.75);
      particle = shard;
      speed = 8u..18u;
      life = 0.26s..0.52s;
      gravity = -8u;
      drag = 1.8;
      vortex { axis = (0, 1, 0); center = (0u, height * 0.3, 0u); strength = 8; }
      turbulence = curl(1.8, 6u);
      size_over_life = 1.0u -> 0u;
      color_over_life = core -> mid -> edge;
      blend = additive;
    }
  }
}
