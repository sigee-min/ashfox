ashfox 1
module plasma_bolt {
  params {
    scale = 1;
    duration = 0.45s;
    seed = 91;
  }

  export palette PlasmaCyan {
    core = #ebffff;
    mid = #3dd4ff;
    edge = #1c5cbf;
    smoke = #1d2a40;
  }

  export palette PlasmaGreen {
    core = #eeffe8;
    mid = #52e868;
    edge = #1c7a38;
    smoke = #1f3326;
  }

  export element bolt_core : dome {
    at = 0s..(duration * 0.82);
    blend = additive;
    shape = sphere;
    radius = 3.5u * scale;
    subdiv = 2;
    color = core;
    texture radial_flare { spikes = 6; seed = seed; }
    dissolve radial_noise { frames = 8; edge_glow = core; seed = seed; }
    scale = 0.5 -> 1.15 ease_out -> 0;
    alpha = 0.6 -> 1.0 snap -> 0;
  }

  export element containment_ring : ring {
    at = 0.03s..(duration * 0.78);
    blend = additive;
    radius = (2.2u * scale)..(6.2u * scale);
    segments = 16;
    ripple_amp = 0.35;
    ripple_freq = 4;
    color = mid;
    spin = 240deg;
    texture ring_wave { rings = 3; seed = seed + 7; }
    scale = 0.4 -> 1.2 ease_out -> 0;
    alpha = 0.85 -> 0.4 -> 0;
  }

  export emitter ion_tail : voxel_burst {
    at = 0s..(duration * 0.6);
    seed = seed;
    count = 20;
    shape = sphere(3u);
    particle = cross_card;
    speed = 8u..18u;
    life = 0.14s..0.28s;
    gravity = 0u;
    drag = 2.0;
    turbulence = curl(2.2, 4u);
    size_over_life = (1.1u * scale) -> 0u;
    color_over_life = core -> mid -> edge;
    blend = additive;
  }

  export recipe PlasmaBolt {
    duration = duration;
    fps = 30;
    loop = once;
    palette = PlasmaCyan;
    element bolt_core : dome {
      at = 0s..(duration * 0.82);
      blend = additive;
      shape = sphere;
      radius = 3.5u * scale;
      subdiv = 2;
      color = core;
      texture radial_flare { spikes = 6; seed = seed; }
      dissolve radial_noise { frames = 8; edge_glow = core; seed = seed; }
      scale = 0.5 -> 1.15 ease_out -> 0;
      alpha = 0.6 -> 1.0 snap -> 0;
    }
    element containment_ring : ring {
      at = 0.03s..(duration * 0.78);
      blend = additive;
      radius = (2.2u * scale)..(6.2u * scale);
      segments = 16;
      ripple_amp = 0.35;
      ripple_freq = 4;
      color = mid;
      spin = 240deg;
      texture ring_wave { rings = 3; seed = seed + 7; }
      scale = 0.4 -> 1.2 ease_out -> 0;
      alpha = 0.85 -> 0.4 -> 0;
    }
    emitter ion_tail : voxel_burst {
      at = 0s..(duration * 0.6);
      seed = seed;
      count = 20;
      shape = sphere(3u);
      particle = cross_card;
      speed = 8u..18u;
      life = 0.14s..0.28s;
      gravity = 0u;
      drag = 2.0;
      turbulence = curl(2.2, 4u);
      size_over_life = (1.1u * scale) -> 0u;
      color_over_life = core -> mid -> edge;
      blend = additive;
    }
  }
}
