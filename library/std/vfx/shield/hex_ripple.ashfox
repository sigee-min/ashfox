ashfox 1
module hex_ripple {
  params {
    radius = 12u;
    duration = 0.55s;
    seed = 109;
  }

  export palette AegisCyan {
    core = #ebffff;
    mid = #48d1f0;
    edge = #1e62a8;
    smoke = #1b2c42;
  }

  export palette BarrierGold {
    core = #fff9db;
    mid = #f0be4d;
    edge = #9e621c;
    smoke = #362c22;
  }

  export element hex_dome : dome {
    at = 0s..(duration * 0.88);
    blend = additive;
    shape = hemisphere;
    radius = radius;
    subdiv = 2;
    color = mid;
    texture magic_circle { runes = 6; rings = 3; seed = seed; posterize = 5; }
    dissolve voronoi { frames = 10; edge_glow = core; seed = seed; }
    scale = 0.85 -> 1.05 ease_out -> 0;
    alpha = 0.2 -> 1.0 snap -> 0;
  }

  export element impact_ripple : ring {
    at = 0.04s..(duration * 0.82);
    blend = additive;
    radius = (radius * 0.25)..(radius * 0.95);
    segments = 6;
    bevel = 0.4;
    color = core;
    texture ring_wave { rings = 4; seed = seed + 5; }
    scale = 0.3 -> 1.15 ease_out -> 0;
    alpha = 0.95 -> 0.45 -> 0;
  }

  export emitter grid_sparks : voxel_burst {
    at = 0.04s..(duration * 0.55);
    seed = seed;
    count = 16;
    shape = ring(radius * 0.6);
    particle = shard;
    speed = 6u..14u;
    life = 0.16s..0.3s;
    gravity = 0u;
    drag = 2.4;
    size_over_life = 0.85u -> 0u;
    color_over_life = core -> mid -> edge;
    blend = additive;
  }

  export recipe HexRipple {
    duration = duration;
    fps = 30;
    loop = once;
    palette = AegisCyan;
    element hex_dome : dome {
      at = 0s..(duration * 0.88);
      blend = additive;
      shape = hemisphere;
      radius = radius;
      subdiv = 2;
      color = mid;
      texture magic_circle { runes = 6; rings = 3; seed = seed; posterize = 5; }
      dissolve voronoi { frames = 10; edge_glow = core; seed = seed; }
      scale = 0.85 -> 1.05 ease_out -> 0;
      alpha = 0.2 -> 1.0 snap -> 0;
    }
    element impact_ripple : ring {
      at = 0.04s..(duration * 0.82);
      blend = additive;
      radius = (radius * 0.25)..(radius * 0.95);
      segments = 6;
      bevel = 0.4;
      color = core;
      texture ring_wave { rings = 4; seed = seed + 5; }
      scale = 0.3 -> 1.15 ease_out -> 0;
      alpha = 0.95 -> 0.45 -> 0;
    }
    emitter grid_sparks : voxel_burst {
      at = 0.04s..(duration * 0.55);
      seed = seed;
      count = 16;
      shape = ring(radius * 0.6);
      particle = shard;
      speed = 6u..14u;
      life = 0.16s..0.3s;
      gravity = 0u;
      drag = 2.4;
      size_over_life = 0.85u -> 0u;
      color_over_life = core -> mid -> edge;
      blend = additive;
    }
  }
}
