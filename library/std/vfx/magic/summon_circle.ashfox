ashfox 1
module summon_circle {
  params {
    radius = 16u;
    runes = 12;
    duration = 1.1s;
    seed = 251;
  }

  export palette EldritchViolet {
    core = #faeaff;
    mid = #c468f2;
    edge = #6328a3;
    smoke = #2a1c40;
  }

  export palette CelestialGold {
    core = #fffbe6;
    mid = #f0c248;
    edge = #99621a;
    smoke = #362c21;
  }

  export element sigil_ring : ring {
    at = 0s..(duration * 0.92);
    blend = additive;
    radius = (radius * 0.2)..radius;
    segments = 24;
    bevel = 0.35;
    color = mid;
    spin = 120deg;
    texture magic_circle { runes = runes; rings = 3; seed = seed; }
    dissolve radial_noise { frames = 10; edge_glow = core; seed = seed; }
    scale = 0.3 -> 1.08 ease_out -> 0;
    alpha = 0.4 -> 1.0 -> 0;
  }

  export element pillar_glow : dome {
    at = (duration * 0.15)..(duration * 0.85);
    blend = additive;
    shape = cone;
    radius = radius * 0.55;
    height = radius * 1.4;
    subdiv = 1;
    color = core;
    texture radial_flare { spikes = 6; seed = seed + 5; }
    scale = 0.4 -> 1.0 ease_out -> 0;
    alpha = 0.2 -> 0.9 -> 0;
  }

  export emitter rising_runes : voxel_burst {
    at = 0.1s..(duration * 0.72);
    seed = seed;
    count = 24;
    shape = ring(radius * 0.75);
    particle = cross_card;
    speed = 8u..16u;
    life = 0.28s..0.48s;
    gravity = 14u;
    drag = 1.8;
    vortex { axis = (0, 1, 0); center = (0u, 8u, 0u); strength = 5; }
    size_over_life = 1.0u -> 0u;
    color_over_life = core -> mid -> edge;
    blend = additive;
  }

  export recipe SummonCircle {
    duration = duration;
    fps = 30;
    loop = once;
    palette = EldritchViolet;
    element sigil_ring : ring {
      at = 0s..(duration * 0.92);
      blend = additive;
      radius = (radius * 0.2)..radius;
      segments = 24;
      bevel = 0.35;
      color = mid;
      spin = 120deg;
      texture magic_circle { runes = runes; rings = 3; seed = seed; }
      dissolve radial_noise { frames = 10; edge_glow = core; seed = seed; }
      scale = 0.3 -> 1.08 ease_out -> 0;
      alpha = 0.4 -> 1.0 -> 0;
    }
    element pillar_glow : dome {
      at = (duration * 0.15)..(duration * 0.85);
      blend = additive;
      shape = cone;
      radius = radius * 0.55;
      height = radius * 1.4;
      subdiv = 1;
      color = core;
      texture radial_flare { spikes = 6; seed = seed + 5; }
      scale = 0.4 -> 1.0 ease_out -> 0;
      alpha = 0.2 -> 0.9 -> 0;
    }
    emitter rising_runes : voxel_burst {
      at = 0.1s..(duration * 0.72);
      seed = seed;
      count = 24;
      shape = ring(radius * 0.75);
      particle = cross_card;
      speed = 8u..16u;
      life = 0.28s..0.48s;
      gravity = 14u;
      drag = 1.8;
      vortex { axis = (0, 1, 0); center = (0u, 8u, 0u); strength = 5; }
      size_over_life = 1.0u -> 0u;
      color_over_life = core -> mid -> edge;
      blend = additive;
    }
  }
}
