ashfox 1
module loot {
  export schema LootChest : anchor {
    field table : string;
    field tier : enum(common, uncommon, rare, epic, mythic) = common;
    field min_rolls : int(1..16) = 1;
    field max_rolls : int(1..32) = 3;
    field facing : enum(north, south, east, west) = south;
    field locked : bool = false;
    mc_block = "minecraft:chest[facing=${facing}]";
  }

  export schema ItemDrop : anchor {
    field item_id : string;
    field chance : float(0..1) = 0.5;
    field count : int(1..64) = 1;
    field offset : vec3 = (0, 0.25, 0);
  }

  export schema HarvestingNode : anchor {
    field resource : enum(ore, herb, timber, crystal, relic) = ore;
    field tool_tier : int(0..5) = 1;
    field respawn : second = 180s;
    field prefab_id : string = "";
  }

  export schema DropTableMeta : meta {
    field table_id : string;
    field luck_bonus : float(0..5) = 0.2;
    field unique_once : bool = false;
  }
}
