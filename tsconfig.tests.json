{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "noEmit": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "jsx": "react-jsx"
  },
  "include": [
    "apps/web/src/**/*.d.ts",
    "apps/web/tests/**/*.ts",
    "packages/blockbench-conformance/tests/**/*.ts",
    "packages/blockbench-runtime/tests/**/*.ts",
    "packages/engine-core/tests/**/*.ts",
    "packages/audio-core/tests/**/*.ts"
  ]
}
