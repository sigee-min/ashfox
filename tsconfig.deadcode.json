{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "noEmit": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "jsx": "react-jsx"
  },
  "include": [
    "apps/blockbench-mcp-sidecar/src/**/*.ts",
    "apps/blockbench-plugin/src/**/*.ts",
    "apps/web/src/**/*.ts",
    "apps/web/src/**/*.tsx",
    "apps/web/tests/**/*.ts",
    "packages/blockbench-conformance/tests/**/*.ts",
    "packages/blockbench-contracts/src/**/*.ts",
    "packages/blockbench-runtime/src/**/*.ts",
    "packages/blockbench-runtime/tests/**/*.ts",
    "packages/engine-core/src/**/*.ts",
    "packages/engine-core/tests/**/*.ts",
    "packages/internal-contracts/src/**/*.ts",
    "apps/cli/src/**/*.ts",
    "packages/asset-build/src/**/*.ts",
    "packages/audio-core/src/**/*.ts",
    "packages/audio-core/tests/**/*.ts",
    "packages/render-core/src/**/*.ts"
  ]
}
