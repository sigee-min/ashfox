ashfox 1
structure tavern {
  import "std/structure/arch/medieval" as arch;
  import "std/structure/interior/tavern" as tavern_kit;
  import "std/structure/furnish/seating" as seat;
  import "std/structure/furnish/lighting" as light;
  import "std/core/hook/world" as world;
  import "std/core/hook/loot" as loot;
  import "../models/wall_lantern.ashfox" as custom_lantern;

  density = 2;
  seed = 404;
  size = (19b, 22b, 17b);
  data_version = 3955;

  params {
    w = 19;
    d = 17;
  }

  outputs = [java_structure, glb];

  preview exterior { sheet = exterior; }
  preview cutaway { sheet = cutaway; }
  preview interior { sheet = interior; }

  palette {
    moss_stone = "minecraft:mossy_stone_bricks";
    stone_brick = mix("minecraft:stone_bricks" * 75%, "minecraft:mossy_stone_bricks" * 15%, "minecraft:cracked_stone_bricks" * 10%);
    plaster = mix("minecraft:white_terracotta" * 85%, "minecraft:calcite" * 15%);
    timber = "minecraft:dark_oak_log[axis=y]";
    beam = "minecraft:dark_oak_log[axis=x]";
    oak_floor = "minecraft:oak_planks";
    spruce_plank = "minecraft:spruce_planks";
    roof_stair = "minecraft:dark_oak_stairs";
    trim_stair = "minecraft:spruce_stairs";
    ridge = "minecraft:dark_oak_slab[type=bottom]";
    porch_stair = "minecraft:stone_brick_stairs[facing=north,half=bottom]";
    oak_stair = "minecraft:oak_stairs";
    fence = "minecraft:dark_oak_fence";
    glass = "minecraft:glass_pane";
    sill = "minecraft:spruce_slab[type=top]";
    shutter = "minecraft:spruce_trapdoor[facing=south,half=bottom,open=true]";
    door = "minecraft:dark_oak_door[facing=north,half=lower,hinge=left,open=false]";
    chimney_brick = "minecraft:bricks";
    hang_lantern = "minecraft:lantern[hanging=true]";
    lantern = asset(custom_lantern, "minecraft:lantern[hanging=false]");
  }

  floor ground {
    y = 0b;
    height = 5b;
    room taproom {
      from = (1b, 1b); size = (15b, 9b); kind = tavern; plinth = stone_brick; floor = oak_floor; wall = plaster; frame = timber; ceiling = spruce_plank;
      interior {
        dna { arch = rustic; mood = warm_hearth; }
        architecture { floor_pattern = herringbone; baseboard = trim; wainscot = paneled; ceiling = beamed; }
        platform bar_stage {
          on = nw; size = (4, 3); height = 0.25; step_facing = south;
          l_counter bar_counter { length = 4; }
        }
        alcove hearth_niche { kind = fireplace; wall = north; at = 7; width = 3; height = 3; }
        wall_line {
          on = east;
          barrel_rack { size = (2, 1); }
          shelving { size = (2, 1); }
        }
        centerpiece {
          on = sw;
          dining_set feast_table { seats = 4; }
          story tavern_meal { on = feast_table; }
        }
        drapery curtains { on = windows; tieback = true; color = "#8b2d2d"; }
        drapery banner { kind = banner; on = ceiling_span; color = "#c8963e"; }
        lighting { bounces = 2; ambient_floor = 0.14; stained_glass_boost = 1.35; }
        sun_shaft { enabled = true; sun_dir = (0.35, -0.72, 0.58); intensity = 0.48; shaft_length = 5.5; }
      }
    }
    room snug { from = (8b, 9b); size = (8b, 4b); kind = living; plinth = stone_brick; floor = oak_floor; wall = plaster; frame = timber; ceiling = spruce_plank; }
    facade taproom.south {
      door {
        at = 2b; width = 2b; height = 2b; block = door; hinge = left; frame = timber; lintel = beam;
        porch { depth = 2; floor = stone_brick; pillars = timber; lamps = lantern; steps = porch_stair; }
      }
      arch { at = 8b; width = 2b; height = 3b; frame = timber; lintel = beam; }
    }
    facade snug.south {
      bay_window { at = center; width = 3b; height = 2b; y_offset = 1b; glass = glass; frame = timber; sill = sill; lintel = roof_stair; stained_glass_color = "#e8a84a"; }
    }
    facade facade_1 {
      on = [taproom.north, taproom.east, taproom.west];
      window { symmetric = 1b; width = 2b; height = 2b; y_offset = 1b; glass = glass; recess = 1b; sill = sill; shutter = shutter; lintel = beam; }
    }
    facade snug.east {
      window { at = center; width = 2b; height = 2b; y_offset = 1b; glass = glass; sill = sill; shutter = shutter; lintel = beam; }
    }
  }

  floor upper {
    y = 5b;
    height = 4b;
    jetty_s = 1b;
    jetty_e = 1b;
    room inn_hall { from = (1b, 1b); size = (15b, 9b); kind = hallway; floor = oak_floor; wall = plaster; frame = timber; ceiling = spruce_plank; }
    room inn_suite {
      from = (8b, 9b); size = (8b, 4b); kind = bedroom; floor = oak_floor; wall = plaster; frame = timber; ceiling = spruce_plank;
      interior {
        dna { arch = rustic; mood = warm_hearth; }
        architecture { floor_pattern = plank; baseboard = trim; wainscot = paneled; ceiling = open_truss; }
        alcove alcove_1 { kind = display; wall = north; width = 2; height = 2; }
        wall_line {
          on = west;
          cabinet { size = (2, 1); }
        }
        centerpiece {
          on = south;
          table suite_table { size = (2, 1); }
          chair { on = east; }
          story scholar_study { on = suite_table; }
        }
        drapery curtains { on = windows; tieback = true; color = "#7c2d2d"; }
        lighting { bounces = 2; ambient_floor = 0.14; stained_glass_boost = 1.3; }
        sun_shaft { enabled = true; sun_dir = (-0.42, -0.72, -0.55); intensity = 0.45; shaft_length = 4.5; }
      }
    }
    facade inn_hall.south { arch { at = 8b; width = 2b; height = 3b; frame = timber; lintel = beam; } }
    facade inn_hall.north { window { symmetric = 2b; width = 2b; height = 2b; y_offset = 1b; glass = glass; sill = sill; shutter = shutter; lintel = beam; } }
    facade inn_suite.south { bay_window { at = center; width = 3b; height = 2b; y_offset = 1b; glass = glass; frame = timber; sill = sill; lintel = roof_stair; } }
    facade inn_suite.east { window { at = center; width = 2b; height = 2b; y_offset = 1b; glass = glass; sill = sill; shutter = shutter; lintel = beam; } }
  }

  staircase { in_room = taproom; style = u_turn; at = (11b, 3b); y_from = 0b; y_to = 5b; facing = west; width = 1b; stair = oak_stair; landing = oak_floor; rail = fence; headroom = 3b; }

  roof {
    on = inn_hall; style = gable; axis = x; overhang = 1b; pitch = standard; stair = roof_stair; trim = trim_stair; ridge = ridge; gable = plaster; under_eave = true;
    chimney { room = taproom; corner = nw; offset = (1b, 1b); width = 2b; rise = 2b; block = chimney_brick; cap = true; }
  }
  roof {
    on = inn_suite; style = gable; axis = z; overhang = 1b; pitch = standard; stair = roof_stair; trim = trim_stair; ridge = ridge; gable = plaster; under_eave = true;
    dormer { wall = east; offset = 0b; width = 3b; height = 3b; window = glass; }
  }

  furnish taproom { hang { block = hang_lantern; at = ceiling_center; drop = 1b; } }
  furnish snug {
    place_anchor { prefab = seat.HearthBench; on = se; offset = (0b, 0b); rotate = 0; }
    hang { block = hang_lantern; at = ceiling_center; drop = 1b; }
  }
  furnish inn_hall {
    place_anchor { prefab = tavern_kit.TavernBar; on = ne; offset = (0b, 0b); rotate = 0; }
    hang { block = hang_lantern; at = ceiling_center; drop = 1b; }
  }
  furnish inn_suite { hang { block = hang_lantern; at = ceiling_center; drop = 1b; } }

  weathering {
    ground_moss { height = 2b; target = stone_brick; into = moss_stone; rate = 35%; }
    corner_quoin { target = plaster; corners = stone_brick; }
    chimney_soot { radius = 2b; rate = 45%; }
  }

  box { from = (16b, 0b, 12b); to = (18b, 0b, 14b); block = stone_brick; }
  box { from = (1b, 0b, 10b); to = (3b, 0b, 13b); block = stone_brick; }
  place arch.CobbleWell { at = (16b, 1b, 12b); rotate = 0; }
  place light.LanternPost { at = (2b, 1b, 12b); rotate = 0; }

  anchor tavern_entry : std.entry { at = (8b, 1b, 9b); facing = south; pool = "ashfox:streets"; target = "road_join"; }
  anchor east_lane : std.road { at = (18b, 0b, 8b); facing = east; pool = "ashfox:streets"; target = "road_join"; }
  anchor cellar_portal : world.PortalGate { room = taproom; at = (3b, 1b, 11b); facing = south; target_world = "overworld"; destination = "tavern_interior"; }
  anchor cellar_stash : loot.LootChest { room = snug; at = (13b, 1b, 11b); facing = north; tier = uncommon; table = "ashfox:tavern/stash"; }
  zone tavern_safe : world.SafeZone { from = (1b, 1b, 1b); to = (16b, 9b, 13b); pvp_disabled = true; regen_rate = 1.0; label = "Hearth Tavern"; }
}
