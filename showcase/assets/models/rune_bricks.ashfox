ashfox 1
model rune_bricks {
  import "std/core/palette/medieval" as med;
  import "std/core/palette/element" as elem;
  import "std/core/material/stone" as stone;
  import "std/core/hook/loot" as loot_hook;

  rig contract BlockRig {
    joint root { parent = none; role = root; channels = rotation; }
  }

  skeleton BlockSkeleton implements BlockRig {
    bind root { parent_origin = (0u, 0u, 0u); }
  }

  surface contract BrickBlock {
    chart block box { coverage = opaque; }
    material = opaque;
  }

  surface mossy_rune_bricks: BrickBlock {
    material = opaque;
    texture atlas {
      density = 1;
      background = mortar; background_alpha = 255;
      palette {
        mortar = (med.CastleStone.slate_shadow, med.CastleStone.slate_base, med.CastleStone.slate_light);
        slate = (stone.StoneParams.basalt_shadow, stone.StoneParams.basalt_base, stone.StoneParams.basalt_light);
        limestone = (med.CastleStone.limestone_shadow, med.CastleStone.limestone_base, med.CastleStone.limestone_light);
        moss = (#40613f, med.CastleStone.moss_accent, #97c47a);
        rune = (elem.ArcanePalette.void_edge, elem.ArcanePalette.ether_mid, elem.ArcanePalette.glyph_core);
      }
      stamp rune_mark { pixels = ".rrr./r...r/.rrr./r...r/.rrr."; r = rune; }
      stamp masonry_crack { pixels = "m..../mm.../..mm./...mm"; m = mortar; }
      stamp moss_clump { pixels = ".ggg./ggggg/g.gg./..g.."; g = moss; }

      chart block box {
        fill = slate; roughness = 0.84; metallic = 0.0; roughness_variation = 0.10; grain = clustered;
        pattern stripe { paint = limestone; axis = y; period = 5px; width = 1px; phase = 0; }
        pattern border { paint = mortar; width = 1px; edges = bottom; }
        face up {
          fill = limestone; grain = clustered;
          pattern blotch { paint = moss; scale = (4px, 4px, 4px); density = 0.35; phase = 11; }
          pattern border { paint = slate; width = 1px; edges = all; }
        }
        face down { fill = slate; grain = none; }
        face north { stamp rune_mark { at = (5px, 5px); protect = true; } stamp masonry_crack { at = (1px, 2px); protect = true; } }
        face south { stamp moss_clump { at = (2px, 10px); protect = true; } stamp masonry_crack { at = (10px, 3px); protect = true; } }
        face west { stamp moss_clump { at = (1px, 1px); protect = true; } stamp masonry_crack { at = (8px, 11px); protect = true; } }
        face east { mirror = west; }
      }
      grain clustered { seed = 3109; }
      tone painterly;
    }
  }

  component FullBlock {
    requires rig skeleton: BlockRig;
    requires surface skin: BrickBlock;
    bind bone root to skeleton.root;
    geometry {
      bone root {
        cube block { origin = (-8u, 0u, -8u); size = (16u, 16u, 16u); surface = skin.block; }
      }
    }
  }

  settings { density = 16; forward = north; profile = block; }
  skeleton = BlockSkeleton;
  use FullBlock as cube_block { skeleton = BlockRig; skin = mossy_rune_bricks; }

  anchor rune_node : loot_hook.HarvestingNode { bone = root; resource = relic; tool_tier = 2; respawn = 240s; }
}
