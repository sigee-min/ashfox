ashfox 1
module griffin_plumage {
  import "std/core/palette/medieval" as med;
  import "std/core/material/metal" as metal;

  export surface contract GriffinPlumage {
    chart haunch box { coverage = opaque; }
    chart chest box { coverage = opaque; }
    chart breast box { coverage = opaque; }
    chart mantle box { coverage = opaque; }
    chart skull box { coverage = opaque; }
    chart beak box { coverage = opaque; }
    chart crest box { coverage = opaque; }
    chart crest_plume flat { coverage = opaque; }
    chart leg box { coverage = opaque; }
    chart paw box { coverage = opaque; }
    chart brace box { coverage = opaque; }
    chart talon box { coverage = opaque; }
    chart shoulder box { coverage = opaque; }
    chart wing_arm box { coverage = opaque; }
    chart feather box { coverage = opaque; }
    chart feather_outer box { coverage = opaque; }
    chart feather_tip box { coverage = opaque; }
    chart tail_base box { coverage = opaque; }
    chart tail_tuft box { coverage = opaque; }
    chart face_neutral flat { coverage = opaque; }
    chart face_blink flat { coverage = opaque; }
    chart face_screech flat { coverage = opaque; }
    material = cutout;
  }

  export surface boss_plumage: GriffinPlumage {
    material = cutout;
    texture atlas {
      density = 2;
      background = void; background_alpha = 0;
      palette {
        void = #000000;
        gold = (metal.MetalParams.gold_shadow, metal.MetalParams.gold_base, metal.MetalParams.gold_light);
        gold_deep = (med.GuildTimber.walnut_shadow, med.GuildTimber.walnut_base, metal.MetalParams.gold_base);
        ivory = (#9b9789, #d9d4c2, #f8f2e2);
        ivory_mid = (#78746a, #b0ab9d, #dbd5c5);
        beak = (#945c22, #e0a43a, #ffd66e);
        feather = (#6d5e4e, #b8aa92, #eadfc8);
        dark = (med.CastleStone.slate_shadow, med.CastleStone.slate_base, med.CastleStone.slate_light);
        eye = #223b40;
        gleam = #58dec8;
        brow = #665848;
      }
      stamp breast_crest { pixels = "gggg/.gg./.mm."; g = gold; m = ivory_mid; }
      stamp eye_neutral { pixels = "bbbb....bbbb/eeee....eeee/eeeg....geee"; b = brow; e = eye; g = gleam; }
      stamp eye_blink { pixels = "............/bbbb....bbbb/mmmm....mmmm"; b = brow; m = ivory_mid; }
      stamp eye_screech { pixels = "bbbb....bbbb/gggg....gggg/eeee....eeee"; b = brow; e = eye; g = gleam; }

      chart haunch box { fill = gold; roughness = 0.72; metallic = 0.15; grain = soft; pattern gradient { to = gold_deep; axis = y; space = local; soft = 0.2; } pattern ao { strength = 0.4; radius = 0.8u; } }
      chart chest box { fill = ivory; roughness = 0.78; grain = soft; pattern gradient { to = ivory_mid; axis = y; space = local; soft = 0.2; } pattern ao { strength = 0.4; radius = 0.8u; } }
      chart breast box { fill = gold; roughness = 0.28; metallic = 0.86; roughness_variation = 0.08; grain = brushed; face north { stamp breast_crest { at = (2px, 2px); protect = true; } } }
      chart mantle box { fill = ivory_mid; roughness = 0.78; grain = soft; pattern border { paint = gold; width = 1px; edges = bottom; } }
      chart skull box { fill = ivory; roughness = 0.76; grain = soft; pattern border { paint = feather; width = 1px; edges = bottom; } pattern ao { strength = 0.35; radius = 0.7u; } }
      chart beak box { fill = beak; roughness = 0.36; metallic = 0.12; grain = none; pattern border { paint = gold_deep; width = 1px; edges = bottom; } }
      chart crest box { fill = ivory; roughness = 0.75; grain = soft; pattern gradient { to = feather; axis = y; space = local; soft = 0.25; } }
      chart crest_plume flat { fill = feather; roughness = 0.78; grain = soft; }
      chart leg box { fill = beak; roughness = 0.45; grain = soft; pattern ao { strength = 0.45; radius = 0.9u; } }
      chart paw box { fill = beak; roughness = 0.45; grain = soft; }
      chart brace box { fill = gold; roughness = 0.72; grain = soft; }
      chart talon box { fill = dark; roughness = 0.32; metallic = 0.45; grain = none; }
      chart shoulder box { fill = ivory; roughness = 0.76; grain = soft; pattern border { paint = gold; width = 1px; edges = bottom; } }
      chart wing_arm box { fill = ivory_mid; roughness = 0.76; grain = soft; pattern ao { strength = 0.35; radius = 0.7u; } }
      chart feather box { fill = feather; roughness = 0.80; grain = soft; pattern border { paint = ivory; width = 1px; edges = top; } }
      chart feather_outer box { fill = feather; roughness = 0.80; grain = soft; pattern border { paint = ivory; width = 1px; edges = top; } }
      chart feather_tip box { fill = dark; roughness = 0.68; grain = none; pattern border { paint = feather; width = 1px; edges = top; } }
      chart tail_base box { fill = gold; roughness = 0.72; grain = soft; pattern ao { strength = 0.4; radius = 0.8u; } }
      chart tail_tuft box { fill = feather; roughness = 0.78; grain = soft; }
      chart face_neutral flat { fill = ivory; stamp eye_neutral { at = (1px, 2px); protect = true; } }
      chart face_blink flat { fill = ivory; stamp eye_blink { at = (1px, 2px); protect = true; } }
      chart face_screech flat { fill = ivory; stamp eye_screech { at = (1px, 2px); protect = true; } }
      grain soft { seed = 8801; }
      tone painterly;
    }
  }
}
