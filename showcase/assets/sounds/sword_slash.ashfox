ashfox 1
sound sword_slash {
  import "std/sound/combat/blade" as blade;

  profile = impact;
  duration = 0.56s;
  seed = 5193;
  space { preset = courtyard; mix = 16%; }

  voice hilt_thump : modal_plate {
    material = leather;
    pitch = 110hz;
    size = 1.1;
    hardness = 0.72;
    damping = 0.75;
    modes = 10;
    strike = mallet;
    splash = 0.42;
    stereo_spread = 0.3;
    highpass = 45hz;
    eq { low = (110hz, 2.5db); }
    gain { env = ad; attack = 2ms; peak = 0.65; curve = exp; }
  }

  seq slash {
    start = 10ms;
    step whoosh { voice = blade.air_slice; at = 0s; duration = 340ms; vary_duration = 90%..110%; vary_gain = 90%..110%; }
    step edge { voice = blade.steel_sing; at = 10ms; duration = 380ms; vary_pitch = -65cents..65cents; }
    step ring { voice = blade.edge_ring; at = 15ms; duration = 440ms; vary_pitch = -60cents..60cents; }
    step punch { voice = hilt_thump; at = 10ms; duration = 220ms; vary_pitch = -45cents..45cents; }
  }

  variants { base = 42; alternate = 43; }
  master { gain = 5db; target = -13lufs; peak = -1.5db; punch = 45%; air = 25%; limit = true; }
}
