ashfox 1
sound claw_hit {
  import "std/sound/combat/hit" as hit_kit;
  import "std/sound/combat/blade" as blade;

  profile = impact;
  duration = 0.58s;
  seed = 42;
  space { preset = dry_close; mix = 15%; }

  voice bone_slash : modal_plate {
    material = bone;
    pitch = 680hz;
    size = 0.8;
    hardness = 0.88;
    damping = 0.58;
    brightness = 0.82;
    modes = 16;
    strike = scrape;
    twin_beat = 0.28;
    splash = 0.45;
    stereo_spread = 0.65;
    highpass = 220hz;
    filter : lowpass { cutoff = log(0: 11000hz -> 1: 1400hz); q = 1.1; }
    pan = 0.14;
    gain { env = ad; attack = 2ms; peak = 0.82; curve = exp; }
  }

  seq hit {
    start = 10ms;
    step impact { voice = hit_kit.flesh_impact; at = 0s; duration = 440ms; vary_pitch = -65cents..65cents; }
    step bone { voice = bone_slash; at = 0s; duration = 300ms; vary_pitch = -70cents..70cents; vary_gain = 90%..110%; }
    step slash { voice = blade.air_slice; at = 0s; duration = 360ms; vary_duration = 90%..110%; vary_gain = 90%..110%; }
    step sparks { voice = hit_kit.impact_transient; at = 0s; duration = 140ms; vary_gain = 85%..115%; }
  }

  variants { base = 42; alternate = 43; }
  master { gain = 5db; target = -12lufs; peak = -1.5db; punch = 45%; warmth = 20%; glue = 15%; limit = true; }
}
