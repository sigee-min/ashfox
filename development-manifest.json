{
  "$schema": "./development-manifest.schema.json",
  "schemaVersion": 1,
  "productExperience": {
    "interactionModel": "ai-authored-ai-compiled-human-observed",
    "canonicalAuthority": "native-ashfox-source",
    "projectFile": {
      "extension": ".ashfoxworkspace",
      "mediaType": "application/vnd.ashfox.workspace+json",
      "encoding": "utf-8",
      "bom": "forbidden",
      "authority": "optional-repository-configuration",
      "loadMode": "read-validate-build-atomic",
      "compiledState": "derived-files-only"
    },
    "humanCapabilities": [
      "capture-evidence",
      "create-project",
      "download-project",
      "export-artifact",
      "observe-agent-decisions",
      "open-project",
      "prompt-agent-externally",
      "view-canonical-asset"
    ],
    "agentCapabilities": [
      "apply-workspace-change-set",
      "inspect-project",
      "present-review-evidence"
    ],
    "forbiddenHumanAuthoring": [
      "direct-animation-authoring",
      "direct-geometry-authoring",
      "direct-hierarchy-authoring",
      "direct-material-authoring",
      "direct-rig-authoring",
      "direct-texture-authoring"
    ],
    "agentDecision": {
      "compilationAuthority": "agent",
      "confirmationRequired": false,
      "requiredEvidence": [
        "workspace-summary",
        "native-size-review",
        "technical-receipt"
      ]
    },
    "deliveryAuthority": "human"
  },
  "engineering": {
    "style": {
      "typescriptStrict": true,
      "indentSpaces": 2,
      "quotes": "single",
      "semicolons": "required",
      "readonlyPublicContracts": true,
      "mutableDraftsPrivate": true
    },
    "principles": [
      {
        "id": "atomic-mutation",
        "rule": "Validate the complete closed workspace and every declared entry before committing one atomic state transition.",
        "enforcedBy": [
          "tests",
          "typecheck"
        ]
      },
      {
        "id": "closed-contracts",
        "rule": "Persisted and transport inputs must pass closed readers that reject unknown keys.",
        "enforcedBy": [
          "quality:check",
          "tests"
        ]
      },
      {
        "id": "deterministic-output",
        "rule": "Equivalent accepted input must produce byte-stable ordered output.",
        "enforcedBy": [
          "tests"
        ]
      },
      {
        "id": "interface-first",
        "rule": "Expose narrow immutable contracts and keep mutable drafts private to implementations.",
        "enforcedBy": [
          "quality:architecture",
          "typecheck"
        ]
      },
      {
        "id": "no-derived-write-path",
        "rule": "Derived compiler output must not have an independent authoring path.",
        "enforcedBy": [
          "quality:architecture",
          "tests"
        ]
      },
      {
        "id": "owner-scoped-files",
        "rule": "Group related implementations under one owner directory and use short responsibility filenames without repeating the owner prefix.",
        "enforcedBy": [
          "quality:architecture",
          "review"
        ]
      },
      {
        "id": "preserve-unrelated-work",
        "rule": "Preserve and do not stage, revert, or reformat work outside the active task.",
        "enforcedBy": [
          "review"
        ]
      },
      {
        "id": "pure-core-io-adapters",
        "rule": "Keep domain and compiler logic host-independent and place I/O behind adapters.",
        "enforcedBy": [
          "quality:architecture",
          "quality:check"
        ]
      },
      {
        "id": "single-authority",
        "rule": "Each decision and state field must have exactly one declared authority.",
        "enforcedBy": [
          "quality:architecture",
          "review"
        ]
      },
      {
        "id": "source-owned-diagnostics",
        "rule": "Diagnostics must identify the owning source token or canonical path.",
        "enforcedBy": [
          "tests"
        ]
      }
    ],
    "testing": {
      "behaviorChangeRequiresRegression": true,
      "statefulPaths": [
        "success",
        "cancellation",
        "stale-revision",
        "invalid-input",
        "exception"
      ],
      "userVisibleChangeRequiresDocs": true
    },
    "exceptions": []
  },
  "workflow": {
    "dirtyWorktree": "preserve-unrelated",
    "changeScope": "smallest-complete-slice",
    "publicContractChange": "reader-version-contract-test",
    "generatedArtifacts": "edit-source-only",
    "commits": {
      "format": "conventional-commits",
      "subject": "imperative",
      "types": [
        "chore",
        "docs",
        "feat",
        "fix",
        "refactor",
        "test"
      ],
      "atomic": true,
      "breakingChangeRequiresReview": true
    },
    "verification": {
      "duringChange": "focused",
      "beforeHandoff": [
        "git diff --check"
      ],
      "beforePullRequest": [
        "npm run quality"
      ]
    }
  },
  "versioning": {
    "product": {
      "scheme": "semver",
      "sourceOfTruth": "package.json",
      "automation": "release-please",
      "synchronizedFiles": [
        ".github/release-please/manifest.json",
        "packages/blockbench-runtime/src/config.ts"
      ],
      "changeOwner": "release-pr",
      "verification": "npm run release:validate"
    },
    "assetWorkspace": {
      "version": 2,
      "sourceGrammar": "ashfox-model 1",
      "container": "ashfox-workspace:2",
      "compatibility": "exact-current-contract",
      "authority": "packages/engine-core/src/project/directory/contract.ts",
      "compiler": "packages/engine-core/src/compiler/directory/compile.ts",
      "releaseState": "unreleased",
      "replacementPolicy": "apply-complete-change-set-atomically",
      "legacyAliases": "forbidden"
    },
    "deliveryTargets": {
      "scope": "source-defaults-with-optional-workspace-overrides",
      "canonicalMutation": false
    }
  },
  "quality": {
    "maxSourceFileLines": 600,
    "maxCodeFileStemLength": 20,
    "newSourceFileRatchetLines": 500,
    "maxFunctionLines": 200,
    "ownerLayout": {
      "contractFile": "contract",
      "testFileSuffix": ".test",
      "testFileExtension": ".ts",
      "testFileStem": "lower-word",
      "maxTestFileStemLength": 18,
      "maxTestFileLines": 500,
      "testOwnership": "owner-directory-required",
      "testDiscovery": "recursive-stable-nonempty",
      "testOwners": [
        {
          "workspace": "apps/cli",
          "roots": [
            "integration"
          ]
        },
        {
          "workspace": "packages/audio-core",
          "roots": [
            "program"
          ]
        },
        {
          "workspace": "packages/blockbench-conformance",
          "roots": [
            "protocol",
            "revision",
            "schema"
          ]
        },
        {
          "workspace": "packages/blockbench-runtime",
          "roots": [
            "adapters",
            "config",
            "dispatcher",
            "domain",
            "plugin",
            "project",
            "runtime",
            "schema",
            "session",
            "shared",
            "sidecar",
            "support",
            "texture",
            "trace",
            "transport",
            "usecases"
          ]
        },
        {
          "workspace": "packages/engine-core",
          "roots": [
            "animation",
            "commands",
            "export",
            "program",
            "project",
            "textures"
          ]
        }
      ]
    },
    "forbiddenSourcePatterns": [
      {
        "id": "as-any",
        "scope": [
          "apps/",
          "packages/"
        ],
        "allowedPaths": []
      },
      {
        "id": "as-unknown-as",
        "scope": [
          "apps/",
          "packages/"
        ],
        "allowedPaths": []
      },
      {
        "id": "bare-document",
        "scope": [
          "packages/blockbench-runtime/src/"
        ],
        "allowedPaths": []
      },
      {
        "id": "bare-window",
        "scope": [
          "packages/blockbench-runtime/src/"
        ],
        "allowedPaths": []
      },
      {
        "id": "browser-authoring-contract",
        "scope": [
          "apps/site/src/"
        ],
        "allowedPaths": []
      },
      {
        "id": "catch-without-binding",
        "scope": [
          "packages/blockbench-runtime/src/"
        ],
        "allowedPaths": []
      },
      {
        "id": "console-in-src",
        "scope": [
          "apps/",
          "packages/"
        ],
        "allowedPaths": [
          "packages/blockbench-runtime/src/logging.ts"
        ]
      },
      {
        "id": "double-assertion",
        "scope": [
          "apps/",
          "packages/"
        ],
        "allowedPaths": []
      },
      {
        "id": "engine-core-host-dependency",
        "scope": [
          "packages/engine-core/src/"
        ],
        "allowedPaths": []
      },
      {
        "id": "explicit-any",
        "scope": [
          "apps/",
          "packages/"
        ],
        "allowedPaths": []
      },
      {
        "id": "globalThis-as",
        "scope": [
          "packages/blockbench-runtime/src/"
        ],
        "allowedPaths": [
          "packages/blockbench-runtime/src/shared/globalState.ts",
          "packages/blockbench-runtime/src/types/blockbench.ts"
        ]
      },
      {
        "id": "throw-in-src",
        "scope": [
          "packages/blockbench-runtime/src/"
        ],
        "allowedPaths": [
          "packages/blockbench-runtime/src/plugin/runtime.ts"
        ]
      },
      {
        "id": "todo-fixme-comment",
        "scope": [
          "packages/blockbench-runtime/src/"
        ],
        "allowedPaths": []
      },
      {
        "id": "ts-ignore",
        "scope": [
          "apps/",
          "packages/"
        ],
        "allowedPaths": []
      }
    ]
  },
  "architecture": {
    "workspaceSourceScopes": [
      "apps",
      "packages"
    ],
    "workspacePolicy": {
      "required": [
        "apps/site"
      ],
      "forbidden": [
        "apps/mcp-gateway",
        "apps/web",
        "apps/worker",
        "packages/backend-core",
        "packages/backend-engine"
      ]
    },
    "tombstones": [
      "apps/ashfox/package.json",
      "apps/cli/build.test.js",
      "apps/cli/capture.test.js",
      "apps/cli/configuration.test.js",
      "apps/cli/docs.test.js",
      "apps/cli/exports.test.js",
      "apps/cli/game.test.js",
      "apps/cli/minecraft.test.js",
      "apps/cli/observe.test.js",
      "apps/cli/onboarding.test.js",
      "apps/cli/packaudio.test.js",
      "apps/cli/packs.test.js",
      "apps/cli/standalone.test.js",
      "apps/cli/test.js",
      "apps/item-study/cli.js",
      "apps/item-study/harness.js",
      "apps/item-study/worker.js",
      "apps/mcp-gateway/package.json",
      "apps/plugin-desktop/package.json",
      "apps/web",
      "apps/web/src/app/api/mcp/route.ts",
      "apps/worker/package.json",
      "docs/guides/workbench-api.md",
      "packages/asset-build/src/archive.ts",
      "packages/asset-build/src/compile.ts",
      "packages/asset-build/src/contract.ts",
      "packages/asset-build/src/digest.ts",
      "packages/asset-build/src/game.ts",
      "packages/asset-build/src/minecraft.ts",
      "packages/asset-build/src/packs.ts",
      "packages/asset-build/src/path.ts",
      "packages/asset-build/src/runtime.ts",
      "packages/asset-build/src/runtimeRead.ts",
      "packages/backend-blockbench/package.json",
      "packages/backend-core/package.json",
      "packages/backend-engine/package.json",
      "packages/engine-core/src/projectFile/workspace",
      "scripts/agent-browser",
      "scripts/audio",
      "scripts/build-blockbench.js",
      "scripts/build-public.js",
      "scripts/build-skill-release.js",
      "scripts/capture-showcase.js",
      "scripts/export-examples.js",
      "scripts/items",
      "scripts/readme.js",
      "scripts/serve-public.js",
      "scripts/showcase.js",
      "scripts/social.js",
      "scripts/test-skill-release.js",
      "scripts/test-skill-sync.py",
      "scripts/verify-program-corpus.js"
    ],
    "packageDependencyPolicies": [
      {
        "workspace": "apps/site",
        "sections": [
          "dependencies",
          "devDependencies"
        ],
        "mode": "allow-only",
        "values": [
          "@ashfox/internal-contracts",
          "marked"
        ]
      }
    ],
    "sourceImportBoundaries": [
      {
        "source": "apps/site/",
        "extensions": [
          ".js",
          ".mjs"
        ],
        "allowedExternalImports": [
          "@ashfox/internal-contracts"
        ],
        "forbiddenExternalPrefixes": [
          "@ashfox/"
        ],
        "forbiddenExternalPackageRoots": [
          "react",
          "three"
        ],
        "forbiddenRelativeTargets": [
          "packages/engine-core/"
        ]
      }
    ],
    "forbiddenDependencies": [
      {
        "source": "packages/asset-build/src/bundle/",
        "targets": [
          "packages/asset-build/src/node/"
        ]
      },
      {
        "source": "packages/asset-build/src/packs/",
        "targets": [
          "packages/asset-build/src/node/"
        ]
      },
      {
        "source": "packages/asset-build/src/shared/",
        "targets": [
          "packages/asset-build/src/bundle/",
          "packages/asset-build/src/node/",
          "packages/asset-build/src/packs/"
        ]
      },
      {
        "source": "packages/blockbench-runtime/src/adapters/",
        "targets": [
          "packages/blockbench-runtime/src/plugin/",
          "packages/blockbench-runtime/src/transport/",
          "packages/blockbench-runtime/src/usecases/"
        ]
      },
      {
        "source": "packages/blockbench-runtime/src/domain/",
        "targets": [
          "packages/blockbench-runtime/src/adapters/",
          "packages/blockbench-runtime/src/plugin/",
          "packages/blockbench-runtime/src/transport/",
          "packages/blockbench-runtime/src/usecases/"
        ]
      },
      {
        "source": "packages/blockbench-runtime/src/usecases/",
        "targets": [
          "packages/blockbench-runtime/src/plugin/",
          "packages/blockbench-runtime/src/transport/"
        ]
      },
      {
        "source": "packages/engine-core/src/compiler/",
        "targets": [
          "packages/engine-core/src/commands/",
          "packages/engine-core/src/validation/"
        ]
      },
      {
        "source": "packages/engine-core/src/project/",
        "targets": [
          "packages/engine-core/src/commands/",
          "packages/engine-core/src/compiler/",
          "packages/engine-core/src/validation/"
        ]
      },
      {
        "source": "packages/render-core/src/",
        "targets": [
          "apps/cli/src/"
        ]
      }
    ]
  }
}
